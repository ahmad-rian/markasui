    .map(
      (p, i) =>
        `${i ? "L" : "M"}${(i * CHART_W) / (points.length - 1)} ${CHART_H - p * 2}`,
    )
    .join("");

const signed = (value: number) => `${value > 0 ? "+" : ""}${value.toFixed(1)}%`;

/** Bentuk lengkap data periode untuk tampilan, dari data ringkas di atas. */
const expand = (d: PeriodData) => {
  const total = d.stats[1]?.[0] ?? "";
  const [onProcess, canceled, delivered] = d.segments.map(([count]) => count);
  return {
    label: d.label,
    subtitle: `Here is how your store performed this ${d.unit}.`,
    compare: `last ${d.unit}`,
    stats: d.stats.map(([value = "", change = "", previous = ""]) => ({
      value,
      change,
      previous,
      up: !change.startsWith("-"),
    })),
    spark: {
      line: d.spark,
      area: `${d.spark}L120 40L0 40Z`,
      summary: d.sparkSummary,
    },
    chart: {
      caption: d.chart,
      summary: d.chartSummary,
      bars: d.bars.map(([label, short, height]) => ({
        label,
        short,
        height,
        value: `Rp ${short}`,
      })),
    },
    activity: {
      caption: `Order status this ${d.unit}`,
      total,
      summary: `${total} orders this ${d.unit}: ${onProcess} on process, ${canceled} canceled, ${delivered} delivered`,
      segments: d.segments.map(([count, share], i) => ({
        label: segmentLabels[i] ?? "",
        count,
        share,
      })),
    },
    regions: {
      caption: `Top provinces this ${d.unit}`,
      total,
      items: d.regions.map((share, i) => ({ name: provinces[i] ?? "", share })),
    },
  };
};

/** Panjang dan posisi tiap segmen gauge pada busur dengan pathLength 100. */
const dashFor = (segments: { share: number }[], index: number) => {
  const start = segments.slice(0, index).reduce((sum, s) => sum + s.share, 0);
  const segment = segments[index];
  const length = Math.max((segment?.share ?? 0) - GAUGE_GAP, 0);
  return { dasharray: `${length} 100`, dashoffset: `${-start}` };
};

/* Kelas pesan obrolan, dipakai server dan script (pesan baru). */
const messageRow = {
  me: "grid max-w-[80%] gap-1 justify-items-end justify-self-end",
  them: "grid max-w-[80%] gap-1 justify-items-start justify-self-start",
};
const messageBubble = {
  me: "rounded-2xl px-4 py-2.5 text-sm bg-primary text-on-primary",
  them: "rounded-2xl px-4 py-2.5 text-sm bg-subtle text-ink",
};
const messageTime = "text-xs text-muted";
const barValue = {
  on: "font-semibold text-ink",
  off: "hidden text-muted sm:block",
};
const barFill = {
  on: "bg-primary",
  off: "bg-primary/15 group-hover:bg-primary/25",
};
const barLabel = { on: "font-medium text-ink", off: "text-muted" };
const chatState = { on: "bg-subtle", off: "hover:bg-subtle/60" };
const SUPPORT = "mailto:support@larisa.id";
const initialReplies: Record<string, string> = {
  "Yoga Pratama": "Sorry about that! A replacement pair is on its way.",
};
const initialConnected = ["Bayarin", "Kirimaja", "Chatku", "Metrik"];

/** Ikon garis 24px sebagai HTML, seperti $icon di versi Blade. */
const icon = (d: string, className = "size-4") =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"></path></svg>`;
const starsHtml = (rating: number) =>
  `<span role="img" aria-label="Rated ${rating} out of 5" class="flex shrink-0 gap-0.5">${[1, 2, 3, 4, 5]
    .map((star) =>
      icon(
        icons.reviews,
        cx("size-4", star <= rating ? "fill-warning text-warning" : "text-faint"),
      ),
    )
    .join("")}</span>`;
const navButton = (value: string, label: string, d: string, submit: boolean) =>
  `<button type="${submit ? "submit" : "button"}" data-larisa-go="${value}"${value === "overview" ? ' aria-current="page"' : ""} class="${cx(navItem, value === "overview" ? navActive : navIdle)}">${icon(d)}${label}</button>`;
const navHtml = (submit: boolean) =>
  navGroups
    .map(
      (group) =>
        `<div class="grid gap-2"><p class="px-3 text-xs font-medium text-faint">${group.label}</p><ul class="grid gap-1">${group.items
          .map((item) => `<li>${navButton(item.value, item.label, item.icon, submit)}</li>`)
          .join("")}</ul></div>`,
    )
    .join("");
const supportHtml = (submit: boolean) =>
  `<div class="grid gap-1 border-t border-line pt-4">${navButton("help", "Help center", icons.help, submit)}<button type="button" data-larisa-logout class="${cx(navItem, navIdle)}">${icon(icons.logout)}Log out</button></div>`;

/** Satu klon per halaman; Overview per periode dan Analytics per rentang supaya angka dirender server. */
type View = { key: string; page: Page; period: Period; range: string; live: boolean };
const view = (page: Page, key: string = page, period: Period = "monthly", range = "30d", live = false): View => ({ key, page, period, range, live });
const views: View[] = [
  view("overview", "overview:monthly", "monthly", "30d", true),
  ...(Object.keys(data) as Period[]).map((period) => view("overview", `overview:${period}`, period)),
  ...trafficRanges.map((entry) => view("analytics", `analytics:${entry.value}`, "monthly", entry.value)),
  view("customers"),
  view("integrations"),
  view("messages"),
  view("reviews"),
  view("help"),
];
const actionViews = [
  { page: "overview", live: true },
  ...["overview", "analytics", "customers", "messages"].map((page) => ({ page, live: false })),
];
const monthly = expand(data.monthly);

/** Data dan class yang dipakai script di klien. */
const config = JSON.stringify({
  titles: pageTitles,
  subtitles: pageSubtitles,
  periods: Object.fromEntries(
    (Object.keys(data) as Period[]).map((period) => {
      const d = expand(data[period]);
      return [period, { label: d.label, subtitle: d.subtitle, bars: d.chart.bars.length }];
    }),
  ),
  defaultBar: DEFAULT_BAR,
  sellers,
  ranges,
  categories,
  sortIcons: { sort: icons.sort, asc: icons.asc, desc: icons.desc },
  customers: customers.map((c) => ({ name: c.name, segment: c.segment, search: [c.name, c.email, c.city] })),
  integrations: integrations.map((item) => item.name),
  connected: initialConnected,
  conversations,
  threads: initialThreads,
  reviews: reviews.map((entry) => ({ name: entry.name, text: entry.text, group: ratingGroup(entry.rating) })),
  replies: initialReplies,
  faqs: faqs.map((faq) => [faq.title, faq.content]),
  classes: { navActive, navIdle, barValue, barFill, barLabel, chatState, messageRow, messageBubble, messageTime },
  ids: { logout: LOGOUT_ID, customer: CUSTOMER_ID, reply: REPLY_ID },
});
---

<larisa-template class="contents" data-config={config}>
  <div class="min-h-dvh bg-canvas text-ink lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]">
    <aside class="sticky top-0 hidden h-dvh flex-col gap-8 border-r border-line bg-surface px-4 py-6 lg:flex">
      <div class="flex items-center gap-2.5 px-3">
        <span class="grid size-8 place-items-center rounded-lg bg-primary text-sm font-semibold text-on-primary" aria-hidden="true">L</span>
        <span class="text-lg font-semibold tracking-tight">Larisa</span>
      </div>
      <nav aria-label="Main navigation" class="grid flex-1 content-start gap-6" set:html={navHtml(false)} />
      <Fragment set:html={supportHtml(false)} />
    </aside>

    <div class="flex min-w-0 flex-col">
      <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-line bg-surface px-4 sm:px-6 lg:px-8">
        <Drawer title="Menu" side="left">
          <button slot="trigger" type="button" class={cx(iconButton, "lg:hidden")} aria-label="Open menu" set:html={icon(icons.menu)} />
          <form method="dialog" class="grid gap-6">
            <nav aria-label="Mobile navigation" class="grid gap-6" set:html={navHtml(true)} />
            <Fragment set:html={supportHtml(true)} />
          </form>
        </Drawer>
        <div class="relative min-w-0 flex-1 sm:max-w-sm">
          <Input type="search" aria-label="Search sellers" placeholder="Search sellers or products" class="pl-9!" data-larisa-query />
          <Fragment set:html={icon(icons.search, searchIcon)} />
        </div>
        <div class="ml-auto flex items-center gap-3">
          <button type="button" class={iconButton} aria-label="Notifications, 3 unread" data-larisa-notify>
            <Fragment set:html={icon(icons.bell)} />
            <span class="absolute -top-1.5 -right-1.5 grid size-5 place-items-center rounded-full border-2 border-surface bg-danger text-[10px] font-semibold text-on-primary" aria-hidden="true">3</span>
          </button>
          <span class="hidden h-8 w-px bg-line sm:block" aria-hidden="true"></span>
          <div class="flex items-center gap-3">
            <Avatar name="Rizky Pratama" />
            <div class="hidden leading-tight md:grid">
              <span class="text-sm font-medium text-ink">Rizky Pratama</span>
              <span class="text-xs text-muted">rizky@larisa.id</span>
            </div>
          </div>
        </div>
      </header>

      <main class="grid min-w-0 content-start gap-6 p-4 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="grid gap-1">
            <Breadcrumb class="mb-1" items={[{ label: "Dashboard", href: "#overview" }, { label: pageTitles.overview }]} />
            <h1 tabindex="-1" class="text-2xl font-semibold tracking-tight text-ink focus:outline-none" data-larisa-heading>{pageTitles.overview}</h1>
            <p class="text-sm text-muted" data-larisa-subtitle>{monthly.subtitle}</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            {
              actionViews.map(({ page, live }) => {
                const Wrapper = live ? "div" : "template";
                return (
                  <Wrapper class={live ? "contents" : undefined} data-larisa-actions={live ? "" : undefined} data-larisa-actions-page={live ? undefined : page}>
                    {page === "overview" && (
                      <>
                        <DropdownMenu items={periodItems} data-larisa-period>
                          <Fragment slot="trigger"><Fragment set:html={icon(icons.calendar)} /><span class="sr-only">{"Period: "}</span><span data-larisa-period-label>{monthly.label}</span></Fragment>
                        </DropdownMenu>
                        <Drawer title="Filter report">
                          <Button slot="trigger" variant="secondary" data-larisa-filters><Fragment set:html={icon(icons.filter)} />Filter</Button>
                          <div class="grid gap-5">
                            <p>Narrow down the best sellers table by date range and product category.</p>
                            <Select label="Date range" data-larisa-draft-range>
                              {ranges.map((entry) => <option value={entry.value} selected={entry.value === "last-30"}>{entry.label}</option>)}
                            </Select>
                            <Select label="Category" data-larisa-draft-category>
                              {categories.map((entry) => <option value={entry.value}>{entry.label}</option>)}
                            </Select>
                          </div>
                          <Fragment slot="footer">
                            <Button variant="secondary" type="submit" value="reset" data-larisa-reset>Reset</Button>
                            <Button type="submit" value="apply" data-larisa-apply>Apply filters</Button>
                          </Fragment>
                        </Drawer>
                        <Button data-larisa-export><Fragment set:html={icon(icons.download)} />Export</Button>
                      </>
                    )}
                    {page === "analytics" && <ToggleGroup label="Period" items={trafficRanges} value="30d" data-larisa-toggle="range" />}
                    {page === "customers" && (
                      <Button variant="secondary" data-larisa-export-customers><Fragment set:html={icon(icons.download)} />Export</Button>
                    )}
                    {page === "messages" && (
                      <Button variant="secondary" data-larisa-mark-read>Mark all as read</Button>
                    )}
                  </Wrapper>
                );
              })
            }
          </div>
        </div>

        {
          views.map(({ key, page, period, range, live }) => {
            const Wrapper = live ? "div" : "template";
            const current = expand(data[period]);
            const stats = traffic[range] ?? traffic["30d"]!;
            const trend = linePath(stats.points);
            return (
              <Wrapper class={live ? "contents" : undefined} data-larisa-view={live ? "" : undefined} data-larisa-page={live ? undefined : key}>
                {page === "overview" && (
                  <div class="grid min-w-0 gap-6">
                    <section aria-labelledby="metrics-title">
                      <h2 id="metrics-title" class="sr-only">Key metrics</h2>
                      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                        {statCards.map((card, index) => {
                          const stat = current.stats[index]!;
                          const highlight = index === 0;
                          return (
                            <article class={cx("grid gap-4 rounded-xl border p-5", highlight ? "border-primary bg-primary text-on-primary" : "border-line bg-surface text-ink")}>
                              <div class="flex items-center justify-between gap-3">
                                <h3 class={cx("text-sm font-medium", highlight ? "text-on-primary/85" : "text-muted")}>{card.label}</h3>
                                <span class={cx("grid size-9 place-items-center rounded-lg", highlight ? "bg-on-primary/10" : "bg-subtle")} set:html={icon(card.icon)} />
                              </div>
                              <div class="flex items-end justify-between gap-3">
                                <p class="text-2xl font-semibold tracking-tight tabular-nums">{stat.value}</p>
                                {index === 3 && (
                                  <svg class="h-10 w-24 shrink-0 text-primary" viewBox="0 0 120 40" preserveAspectRatio="none" role="img" aria-label={current.spark.summary}>
                                    <path d={current.spark.area} class="fill-primary/10" />
                                    <path d={current.spark.line} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                                  </svg>
                                )}
                              </div>
                              <div class="flex flex-wrap items-center gap-2 text-xs">
                                <span class="inline-flex rounded-full bg-surface"><Badge variant={stat.up ? "success" : "danger"} dot={false}><span>{stat.change}</span></Badge></span>
                                <span class={highlight ? "text-on-primary/85" : "text-muted"}>{`vs ${stat.previous} ${current.compare}`}</span>
                              </div>
                            </article>
                          );
                        })}
                      </div>
                    </section>

                    <div class="grid gap-4 xl:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)]">
                      <Card aria-labelledby="report-title">
                        <div class="grid gap-6">
                          <div class="flex flex-wrap items-start justify-between gap-4">
                            <div class="grid gap-1">
                              <h2 id="report-title" class={sectionTitle}>Sales report</h2>
                              <p class={sectionCaption}>{current.chart.caption}</p>
                            </div>
                            <div class="grid justify-items-end gap-0.5 text-right" aria-live="polite">
                              <p class="text-xs text-muted" data-larisa-picked-label>{current.chart.bars[DEFAULT_BAR]?.label}</p>
                              <p class="text-lg font-semibold tabular-nums" data-larisa-picked-value>{current.chart.bars[DEFAULT_BAR]?.value}</p>
                            </div>
                          </div>
                          <div class="relative">
                            <div class="pointer-events-none absolute inset-x-0 top-12 bottom-6 flex flex-col justify-between" aria-hidden="true">
                              <span class="border-t border-dashed border-line"></span>
                              <span class="border-t border-dashed border-line"></span>
                              <span class="border-t border-dashed border-line"></span>
                              <span class="border-t border-line"></span>
                            </div>
                            <div role="group" aria-label={current.chart.summary} class="relative grid grid-cols-6 gap-3 sm:gap-5">
                              {current.chart.bars.map((entry, index) => {
                                const state = index === DEFAULT_BAR ? "on" : "off";
                                return (
                                  <button type="button" aria-pressed={index === DEFAULT_BAR ? "true" : "false"} data-larisa-bar={index} data-label={entry.label} data-value={entry.value} class={cx("group flex h-64 min-w-0 flex-col items-center justify-end gap-2 rounded-md", focusRing)}>
                                    <span class={cx("text-xs tabular-nums", barValue[state])} data-larisa-bar-value>{entry.short}</span>
                                    <span class={cx("w-full max-w-14 rounded-t-md transition-colors duration-150 ease-out motion-reduce:transition-none", barFill[state])} style={`height: ${(entry.height * BAR_MAX_PX) / 100}px`} data-larisa-bar-fill></span>
                                    <span class={cx("text-xs", barLabel[state])} data-larisa-bar-label>{entry.label}</span>
                                  </button>
                                );
                              })}
                            </div>
                          </div>
                        </div>
                      </Card>

                      <Card aria-labelledby="activity-title">
                        <div class="grid gap-6">
                          <div class="grid gap-1">
                            <h2 id="activity-title" class={sectionTitle}>Sales activity</h2>
                            <p class={sectionCaption}>{current.activity.caption}</p>
                          </div>
                          <div class="relative mx-auto w-full max-w-72">
                            <svg viewBox="0 0 200 110" class="w-full" role="img" aria-label={current.activity.summary}>
                              <path d={GAUGE_ARC} pathLength="100" fill="none" stroke-width="20" class="stroke-subtle" />
                              {current.activity.segments.map((_, index) => {
                                const dash = dashFor(current.activity.segments, index);
                                return <path d={GAUGE_ARC} pathLength="100" fill="none" stroke-width="20" stroke-dasharray={dash.dasharray} stroke-dashoffset={dash.dashoffset} class={segmentClasses[index]} />;
                              })}
                            </svg>
                            <div class="absolute inset-x-0 bottom-0 grid justify-items-center gap-0.5">
                              <p class="text-2xl font-semibold tracking-tight tabular-nums">{current.activity.total}</p>
                              <p class="text-xs text-muted">Total orders</p>
                            </div>
                          </div>
                          <ul class="grid gap-3">
                            {current.activity.segments.map((entry, index) => (
                              <li class="flex items-center justify-between gap-3">
                                <span class="flex items-center gap-2"><span class={cx("size-2.5 rounded-full", dotClasses[index])} aria-hidden="true"></span>{entry.label}</span>
                                <span class="flex items-center gap-2 tabular-nums">
                                  <span class="font-medium text-ink">{entry.count}</span>
                                  <span class="w-10 text-right text-muted">{`${entry.share}%`}</span>
                                </span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </Card>
                    </div>

                    <div class="grid gap-4 xl:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)]">
                      <Card aria-labelledby="sellers-title" class="min-w-0">
                        <div class="grid gap-5">
                          <div class="grid gap-1">
                            <h2 id="sellers-title" class={sectionTitle}>Best sellers</h2>
                            <p class={sectionCaption} data-larisa-sellers-caption>{`${labelOf(ranges, "last-30")}, ${labelOf(categories, "all")}`}</p>
                          </div>
                          <div role="region" aria-label="Best sellers" tabindex="0" class={cx(tableWrap, focusRing)}>
                            <table class="w-full border-collapse text-sm">
                              <thead>
                                <tr class={headRow}>
                                  {columns.map((column) => (
                                    <th scope="col" aria-sort={column.key === "total" ? "descending" : undefined} data-larisa-sort={column.key} class={cx(headCell, column.numeric ? "text-right" : "text-left")}>
                                      <button type="button" data-numeric={column.numeric ? "true" : undefined} class={cx("-my-0.5 inline-flex min-h-6 items-center gap-1 rounded-sm transition-colors duration-150 ease-out hover:text-ink motion-reduce:transition-none", column.key === "total" && "text-ink", focusRing)}>{column.label}<Fragment set:html={icon(column.key === "total" ? icons.desc : icons.sort, "size-3.5")} /></button>
                                    </th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody data-larisa-sellers>
                                {sellers.map((seller, index) => (
                                  <tr data-seller={index} class={row}>
                                    <td class="px-4 py-3">
                                      <div class="flex items-center gap-3">
                                        <Avatar name={seller.name} size="sm" />
                                        <span class="font-medium whitespace-nowrap text-ink">{seller.name}</span>
                                      </div>
                                    </td>
                                    <td class="px-4 py-3">
                                      <div class="grid">
                                        <span class="whitespace-nowrap text-ink">{seller.product}</span>
                                        <span class="text-xs text-muted">{labelOf(categories, seller.category)}</span>
                                      </div>
                                    </td>
                                    <td class="px-4 py-3 text-right"><Badge variant={seller.change >= 0 ? "success" : "danger"} dot={false}><span>{signed(seller.change)}</span></Badge></td>
                                    <td class="px-4 py-3 text-right font-medium whitespace-nowrap text-ink tabular-nums">{`Rp ${seller.total.toFixed(1)}M`}</td>
                                  </tr>
                                ))}
                                <tr class="border-t border-line" hidden data-larisa-empty>
                                  <td colspan="4" class="px-4 py-8 text-center text-muted">No sellers match your filters.</td>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                        </div>
                      </Card>

                      <Card aria-labelledby="regions-title">
                        <div class="grid gap-5">
                          <div class="grid gap-1">
                            <h2 id="regions-title" class={sectionTitle}>Orders by region</h2>
                            <p class={sectionCaption}>{current.regions.caption}</p>
                          </div>
                          <div class="flex items-baseline gap-2">
                            <p class="text-3xl font-semibold tracking-tight tabular-nums">{current.regions.total}</p>
                            <p class="text-sm text-muted">orders from 34 provinces</p>
                          </div>
                          <ul class="grid gap-4">
                            {current.regions.items.map((region) => (
                              <li class="grid gap-2">
                                <div class="flex items-center justify-between gap-3">
                                  <span class="font-medium text-ink">{region.name}</span>
                                  <span class="text-muted tabular-nums">{`${region.share}%`}</span>
                                </div>
                                <Progress value={region.share} aria-label={`${region.name} share of orders`} class="h-1.5!" />
                              </li>
                            ))}
                          </ul>
                        </div>
                      </Card>
                    </div>
                  </div>
                )}

                {page === "analytics" && (
                  <div class="grid min-w-0 gap-6">
                    <section aria-labelledby="traffic-title">
                      <h2 id="traffic-title" class="sr-only">Traffic metrics</h2>
                      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                        {kpiLabels.map((label, index) => {
                          const change = stats.changes[index] ?? "";
                          return (
                            <article class={cx(panel, "grid gap-3 p-5")}>
                              <h3 class="text-sm font-medium text-muted">{label}</h3>
                              <div class="flex items-center justify-between gap-3">
                                <p class="text-2xl font-semibold tracking-tight tabular-nums">{stats.kpis[index]}</p>
                                <Badge variant={change.startsWith("-") ? "danger" : "success"} dot={false}><span>{change}</span></Badge>
                              </div>
                            </article>
                          );
                        })}
                      </div>
                    </section>
                    <div class="grid gap-4 xl:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)]">
                      <Card aria-labelledby="trend-title">
                        <div class="grid gap-6">
                          <div class="flex flex-wrap items-start justify-between gap-4">
                            <div class="grid gap-1">
                              <h2 id="trend-title" class={sectionTitle}>Sales trend</h2>
                              <p class={sectionCaption}>{stats.caption}</p>
                            </div>
                            <p class="text-lg font-semibold tabular-nums">{stats.total}</p>
                          </div>
                          <div class="grid gap-3">
                            <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="none" class="h-56 w-full text-primary" role="img" aria-label={stats.summary}>
                              <path d="M0 50H600M0 100H600M0 150H600" class="stroke-line" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
                              <path d={`${trend}L${CHART_W} ${CHART_H}L0 ${CHART_H}Z`} class="fill-primary/10" />
                              <path d={trend} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                            </svg>
                            <div class="flex justify-between text-xs text-muted" aria-hidden="true">
                              {stats.axis.map((label) => <span>{label}</span>)}
                            </div>
                          </div>
                        </div>
                      </Card>
                      <Card aria-labelledby="funnel-title">
                        <div class="grid gap-5">
                          <div class="grid gap-1">
                            <h2 id="funnel-title" class={sectionTitle}>Conversion funnel</h2>
                            <p class={sectionCaption}>From store visit to completed order</p>
                          </div>
                          <ol class="grid gap-5">
                            {funnelSteps.map((step, index) => {
                              const count = stats.funnel[index] ?? 0;
                              const share = Math.round((count / (stats.funnel[0] ?? 1)) * 1000) / 10;
                              return (
                                <li class="grid gap-2">
                                  <div class="flex items-center justify-between gap-3">
                                    <span class="font-medium text-ink">{step}</span>
                                    <span class="text-muted tabular-nums">{`${count.toLocaleString("en-US")} (${share}%)`}</span>
                                  </div>
                                  <Progress value={share} aria-label={`${step}, ${share}% of visits`} class="h-1.5!" />
                                </li>
                              );
                            })}
                          </ol>
                        </div>
                      </Card>
                    </div>
                    <Card aria-labelledby="channels-title">
                      <div class="grid gap-5">
                        <div class="grid gap-1">
                          <h2 id="channels-title" class={sectionTitle}>Traffic channels</h2>
                          <p class={sectionCaption}>{`Where your ${stats.kpis[0]} visitors came from`}</p>
                        </div>
                        <div class="flex h-3 gap-1 overflow-hidden rounded-full" aria-hidden="true">
                          {stats.channels.map((share, index) => <span class={cx("h-full", channelClasses[index])} style={`width: ${share}%`}></span>)}
                        </div>
                        <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                          {stats.channels.map((share, index) => (
                            <li class="grid gap-1">
                              <span class="flex items-center gap-2 text-muted"><span class={cx("size-2.5 rounded-full", channelClasses[index])} aria-hidden="true"></span>{channelNames[index]}</span>
                              <span class="text-xl font-semibold tracking-tight tabular-nums">{`${share}%`}</span>
                              <span class="text-xs text-muted tabular-nums">{`${Math.round(((stats.funnel[0] ?? 0) * share) / 100).toLocaleString("en-US")} visits`}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </Card>
                  </div>
                )}

                {page === "customers" && (
                  <div class="grid min-w-0 gap-6">
                    <Card aria-labelledby="customers-title" class="min-w-0">
                      <div class="grid gap-5">
                        <div class="flex flex-wrap items-end justify-between gap-4">
                          <div class="grid gap-1">
                            <h2 id="customers-title" class={sectionTitle}>Customer list</h2>
                            <p class={sectionCaption} aria-live="polite" data-larisa-customer-count>{`Showing ${customers.length} of ${customers.length} customers`}</p>
                          </div>
                          <ToggleGroup label="Segment" items={segments} value="all" class="flex-wrap" data-larisa-toggle="segment" />
                        </div>
                        <div class="relative sm:max-w-xs">
                          <Input type="search" aria-label="Search customers" placeholder="Search name, email or city" class="pl-9!" data-larisa-customer-query />
                          <Fragment set:html={icon(icons.search, searchIcon)} />
                        </div>
                        <div role="region" aria-label="Customers" tabindex="0" class={cx(tableWrap, focusRing)}>
                          <table class="w-full border-collapse text-sm">
                            <thead>
                              <tr class={headRow}>
                                <th scope="col" class={headCell}>Customer</th>
                                <th scope="col" class={headCell}>City</th>
                                <th scope="col" class={headCell}>Segment</th>
                                <th scope="col" class={cx(headCell, "text-right")}>Orders</th>
                                <th scope="col" class={cx(headCell, "text-right")}>Total spent</th>
                                <th scope="col" class={headCell}><span class="sr-only">Actions</span></th>
                              </tr>
                            </thead>
                            <tbody>
                              {customers.map((entry, index) => (
                                <tr data-customer={index} class={row}>
                                  <td class="px-4 py-3">
                                    <div class="flex items-center gap-3">
                                      <Avatar name={entry.name} size="sm" />
                                      <div class="grid">
                                        <span class="font-medium whitespace-nowrap text-ink">{entry.name}</span>
                                        <span class="text-xs text-muted">{entry.email}</span>
                                      </div>
                                    </div>
                                  </td>
                                  <td class="px-4 py-3 whitespace-nowrap">{entry.city}</td>
                                  <td class="px-4 py-3"><Badge variant={segmentBadges[entry.segment]}>{labelOf(segments, entry.segment)}</Badge></td>
                                  <td class="px-4 py-3 text-right tabular-nums">{entry.orders}</td>
                                  <td class="px-4 py-3 text-right font-medium whitespace-nowrap text-ink tabular-nums">{entry.spent}</td>
                                  <td class="px-4 py-3 text-right"><Button variant="ghost" size="sm" aria-label={`View ${entry.name}`} data-larisa-view-customer={entry.name}>View</Button></td>
                                </tr>
                              ))}
                              <tr class="border-t border-line" hidden data-larisa-empty>
                                <td colspan="6" class="px-4 py-8 text-center text-muted">No customers match your search.</td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </Card>
                    <Drawer id={CUSTOMER_ID} title="Customer details">
                      <div class="contents" data-larisa-customer-details></div>
                      {customers.map((customer) => (
                        <template data-larisa-customer={customer.name}>
                          <div class="grid gap-6">
                            <div class="grid gap-0.5">
                              <p class="text-base font-semibold text-ink">{customer.name}</p>
                              <p>{customer.email}</p>
                            </div>
                            <dl class="grid grid-cols-2 gap-4">
                              {[
                                ["Segment", labelOf(segments, customer.segment)],
                                ["City", customer.city],
                                ["Orders", String(customer.orders)],
                                ["Total spent", customer.spent],
                                ["Customer since", customer.since],
                                ["Last order", customer.last],
                              ].map(([term, value]) => (
                                <div class="grid gap-1">
                                  <dt class="text-xs">{term}</dt>
                                  <dd class="font-medium text-ink">{value}</dd>
                                </div>
                              ))}
                            </dl>
                          </div>
                        </template>
                      ))}
                      <Button slot="footer" type="submit" data-larisa-goto="messages"><Fragment set:html={icon(icons.messages)} />Send message</Button>
                    </Drawer>
                  </div>
                )}

                {page === "integrations" && (
                  <div class="grid min-w-0 gap-6">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                      <ToggleGroup label="Category" items={integrationCategories} value="all" class="flex-wrap" data-larisa-toggle="integrationCategory" />
                      <p class="text-sm text-muted" aria-live="polite" data-larisa-active-count>{`${initialConnected.length} of ${integrations.length} active`}</p>
                    </div>
                    <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                      {integrations.map((item) => {
                        const on = initialConnected.includes(item.name);
                        return (
                          <li class={cx(panel, "grid content-start gap-4 p-5")} data-category={item.category} data-integration={item.name}>
                            <div class="flex items-center justify-between gap-3">
                              <span class="grid size-10 place-items-center rounded-lg bg-subtle text-sm font-semibold text-ink" aria-hidden="true">{item.name.slice(0, 2).toUpperCase()}</span>
                              <Switch aria-label={`Enable ${item.name}`} checked={on} data-larisa-switch={item.name} />
                            </div>
                            <div class="grid gap-1">
                              <h2 class={sectionTitle}>{item.name}</h2>
                              <p class={sectionCaption}>{item.description}</p>
                            </div>
                            <div class="flex items-center justify-between gap-3 text-xs">
                              <span class="text-muted">{labelOf(integrationCategories, item.category)}</span>
                              <Badge variant="success" hidden={!on} data-larisa-on>Active</Badge>
                              <Badge variant="neutral" hidden={on} data-larisa-off>Inactive</Badge>
                            </div>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}

                {page === "messages" && (
                  <div class="grid min-w-0 gap-6">
                    <section aria-label="Inbox" class={cx(panel, "grid overflow-hidden lg:grid-cols-[20rem_minmax(0,1fr)]")}>
                      <div class="grid grid-cols-1 content-start gap-1 border-b border-line p-3 lg:border-r lg:border-b-0">
                        <h2 class="px-3 py-2 text-sm font-semibold text-ink">Conversations</h2>
                        <ul class="grid grid-cols-1 gap-1">
                          {conversations.map((entry) => {
                            const last = initialThreads[entry.id]?.slice(-1)[0];
                            const unread = entry.id === "dewi" ? 0 : entry.unread;
                            return (
                              <li>
                                <button type="button" aria-current={entry.id === "dewi" ? "true" : undefined} data-larisa-chat={entry.id} class={cx(chatItem, entry.id === "dewi" ? chatState.on : chatState.off)}>
                                  <Avatar name={entry.name} size="sm" />
                                  <span class="grid min-w-0 flex-1 grid-cols-1 gap-0.5">
                                    <span class="flex items-center justify-between gap-2">
                                      <span class="truncate text-sm font-medium text-ink">{entry.name}</span>
                                      <span class="shrink-0 text-xs text-muted" data-larisa-last-time>{last?.time}</span>
                                    </span>
                                    <span class="flex items-center justify-between gap-2">
                                      <span class="truncate text-xs text-muted" data-larisa-last-text>{last?.text}</span>
                                      <span class="grid size-5 shrink-0 place-items-center rounded-full bg-primary text-[10px] font-semibold text-on-primary" hidden={unread === 0} data-larisa-unread><span data-larisa-unread-count>{unread}</span><span class="sr-only">{" unread"}</span></span>
                                    </span>
                                  </span>
                                </button>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                      <div class="grid min-h-[32rem] grid-rows-[auto_minmax(0,1fr)_auto]">
                        <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-4">
                          <div class="grid gap-0.5">
                            <h2 class={sectionTitle} data-larisa-chat-name>{conversations[0]!.name}</h2>
                            <p class="text-xs text-muted" data-larisa-chat-topic>{conversations[0]!.topic}</p>
                          </div>
                          <Badge variant="success">Online</Badge>
                        </div>
                        <div role="log" aria-label={`Conversation with ${conversations[0]!.name}`} class="grid content-start gap-4 p-5" data-larisa-log>
                          {(initialThreads.dewi ?? []).map((message) => (
                            <div class={messageRow[message.from]}>
                              <p class={messageBubble[message.from]}>{message.text}</p>
                              <span class={messageTime}>{message.time}</span>
                            </div>
                          ))}
                        </div>
                        <form class="flex items-end gap-2 border-t border-line p-4" data-larisa-reply-form>
                          <div class="min-w-0 flex-1">
                            <Input aria-label={`Reply to ${conversations[0]!.name}`} placeholder="Write a reply" data-larisa-reply-input />
                          </div>
                          <Button type="submit"><Fragment set:html={icon(icons.send)} />Send</Button>
                        </form>
                      </div>
                    </section>
                  </div>
                )}

                {page === "reviews" && (
                  <div class="grid min-w-0 gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
                    <Card aria-labelledby="rating-title" class="self-start">
                      <div class="grid gap-5">
                        <h2 id="rating-title" class={sectionTitle}>Rating summary</h2>
                        <div class="flex items-center gap-4">
                          <p class="text-5xl font-semibold tracking-tight tabular-nums">4.5</p>
                          <div class="grid gap-1">
                            <Fragment set:html={starsHtml(4.5)} />
                            <p class="text-sm text-muted">From 1,248 reviews</p>
                          </div>
                        </div>
                        <ul class="grid gap-3">
                          {ratingBreakdown.map((entry) => (
                            <li class="grid grid-cols-[3.5rem_minmax(0,1fr)_2.5rem] items-center gap-3">
                              <span class="text-muted">{entry.label}</span>
                              <Progress value={entry.share} aria-label={`${entry.label}, ${entry.share}% of reviews`} class="h-1.5!" />
                              <span class="text-right text-muted tabular-nums">{entry.count}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </Card>
                    <Card aria-labelledby="reviews-title" class="min-w-0">
                      <div class="grid gap-5">
                        <div class="flex flex-wrap items-center justify-between gap-4">
                          <h2 id="reviews-title" class={sectionTitle}>Latest reviews</h2>
                          <ToggleGroup label="Filter by rating" items={starFilters} value="all" class="flex-wrap" data-larisa-toggle="stars" />
                        </div>
                        <ul class="grid gap-5" data-larisa-reviews>
                          {reviews.map((entry) => {
                            const answer = initialReplies[entry.name];
                            return (
                              <li class="grid gap-3 border-t border-line pt-5 first:border-t-0 first:pt-0" data-review={entry.name}>
                                <div class="flex flex-wrap items-start justify-between gap-3">
                                  <div class="flex items-center gap-3">
                                    <Avatar name={entry.name} size="sm" />
                                    <div class="grid">
                                      <span class="font-medium text-ink">{entry.name}</span>
                                      <span class="text-xs text-muted">{`${entry.product}, ${entry.date}`}</span>
                                    </div>
                                  </div>
                                  <Fragment set:html={starsHtml(entry.rating)} />
                                </div>
                                <p class="text-ink">{entry.text}</p>
                                <div class="grid gap-1 rounded-lg bg-subtle p-3" hidden={!answer} data-larisa-answer>
                                  <span class="text-xs font-medium text-muted">Your reply</span>
                                  <p class="text-ink" data-larisa-answer-text>{answer}</p>
                                </div>
                                <div hidden={Boolean(answer)} data-larisa-reply-wrap>
                                  <Button variant="secondary" size="sm" aria-label={`Reply to ${entry.name}`} data-larisa-reply={entry.name}>Reply</Button>
                                </div>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    </Card>
                    <Modal id={REPLY_ID} title="Reply to review">
                      <div class="grid gap-4">
                        <blockquote class="grid gap-1 rounded-lg bg-subtle p-3">
                          <span class="font-medium text-ink" data-larisa-review-name></span>
                          <span data-larisa-review-text></span>
                        </blockquote>
                        <Textarea label="Your reply" rows={4} data-larisa-draft-reply />
                      </div>
                      <Fragment slot="footer">
                        <Button variant="secondary" type="submit" value="cancel">Cancel</Button>
                        <Button type="submit" value="post" data-larisa-post>Post reply</Button>
                      </Fragment>
                    </Modal>
                  </div>
                )}

                {page === "help" && (
                  <div class="grid min-w-0 gap-4 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
                    <Card aria-labelledby="faq-title" class="min-w-0">
                      <div class="grid gap-5">
                        <div class="grid gap-1">
                          <h2 id="faq-title" class={sectionTitle}>Frequently asked questions</h2>
                          <p class={sectionCaption} aria-live="polite" data-larisa-faq-count>{`Showing ${faqs.length} of ${faqs.length} articles`}</p>
                        </div>
                        <div class="relative">
                          <Input type="search" aria-label="Search help articles" placeholder="Search payouts, shipping, refunds" class="pl-9!" data-larisa-faq-query />
                          <Fragment set:html={icon(icons.search, searchIcon)} />
                        </div>
                        <Accordion items={faqs} defaultValue="payout" data-larisa-faqs />
                        <p class="py-8 text-center text-muted" hidden data-larisa-faq-empty>No articles match your search.</p>
                      </div>
                    </Card>
                    <Card aria-labelledby="contact-title" class="self-start">
                      <div class="grid gap-4">
                        <div class="grid gap-1">
                          <h2 id="contact-title" class={sectionTitle}>Still need help?</h2>
                          <p class={sectionCaption}>Our team replies within 2 hours, every day from 08.00 to 20.00 WIB.</p>
                        </div>
                        <Button data-larisa-chat-start><Fragment set:html={icon(icons.messages)} />Start a chat</Button>
                        <p class={sectionCaption}>Or email <a href={SUPPORT} class={cx("rounded-sm font-medium text-primary underline underline-offset-2", focusRing)}>support@larisa.id</a></p>
                      </div>
                    </Card>
                  </div>
                )}
              </Wrapper>
            );
          })
        }
      </main>
    </div>
    <AlertDialog id={LOGOUT_ID} title="Log out of Larisa?" variant="danger" actionLabel="Log out">You will need to sign in again to manage your store.</AlertDialog>
    <Toaster />
  </div>
</larisa-template>

<script>
  type Option = { value: string; label: string };
  type Seller = {
    name: string;
    product: string;
    category: string;
    change: number;
    total: number;
  };
  type SortKey = "name" | "product" | "change" | "total";
  type Message = { from: "me" | "them"; text: string; time: string };
  type Pair = { on: string; off: string };
  type Config = {
    titles: Record<string, string>;
    subtitles: Record<string, string>;
    periods: Record<string, { label: string; subtitle: string; bars: number }>;
    defaultBar: number;
    sellers: Seller[];
    ranges: Option[];
    categories: Option[];
    sortIcons: { sort: string; asc: string; desc: string };
    customers: { name: string; segment: string; search: string[] }[];
    integrations: string[];
    connected: string[];
    conversations: { id: string; name: string; topic: string; unread: number }[];
    threads: Record<string, Message[]>;
    reviews: { name: string; text: string; group: string }[];
    replies: Record<string, string>;
    faqs: [string, string][];
    classes: {
      navActive: string;
      navIdle: string;
      barValue: Pair;
      barFill: Pair;
      barLabel: Pair;
      chatState: Pair;
      messageRow: Record<Message["from"], string>;
      messageBubble: Record<Message["from"], string>;
      messageTime: string;
    };
    ids: { logout: string; customer: string; reply: string };
  };
  type ToastDetail = { title: string; description?: string; variant?: string };
  type Toggle = "range" | "segment" | "integrationCategory" | "stars";

  const toast = (detail: ToastDetail) =>
    window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const setClasses = (element: Element, pair: Pair, on: boolean) => {
    element.classList.remove(...(on ? pair.off : pair.on).split(" "));
    element.classList.add(...(on ? pair.on : pair.off).split(" "));
  };
  const labelOf = (list: Option[], value: string) =>
    list.find((entry) => entry.value === value)?.label ?? "";
  const includes = (needle: string, ...fields: string[]) =>
    fields.some((field) => field.toLowerCase().includes(needle));
  const openDialog = (id: string) => {
    const dialog = document.getElementById(id);
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.returnValue = "";
    dialog.showModal();
    dialog.dataset.state = "open";
  };
  const compareSellers = (a: Seller, b: Seller, key: SortKey, dir: string) => {
    const x = a[key];
    const y = b[key];
    const order =
      typeof x === "number" && typeof y === "number"
        ? x - y
        : String(x).localeCompare(String(y));
    return dir === "asc" ? order : -order;
  };

  /** Satu elemen per template: navigasi hash dan state dasbor yang bertahan antar halaman. */
  class LarisaTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private page = "overview";
    private period = "monthly";
    private selectedBar = this.config.defaultBar;
    private query = "";
    private sortKey: SortKey = "total";
    private sortDir = "desc";
    private appliedRange = "last-30";
    private appliedCategory = "all";
    private range = "30d";
    private segment = "all";
    private customerQuery = "";
    private integrationCategory = "all";
    private connected = [...this.config.connected];
    private chat = "dewi";
    private threads = structuredClone(this.config.threads);
    private read = ["dewi"];
    private reply = "";
    private stars = "all";
    private replies = { ...this.config.replies };
    private reviewName = "";
    private faqQuery = "";
    /** Semua item Accordion di klon Help yang sedang tampil. */
    private faqItems: Element[] | undefined;
    private readonly onHashChange = () => {
      this.open(this.fromHash());
      this.heading()?.focus();
    };
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onInput = (event: Event) => this.handleInput(event);
    private readonly onChange = (event: Event) => this.handleChange(event);
    private readonly onSubmit = (event: Event) => this.handleSubmit(event);
    private readonly onSelect = (event: Event) =>
      this.changePeriod(String((event as CustomEvent).detail));
    private readonly onAction = () =>
      toast({
        title: "Signed out",
        description: "This is a demo, your session is still active.",
      });

    connectedCallback() {
      this.open(this.fromHash());
      window.addEventListener("hashchange", this.onHashChange);
      this.addEventListener("click", this.onClick);
      this.addEventListener("input", this.onInput);
      this.addEventListener("change", this.onChange);
      this.addEventListener("submit", this.onSubmit);
      this.addEventListener("markas-select", this.onSelect);
      this.addEventListener("markas-action", this.onAction);
    }

    disconnectedCallback() {
      window.removeEventListener("hashchange", this.onHashChange);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("input", this.onInput);
      this.removeEventListener("change", this.onChange);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("markas-select", this.onSelect);
      this.removeEventListener("markas-action", this.onAction);
    }

    private find<T extends Element = HTMLElement>(selector: string) {
      return this.querySelector<T>(selector);
    }

    private findAll<T extends Element = HTMLElement>(selector: string) {
      return [...this.querySelectorAll<T>(selector)];
    }

    private heading() {
      return this.find("[data-larisa-heading]");
    }

    private fromHash() {
      const value = window.location.hash.slice(1);
      return value in this.config.titles ? value : "overview";
    }

    /** Pindah halaman lewat hash. Item yang sudah aktif cukup memindahkan fokus ke judul. */
    private go(value: string) {
      if (!(value in this.config.titles)) return;
      if (value === this.page) this.heading()?.focus();
      else window.location.hash = value;
    }

    /** Buka halaman: judul, navigasi, tombol aksi, lalu isi halaman dari <template>. */
    private open(page: string) {
      this.page = page;
      const { titles, classes } = this.config;
      this.findAll("[data-larisa-go]").forEach((button) => {
        const active = button.dataset.larisaGo === page;
        if (active) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
        setClasses(
          button,
          { on: classes.navActive, off: classes.navIdle },
          active,
        );
      });
      this.heading()!.textContent = titles[page] ?? "";
      const crumb = this.find('nav[aria-label="Breadcrumb"] [aria-current]');
      if (crumb) crumb.textContent = titles[page] ?? "";
      this.renderSubtitle();
      const actions = this.find("[data-larisa-actions]")!;
      const template = this.find<HTMLTemplateElement>(
        `template[data-larisa-actions-page="${page}"]`,
      );
      actions.replaceChildren(template ? template.content.cloneNode(true) : "");
      if (page === "overview") this.renderPeriodLabel();
      if (page === "analytics") this.syncToggle("range");
      this.renderBody();
    }

    private renderSubtitle() {
      const { subtitles, periods } = this.config;
      this.find("[data-larisa-subtitle]")!.textContent =
        this.page === "overview"
          ? (periods[this.period]?.subtitle ?? "")
          : (subtitles[this.page] ?? "");
    }

    private renderPeriodLabel() {
      const label = this.find("[data-larisa-period-label]");
      if (label)
        label.textContent = this.config.periods[this.period]?.label ?? "";
    }

    /** Isi halaman diklon baru (Overview per periode, Analytics per rentang), lalu state diterapkan. */
    private renderBody() {
      const key =
        this.page === "overview"
          ? `overview:${this.period}`
          : this.page === "analytics"
            ? `analytics:${this.range}`
            : this.page;
      const template = this.find<HTMLTemplateElement>(
        `template[data-larisa-page="${key}"]`,
      );
      if (!template) return;
      this.find("[data-larisa-view]")!.replaceChildren(
        template.content.cloneNode(true),
      );
      this.faqItems = undefined;
      if (this.page === "overview") {
        this.renderBar();
        this.renderSellers();
      } else if (this.page === "customers") {
        this.find<HTMLInputElement>("[data-larisa-customer-query]")!.value =
          this.customerQuery;
        this.syncToggle("segment");
        this.renderCustomers();
      } else if (this.page === "integrations") {
        this.syncToggle("integrationCategory");
        this.renderIntegrations();
      } else if (this.page === "messages") {
        this.find<HTMLInputElement>("[data-larisa-reply-input]")!.value =
          this.reply;
        this.renderMessages();
      } else if (this.page === "reviews") {
        this.syncToggle("stars");
        this.renderReviews();
      } else if (this.page === "help") {
        this.find<HTMLInputElement>("[data-larisa-faq-query]")!.value =
          this.faqQuery;
        this.renderFaqs();
      }
    }

    /** ToggleGroup Astro melepas pilihan aktif saat diklik lagi; state di sini yang menentukan. */
    private syncToggle(name: Toggle) {
      const value = this[name];
      this.findAll<HTMLButtonElement>(
        `[data-larisa-toggle="${name}"] > button`,
      ).forEach((button) => {
        const on = button.dataset.value === value;
        button.setAttribute("aria-pressed", String(on));
        button.dataset.state = on ? "on" : "off";
      });
    }

    private choose(name: Toggle, value: string) {
      if (value && value !== this[name]) {
        this[name] = value;
        if (name === "range") this.renderBody();
        else if (name === "segment") this.renderCustomers();
        else if (name === "integrationCategory") this.renderIntegrations();
        else this.renderReviews();
      }
      // Script ToggleGroup berjalan setelah listener ini; tombol disamakan sesudahnya.
      setTimeout(() => this.syncToggle(name));
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      const closest = (selector: string) =>
        target.closest<HTMLElement>(selector);
      const toggle = closest("[data-larisa-toggle] > button");
      if (toggle) {
        const group = toggle.parentElement!.dataset.larisaToggle as Toggle;
        return this.choose(group, toggle.dataset.value ?? "");
      }
      const go = closest("[data-larisa-go], [data-larisa-goto]");
      if (go) return this.go(go.dataset.larisaGo ?? go.dataset.larisaGoto ?? "");
      const bar = closest("[data-larisa-bar]");
      if (bar) {
        this.selectedBar = Number(bar.dataset.larisaBar);
        return this.renderBar();
      }
      const sort = closest("[data-larisa-sort] > button");
      if (sort) return this.sortBy(sort);
      const viewCustomer = closest("[data-larisa-view-customer]");
      if (viewCustomer)
        return this.viewCustomer(viewCustomer.dataset.larisaViewCustomer!);
      const chat = closest("[data-larisa-chat]");
      if (chat) return this.openChat(chat.dataset.larisaChat!);
      const reply = closest("[data-larisa-reply]");
      if (reply) return this.openReply(reply.dataset.larisaReply!);
      if (closest("[data-larisa-post]")) return this.postReply();
      if (closest("[data-larisa-logout]"))
        return openDialog(this.config.ids.logout);
      if (closest("[data-larisa-filters]")) return this.openFilters();
      if (closest("[data-larisa-apply]")) return this.applyFilters();
      if (closest("[data-larisa-reset]")) return this.resetFilters();
      if (closest("[data-larisa-export]"))
        return toast({
          title: "Report exported",
          description: `${this.config.periods[this.period]?.label} sales report saved as CSV.`,
          variant: "success",
        });
      if (closest("[data-larisa-notify]"))
        return toast({
          title: "3 new notifications",
          description: "Dewi Lestari reached Rp 48.2M in sales.",
        });
      if (closest("[data-larisa-export-customers]"))
        return toast({
          title: "Customers exported",
          description: `${this.visibleCustomers().length} customers saved as CSV.`,
          variant: "success",
        });
      if (closest("[data-larisa-mark-read]")) return this.markAllRead();
      if (closest("[data-larisa-chat-start]"))
        toast({
          title: "Chat started",
          description: "A support agent will join in a moment.",
        });
    }

    private handleInput(event: Event) {
      const field = event.target as HTMLInputElement;
      if (field.matches("[data-larisa-query]")) {
        this.query = field.value;
        if (this.page === "overview") this.renderSellers();
      } else if (field.matches("[data-larisa-customer-query]")) {
        this.customerQuery = field.value;
        this.renderCustomers();
      } else if (field.matches("[data-larisa-faq-query]")) {
        this.faqQuery = field.value;
        this.renderFaqs();
      } else if (field.matches("[data-larisa-reply-input]")) {
        this.reply = field.value;
      }
    }

    private handleChange(event: Event) {
      const field = event.target as HTMLInputElement;
      const name = field.dataset.larisaSwitch;
      if (name) this.toggleIntegration(name, field.checked);
    }

    private handleSubmit(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-larisa-reply-form]")) return;
      event.preventDefault();
      this.sendReply();
    }

    /* Overview */
    private changePeriod(value: string) {
      if (!(value in this.config.periods)) return;
      this.period = value;
      this.selectedBar = this.config.defaultBar;
      this.renderPeriodLabel();
      this.renderSubtitle();
      this.renderBody();
    }

    private renderBar() {
      const { barValue, barFill, barLabel } = this.config.classes;
      const bars = this.findAll("[data-larisa-bar]");
      const picked =
        bars[this.selectedBar] ?? bars[bars.length - 1] ?? undefined;
      bars.forEach((bar) => {
        const on = bar === picked;
        bar.setAttribute("aria-pressed", String(on));
        setClasses(bar.querySelector("[data-larisa-bar-value]")!, barValue, on);
        setClasses(bar.querySelector("[data-larisa-bar-fill]")!, barFill, on);
        setClasses(bar.querySelector("[data-larisa-bar-label]")!, barLabel, on);
      });
      this.find("[data-larisa-picked-label]")!.textContent =
        picked?.dataset.label ?? "";
      this.find("[data-larisa-picked-value]")!.textContent =
        picked?.dataset.value ?? "";
    }

    private sortBy(button: HTMLElement) {
      const key = button.parentElement!.dataset.larisaSort as SortKey;
      if (key === this.sortKey)
        this.sortDir = this.sortDir === "asc" ? "desc" : "asc";
      else {
        this.sortKey = key;
        this.sortDir = button.dataset.numeric ? "desc" : "asc";
      }
      this.renderSellers();
    }

    /** Baris dirender server; tabel disaring dengan hidden dan diurutkan dengan memindah tr. */
    private renderSellers() {
      const { sellers, ranges, categories, sortIcons } = this.config;
      const body = this.find("[data-larisa-sellers]");
      if (!body) return;
      this.find("[data-larisa-sellers-caption]")!.textContent =
        `${labelOf(ranges, this.appliedRange)}, ${labelOf(categories, this.appliedCategory)}`;
      this.findAll("[data-larisa-sort]").forEach((cell) => {
        const active = cell.dataset.larisaSort === this.sortKey;
        if (active)
          cell.setAttribute(
            "aria-sort",
            this.sortDir === "asc" ? "ascending" : "descending",
          );
        else cell.removeAttribute("aria-sort");
        const button = cell.querySelector("button")!;
        button.classList.toggle("text-ink", active);
        button
          .querySelector("path")!
          .setAttribute(
            "d",
            active
              ? this.sortDir === "asc"
                ? sortIcons.asc
                : sortIcons.desc
              : sortIcons.sort,
          );
      });
      const needle = this.query.trim().toLowerCase();
      const rows = [...body.querySelectorAll<HTMLElement>("tr[data-seller]")];
      const sellerOf = (row: HTMLElement) => sellers[Number(row.dataset.seller)]!;
      let visible = 0;
      rows
        .sort((a, b) =>
          compareSellers(sellerOf(a), sellerOf(b), this.sortKey, this.sortDir),
        )
        .forEach((row) => {
          const seller = sellerOf(row);
          const match =
            (this.appliedCategory === "all" ||
              seller.category === this.appliedCategory) &&
            includes(needle, seller.name, seller.product);
          row.hidden = !match;
          if (match) visible += 1;
          body.appendChild(row);
        });
      const empty = body.querySelector<HTMLElement>("[data-larisa-empty]")!;
      empty.hidden = visible > 0;
      body.appendChild(empty);
    }

    private draftSelects() {
      return [
        this.find<HTMLSelectElement>("[data-larisa-draft-range]"),
        this.find<HTMLSelectElement>("[data-larisa-draft-category]"),
      ] as const;
    }

    private openFilters() {
      const [range, category] = this.draftSelects();
      if (range) range.value = this.appliedRange;
      if (category) category.value = this.appliedCategory;
    }

    private applyFilters() {
      const [range, category] = this.draftSelects();
      this.appliedRange = range?.value ?? this.appliedRange;
      this.appliedCategory = category?.value ?? this.appliedCategory;
      this.renderSellers();
      toast({
        title: "Filters applied",
        description: `${labelOf(this.config.ranges, this.appliedRange)}, ${labelOf(this.config.categories, this.appliedCategory)}`,
      });
    }

    private resetFilters() {
      this.appliedRange = "last-30";
      this.appliedCategory = "all";
      this.openFilters();
      this.renderSellers();
      toast({ title: "Filters reset" });
    }

    /* Customers */
    private visibleCustomers() {
      const needle = this.customerQuery.trim().toLowerCase();
      return this.config.customers.filter(
        (customer) =>
          (this.segment === "all" || customer.segment === this.segment) &&
          includes(needle, ...customer.search),
      );
    }

    private renderCustomers() {
      const count = this.find("[data-larisa-customer-count]");
      if (!count) return;
      const visible = this.visibleCustomers();
      this.findAll("tr[data-customer]").forEach((row) => {
        const customer = this.config.customers[Number(row.dataset.customer)];
        row.hidden = !visible.includes(customer!);
      });
      this.find("[data-larisa-view] [data-larisa-empty]")!.hidden =
        visible.length > 0;
      count.textContent = `Showing ${visible.length} of ${this.config.customers.length} customers`;
    }

    private viewCustomer(name: string) {
      const template = this.find<HTMLTemplateElement>(
        `template[data-larisa-customer="${CSS.escape(name)}"]`,
      );
      this.find("[data-larisa-customer-details]")?.replaceChildren(
        template ? template.content.cloneNode(true) : "",
      );
      openDialog(this.config.ids.customer);
    }

    /* Integrations */
    private renderIntegrations() {
      const count = this.find("[data-larisa-active-count]");
      if (!count) return;
      this.findAll("li[data-integration]").forEach((item) => {
        const on = this.connected.includes(item.dataset.integration!);
        item.hidden =
          this.integrationCategory !== "all" &&
          item.dataset.category !== this.integrationCategory;
        item.querySelector<HTMLInputElement>("[data-larisa-switch]")!.checked =
          on;
        item.querySelector<HTMLElement>("[data-larisa-on]")!.hidden = !on;
        item.querySelector<HTMLElement>("[data-larisa-off]")!.hidden = on;
      });
      count.textContent = `${this.connected.length} of ${this.config.integrations.length} active`;
    }

    private toggleIntegration(name: string, on: boolean) {
      this.connected = on
        ? [...this.connected, name]
        : this.connected.filter((entry) => entry !== name);
      this.renderIntegrations();
      toast({
        title: on ? `${name} connected` : `${name} disconnected`,
        variant: on ? "success" : "default",
      });
    }

    /* Messages */
    private conversation() {
      const { conversations } = this.config;
      return (
        conversations.find((entry) => entry.id === this.chat) ??
        conversations[0]!
      );
    }

    private renderMessages() {
      const log = this.find("[data-larisa-log]");
      if (!log) return;
      const { classes, conversations } = this.config;
      for (const entry of conversations) {
        const button = this.find(`[data-larisa-chat="${entry.id}"]`)!;
        const active = entry.id === this.chat;
        const last = this.threads[entry.id]?.slice(-1)[0];
        const unread = this.read.includes(entry.id) ? 0 : entry.unread;
        if (active) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
        setClasses(button, classes.chatState, active);
        button.querySelector("[data-larisa-last-time]")!.textContent =
          last?.time ?? "";
        button.querySelector("[data-larisa-last-text]")!.textContent =
          last?.text ?? "";
        button.querySelector<HTMLElement>("[data-larisa-unread]")!.hidden =
          unread === 0;
        button.querySelector("[data-larisa-unread-count]")!.textContent =
          String(unread);
      }
      const conversation = this.conversation();
      this.find("[data-larisa-chat-name]")!.textContent = conversation.name;
      this.find("[data-larisa-chat-topic]")!.textContent = conversation.topic;
      log.setAttribute("aria-label", `Conversation with ${conversation.name}`);
      log.replaceChildren(
        ...(this.threads[conversation.id] ?? []).map((message) => {
          const row = document.createElement("div");
          const bubble = document.createElement("p");
          const time = document.createElement("span");
          row.className = classes.messageRow[message.from];
          bubble.className = classes.messageBubble[message.from];
          time.className = classes.messageTime;
          bubble.textContent = message.text;
          time.textContent = message.time;
          row.append(bubble, time);
          return row;
        }),
      );
      const input = this.find("[data-larisa-reply-input]")!;
      input.setAttribute("aria-label", `Reply to ${conversation.name}`);
    }

    private openChat(id: string) {
      this.chat = id;
      if (!this.read.includes(id)) this.read = [...this.read, id];
      this.reply = "";
      this.find<HTMLInputElement>("[data-larisa-reply-input]")!.value = "";
      this.renderMessages();
    }

    private markAllRead() {
      this.read = this.config.conversations.map((entry) => entry.id);
      this.renderMessages();
      toast({ title: "All messages marked as read" });
    }

    private sendReply() {
      const text = this.reply.trim();
      if (text === "") {
        toast({ title: "Write a message first", variant: "danger" });
        return;
      }
      this.threads = {
        ...this.threads,
        [this.chat]: [
          ...(this.threads[this.chat] ?? []),
          { from: "me", text, time: "Now" },
        ],
      };
      this.reply = "";
      this.find<HTMLInputElement>("[data-larisa-reply-input]")!.value = "";
      this.renderMessages();
      toast({
        title: "Reply sent",
        description: `To ${this.conversation().name}`,
        variant: "success",
      });
    }

    /* Reviews */
    private renderReviews() {
      const list = this.find("[data-larisa-reviews]");
      if (!list) return;
      for (const review of this.config.reviews) {
        const item = list.querySelector<HTMLElement>(
          `[data-review="${CSS.escape(review.name)}"]`,
        )!;
        const answer = this.replies[review.name];
        item.hidden = this.stars !== "all" && review.group !== this.stars;
        item.querySelector<HTMLElement>("[data-larisa-answer]")!.hidden =
          !answer;
        item.querySelector("[data-larisa-answer-text]")!.textContent =
          answer ?? "";
        item.querySelector<HTMLElement>("[data-larisa-reply-wrap]")!.hidden =
          Boolean(answer);
      }
    }

    private openReply(name: string) {
      const review = this.config.reviews.find((entry) => entry.name === name);
      this.reviewName = name;
      this.find("[data-larisa-review-name]")!.textContent = review?.name ?? "";
      this.find("[data-larisa-review-text]")!.textContent = review?.text ?? "";
      this.find<HTMLTextAreaElement>("[data-larisa-draft-reply]")!.value = "";
      openDialog(this.config.ids.reply);
    }

    private postReply() {
      const field = this.find<HTMLTextAreaElement>("[data-larisa-draft-reply]");
      const text = field?.value.trim() ?? "";
      if (text === "") {
        toast({ title: "Reply is empty", variant: "danger" });
        return;
      }
      this.replies = { ...this.replies, [this.reviewName]: text };
      this.renderReviews();
      toast({
        title: "Reply posted",
        description: `${this.reviewName} will be notified.`,
        variant: "success",
      });
    }

    /* Help: item Accordion yang tidak cocok dilepas dari DOM, sama seperti React. */
    private renderFaqs() {
      const root = this.find("[data-larisa-faqs]");
      if (!root) return;
      const items = (this.faqItems ??= [...root.children]);
      const needle = this.faqQuery.trim().toLowerCase();
      const matches = items.filter((_, index) => {
        const [title = "", content = ""] = this.config.faqs[index] ?? [];
        return includes(needle, title, content);
      });
      root.replaceChildren(...matches);
      root.hidden = matches.length === 0;
      this.find("[data-larisa-faq-empty]")!.hidden = matches.length > 0;
      this.find("[data-larisa-faq-count]")!.textContent =
        `Showing ${matches.length} of ${this.config.faqs.length} articles`;
    }
  }

  if (!customElements.get("larisa-template"))
    customElements.define("larisa-template", LarisaTemplate);
</script>
