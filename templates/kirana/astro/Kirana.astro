                  </section>
                )}
              </Wrapper>
            );
          })
        }
      </main>
    </div>
    <Toaster />
  </div>
</kirana-template>

<script>
  type Mark = { tone: string; who: string; task: string; face: string };
  type DealInfo = {
    title: string;
    day: number;
    stage: string;
    value: string;
    card: string;
    team: string;
  };
  type Contact = Record<string, string>;
  type FunnelData = { total: string; steps: string[][] };
  type Config = {
    defaultPage: string;
    titleId: string;
    dealDrawer: string;
    nav: Record<string, [string, string]>;
    dealSelected: string;
    deals: Record<string, DealInfo>;
    contact: Contact;
    face: string;
    faceTones: string[];
    today: string;
    monthNames: string[];
    weekdays: string[];
    marks: Record<string, Mark>;
    dayBase: string;
    dayTones: Record<string, string>;
    daySelected: string;
    funnel: Record<string, FunnelData>;
    segment: [string, string];
    chip: [string, string];
    booksTotal: number;
    tasksTotal: number;
  };
  type ToastDetail = { title: string; description: string; variant?: string };

  const toast = (detail: ToastDetail) =>
    window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const cx = (...c: (string | false | null | undefined)[]) =>
    c.filter(Boolean).join(" ");
  const pad = (value: number) => String(value).padStart(2, "0");
  const plural = (count: number, word: string) =>
    `${count} ${word}${count === 1 ? "" : "s"}`;
  const toggleIn = (list: string[], id: string) =>
    list.includes(id) ? list.filter((item) => item !== id) : [...list, id];
  const setClasses = (element: Element, add: string, remove: string) => {
    element.classList.remove(...remove.split(" "));
    element.classList.add(...add.split(" "));
  };
  /** Tombol toggle: aria-pressed plus pasangan class aktif dan diam. */
  const press = (element: Element, on: boolean, [active, idle]: string[]) => {
    element.setAttribute("aria-pressed", String(on));
    setClasses(element, on ? active! : idle!, on ? idle! : active!);
  };

  /** Satu elemen per template: navigasi hash dan interaksi tiap halaman. */
  class KiranaTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private contact: Contact = {};
    private stages: Record<string, string> = {};
    private selectedDeal = "";
    private calendar = { year: 2026, month: 9 };
    private selectedDay = "";
    private done: string[] = [];
    private read: string[] = [];
    private invoiceSort = { key: "due", dir: 1 };
    /** Semua <li> atau baris di klon yang sedang tampil, dalam urutan aslinya. */
    private lists: Record<string, HTMLElement[]> = {};
    private readonly onHashChange = () => {
      this.open(this.readHash());
      document.getElementById(this.config.titleId)?.focus();
    };
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onInput = (event: Event) => this.handleInput(event);
    private readonly onChange = (event: Event) => this.handleChange(event);
    private readonly onSelect = (event: Event) => this.handleSelect(event);
    private readonly onClose = (event: Event) => this.handleClose(event);

    connectedCallback() {
      this.open(this.readHash());
      window.addEventListener("hashchange", this.onHashChange);
      this.addEventListener("click", this.onClick);
      this.addEventListener("input", this.onInput);
      this.addEventListener("change", this.onChange);
      this.addEventListener("markas-select", this.onSelect);
      // close tidak bubble: didengar di fase capture.
      this.addEventListener("close", this.onClose, true);
    }

    disconnectedCallback() {
      window.removeEventListener("hashchange", this.onHashChange);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("input", this.onInput);
      this.removeEventListener("change", this.onChange);
      this.removeEventListener("markas-select", this.onSelect);
      this.removeEventListener("close", this.onClose, true);
    }

    private find<T extends Element = HTMLElement>(selector: string) {
      return this.querySelector<T>(`[data-kirana-view] ${selector}`);
    }

    private findAll<T extends Element = HTMLElement>(selector: string) {
      return [...this.querySelectorAll<T>(`[data-kirana-view] ${selector}`)];
    }

    private get fullName() {
      return `${this.contact.firstName} ${this.contact.lastName}`;
    }

    /** Halaman aktif disimpan di hash URL supaya bisa dibagikan dan tombol Back bekerja. */
    private readHash() {
      const id = window.location.hash.slice(1);
      return this.querySelector(`template[data-kirana-page="${CSS.escape(id)}"]`)
        ? id
        : this.config.defaultPage;
    }

    /** Ganti isi halaman dengan klon baru dari <template>, lalu reset state halaman itu. */
    private open(id: string) {
      const template = this.querySelector<HTMLTemplateElement>(
        `template[data-kirana-page="${id}"]`,
      );
      const view = this.querySelector("[data-kirana-view]");
      if (!template || !view) return;
      view.replaceChildren(template.content.cloneNode(true));
      this.contact = { ...this.config.contact };
      this.stages = Object.fromEntries(
        Object.entries(this.config.deals).map(([key, deal]) => [key, deal.stage]),
      );
      this.selectedDeal = "";
      this.calendar = { year: 2026, month: 9 };
      this.selectedDay = this.config.today;
      this.done = this.findAll<HTMLInputElement>("[data-kirana-task]")
        .filter((box) => box.checked)
        .map((box) => box.dataset.kiranaTask!);
      this.read = this.findAll("[data-kirana-read][aria-pressed=true]").map(
        (button) => button.dataset.kiranaRead!,
      );
      this.invoiceSort = { key: "due", dir: 1 };
      this.lists = {
        deals: this.findAll("[data-kirana-deals] > li"),
        books: this.findAll("[data-kirana-books] > li"),
        founders: this.findAll("[data-kirana-founders] > li"),
        projects: this.findAll("[data-kirana-projects] > li"),
        rows: this.findAll("tbody > tr"),
      };
      this.querySelectorAll<HTMLElement>("[data-kirana-nav]").forEach((item) => {
        const active = item.dataset.kiranaGo === id;
        const [on, off] = this.config.nav[item.dataset.kiranaNav!]!;
        if (active) item.setAttribute("aria-current", "page");
        else item.removeAttribute("aria-current");
        setClasses(item, active ? on : off, active ? off : on);
      });
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      const go = target.closest<HTMLElement>("[data-kirana-go]");
      if (go?.dataset.kiranaGo) {
        window.location.assign(`#${go.dataset.kiranaGo}`);
        return;
      }
      const notice = target.closest<HTMLElement>("[data-toast]");
      if (notice)
        toast({
          title: notice.dataset.toast!,
          description:
            notice.dataset.toastName !== undefined
              ? this.fullName
              : (notice.dataset.toastText ?? ""),
        });
      const deal = target.closest<HTMLElement>("[data-kirana-deal-open]");
      if (deal) return this.openDeal(deal.dataset.kiranaDealOpen!);
      if (target.closest("[data-kirana-edit]")) return this.fillDraft();
      const shift = target.closest<HTMLElement>("[data-kirana-shift]");
      if (shift) return this.shiftMonth(Number(shift.dataset.kiranaShift));
      const day = target.closest<HTMLElement>("[data-kirana-day]");
      if (day) {
        this.selectedDay = day.dataset.kiranaDay!;
        return this.renderCalendar();
      }
      const mode = target.closest<HTMLElement>("[data-kirana-mode]");
      if (mode) return this.setMode(mode.dataset.kiranaMode!);
      const topic = target.closest<HTMLElement>("[data-kirana-topic]");
      if (topic) return this.filterBooks(topic.dataset.kiranaTopic!);
      const read = target.closest<HTMLElement>("[data-kirana-read]");
      if (read) return this.toggleRead(read);
      const sort = target.closest<HTMLElement>("[data-kirana-sort] button");
      if (sort)
        return this.sortInvoices(
          sort.closest<HTMLElement>("[data-kirana-sort]")!.dataset.kiranaSort!,
        );
      const status = target.closest<HTMLElement>("[data-kirana-status]");
      if (status) this.filterProjects(status.dataset.kiranaStatus!);
    }

    /* Contacts: pilihan menu panel */
    private handleSelect(event: Event) {
      const value = (event as CustomEvent<string>).detail;
      const menu = (event.target as Element).closest<HTMLElement>(
        "[data-kirana-menu]",
      )?.dataset.kiranaMenu;
      if (menu === "history") {
        if (value === "export")
          toast({
            title: "History exported",
            description: "6 deals, interaction-history.csv",
          });
        else this.sortDeals(value);
      } else if (menu === "schedule") {
        if (value === "add")
          toast({
            title: "Task added",
            description: `${this.shortDay(this.selectedDay)}, 09:00`,
          });
        else {
          this.calendar = { year: 2026, month: 9 };
          this.selectedDay = this.config.today;
          this.renderCalendar();
        }
      } else if (menu === "funnel") {
        if (value === "export")
          toast({ title: "Funnel exported", description: "stage-funnel.csv" });
        else this.setMode(value);
      } else if (menu === "profile") {
        toast({ title: value, description: this.fullName });
      }
    }

    private sortDeals(sort: string) {
      const list = this.find("[data-kirana-deals]");
      if (!list) return;
      const number = (item: HTMLElement, key: string) => Number(item.dataset[key]);
      const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        default: () => 0,
        high: (a, b) => number(b, "value") - number(a, "value"),
        newest: (a, b) => number(b, "day") - number(a, "day"),
      };
      list.replaceChildren(...[...this.lists.deals!].sort(sorters[sort]));
    }

    private openDeal(id: string) {
      const deal = this.config.deals[id];
      const dialog = document.getElementById(this.config.dealDrawer);
      if (!deal || !(dialog instanceof HTMLDialogElement)) return;
      this.selectedDeal = id;
      const selected = this.config.dealSelected;
      this.lists.deals!.forEach((item) => {
        const on = item.dataset.deal === id;
        if (on) item.classList.add(...selected.split(" "));
        else item.classList.remove(...selected.split(" "));
        item
          .querySelector("[data-kirana-deal-select]")
          ?.setAttribute("aria-pressed", String(on));
      });
      this.renderDeal();
      dialog.returnValue = "";
      dialog.showModal();
    }

    private renderDeal() {
      const id = this.selectedDeal || Object.keys(this.config.deals)[0]!;
      const deal = this.config.deals[id]!;
      this.find("[data-kirana-deal-card]")!.className = deal.card;
      this.find("[data-kirana-deal-day]")!.textContent = `Oct ${deal.day}, 2026`;
      this.find("[data-kirana-deal-title]")!.textContent = deal.title;
      this.find("[data-kirana-deal-value]")!.textContent = deal.value;
      this.find("[data-stage]")!.textContent = this.stages[id]!;
      this.find("[data-kirana-deal-customer]")!.textContent = this.fullName;
      this.find("[data-kirana-deal-team]")!.innerHTML = deal.team;
    }

    /* Contacts: edit detail. Draft diisi ulang dari data kontak setiap drawer dibuka. */
    private fillDraft() {
      this.findAll<HTMLInputElement>("[data-kirana-edit-drawer] input").forEach(
        (field) => (field.value = this.contact[field.name] ?? ""),
      );
    }

    private handleClose(event: Event) {
      const dialog = event.target;
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (dialog.id === this.config.dealDrawer && dialog.returnValue === "won") {
        const id = this.selectedDeal || Object.keys(this.config.deals)[0]!;
        this.stages[id] = "Won";
        this.renderDeal();
        toast({
          title: "Deal marked as won",
          description: this.config.deals[id]!.title,
          variant: "success",
        });
      }
      if (
        dialog.matches("[data-kirana-edit-drawer]") &&
        dialog.returnValue === "save"
      ) {
        const draft: Contact = {};
        dialog
          .querySelectorAll<HTMLInputElement>("input")
          .forEach((field) => (draft[field.name] = field.value));
        this.contact = draft;
        this.renderContact();
        toast({
          title: "Contact details saved",
          description: this.fullName,
          variant: "success",
        });
      }
    }

    private renderContact() {
      const name = this.fullName;
      const words = name.split(" ");
      const initials = words
        .filter((_, index) => index === 0 || index === words.length - 1)
        .map((word) => word.charAt(0))
        .join("")
        .toUpperCase();
      const tones = this.config.faceTones;
      const tone =
        tones[[...name].reduce((sum, char) => sum + char.charCodeAt(0), 0) % tones.length];
      const face = this.find("[data-kirana-face]")!;
      face.className = cx(
        this.config.face,
        tone,
        "mb-2 size-24 text-2xl ring-4 ring-surface",
      );
      face.textContent = initials;
      this.find("#kirana-profile-name")!.textContent = name;
      this.find("[data-kirana-deal-customer]")!.textContent = name;
      this.findAll("[data-kirana-contact]").forEach(
        (field) => (field.textContent = this.contact[field.dataset.kiranaContact!] ?? ""),
      );
    }

    /* Contacts: kalender */
    private shortDay(iso: string) {
      const [, month = 1, day = 1] = iso.split("-").map(Number);
      return `${this.config.monthNames[month - 1]?.slice(0, 3)} ${day}`;
    }

    private shiftMonth(step: number) {
      const next = new Date(this.calendar.year, this.calendar.month + step, 1);
      this.calendar = { year: next.getFullYear(), month: next.getMonth() };
      this.renderCalendar();
    }

    /** Sel kalender bulan, minggu dimulai Senin, sama dengan monthCells di versi React. */
    private renderCalendar() {
      const { year, month } = this.calendar;
      const { monthNames, marks, dayBase, dayTones, daySelected } = this.config;
      const name = monthNames[month]!;
      const offset = (new Date(year, month, 1).getDay() + 6) % 7;
      const days = new Date(year, month + 1, 0).getDate();
      const cells = [
        ...Array<null>(offset).fill(null),
        ...Array.from({ length: days }, (_, index) => index + 1),
      ];
      cells.push(...Array<null>((7 - (cells.length % 7)) % 7).fill(null));
      const html = cells.map((day) => {
        if (day === null) return `<span aria-hidden="true"></span>`;
        const iso = `${year}-${pad(month + 1)}-${pad(day)}`;
        const item = marks[iso];
        const selected = this.selectedDay === iso;
        return `<button type="button" aria-pressed="${selected}" class="${cx(dayBase, dayTones[item?.tone ?? "none"], selected && daySelected)}" data-kirana-day="${iso}"><span aria-hidden="true">${day}</span><span class="sr-only">${name} ${day}${item ? `, ${item.task}` : ""}</span>${item ? item.face : ""}</button>`;
      });
      const heads = this.config.weekdays.map(
        (day) =>
          `<span aria-hidden="true" class="text-center text-xs font-medium text-muted">${day}</span>`,
      );
      this.find("[data-kirana-calendar]")!.innerHTML = [...heads, ...html].join("");
      this.find("[data-kirana-month]")!.innerHTML =
        `${name}<span class="text-sm font-normal text-muted">${year}</span>`;
      const mark = marks[this.selectedDay];
      const agenda = this.find("[data-agenda]")!;
      agenda.replaceChildren();
      const strong = document.createElement("span");
      strong.className = "font-semibold text-ink";
      strong.textContent = this.shortDay(this.selectedDay);
      agenda.append(
        strong,
        mark ? `: ${mark.task} with ${mark.who}` : ": no tasks scheduled",
      );
    }

    /* Contacts: funnel */
    private setMode(mode: string) {
      const data = this.config.funnel[mode];
      if (!data) return;
      this.findAll("[data-kirana-mode]").forEach((button) =>
        press(button, button.dataset.kiranaMode === mode, this.config.segment),
      );
      this.find("[data-funnel-total]")!.textContent = data.total;
      data.steps.forEach(([, value], index) => {
        this.find(`[data-kirana-step="${index}"]`)!.textContent = value!;
        if (index === 0)
          this.find("[data-kirana-step-open]")!.dataset.toastText =
            `${value} in this stage`;
      });
    }

    /* Home */
    private handleChange(event: Event) {
      const box = event.target as HTMLInputElement;
      if (!box.matches("[data-kirana-task]")) return;
      this.done = toggleIn(this.done, box.dataset.kiranaTask!);
      this.find("[data-kirana-done]")!.textContent =
        `${this.done.length} of ${this.config.tasksTotal} done`;
      this.find<HTMLProgressElement>("[data-kirana-progress]")!.value =
        this.done.length;
    }

    /* Book Summaries: daftar disaring dengan memasang ulang <li>, seperti React. */
    private filterBooks(topic: string) {
      this.findAll("[data-kirana-topic]").forEach((button) =>
        press(button, button.dataset.kiranaTopic === topic, this.config.chip),
      );
      const visible = this.lists.books!.filter(
        (book) => topic === "All" || book.dataset.topic === topic,
      );
      visible.forEach((book, index) => {
        book.querySelector<HTMLElement>("[data-kirana-bar]")!.style.width =
          `${30 + ((index * 17) % 40)}%`;
      });
      this.find("[data-kirana-books]")!.replaceChildren(...visible);
    }

    private toggleRead(button: HTMLElement) {
      const id = button.dataset.kiranaRead!;
      this.read = toggleIn(this.read, id);
      const on = this.read.includes(id);
      const label = on ? "Read" : "Mark as read";
      press(button, on, this.config.chip);
      const [visibleLabel, srLabel] = button.querySelectorAll("span");
      visibleLabel!.textContent = label;
      srLabel!.textContent = `${label}: ${button.dataset.title}`;
      this.find("[data-kirana-read-count]")!.textContent =
        `${this.read.length} of ${this.config.booksTotal} read`;
    }

    /* Founders */
    private handleInput(event: Event) {
      const field = event.target as HTMLInputElement;
      if (!field.matches("[data-kirana-search]")) return;
      const needle = field.value.trim().toLowerCase();
      const visible = this.lists.founders!.filter((item) =>
        item.dataset.search!.includes(needle),
      );
      this.find("[data-kirana-founders]")!.replaceChildren(...visible);
      this.find("[data-kirana-founder-empty]")!.hidden = visible.length > 0;
      this.find("[data-kirana-founder-count]")!.textContent = plural(
        visible.length,
        "founder",
      );
    }

    /* Finance */
    private sortInvoices(key: string) {
      const dir = this.invoiceSort.key === key ? -this.invoiceSort.dir : 1;
      this.invoiceSort = { key, dir };
      const value = (row: HTMLElement) =>
        key === "amount" ? Number(row.dataset.amount) : row.dataset.due!;
      const rows = [...this.lists.rows!].sort((a, b) => {
        const left = value(a);
        const right = value(b);
        return (left < right ? -1 : left > right ? 1 : 0) * dir;
      });
      this.find("tbody")!.replaceChildren(...rows);
      this.findAll("[data-kirana-sort]").forEach((column) => {
        if (column.dataset.kiranaSort === key)
          column.setAttribute("aria-sort", dir === 1 ? "ascending" : "descending");
        else column.removeAttribute("aria-sort");
      });
    }

    /* Projects */
    private filterProjects(status: string) {
      this.findAll("[data-kirana-status]").forEach((button) =>
        press(button, button.dataset.kiranaStatus === status, this.config.chip),
      );
      const visible = this.lists.projects!.filter(
        (item) => status === "All" || item.dataset.status === status,
      );
      this.find("[data-kirana-projects]")!.replaceChildren(...visible);
      this.find("[data-kirana-project-count]")!.textContent = plural(
        visible.length,
        "project",
      );
    }
  }

  if (!customElements.get("kirana-template"))
    customElements.define("kirana-template", KiranaTemplate);
</script>
