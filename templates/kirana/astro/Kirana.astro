                      {growthPeriods.map((period) => {
                        const peak = Math.max(...period.bars);
                        return (
                          <div slot={period.value} class="grid gap-4">
                            <dl class="grid gap-3 sm:grid-cols-3">
                              {period.metrics.map(([label, value]) => (
