                              <h3 class="font-semibold">{item.name}</h3>
                              <p class="text-sm text-muted">{item.client}, due {item.due}</p>
                            </div>
                            <Badge variant={projectVariant[item.status]}>{item.status}</Badge>
                          </div>
                          <div class="grid gap-1.5">
                            <p class="flex justify-between gap-4 text-sm"><span class="font-medium">Progress</span><span class="text-muted tabular-nums">{item.progress}%</span></p>
                            <Progress value={item.progress} max={100} aria-label={`${item.name} progress`} />
                          </div>
                        </li>
                      ))}
