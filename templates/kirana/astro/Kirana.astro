                {id === "projects" && (
                  <section aria-labelledby="kirana-projects-title" class={cx(panel, "xl:col-span-2")}>
                    <div class="flex items-center justify-between gap-3">
                      <div class="min-w-0">
                        <h2 id="kirana-projects-title" class="text-lg font-semibold tracking-tight">Delivery board</h2>
                        <p class="text-sm text-muted" data-kirana-project-count>{plural(projects.length, "project")}</p>
                      </div>
                    </div>
                    <div role="group" aria-label="Filter by status" class="flex flex-wrap gap-2">
                      {projectFilters.map((item) => (
                        <button type="button" aria-pressed={item === "All" ? "true" : "false"} class={cx(chip, item === "All" ? chipOn : chipOff)} data-kirana-status={item}>{item}</button>
                      ))}
                    </div>
                    <ul class="grid gap-3 md:grid-cols-2" data-kirana-projects>
                      {projects.map((item) => (
                        <li data-project={item.id} data-status={item.status} class="grid gap-3 rounded-3xl border border-line bg-surface p-4">
                          <div class="flex items-start justify-between gap-3">
