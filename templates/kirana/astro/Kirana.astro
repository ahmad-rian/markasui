const railBase = `inline-flex size-11 items-center justify-center rounded-2xl transition-colors duration-150 ${focusRing}`;
const railActive = "bg-(--tpl-blue) text-(--tpl-on)";
const railIdle = "text-(--tpl-rail-idle) hover:text-(--tpl-on)";
// Label rail muncul saat hover atau fokus keyboard, cukup dengan CSS.
const railTip =
  "pointer-events-none absolute top-1/2 left-full z-30 ml-3 -translate-y-1/2 rounded-md bg-ink px-2 py-1 text-xs font-medium whitespace-nowrap text-canvas opacity-0 shadow-overlay transition-opacity duration-150 group-hover:opacity-100 group-has-focus-visible:opacity-100";
const menuItem = `flex h-10 w-full items-center gap-3 rounded-xl px-3 text-left text-sm font-medium transition-colors duration-150 ${focusRing}`;
const menuIdle = "text-ink hover:bg-subtle";
const face =
  "inline-flex shrink-0 items-center justify-center rounded-full font-semibold text-(--tpl-av-ink) select-none";
const faceTones = [
  "bg-(--tpl-av1)",
  "bg-(--tpl-av2)",
  "bg-(--tpl-av3)",
  "bg-(--tpl-av4)",
  "bg-(--tpl-av5)",
];
const statBadges = {
  mint: "bg-(--tpl-mint) text-(--tpl-mint-ink)",
  sky: "bg-(--tpl-sky) text-(--tpl-sky-ink)",
};
const pill =
  "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold whitespace-nowrap";
// prettier-ignore
const tones: Record<Tone, string> = {
  blue: "bg-(--tpl-blue) text-(--tpl-on) [--card:var(--tpl-blue)]",
  teal: "bg-(--tpl-teal) text-(--tpl-on) [--card:var(--tpl-teal)]",
  night: "bg-(--tpl-night) text-(--tpl-on) [--card:var(--tpl-night)] dark:border dark:border-line",
  sun: "bg-(--tpl-sun) text-(--tpl-on-sun) [--card:var(--tpl-sun)]",
  plain: "border border-line bg-surface text-ink [--card:var(--color-surface)]",
  rose: "bg-(--tpl-rose) text-ink [--card:var(--tpl-rose)]",
};
const dealBase =
  "relative flex min-h-44 flex-col rounded-3xl p-4 transition-shadow duration-150";
const dealSelected = "ring-2 ring-primary ring-offset-2 ring-offset-canvas";
const cardButton = (tone: Tone) =>
  `relative z-10 inline-flex size-8 shrink-0 items-center justify-center rounded-full transition-colors duration-150 ${focusRing} ${
    tone === "night"
      ? "bg-(--tpl-on) text-(--tpl-night)"
      : tone === "plain"
        ? "bg-subtle text-ink hover:bg-line"
        : "bg-(--tpl-on)/25 hover:bg-(--tpl-on)/40"
  }`;
const selectable =
  "text-left after:absolute after:inset-0 after:rounded-3xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-primary";
const dayBase = `relative flex h-10 items-center justify-center gap-1 sm:justify-between rounded-xl px-2 text-xs font-semibold tabular-nums transition-colors duration-150 ${focusRing}`;
// prettier-ignore
const dayTones: Record<string, string> = {
  none: "bg-subtle/70 text-ink hover:bg-subtle", blue: tones.blue, sun: tones.sun, teal: tones.teal,
};
const daySelected = "ring-2 ring-primary ring-offset-2 ring-offset-surface";
const segment = `inline-flex h-8 items-center rounded-full px-4 text-xs font-semibold transition-colors duration-150 ${focusRing}`;
const segmentOn = "bg-surface text-ink shadow-(--tpl-shadow)";
const segmentOff = "text-muted hover:text-ink";
const chip = `inline-flex h-9 items-center rounded-full border px-4 text-sm font-medium transition-colors duration-150 ${focusRing}`;
const chipOn = "border-primary bg-primary text-on-primary";
const chipOff = "border-line bg-surface text-ink hover:bg-subtle";
const tile = "rounded-2xl border border-line bg-surface p-4";
const tableWrap = `relative overflow-x-auto rounded-2xl border border-line bg-surface contain-inline-size ${focusRing}`;
const th = "px-4 py-3 font-medium whitespace-nowrap";
const td = "px-4 py-3 whitespace-nowrap";
const thButton = `inline-flex items-center gap-1 rounded-md font-medium hover:text-ink ${focusRing}`;

const cx = (...c: (string | false | null | undefined)[]) =>
  c.filter(Boolean).join(" ");
const rupiah = (value: number) => `Rp ${value.toLocaleString("id-ID")}`;
const pad = (value: number) => String(value).padStart(2, "0");
const isoDate = (year: number, month: number, day: number) =>
  `${year}-${pad(month + 1)}-${pad(day)}`;
const plural = (count: number, word: string) =>
  `${count} ${word}${count === 1 ? "" : "s"}`;
/** Huruf pertama kata pertama dan terakhir, sama dengan Avatar. */
const initials = (name: string) =>
  name
    .split(" ")
    .filter((_, index, words) => index === 0 || index === words.length - 1)
    .map((word) => word.charAt(0))
    .join("")
    .toUpperCase();
/** Warna avatar inisial yang selalu sama untuk nama yang sama. */
const faceTone = (name: string) =>
  faceTones[
    [...name].reduce((sum, char) => sum + char.charCodeAt(0), 0) %
      faceTones.length
  ];
const shortDay = (iso: string) => {
  const [, month = 1, day = 1] = iso.split("-").map(Number);
  return `${monthNames[month - 1]?.slice(0, 3)} ${day}`;
};

/** Sel kalender bulan, minggu dimulai Senin. null untuk sel kosong. */
function monthCells(year: number, month: number) {
  const offset = (new Date(year, month, 1).getDay() + 6) % 7;
  const days = new Date(year, month + 1, 0).getDate();
  const cells = [
    ...Array<null>(offset).fill(null),
    ...Array.from({ length: days }, (_, index) => index + 1),
  ];
  return [...cells, ...Array<null>((7 - (cells.length % 7)) % 7).fill(null)];
}

const escape = (value: string | number) =>
  String(value).replace(/[&<>"]/g, (char) => `&#${char.charCodeAt(0)};`);
const icon = (name: IconName, className = "size-5") =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}"></path></svg>`;
const faceHtml = (name: string, className: string) =>
  `<span aria-hidden="true" class="${cx(face, faceTone(name), className)}">${escape(initials(name))}</span>`;
const teamHtml = (names: string[], ring: string) =>
  `<div role="img" aria-label="${escape(`Team: ${names.join(", ")}`)}" class="flex -space-x-1">${names.map((name) => faceHtml(name, cx("size-7 text-[10px] ring-2", ring))).join("")}</div>`;
const dayFace = "size-5 text-[8px] ring-1 ring-(--tpl-on) max-sm:hidden";
const pageIds = Object.keys(pages) as PageId[];
const firstDeal = dealList[0]!;
const growthTabs = growthPeriods.map(({ value, label }) => ({ value, label }));
const cashPeak = Math.max(...cashflow.map(([, value]) => value));
const view = { year: 2026, month: 9 };

/** Data dan class yang dipakai script di klien. */
const config = JSON.stringify({
  defaultPage: DEFAULT_PAGE,
  titleId: TITLE_ID,
  dealDrawer: DEAL_DRAWER,
  nav: {
    top: [pillActive, pillIdle],
    rail: [railActive, railIdle],
    menu: [pillActive, menuIdle],
  },
  dealSelected,
  deals: Object.fromEntries(
    dealList.map((deal) => [
      deal.id,
      {
        title: deal.title,
        day: deal.day,
        stage: deal.stage,
        value: rupiah(deal.value),
        card: cx("rounded-3xl p-4", tones[deal.tone as Tone]),
        team: teamHtml(deal.team, "ring-surface"),
      },
    ]),
  ),
  contact: initialContact,
  face,
  faceTones,
  today: TODAY,
  monthNames,
  weekdays,
  marks: Object.fromEntries(
    Object.entries(marks).map(([iso, mark]) => [
      iso,
      { ...mark, face: faceHtml(mark.who, dayFace) },
    ]),
  ),
  dayBase,
  dayTones,
  daySelected,
  funnel,
  segment: [segmentOn, segmentOff],
  chip: [chipOn, chipOff],
  booksTotal: books.length,
  tasksTotal: todayTasks.length,
});
---

<kirana-template class="contents" data-config={config}>
  <div class={shell}>
    <header class="flex h-20 items-center gap-3 px-4 lg:px-6">
      <Drawer title="Menu" side="left">
        <button slot="trigger" type="button" aria-label="Open menu" class={cx(roundButton, "xl:hidden")} set:html={icon("menu")} />
        <form method="dialog" class="grid gap-1">
          {rail.map((item) => (
            <button type="submit" aria-current={item.id === DEFAULT_PAGE ? "page" : undefined} class={cx(menuItem, item.id === DEFAULT_PAGE ? pillActive : menuIdle)} data-kirana-nav="menu" data-kirana-go={item.id} data-toast={item.id ? undefined : item.label} data-toast-text={item.id ? undefined : "Coming up in your workspace"}><Fragment set:html={icon(item.icon)} />{item.label}</button>
          ))}
        </form>
      </Drawer>
      <div class="flex min-w-0 items-center gap-3">
        <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-linear-135 from-(--tpl-blue) to-(--tpl-teal) text-(--tpl-on)">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </span>
        <div class="min-w-0 leading-tight">
          <p class="text-lg font-bold tracking-tight">Kirana</p>
          <p class="truncate text-xs text-muted max-[390px]:hidden">Grow. Connect. Succeed.</p>
        </div>
      </div>
      <nav aria-label="Main" class={cx("mx-auto hidden items-center gap-1 rounded-full p-1 xl:flex", glass)}>
        {topNav.map((id) => (
          <button type="button" aria-current={id === DEFAULT_PAGE ? "page" : undefined} class={cx(pillBase, id === DEFAULT_PAGE ? pillActive : pillIdle)} data-kirana-nav="top" data-kirana-go={id}>{pages[id].label}</button>
        ))}
      </nav>
      <div class="ml-auto flex items-center gap-2 xl:ml-0">
        <button type="button" aria-label="Messages, 2 unread" class={cx(roundButton, "max-sm:hidden")} data-toast="2 unread messages" data-toast-text="Ratna Kusuma replied">
          <Fragment set:html={icon("mail")} />
          <span aria-hidden="true" class="absolute top-2 right-2 size-2 rounded-full bg-danger ring-2 ring-surface"></span>
        </button>
        <button type="button" aria-label="Notifications, 3 unread" class={roundButton} data-toast="3 unread notifications" data-toast-text="Enterprise Plan moved stage">
          <Fragment set:html={icon("bell")} />
          <span aria-hidden="true" class="absolute top-2 right-2 size-2 rounded-full bg-danger ring-2 ring-surface"></span>
        </button>
        <button type="button" aria-label="Open public site" class={cx(roundButton, "max-sm:hidden")} data-toast="Public site" data-toast-text="kirana.id opened in a new tab" set:html={icon("external")} />
        <Avatar name="Dimas Pratama" size="md" class="ring-2 ring-surface" />
      </div>
    </header>

    <div class="px-4 pb-8 lg:grid lg:grid-cols-[64px_minmax(0,1fr)] lg:gap-5 lg:pr-6 lg:pl-5">
      <div class="hidden lg:block">
        <nav aria-label="Workspace" class="sticky top-6 flex flex-col items-center gap-1.5 rounded-full bg-(--tpl-night) px-2.5 py-3 shadow-(--tpl-shadow) dark:border dark:border-line">
          {rail.map((item) => (
            <span class="group relative inline-flex">
              <button type="button" aria-label={item.label} aria-current={item.id === DEFAULT_PAGE ? "page" : undefined} class={cx(railBase, item.id === DEFAULT_PAGE ? railActive : railIdle)} data-kirana-nav="rail" data-kirana-go={item.id} data-toast={item.id ? undefined : item.label} data-toast-text={item.id ? undefined : "Coming up in your workspace"} set:html={icon(item.icon)} />
              <span aria-hidden="true" class={railTip}>{item.label}</span>
            </span>
          ))}
        </nav>
      </div>

      <main class="grid min-w-0 content-start gap-4 xl:grid-cols-[minmax(0,1fr)_340px]">
        {
          /* Halaman bawaan dirender langsung (tanpa JS tetap tampil), lalu semua halaman sebagai <template>. */
          [{ live: true, id: DEFAULT_PAGE }, ...pageIds.map((id) => ({ live: false, id }))].map(({ live, id }) => {
            const Wrapper = live ? "div" : "template";
            return (
              <Wrapper class={live ? "contents" : undefined} data-kirana-view={live ? "" : undefined} data-kirana-page={live ? undefined : id}>
                <div class={cx("flex flex-wrap items-center gap-4 xl:flex-nowrap", id !== "contacts" && "xl:col-span-2")}>
                  <div class="flex items-center gap-4">
                    <button type="button" aria-label="Back to Home" class={roundButton} data-kirana-go="home" set:html={icon("back")} />
                    <div class="w-48">
                      <p class="text-xs text-muted">Kirana / {pages[id].label}</p>
                      <h1 id={TITLE_ID} tabindex="-1" class="text-[28px] leading-tight font-bold tracking-tight focus:outline-none">{pages[id].title}</h1>
                    </div>
                  </div>
                  <div class="grid w-full min-w-0 gap-3 sm:grid-cols-3 xl:flex-1">
                    {headerStats[id].map((stat) => (
                      <div class={cx("flex items-center gap-3 rounded-3xl p-3", glass)}>
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-subtle" set:html={icon(stat.icon)} />
                        <div class="grid min-w-0 gap-1">
                          <p class="flex flex-wrap items-center gap-x-2 gap-y-1"><span class="text-lg font-bold tracking-tight whitespace-nowrap tabular-nums">{stat.value}</span><span class={cx(pill, statBadges[stat.tone])}>{stat.badge}</span></p>
                          <p class="max-w-40 text-xs leading-snug text-muted">{stat.label}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {id === "contacts" && (
                  <div class="contents">
                    <div class="grid min-w-0 content-start gap-4">
                      <section aria-labelledby="kirana-history-title" class={panel}>
                        <div class="flex items-center justify-between gap-3">
                          <div class="min-w-0"><h2 id="kirana-history-title" class="text-lg font-semibold tracking-tight">Interaction History</h2></div>
                          <div class="flex shrink-0 gap-2">
                            <DropdownMenu items={historyMenu} class={menuTrigger} data-kirana-menu="history"><Fragment slot="trigger"><Fragment set:html={icon("dots", "size-4")} /><span class="sr-only">Interaction History options</span></Fragment></DropdownMenu>
                            <button type="button" aria-label="Expand Interaction History" class={smallButton} data-toast="Interaction History expanded" data-toast-text="Opened in full view" set:html={icon("expand", "size-4")} />
                          </div>
                        </div>
                        <ul role="list" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-kirana-deals>
                          {dealList.map((item) => {
                            const tone = item.tone as Tone;
                            return (
                              <li data-deal={item.id} data-value={item.value} data-day={item.day} class={cx(dealBase, tones[tone])}>
                                <div class="flex items-start justify-between gap-3">
                                  <p class="pt-1 text-xs font-medium">Oct {item.day}</p>
                                  <button type="button" aria-label={`Open ${item.title}`} class={cardButton(tone)} data-kirana-deal-open={item.id} set:html={icon(tone === "night" ? "arrow" : "dots", "size-4")} />
                                </div>
                                <h3 class="mt-1 max-w-56 text-lg leading-snug font-semibold"><button type="button" aria-pressed="false" class={selectable} data-kirana-deal-open={item.id} data-kirana-deal-select>{item.title}</button></h3>
                                <div class="mt-auto flex items-end justify-between gap-2 pt-4">
                                  <p class="text-lg font-bold tracking-tight tabular-nums">{rupiah(item.value)}</p>
                                  <Fragment set:html={teamHtml(item.team, "ring-(--card)")} />
                                </div>
                              </li>
                            );
                          })}
                        </ul>
                      </section>
                      <div class="grid gap-4 lg:grid-cols-2">
                        <section aria-labelledby="kirana-schedule-title" class={panel}>
                          <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0"><h2 id="kirana-schedule-title" class="text-lg font-semibold tracking-tight">Tasks Schedule</h2></div>
                            <div class="flex shrink-0 gap-2">
                              <DropdownMenu items={scheduleMenu} class={menuTrigger} data-kirana-menu="schedule"><Fragment slot="trigger"><Fragment set:html={icon("dots", "size-4")} /><span class="sr-only">Tasks Schedule options</span></Fragment></DropdownMenu>
                              <button type="button" aria-label="Expand Tasks Schedule" class={smallButton} data-toast="Tasks Schedule expanded" data-toast-text="Opened in full view" set:html={icon("expand", "size-4")} />
                            </div>
                          </div>
                          <div class="flex items-center justify-between gap-3">
                            <h3 class="flex items-baseline gap-2 text-base font-semibold" data-kirana-month>{monthNames[view.month]}<span class="text-sm font-normal text-muted">{view.year}</span></h3>
                            <div class="flex gap-2">
                              <button type="button" aria-label="Previous month" class={smallButton} data-kirana-shift="-1" set:html={icon("prev", "size-4")} />
                              <button type="button" aria-label="Next month" class={smallButton} data-kirana-shift="1" set:html={icon("next", "size-4")} />
                            </div>
                          </div>
                          <div class="grid grid-cols-7 gap-1.5" data-kirana-calendar>
                            {weekdays.map((day) => <span aria-hidden="true" class="text-center text-xs font-medium text-muted">{day}</span>)}
                            {monthCells(view.year, view.month).map((day) => {
                              if (day === null) return <span aria-hidden="true" />;
                              const iso = isoDate(view.year, view.month, day);
                              const item = marks[iso];
                              return (
                                <button type="button" aria-pressed={TODAY === iso ? "true" : "false"} class={cx(dayBase, dayTones[item?.tone ?? "none"], TODAY === iso && daySelected)} data-kirana-day={iso}><span aria-hidden="true">{day}</span><span class="sr-only">{`${monthNames[view.month]} ${day}${item ? `, ${item.task}` : ""}`}</span>{item && <Fragment set:html={faceHtml(item.who, dayFace)} />}</button>
                              );
                            })}
                          </div>
                          <p aria-live="polite" data-agenda class="text-sm text-muted"><span class="font-semibold text-ink">{shortDay(TODAY)}</span>{`: ${marks[TODAY]!.task} with ${marks[TODAY]!.who}`}</p>
                        </section>
                        <section aria-labelledby="kirana-funnel-title" class={panel}>
                          <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0"><h2 id="kirana-funnel-title" class="text-lg font-semibold tracking-tight">Stage Funnel</h2></div>
                            <div class="flex shrink-0 gap-2">
                              <DropdownMenu items={funnelMenu} class={menuTrigger} data-kirana-menu="funnel"><Fragment slot="trigger"><Fragment set:html={icon("dots", "size-4")} /><span class="sr-only">Stage Funnel options</span></Fragment></DropdownMenu>
                              <button type="button" aria-label="Expand Stage Funnel" class={smallButton} data-toast="Stage Funnel expanded" data-toast-text="Opened in full view" set:html={icon("expand", "size-4")} />
                            </div>
                          </div>
                          <div class="flex flex-wrap items-end justify-between gap-3">
                            <div>
                              <p data-funnel-total class="text-2xl font-bold tracking-tight tabular-nums">{funnel.weighted.total}</p>
                              <p class="text-xs text-muted">Total in Pipeline</p>
                            </div>
                            <div role="group" aria-label="Pipeline value" class="inline-flex rounded-full bg-subtle p-1">
                              {funnelModes.map((value) => (
                                <button type="button" aria-pressed={value === "weighted" ? "true" : "false"} class={cx(segment, value === "weighted" ? segmentOn : segmentOff)} data-kirana-mode={value}>{value === "weighted" ? "Weighted" : "Total"}</button>
                              ))}
                            </div>
                          </div>
                          <ol class="grid gap-2.5" aria-label="Pipeline by stage">
                            {funnel.weighted.steps.map(([label, value], index) => (
                              <li class={cx("mx-auto flex h-14 items-center justify-between gap-3 rounded-full bg-subtle pr-2 pl-5", funnelWidths[index])}>
                                <span class="grid leading-tight">
                                  <span class="text-xs text-muted">{label}</span>
                                  <span class="text-sm font-bold tabular-nums" data-kirana-step={index}>{value}</span>
                                </span>
                                {index === 0 ? (
                                  <button type="button" aria-label={`Open ${label}`} class={cx(smallButton, "size-10")} data-toast={label} data-toast-text={`${value} in this stage`} data-kirana-step-open set:html={icon("arrow", "size-4")} />
                                ) : (
                                  <span class="size-10" aria-hidden="true" />
                                )}
                              </li>
                            ))}
                          </ol>
                        </section>
                      </div>
                    </div>

                    <div class="grid min-w-0 grid-cols-1 content-start gap-4 xl:col-start-2 xl:row-span-2 xl:row-start-1">
                      <section aria-labelledby="kirana-profile-name" class="grid gap-4 rounded-3xl border border-(--tpl-glass-line) bg-linear-to-b from-(--tpl-rose) to-(--tpl-rose-2) p-4 shadow-(--tpl-shadow)">
                        <div class="flex items-center justify-between gap-2">
                          <div class="flex gap-2">
                            <button type="button" aria-label="Forward contact" class={smallButton} data-toast="Contact forwarded" data-toast-name set:html={icon("forward", "size-4")} />
                            <button type="button" aria-label="Share profile" class={smallButton} data-toast="Share link ready" data-toast-name set:html={icon("share", "size-4")} />
                          </div>
                          <div class="flex gap-2">
                            <DropdownMenu items={profileMenu} class={menuTrigger} data-kirana-menu="profile"><Fragment slot="trigger"><Fragment set:html={icon("dots", "size-4")} /><span class="sr-only">Profile options</span></Fragment></DropdownMenu>
                            <button type="button" aria-label="Expand Profile" class={smallButton} data-toast="Profile expanded" data-toast-text="Opened in full view" set:html={icon("expand", "size-4")} />
                          </div>
                        </div>
                        <div class="grid justify-items-center gap-1 pb-1 text-center">
                          <span aria-hidden="true" class={cx(face, faceTone(`${initialContact.firstName} ${initialContact.lastName}`), "mb-2 size-24 text-2xl ring-4 ring-surface")} data-kirana-face>{initials(`${initialContact.firstName} ${initialContact.lastName}`)}</span>
                          <h2 id="kirana-profile-name" class="text-xl font-bold tracking-tight">{`${initialContact.firstName} ${initialContact.lastName}`}</h2>
                          <p class="text-sm text-muted">Chief Growth Officer</p>
                          <p class="text-sm font-medium">PT Nusantara Digital</p>
                        </div>
                        <div class="flex flex-wrap justify-center gap-2">
                          {profileActions.map((action) => (
                            <button type="button" aria-label={action.label} class={cx(smallButton, "size-10 border-transparent")} data-toast={action.label} data-toast-name set:html={icon(action.icon, "size-4")} />
                          ))}
                        </div>
                      </section>

                      <section aria-labelledby="kirana-details-title" class={panel}>
                        <div class="flex items-center justify-between gap-3">
                          <div class="min-w-0"><h2 id="kirana-details-title" class="text-lg font-semibold tracking-tight">Detailed Information</h2></div>
                          <div class="flex shrink-0 gap-2">
                            <Drawer title="Edit contact details" data-kirana-edit-drawer>
                              <button slot="trigger" type="button" aria-label="Edit details" class={smallButton} data-kirana-edit set:html={icon("pencil", "size-4")} />
