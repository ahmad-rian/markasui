                      </div>
                      <div role="img" aria-label={`Cash flow: ${cashflow.map(([month, value]) => `${month} Rp ${value} million`).join(", ")}`} class="flex h-56 items-end gap-3">
                        {cashflow.map(([month, value], index) => (
                          <div class="flex h-full min-w-0 flex-1 flex-col justify-end gap-2">
                            <span class="text-center text-xs font-semibold tabular-nums">{value}</span>
                            <div class={cx("rounded-xl", index === cashflow.length - 1 ? "bg-(--tpl-teal)" : "bg-(--tpl-mint)")} style={`height: ${Math.round((value / cashPeak) * 80)}%`} />
                            <span class="text-center text-xs text-muted">{month}</span>
