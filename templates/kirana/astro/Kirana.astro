                            <div role="img" aria-label={`New leads, ${period.label}: ${period.bars.map((value, index) => `${barLabels[index]} ${value}`).join(", ")}`} class="flex h-48 items-end gap-3">
                              {period.bars.map((value, index) => (
                                <div data-bar class="flex h-full min-w-0 flex-1 flex-col justify-end gap-2">
                                  <div class={cx("rounded-xl", index === period.bars.length - 1 ? "bg-(--tpl-blue)" : "bg-(--tpl-sky)")} style={`height: ${Math.round((value / peak) * 100)}%`} />
                                  <span class="text-center text-xs text-muted">{barLabels[index]}</span>
                                </div>
                              ))}
