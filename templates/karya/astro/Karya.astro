const CASE_ID = "karya-case";
const EMAIL = "hello@rania.design";
const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const MIN_MESSAGE = 10;


const icon = (name: IconName, className: string) =>
