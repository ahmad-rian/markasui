const firstCase = cases[0]!;
const popOn = "scale-110 -rotate-6 shadow-[0_8px_0_var(--tpl-ink)]";
const popOff = "shadow-[0_2px_0_var(--tpl-ink)]";

/** Data dan class yang dipakai script di klien. */
const config = JSON.stringify({
  sectionIds,
  navOn,
  navIdle,
  navDot,
  pileFront,
  pileBack,
  popOn,
  popOff,
  icons: { menu: icons.menu, close: icons.close },
  cases: cases.map(({ id, name }) => ({ id, name })),
  caseId: CASE_ID,
  emailPattern: EMAIL_PATTERN.source,
  minMessage: MIN_MESSAGE,
  drag: { x: DRAG_LIMIT_X, top: DRAG_LIMIT_TOP, bottom: DRAG_LIMIT_BOTTOM },
