---

<karya-template class="contents" data-config={config}>
  <div class={cx(root, palette)} data-karya-root>
    <style is:inline set:html={motionCss}></style>
    <header class={headerWrap}>
      <div class={navPill}>
        <a href="#home" class={monogram} aria-label="Rania Putri, home">R</a>
        <nav aria-label="Main" class={navList}>
          {nav.map((item) => <a href={`#${item.id}`} data-karya-nav={item.id} class={cx(navLink, navIdle)}>{item.label}{item.icon && <Fragment set:html={icon(item.icon, "size-4")} />}</a>)}
        </nav>
        <button type="button" class={menuButton} aria-expanded="false" aria-controls="karya-menu" aria-label="Open menu" data-karya-menu-toggle set:html={icon("menu", "size-4")} />
        <a href="#contact" class={mailButton} aria-label="Contact" set:html={icon("mail", "size-4")} />
        <nav id="karya-menu" aria-label="Mobile" class={menuPanel} hidden>
          {nav.map((item) => <a href={`#${item.id}`} data-karya-nav={item.id} data-karya-menu-link class={menuLink}>{item.label}{item.icon && <Fragment set:html={icon(item.icon, "size-4")} />}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <section id="home" aria-labelledby="karya-title" class={hero}>
        <p class={hello}>Hello<span class={helloAvatar} aria-hidden="true">RP</span>I&apos;m Rania</p>
        <h1 id="karya-title" class={heroTitle}><span class={heroLine}>I design products that </span><span class={heroLine}><em>feel</em> simple, even </span><span class={heroLine}>when they&apos;re not.</span></h1>
        <p class={lead}>Product designer in Yogyakarta. Eight years of untangling <strong class={strong}>complex B2B workflows</strong> and building the <strong class={strong}>design system</strong> that keeps them consistent.</p>
        <div class={pile} data-pile="">
          <button type="button" class={tidyButton} data-karya-tidy><Fragment set:html={icon("reset", "size-3.5")} />Tidy up</button>
          <ul aria-label="Things I do">
            {pills.map((item) => <li data-pill={item.id} class={cx(pillBase, item.className, pileBack)}>{item.label}</li>)}
            {stickers.map((item) => <li data-pill={item.id} class={cx(dotBase, item.className, pileBack)}><Fragment set:html={icon(item.icon, "size-5 md:size-6")} /><span class={srOnly}>{item.id}</span></li>)}
          </ul>
        </div>
      </section>

      <section id="work" aria-labelledby="karya-work-title" class={cx(wrap, section)}>
        <div class={sectionHead} data-reveal="">
          <h2 id="karya-work-title" class={h2}>Selected work</h2>
          <p class={sideNote}>Case studies, 2022 to 2025</p>
        </div>
        <ul class={caseGrid} data-reveal="">
          {cases.map((item) => (
            <li class={cx(caseCard, item.tone)}>
              <div class={caseShot}>
                {item.id === "ledger" && (
                  <div class="absolute inset-0 grid grid-cols-[3rem_1fr]" aria-hidden="true">
                    <div class="grid content-start gap-2 border-r-2 border-(--tpl-ink)/10 bg-(--tpl-ink)/5 p-3">
                      <span class="size-6 rounded-lg bg-(--tpl-ink)"></span>
                      <span class="size-6 rounded-lg bg-(--tpl-ink)/15"></span>
                      <span class="size-6 rounded-lg bg-(--tpl-ink)/15"></span>
                      <span class="size-6 rounded-lg bg-(--tpl-ink)/15"></span>
                    </div>
                    <div class="grid content-start gap-3 p-4">
                      <div class="flex items-center justify-between">
                        <p class="text-xs font-semibold">March close</p>
                        <span class="rounded-full bg-(--tpl-sun) px-2 py-0.5 text-[10px] font-semibold">Day 3 of 5</span>
                      </div>
                      <div class="grid grid-cols-3 gap-2">
                        {ledgerTiles.map(([label, value]) => (
                          <div class="rounded-xl border-2 border-(--tpl-ink)/10 p-2">
                            <p class="text-[10px] text-(--tpl-ink)/70">{label}</p>
                            <p class="text-sm font-semibold">{value}</p>
                          </div>
                        ))}
                      </div>
                      <div class="flex h-32 items-end gap-2 rounded-xl border-2 border-(--tpl-ink)/10 p-2 md:h-40">
                        {ledgerBars.map((height, index) => <span class={cx("flex-1 rounded-md", height, index === 5 ? "bg-(--tpl-ink)" : "bg-(--tpl-sun)")}></span>)}
                      </div>
                    </div>
                  </div>
                )}
                {item.id === "muat" && (
                  <div class="absolute inset-0 grid gap-3 p-4" aria-hidden="true">
                    <div class="flex items-center justify-between">
                      <p class="text-xs font-semibold">Dispatch, Cikarang hub</p>
                      <span class="rounded-full bg-(--tpl-ink) px-2 py-0.5 text-[10px] font-semibold text-(--tpl-paper)">42 trucks</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                      {muatColumns.map(([label, count]) => (
                        <div class="grid content-start gap-2 rounded-xl bg-(--tpl-ink)/5 p-2">
                          <p class="text-[10px] font-semibold">{label}</p>
                          {Array.from({ length: count }, (_, index) => (
                            <div class="grid gap-1.5 rounded-lg border-2 border-(--tpl-ink)/10 bg-(--tpl-paper) p-2">
                              <span class={cx(mockBar, "w-4/5 bg-(--tpl-ink)/20")}></span>
                              <span class={cx(mockBar, "w-1/3", index === 0 && label === "On the road" ? "bg-(--tpl-orange)" : "bg-(--tpl-sky)")}></span>
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
                {item.id === "tenun" && (
                  <div class="absolute inset-0 grid content-center gap-4 p-5" aria-hidden="true">
                    <div class="flex gap-2">
                      {tenunSwatches.map((tone) => <span class={cx("h-10 flex-1 rounded-xl border-2 border-(--tpl-ink)", tone)}></span>)}
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-full bg-(--tpl-ink) px-4 py-2 text-xs font-semibold text-(--tpl-paper)">Primary</span>
                      <span class="rounded-full border-2 border-(--tpl-ink) px-4 py-1.5 text-xs font-semibold">Secondary</span>
                      <span class="flex h-6 w-11 items-center justify-end rounded-full bg-(--tpl-ink) p-1"><span class="size-4 rounded-full bg-(--tpl-pink)"></span></span>
                    </div>
                    <div class="flex items-end justify-between border-t-2 border-(--tpl-ink)/10 pt-3">
                      <span class="font-serif text-5xl leading-none">Aa</span>
                      <span class="font-mono text-[10px] font-semibold">48 COMPONENTS</span>
                    </div>
                  </div>
                )}
                {item.id === "sehat" && (
                  <div class="absolute inset-0 grid gap-2 p-4" aria-hidden="true">
                    <div class="grid grid-cols-5 gap-2 text-center text-[10px] font-semibold">
                      {weekDays.map((day) => <span>{day}</span>)}
                    </div>
                    <div class="grid grid-cols-5 grid-rows-4 gap-2 rounded-xl bg-(--tpl-ink)/5 p-2">
                      {sehatSlots.map((slot) => <span class={cx("rounded-lg border-2 border-(--tpl-ink)", slot)}></span>)}
                    </div>
                  </div>
                )}
              </div>
              <div class={caseFoot}>
                <div>
                  <h3 class={caseTitle}>{item.name}</h3>
                  <p class={caseLead}>{item.lead}</p>
                  <ul class={tagList} aria-label="Tags">
                    {item.tags.map((text) => <li class={tag}>{text}</li>)}
                  </ul>
                </div>
                <button type="button" class={caseOpen} aria-label={`Open case study: ${item.name}`} data-karya-case={item.id} set:html={icon("arrow", "size-5")} />
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="playground" aria-labelledby="karya-play-title" class={cx(wrap, section)}>
        <div class={sectionHead} data-reveal="">
          <h2 id="karya-play-title" class={h2}>Playground</h2>
          <p class={sideNote}>Small experiments, try them</p>
        </div>
        <ul class={playGrid} data-reveal="">
          <li class={playCard}>
            <div class={cx(playStage, "bg-(--tpl-lilac)")} aria-hidden="true">
              <div data-radius="" class="size-28 border-2 border-(--tpl-ink) bg-(--tpl-sun)" style={`border-radius: ${RADIUS_DEFAULT}px`}></div>
            </div>
            <div>
              <h3 class={playTitle}>Rounding corners</h3>
              <p class={small}>The oldest debate in the studio, now with a slider.</p>
            </div>
            <Slider id="karya-radius" label="Corner radius" min={0} max={56} value={RADIUS_DEFAULT} />
          </li>
          <li class={playCard}>
            <div class={cx(playStage, "bg-subtle")} aria-hidden="true">
              <div data-tint="" class="size-28 rounded-3xl border-2 border-line" style={`background-color: color-mix(in oklab, var(--color-primary) ${TINT_DEFAULT}%, var(--color-surface))`}></div>
            </div>
            <div>
              <h3 class={playTitle}>Token tint</h3>
              <p class={small}>Mixes the primary token into the surface, like a real theme would.</p>
            </div>
            <Slider id="karya-tint" label="Primary mix" min={10} max={100} step={10} value={TINT_DEFAULT} />
          </li>
          <li class={playCard}>
            <div class={cx(playStage, "bg-(--tpl-mint)")} aria-hidden="true">
              <span data-pop="off" class={cx("rounded-full border-2 border-(--tpl-ink) bg-(--tpl-orange) px-6 py-3 font-mono text-sm font-semibold text-(--tpl-ink) uppercase transition-transform duration-300 ease-out motion-reduce:transition-none", popOff)}>Ship it</span>
            </div>
            <div>
              <h3 class={playTitle}>Making it pop</h3>
              <p class={small}>What every client asks for, in one honest switch.</p>
            </div>
            <Switch id="karya-pop" label="Make it pop" />
          </li>
        </ul>
      </section>

      <section id="about" aria-labelledby="karya-about-title" class={cx(wrap, section)}>
        <h2 id="karya-about-title" class={h2} data-reveal="">About</h2>
        <div class={aboutGrid}>
          <div class={portrait} role="img" aria-label="Illustrated portrait of Rania" data-reveal="">
            <span class="absolute -bottom-16 left-1/2 h-56 w-64 -translate-x-1/2 rounded-t-full border-2 border-(--tpl-ink) bg-(--tpl-orange)"></span>
            <span class="absolute top-[18%] left-1/2 flex size-40 -translate-x-1/2 items-center justify-center rounded-full border-2 border-(--tpl-ink) bg-(--tpl-pink) font-serif text-5xl text-(--tpl-ink)">RP</span>
            <span class="absolute top-8 right-8 size-10 rotate-12 rounded-xl border-2 border-(--tpl-ink) bg-(--tpl-sky)"></span>
            <span class="absolute top-1/2 left-6 size-8 rounded-full border-2 border-(--tpl-ink) bg-(--tpl-mint)"></span>
          </div>
          <div data-reveal="">
            <div class={bio}>
              {about.map((text) => <p>{text}</p>)}
            </div>
            <ol id="cv" class={timeline} aria-label="Experience">
              {experience.map((item, index) => (
                <li class={timelineItem}>
                  <span class={cx(timelineDot, index === 0 ? "bg-primary" : "bg-faint")} aria-hidden="true"></span>
                  <p class={timelineYears}>{item.years}</p>
                  <p class={timelineRole}>{item.role}, {item.company}</p>
                  <p class={small}>{item.detail}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <section id="contact" aria-labelledby="karya-contact-title" class={cx(wrap, section)}>
        <div class={contactCard} data-reveal="">
          <div>
            <h2 id="karya-contact-title" class={contactTitle}>Got a messy workflow? Let&apos;s make it <em>feel</em> simple.</h2>
            <p class={contactLead}>Tell me what your team is wrestling with. I reply to every message within two working days.</p>
            <a href={`mailto:${EMAIL}`} class={mailLink}><Fragment set:html={icon("mail", "size-4")} />{EMAIL}</a>
          </div>
          <form class={form} novalidate aria-label="Contact form" data-karya-form>
            <div class={field}>
              <Input id="karya-name" label="Name" name="name" autocomplete="name" placeholder="Andi Pratama" />
              <p id="karya-name-error" class={errorText} hidden></p>
            </div>
            <div class={field}>
              <Input id="karya-email" label="Email" type="email" name="email" autocomplete="email" placeholder="you@company.com" />
              <p id="karya-email-error" class={errorText} hidden></p>
            </div>
            <div class={field}>
              <Textarea id="karya-message" label="Project details" name="message" rows={4} placeholder="What is your team building, and what feels hard?" />
              <p id="karya-message-error" class={errorText} hidden></p>
            </div>
            <Button type="submit" size="lg">Send message</Button>
          </form>
        </div>
      </section>
    </main>

    <footer class={footer}>
      <p>&copy; 2026 Rania Putri. Built with MarkasUI.</p>
      <nav aria-label="Footer" class={footerNav}>
        {footerLinks.map((link) => <a href={link.href} class={quietLink}>{link.label}</a>)}
      </nav>
    </footer>

    {
      (() => {
        const content = (current: CaseStudy) => (
          <>
            <dl class={caseMeta}>
              <div>
                <dt class={caseLabel}>Role</dt>
                <dd class={caseValue}>{current.role}</dd>
              </div>
              <div>
                <dt class={caseLabel}>Timeline</dt>
                <dd class={caseValue}>{current.timeline}</dd>
              </div>
              <div>
                <dt class={caseLabel}>Team</dt>
                <dd class={caseValue}>{current.team}</dd>
              </div>
            </dl>
            <p>{current.problem}</p>
            <ol class={caseSteps}>
              {current.steps.map((step) => <li>{step}</li>)}
            </ol>
            <div class={caseStats}>
              {current.stats.map(([value, label]) => <p class={caseStat}><span class={caseNumber}>{value}</span><span class={caseLabel}>{label}</span></p>)}
            </div>
          </>
        );
        return (
          <>
            <Modal id={CASE_ID} title={firstCase.name}>
              <div class={caseBody} data-karya-case-view>{content(firstCase)}</div>
              <Fragment slot="footer">
                <Button variant="secondary" type="submit">Done</Button>
                <Button data-karya-next>Next project</Button>
              </Fragment>
            </Modal>
            {cases.map((current) => <template data-karya-case-body={current.id}>{content(current)}</template>)}
          </>
        );
      })()
    }
    <Toaster />
  </div>
</karya-template>

<script>
  type Config = {
    sectionIds: string[];
    navOn: string;
    navIdle: string;
    navDot: string;
    pileFront: string;
    pileBack: string;
    popOn: string;
    popOff: string;
    icons: { menu: string; close: string };
    cases: { id: string; name: string }[];
    caseId: string;
    emailPattern: string;
    minMessage: number;
    drag: { x: number; top: number; bottom: number };
  };
  type Field = "name" | "email" | "message";
  type Drag = { pill: HTMLElement; x: number; y: number; ox: number; oy: number };

  const toast = (detail: { title: string; description: string; variant: string }) =>
    window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));
  const setClasses = (element: Element, add: string, remove: string) => {
    element.classList.remove(...remove.split(" "));
    element.classList.add(...add.split(" "));
  };

  /** Satu elemen per template: navigasi hash, menu, stiker, playground, studi kasus, dan form. */
  class KaryaTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private drag: Drag | null = null;
    private caseId = "";
    private observer: IntersectionObserver | undefined;
    private readonly onHashChange = () => this.syncHash();
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onInput = (event: Event) => this.handleInput(event);
    private readonly onKeydown = (event: KeyboardEvent) => this.handleKeydown(event);
    private readonly onSubmit = (event: Event) => this.submit(event);
    private readonly onPointerDown = (event: PointerEvent) => this.startDrag(event);
    private readonly onPointerMove = (event: PointerEvent) => this.moveDrag(event);
    private readonly onPointerEnd = () => (this.drag = null);

    connectedCallback() {
      this.caseId = this.config.cases[0]!.id;
      this.syncHash();
      window.addEventListener("hashchange", this.onHashChange);
      this.addEventListener("click", this.onClick);
      this.addEventListener("input", this.onInput);
      this.addEventListener("change", this.onInput);
      this.addEventListener("keydown", this.onKeydown);
      this.addEventListener("submit", this.onSubmit);
      this.addEventListener("pointerdown", this.onPointerDown);
      this.addEventListener("pointermove", this.onPointerMove);
      this.addEventListener("pointerup", this.onPointerEnd);
      this.addEventListener("pointercancel", this.onPointerEnd);
      this.startReveal();
    }

    disconnectedCallback() {
      window.removeEventListener("hashchange", this.onHashChange);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("input", this.onInput);
      this.removeEventListener("change", this.onInput);
      this.removeEventListener("keydown", this.onKeydown);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("pointerdown", this.onPointerDown);
      this.removeEventListener("pointermove", this.onPointerMove);
      this.removeEventListener("pointerup", this.onPointerEnd);
      this.removeEventListener("pointercancel", this.onPointerEnd);
      this.observer?.disconnect();
    }

    /** Tampilkan elemen data-reveal dan tumpukan stiker saat masuk layar; dilewati saat reduced motion. */
    private startReveal() {
      const root = this.querySelector<HTMLElement>("[data-karya-root]");
      if (
        !root ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        !("IntersectionObserver" in window)
      )
        return;
      root.dataset.motion = "on";
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute("data-shown", "");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      root
        .querySelectorAll("[data-reveal],[data-pile]")
        .forEach((item) => observer.observe(item));
      this.observer = observer;
    }

    /** Section aktif mengikuti hash URL; titik hanya ada di link aktif. */
    private syncHash() {
      const hash = window.location.hash.slice(1);
      const active = this.config.sectionIds.includes(hash) ? hash : "home";
      this.querySelectorAll<HTMLElement>("[data-karya-nav]").forEach((link) => {
        const on = link.dataset.karyaNav === active;
        if (on) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
        if (link.hasAttribute("data-karya-menu-link")) return;
        setClasses(
          link,
          on ? this.config.navOn : this.config.navIdle,
          on ? this.config.navIdle : this.config.navOn,
        );
        const dot = link.querySelector("[data-karya-dot]");
        if (on && !dot) {
          const span = document.createElement("span");
          span.className = this.config.navDot;
          span.dataset.karyaDot = "";
          link.prepend(span);
        } else if (!on) dot?.remove();
      });
    }

    private menu() {
      return this.querySelector<HTMLElement>("#karya-menu")!;
    }

    private setMenu(open: boolean) {
      this.menu().hidden = !open;
      const toggle = this.querySelector("[data-karya-menu-toggle]")!;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle
        .querySelector("path")
        ?.setAttribute("d", open ? this.config.icons.close : this.config.icons.menu);
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      if (target.closest("[data-karya-menu-toggle]"))
        return this.setMenu(this.menu().hidden !== false);
      if (target.closest("[data-karya-menu-link]")) return this.setMenu(false);
      if (target.closest("[data-karya-tidy]")) return this.tidy();
      const study = target.closest<HTMLElement>("[data-karya-case]");
      if (study) return this.openCase(study.dataset.karyaCase!);
      if (target.closest("[data-karya-next]")) {
        const { cases } = this.config;
        const index = cases.findIndex((item) => item.id === this.caseId);
        this.showCase(cases[(index + 1) % cases.length]!.id);
      }
    }

    private handleKeydown(event: KeyboardEvent) {
      if (event.key === "Escape" && (event.target as Element).closest("#karya-menu"))
        this.setMenu(false);
    }

    /* Stiker: seret dengan pointer, posisi dibatasi supaya tetap dekat tumpukan. */
    private startDrag(event: PointerEvent) {
      const pill = (event.target as Element).closest<HTMLElement>("[data-pill]");
      if (!pill) return;
      pill.setPointerCapture(event.pointerId);
      const [ox = 0, oy = 0] = (pill.style.translate || "0px 0px")
        .split(" ")
        .map((part) => parseFloat(part) || 0);
      this.drag = { pill, x: event.clientX, y: event.clientY, ox, oy };
      this.querySelectorAll("[data-pill]").forEach((other) =>
        setClasses(
          other,
          other === pill ? this.config.pileFront : this.config.pileBack,
          other === pill ? this.config.pileBack : this.config.pileFront,
        ),
      );
    }

    private moveDrag(event: PointerEvent) {
      const state = this.drag;
      if (!state) return;
      const { drag } = this.config;
      const x = clamp(state.ox + event.clientX - state.x, -drag.x, drag.x);
      const y = clamp(state.oy + event.clientY - state.y, drag.top, drag.bottom);
      state.pill.style.translate = `${x}px ${y}px`;
    }

    private tidy() {
      this.querySelectorAll<HTMLElement>("[data-pill]").forEach((pill) => {
        pill.style.removeProperty("translate");
        if (!pill.getAttribute("style")) pill.removeAttribute("style");
        setClasses(pill, this.config.pileBack, this.config.pileFront);
      });
    }

    /* Playground */
    private handleInput(event: Event) {
      const field = event.target as HTMLInputElement;
      if (field.id === "karya-radius")
        this.querySelector<HTMLElement>("[data-radius]")!.style.borderRadius =
          `${field.value}px`;
      if (field.id === "karya-tint")
        this.querySelector<HTMLElement>("[data-tint]")!.style.backgroundColor =
          `color-mix(in oklab, var(--color-primary) ${field.value}%, var(--color-surface))`;
      if (field.id === "karya-pop") {
        const target = this.querySelector<HTMLElement>("[data-pop]")!;
        target.dataset.pop = field.checked ? "on" : "off";
        setClasses(
          target,
          field.checked ? this.config.popOn : this.config.popOff,
          field.checked ? this.config.popOff : this.config.popOn,
        );
      }
    }

    /* Studi kasus: isi modal diklon dari <template> sesuai proyek. */
    private showCase(id: string) {
      const template = this.querySelector<HTMLTemplateElement>(
        `template[data-karya-case-body="${id}"]`,
      );
      const view = this.querySelector("[data-karya-case-view]");
      if (!template || !view) return;
      this.caseId = id;
      view.replaceChildren(template.content.cloneNode(true));
      const title = document.getElementById(`${this.config.caseId}-title`);
      if (title)
        title.textContent =
          this.config.cases.find((item) => item.id === id)?.name ?? "";
    }

    private openCase(id: string) {
      this.showCase(id);
      const dialog = document.getElementById(this.config.caseId);
      if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
    }

    /* Form kontak */
    private submit(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-karya-form]")) return;
      event.preventDefault();
      const field = (name: Field) =>
        form.querySelector<HTMLInputElement | HTMLTextAreaElement>(
          `[name="${name}"]`,
        )!;
      const value = (name: Field) => field(name).value;
      const errors: Partial<Record<Field, string>> = {};
      if (!value("name").trim()) errors.name = "Tell me your name.";
      if (!new RegExp(this.config.emailPattern).test(value("email").trim()))
        errors.email = "Enter a valid email address, like you@company.com.";
      if (value("message").trim().length < this.config.minMessage)
        errors.message = "Write at least 10 characters about your project.";
      for (const name of ["name", "email", "message"] as const) {
        const error = form.querySelector<HTMLElement>(`#karya-${name}-error`)!;
        const text = errors[name];
        error.hidden = !text;
        error.textContent = text ?? "";
        if (text) {
          field(name).setAttribute("aria-invalid", "true");
          field(name).setAttribute("aria-describedby", error.id);
        } else {
          field(name).removeAttribute("aria-invalid");
          field(name).removeAttribute("aria-describedby");
        }
      }
      if (Object.keys(errors).length) return;
      const first = value("name").trim().split(/\s+/)[0];
      toast({
        title: "Message sent",
        description: `Thanks ${first}, I will reply to ${value("email").trim()} within two days.`,
        variant: "success",
      });
      for (const name of ["name", "email", "message"] as const) field(name).value = "";
    }
  }

  if (!customElements.get("karya-template"))
    customElements.define("karya-template", KaryaTemplate);
</script>
