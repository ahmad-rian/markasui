type IconName = keyof typeof icons;

const TITLE = "Learn the job from people who do it";
const MODAL_ID = "belajar-course-modal";
const EMAIL_ID = "belajar-email";
const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
// prettier-ignore
const nav = [
  { label: "Courses", href: "#courses" }, { label: "How it works", href: "#how" },
  { label: "Mentors", href: "#mentors" }, { label: "Pricing", href: "#pricing" },
  { label: "FAQ", href: "#faq" },
];
const heroFacts = [
  "8 to 10 weeks",
  "2 live sessions a week",
  "Reviewed final project",
];
// prettier-ignore
const logos = [
  { name: "Sagara", path: "M3 15a9 9 0 0 1 18 0Z" },
  { name: "Kopi Kita", path: "M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" },
  { name: "Nusantara Labs", path: "M12 2 21 7v10l-9 5-9-5V7Z" },
  { name: "Arunika", path: "M12 3 22 20H2Z" },
  { name: "Lumbung", path: "M12 2 22 12 12 22 2 12Z" },
  { name: "Teras Data", path: "M4 4h7v16H4ZM13 9h7v11h-7Z" },
];
// prettier-ignore
const topics = [
  { value: "all", label: "All" }, { value: "data", label: "Data" }, { value: "product", label: "Product" },
  { value: "design", label: "Design" }, { value: "marketing", label: "Marketing" },
];
// prettier-ignore
const mentors = [
  { id: "rina", name: "Rina Siregar", role: "Senior Data Analyst", bio: "Nine years of analytics in retail and fintech. Still writes SQL every morning." },
  { id: "ayu", name: "Ayu Lestari", role: "Group Product Manager", bio: "Has shipped payment and lending products used by millions of Indonesians." },
  { id: "nadia", name: "Nadia Putri", role: "Lead Product Designer", bio: "Runs a design team of twelve and hires junior designers every year." },
  { id: "bayu", name: "Bayu Saputra", role: "Head of Growth", bio: "Grew two consumer apps from launch to their first million users." },
];
// prettier-ignore
const courses = [
  { id: "sql", title: "SQL for data analysis", topic: "data", level: "Beginner", weeks: 8, starts: "12 Jan", price: 2400000, mentor: "rina", text: "Query real sales data, join messy tables, and answer the questions your manager asks every week.", project: "A weekly sales report built from a retail dataset of 2 million orders." },
  { id: "python", title: "Python for analysts", topic: "data", level: "Intermediate", weeks: 10, starts: "2 Feb", price: 3200000, mentor: "rina", text: "Clean data with pandas, automate the spreadsheets you rebuild by hand, and chart the results.", project: "A notebook that cleans, analyses, and charts a year of ride booking data." },
  { id: "pm", title: "Product management fundamentals", topic: "product", level: "Beginner", weeks: 10, starts: "19 Jan", price: 3500000, mentor: "ayu", text: "Find the problem worth solving, write a clear spec, and work with engineers and designers.", project: "A product spec and launch plan for a feature in an app you use daily." },
  { id: "experiments", title: "Product analytics and experiments", topic: "product", level: "Intermediate", weeks: 8, starts: "9 Feb", price: 2900000, mentor: "ayu", text: "Choose the right metrics, design A/B tests, and explain the results to people who decide.", project: "An experiment plan and readout for a checkout flow change." },
  { id: "figma", title: "UI design with Figma", topic: "design", level: "Beginner", weeks: 8, starts: "12 Jan", price: 2700000, mentor: "nadia", text: "Layout, type, and components in Figma, from the first wireframe to a clickable prototype.", project: "A mobile app redesign with a small component library." },
  { id: "research", title: "UX research in practice", topic: "design", level: "Intermediate", weeks: 6, starts: "26 Jan", price: 2200000, mentor: "nadia", text: "Plan interviews, run usability tests, and turn what you hear into decisions a team can act on.", project: "A usability study with five participants and a findings report." },
  { id: "ads", title: "Performance marketing", topic: "marketing", level: "Beginner", weeks: 8, starts: "19 Jan", price: 2500000, mentor: "bayu", text: "Plan paid campaigns, set budgets, and read the numbers that show what is working.", project: "A one month campaign plan with budget, targeting, and reporting." },
  { id: "seo", title: "Content strategy and SEO", topic: "marketing", level: "Beginner", weeks: 6, starts: "2 Feb", price: 1900000, mentor: "bayu", text: "Research what people search for, plan a content calendar, and write pages that rank.", project: "A three month content plan and two published articles." },
];
const SCHEDULE = "Tue and Thu, 19.30 WIB";
// prettier-ignore
const steps = [
  { lottie: "study", label: "At your own pace", title: "Watch and read before class", text: "Short lessons of 15 to 20 minutes that fit a commute. Each one ends with a small exercise." },
  { lottie: "mentor", label: "Live, twice a week", title: "Work through it with a mentor", text: "Evening sessions with your mentor and up to 24 classmates. Bring your questions and your exercise." },
  { lottie: "certificate", label: "Final two weeks", title: "Finish with a reviewed project", text: "Your mentor reviews your project in detail. Pass the review to get a certificate with a public link." },
] as const;
// prettier-ignore
const stories = [
  { name: "Putri Anggraini", role: "Data Analyst, Medan", course: "SQL for data analysis", quote: "I used to build reports by hand in Excel. Eight weeks later I wrote the queries for our weekly sales review, and the notes on my project were more useful than anything I had read online." },
  { name: "Fajar Ramadhan", role: "Associate Product Manager, Jakarta", course: "Product management fundamentals", quote: "The live sessions felt like a real product team. We argued about scope, wrote specs, and got honest feedback. I talked about my final project in three interviews." },
  { name: "Melati Kusuma", role: "UI Designer, Bandung", course: "UI design with Figma", quote: "I could follow along after work, and the recordings saved me twice when my shift ran late. Nadia reviewed every screen I made, not just the final one." },
];
// prettier-ignore
const billingOptions = [{ value: "monthly", label: "Monthly" }, { value: "yearly", label: "Yearly" }];
// prettier-ignore
const plans = [
  { id: "free", name: "Free", tag: "", monthly: 0, yearly: 0, text: "Try the format before you commit.", features: ["One free lesson from every course", "Community forum", "Monthly live Q&A with a mentor"] },
  { id: "plus", name: "Plus", tag: "", monthly: 249000, yearly: 199000, text: "Self-paced learning across every course.", features: ["All recorded lessons and exercises", "Project templates and datasets", "Certificates for self-paced tracks"] },
  { id: "cohort", name: "Cohort", tag: "Most chosen", monthly: 899000, yearly: 719000, text: "Live cohorts with a mentor, all year.", features: ["Everything in Plus", "Join any live cohort, one at a time", "Mentor review of every project", "A career session with a recruiter"] },
];
// prettier-ignore
const faqs = [
  { question: "Do I need experience before joining?", answer: "Not for beginner courses. Intermediate courses list what you should know first, and a short placement quiz tells you if you are ready." },
  { question: "How much time does a course take each week?", answer: "Plan for six to eight hours: two live sessions of 90 minutes, plus lessons and exercises at your own pace." },
  { question: "What if I miss a live session?", answer: "Every session is recorded and posted within a few hours. Your mentor also answers questions in the cohort chat." },
  { question: "Can my company pay for the course?", answer: "Yes. We issue invoices with full tax details and offer team plans for five or more people." },
  { question: "Can I get a refund?", answer: "Yes. You get a full refund if you cancel before the end of the first week of your cohort." },
];
// prettier-ignore
const footerColumns = [
  { title: "Learn", links: [{ label: "Courses", href: "#courses" }, { label: "How it works", href: "#how" }, { label: "Pricing", href: "#pricing" }] },
  { title: "Company", links: [{ label: "About", href: "/about" }, { label: "Mentors", href: "#mentors" }, { label: "Careers", href: "/careers" }] },
  { title: "Support", links: [{ label: "FAQ", href: "#faq" }, { label: "Contact", href: "/contact" }, { label: "For teams", href: "/teams" }] },
];
// prettier-ignore
const legal = [{ label: "Privacy", href: "/privacy" }, { label: "Terms", href: "/terms" }];

const rupiah = (value: number) =>
  `Rp ${String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ".")}`;
const mentorOf = (id: string) =>
  mentors.find((mentor) => mentor.id === id) ?? mentors[0]!;
const topicLabel = (value: string) =>
  topics.find((topic) => topic.value === value)?.label ?? "";
const coursesBy = (id: string) =>
  courses
    .filter((course) => course.mentor === id)
    .map((course) => course.title)
    .join(", ");
const countLabel = (shown: number) =>
  shown === courses.length
    ? `Showing all ${courses.length} courses`
    : `Showing ${shown} of ${courses.length} courses`;
const planPriceOf = (plan: (typeof plans)[number], billing: string) =>
  billing === "yearly" ? plan.yearly : plan.monthly;
const planNoteOf = (plan: (typeof plans)[number], billing: string) =>
  plan.monthly === 0
    ? "No card needed"
    : billing === "yearly"
      ? `Billed ${rupiah(plan.yearly * 12)} a year`
      : "Billed monthly, cancel anytime";

const first = courses[0]!;
const firstMentor = mentorOf(first.mentor);
const icon = (name: IconName, className: string) =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}" /></svg>`;
const brandHtml = `<a href="#top" class="${brandLink}"><span class="${brandMark}">${icon("book", "size-4")}</span>Benak</a>`;
const config = JSON.stringify({
  modalId: MODAL_ID,
  emailId: EMAIL_ID,
  emailPattern: EMAIL_PATTERN.source,
  note: [fieldError, fieldHint],
  total: courses.length,
  courses: Object.fromEntries(
    courses.map((course) => [
      course.id,
      {
        title: course.title,
        topic: course.topic,
        topicLabel: topicLabel(course.topic),
        level: course.level,
        text: course.text,
        weeks: `${course.weeks} weeks`,
        starts: course.starts,
        project: course.project,
        mentor: course.mentor,
        price: rupiah(course.price),
      },
    ]),
  ),
  plans: Object.fromEntries(
    plans.map((plan) => [
      plan.id,
      {
        name: plan.name,
        monthly: [rupiah(plan.monthly), planNoteOf(plan, "monthly")],
        yearly: [rupiah(plan.yearly), planNoteOf(plan, "yearly")],
      },
    ]),
  ),
});
---

<belajar-template class="contents" data-config={config}>
  <div id="top" class={root}>
    <Navbar variant="blur" sticky class={navbarEdge} links={nav}>
      <Fragment slot="brand" set:html={brandHtml} />
      <Fragment slot="actions">
        <a href="/login" class={signIn}>Sign in</a>
        <a href="#courses" class={startLink}>Start learning</a>
      </Fragment>
    </Navbar>

    <main>
      <section aria-labelledby="belajar-title" class={hero}>
        <div>
          <p class={eyebrow}><span aria-hidden="true" class={eyebrowDot}></span>Next cohorts start 12 January 2027</p>
          <h1 id="belajar-title" class={h1}>{TITLE}</h1>
          <p class={heroLead}>Live, mentor-led courses in data, product, design, and marketing. Small cohorts, weekly projects, and feedback in Bahasa Indonesia, planned around a full-time job.</p>
          <div class={heroActions}>
            <a href="#courses" class={heroLink}>Browse courses<Fragment set:html={icon("arrow", "size-4")} /></a>
            <Button variant="secondary" size="lg" data-belajar-free>Try a free lesson</Button>
          </div>
          <ul class={factList}>
            {heroFacts.map((item) => <li class={fact}><Fragment set:html={icon("check", checkIcon)} />{item}</li>)}
          </ul>
        </div>
        <figure class={heroCard}>
          <div class={heroStage}>
            <div data-lottie-name="hero" aria-hidden="true" class={heroLottie}></div>
          </div>
          <figcaption>
            <div class={nextRow}>
              <Avatar name="Rina Siregar" size="sm" />
              <div>
                <p class={nextLabel}>Up next in your cohort</p>
                <p class={nextTitle}>Live review: joining sales tables</p>
                <p class={nextLabel}>Thursday, 19.30 WIB with Rina Siregar</p>
              </div>
            </div>
            <div class={progressRow}>
              <div class={progressTrack}><div class={progressBar}></div></div>
              <span class={progressText}>Week 3 of 8</span>
            </div>
          </figcaption>
        </figure>
      </section>

      <div class={logoWrap}>
        <LogoCloud title="Our graduates work at teams like these" logos={logos} />
      </div>

      <section id="courses" aria-labelledby="belajar-courses" class={section}>
        <div class={sectionHead}>
          <h2 id="belajar-courses" class={h2}>Pick a course that fits your week</h2>
          <p class={lead}>Every course runs as a cohort of up to 24 people, with two live evening sessions a week and a project you keep.</p>
        </div>
        <div class={toolbar}>
          <div class={filterScroll}>
            <ToggleGroup label="Filter courses by topic" items={topics} value="all" data-belajar-filter />
          </div>
          <p aria-live="polite" class={countText} data-belajar-count>{countLabel(courses.length)}</p>
        </div>
        <ul class={courseGrid} data-belajar-courses>
          {
            courses.map((course) => (
              <li data-course={course.id} data-topic={course.topic} class={courseCard}>
                <div class={courseBody}>
                  <div class={courseTop}>
                    <span class={topicText}>{topicLabel(course.topic)}</span>
                    <Badge dot={false}>{course.level}</Badge>
                  </div>
                  <h3 class={courseTitle}>{course.title}</h3>
                  <p class={courseText}>{course.text}</p>
                  <p class={courseMeta}>{course.weeks} weeks, starts {course.starts}</p>
                </div>
                <div class={courseFoot}>
                  <span class={priceText}>{rupiah(course.price)}</span>
                  <Button variant="secondary" size="sm" aria-label={`Details, ${course.title}`} data-belajar-open={course.id}>Details</Button>
                </div>
              </li>
            ))
          }
        </ul>
        <Modal id={MODAL_ID} title="Course details">
          <div class={modalBody}>
            <div>
              <div class={courseTop}>
                <span class={topicText} data-belajar-modal="topicLabel">{topicLabel(first.topic)}</span>
                <Badge dot={false} data-belajar-modal="level">{first.level}</Badge>
              </div>
              <p data-modal-title="" class={modalTitle} data-belajar-modal="title">{first.title}</p>
              <p class={modalText} data-belajar-modal="text">{first.text}</p>
            </div>
            <dl class={factGrid}>
              <div class={factCell}><dt class={factTerm}>Length</dt><dd class={factValue} data-belajar-modal="weeks">{first.weeks} weeks</dd></div>
              <div class={factCell}><dt class={factTerm}>Starts</dt><dd class={factValue} data-belajar-modal="starts">{first.starts}</dd></div>
              <div class={factCell}><dt class={factTerm}>Live</dt><dd class={factValue}>{SCHEDULE}</dd></div>
            </dl>
            <div class={projectBox}>
              <p class={projectTerm}>What you will build</p>
              <p class={projectText} data-belajar-modal="project">{first.project}</p>
            </div>
            <div class={modalMentor}>
              {
                mentors.map((mentor) => (
                  <div class={person} data-belajar-mentor={mentor.id} hidden={mentor.id !== firstMentor.id}>
                    <Avatar name={mentor.name} size="sm" />
                    <div>
                      <p class={personName}>{mentor.name}</p>
                      <p class={personRole}>{mentor.role}</p>
                    </div>
                  </div>
                ))
              }
              <p class={modalPrice} data-belajar-modal="price">{rupiah(first.price)}</p>
            </div>
          </div>
          <Fragment slot="footer">
            <Button variant="secondary" type="submit" value="cancel">Close</Button>
            <Button type="submit" value="apply">Apply for this cohort</Button>
          </Fragment>
        </Modal>
      </section>

      <section id="how" aria-labelledby="belajar-how" class={section}>
        <div class={sectionHead}>
          <h2 id="belajar-how" class={h2}>How a course works</h2>
          <p class={lead}>About six to eight hours a week, most of it in the evening. You learn on your own first, then practise with people.</p>
        </div>
        <ol class={stepGrid}>
          {
            steps.map((step) => (
              <li>
                <div class={stepArt}>
                  <div data-lottie-name={step.lottie} aria-hidden="true" class={stepLottie}></div>
                </div>
                <p class={stepLabel}>{step.label}</p>
                <h3 class={stepTitle}>{step.title}</h3>
                <p class={stepText}>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="mentors" aria-labelledby="belajar-mentors" class={section}>
        <div class={sectionHead}>
          <h2 id="belajar-mentors" class={h2}>Taught by people who still do the work</h2>
          <p class={lead}>Every mentor works in the field they teach and leads at most two cohorts a year.</p>
        </div>
        <ul class={mentorGrid}>
          {
            mentors.map((mentor) => (
              <li class={mentorCard}>
                <Avatar name={mentor.name} size="lg" />
                <div>
                  <h3 class={mentorName}>{mentor.name}</h3>
                  <p class={personRole}>{mentor.role}</p>
                </div>
                <p class={mentorBio}>{mentor.bio}</p>
                <p class={mentorTeaches}>Teaches {coursesBy(mentor.id)}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="stories" aria-labelledby="belajar-stories" class={section}>
        <div class={sectionHead}>
          <h2 id="belajar-stories" class={h2}>From recent graduates</h2>
        </div>
        <ul class={storyGrid}>
          {
            stories.map((story) => (
              <li>
                <figure class={storyCard}>
                  <blockquote class={quoteText}>{story.quote}</blockquote>
                  <figcaption class={person}>
                    <Avatar name={story.name} size="md" />
                    <div>
                      <p class={personName}>{story.name}</p>
                      <p class={personRole}>{story.role}, {story.course}</p>
                    </div>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="pricing" aria-labelledby="belajar-pricing" class={section}>
        <div class={pricingHead}>
          <div class={sectionHead}>
            <h2 id="belajar-pricing" class={h2}>Pay per course, or learn all year</h2>
            <p class={lead}>Course prices above are one-time. A membership suits you if you plan to keep learning.</p>
          </div>
          <div class={billingRow}>
            <ToggleGroup label="Billing period" items={billingOptions} value="monthly" data-belajar-billing />
            <span class={saveNote}>Save 20% with yearly</span>
          </div>
        </div>
        <ul class={planGrid}>
          {
            plans.map((plan) => (
              <li data-plan={plan.id} class={plan.tag ? planFeatured : planCard}>
                <div class={planHead}>
                  <h3 class={planName}>{plan.name}</h3>
                  {plan.tag && <Badge variant="primary" dot={false}>{plan.tag}</Badge>}
                </div>
                <p class={planText}>{plan.text}</p>
                <p class={planPrice}>
                  <span data-price="" class={planAmount}>{rupiah(planPriceOf(plan, "monthly"))}</span>
                  <span class={planUnit}>/month</span>
                </p>
                <p class={planNote} data-plan-note>{planNoteOf(plan, "monthly")}</p>
                <ul class={featureList}>
                  {plan.features.map((feature) => <li class={featureItem}><Fragment set:html={icon("check", featureIcon)} />{feature}</li>)}
                </ul>
                <Button variant={plan.tag ? "primary" : "secondary"} class={planButton} data-belajar-plan={plan.name}>Choose {plan.name}</Button>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="faq" aria-labelledby="belajar-faq" class={faqLayout}>
        <div class={faqAside}>
          <h2 id="belajar-faq" class={h2}>Questions, answered</h2>
          <p class={lead}>Not sure which course fits? An advisor can look at your goals and suggest one.</p>
          <Button variant="secondary" data-belajar-chat>Chat with an advisor</Button>
        </div>
        <Faq items={faqs} exclusive class={faqList} />
      </section>

      <div class={bandWrap}>
        <section aria-labelledby="belajar-newsletter" class={band}>
          <div>
            <h2 id="belajar-newsletter" class={bandTitle}>One free lesson every Tuesday</h2>
            <p class={bandText}>A ten minute lesson from one of our mentors, with an exercise you can finish over coffee.</p>
          </div>
          <form class={form} novalidate data-belajar-news>
            <label for={EMAIL_ID} class={fieldLabel}>Email address</label>
            <div class={fieldRow}>
              <Input id={EMAIL_ID} type="email" name="email" autocomplete="email" placeholder="nama@email.com" class={field} aria-describedby={`${EMAIL_ID}-note`} />
              <Button type="submit" class={fieldButton}>Subscribe</Button>
            </div>
            <p id={`${EMAIL_ID}-note`} class={fieldHint}>One email a week. Unsubscribe in one click.</p>
          </form>
        </section>
      </div>
    </main>

    <Footer class={footer} description="Live online courses for working professionals in Indonesia." columns={footerColumns} legal={legal} copyright="© 2026 Benak. Built with MarkasUI.">
      <Fragment slot="brand" set:html={brandHtml} />
    </Footer>
    <Toaster />
  </div>
</belajar-template>

<script>
  import { playLottie, type LottieName } from "../lottie/player";

  type CourseInfo = Record<"title" | "topic" | "topicLabel" | "level" | "text" | "weeks" | "starts" | "project" | "mentor" | "price", string>;
  type Config = {
    modalId: string;
    emailId: string;
    emailPattern: string;
    note: [string, string];
    total: number;
    courses: Record<string, CourseInfo>;
    plans: Record<string, { name: string; monthly: [string, string]; yearly: [string, string] }>;
  };
  type ToastDetail = { title: string; description: string; variant?: string };

  const HINT = "One email a week. Unsubscribe in one click.";
  const toast = (detail: ToastDetail) => window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const setClasses = (element: Element, on: boolean, [active, idle]: string[]) => {
    element.classList.remove(...(on ? idle! : active!).split(" "));
    element.classList.add(...(on ? active! : idle!).split(" "));
  };

  /** Satu elemen per template: menu mobile, filter kursus, modal, harga, newsletter, Lottie. */
  class BelajarTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private selected = "";
    private courses: HTMLElement[] = [];
    private stops: (() => void)[] = [];
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onSubmit = (event: Event) => this.subscribe(event);
    private readonly onClose = (event: Event) => this.modalClosed(event);

    connectedCallback() {
      this.courses = [...this.querySelectorAll<HTMLElement>("[data-belajar-courses] > li")];
      this.selected = this.courses[0]?.dataset.course ?? "";
      this.stops = [...this.querySelectorAll<HTMLElement>("[data-lottie-name]")].map((box) => playLottie(box, box.dataset.lottieName as LottieName));
      this.addEventListener("click", this.onClick);
      this.addEventListener("submit", this.onSubmit);
      // close tidak bubble: didengar di fase capture.
      this.addEventListener("close", this.onClose, true);
    }

    disconnectedCallback() {
      this.stops.forEach((stop) => stop());
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("close", this.onClose, true);
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      // Navbar tidak menutup menu mobile saat link di-klik; tutup lewat tombolnya sendiri.
      if (target.closest("[data-state=open] a"))
        return this.querySelector<HTMLButtonElement>("header button[aria-expanded=true]")?.click();
      const toggle = target.closest<HTMLButtonElement>("[data-belajar-filter] > button, [data-belajar-billing] > button");
      if (toggle) return this.pickToggle(event, toggle);
      if (target.closest("[data-belajar-free]"))
        return toast({ title: "Free lesson unlocked", description: "Lesson 1 of SQL for data analysis is ready. It takes about 15 minutes." });
      if (target.closest("[data-belajar-chat]"))
        return toast({ title: "Chat opened", description: "An advisor usually replies within 10 minutes, 09.00 to 21.00 WIB." });
      const plan = target.closest<HTMLElement>("[data-belajar-plan]");
      if (plan)
        return toast({ title: `${plan.dataset.belajarPlan} plan selected`, description: "Checkout opens in the next step. You can switch plans later." });
      const open = target.closest<HTMLElement>("[data-belajar-open]");
      if (open) this.openCourse(open.dataset.belajarOpen!);
    }

    /** ToggleGroup mengosongkan pilihan saat item aktif diklik lagi; hentikan supaya selalu ada pilihan. */
    private pickToggle(event: Event, button: HTMLButtonElement) {
      if (button.getAttribute("aria-pressed") === "true") return event.stopPropagation();
      const value = button.dataset.value!;
      if (button.parentElement!.matches("[data-belajar-filter]")) this.setTopic(value);
      else this.setBilling(value);
    }

    /* Filter kursus: kartu disaring dengan memasang ulang <li>, seperti React. */
    private setTopic(topic: string) {
      const visible = this.courses.filter((course) => topic === "all" || course.dataset.topic === topic);
      this.querySelector("[data-belajar-courses]")!.replaceChildren(...visible);
      const { total } = this.config;
      this.querySelector("[data-belajar-count]")!.textContent =
        visible.length === total ? `Showing all ${total} courses` : `Showing ${visible.length} of ${total} courses`;
    }

    private setBilling(billing: string) {
      this.querySelectorAll<HTMLElement>("[data-plan]").forEach((card) => {
        const plan = this.config.plans[card.dataset.plan!]!;
        const [price, note] = billing === "yearly" ? plan.yearly : plan.monthly;
        card.querySelector("[data-price]")!.textContent = price;
        card.querySelector("[data-plan-note]")!.textContent = note;
      });
    }

    private openCourse(id: string) {
      const course = this.config.courses[id];
      const dialog = document.getElementById(this.config.modalId);
      if (!course || !(dialog instanceof HTMLDialogElement)) return;
      this.selected = id;
      dialog.querySelectorAll<HTMLElement>("[data-belajar-modal]").forEach((field) => {
        field.textContent = course[field.dataset.belajarModal as keyof CourseInfo];
      });
      dialog.querySelectorAll<HTMLElement>("[data-belajar-mentor]").forEach((mentor) => {
        mentor.hidden = mentor.dataset.belajarMentor !== course.mentor;
      });
      dialog.showModal();
    }

    private modalClosed(event: Event) {
      const dialog = event.target;
      if (!(dialog instanceof HTMLDialogElement) || dialog.id !== this.config.modalId) return;
      if (dialog.returnValue === "apply")
        toast({
          title: "Application started",
          description: `We saved a seat for you in ${this.config.courses[this.selected]!.title}. Finish your application within 48 hours.`,
          variant: "success",
        });
      dialog.returnValue = "";
    }

    private subscribe(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-belajar-news]")) return;
      event.preventDefault();
      const field = form.querySelector<HTMLInputElement>(`#${this.config.emailId}`)!;
      const note = form.querySelector<HTMLElement>(`#${this.config.emailId}-note`)!;
      const value = field.value.trim();
      const valid = new RegExp(this.config.emailPattern).test(value);
      setClasses(note, !valid, this.config.note);
      note.textContent = valid ? HINT : "Enter a valid email address, like nama@email.com.";
      if (!valid) return field.setAttribute("aria-invalid", "true");
      field.removeAttribute("aria-invalid");
      field.value = "";
      toast({ title: "You are subscribed", description: `The first lesson is on its way to ${value}.`, variant: "success" });
    }
  }

  if (!customElements.get("belajar-template")) customElements.define("belajar-template", BelajarTemplate);
</script>
