    {
      name: "Ultra",
      amount: "300 Mbps",
      boosted: "600 Mbps",
      price: "Rp575.000",
      boostedPrice: "Rp690.000",
      perks: ["Symmetric upload", "Static IP on request"],
    },
  ],
};
const FEATURED = 1;

type Coverage = { network: string; speed: string; home: string; bars: number };
const coverageByCity: Record<string, Coverage> = {
  jakarta: {
    network: "5G",
    speed: "Up to 420 Mbps",
    home: "Fiber ready",
    bars: 4,
  },
  surabaya: {
    network: "5G",
    speed: "Up to 380 Mbps",
    home: "Fiber ready",
    bars: 4,
  },
  bandung: {
    network: "5G",
    speed: "Up to 350 Mbps",
    home: "Fiber ready",
    bars: 4,
  },
  denpasar: {
    network: "5G",
    speed: "Up to 300 Mbps",
    home: "Fiber ready",
    bars: 4,
  },
  medan: {
    network: "4G+",
    speed: "Up to 150 Mbps",
    home: "Fiber ready",
    bars: 3,
  },
  makassar: {
    network: "4G+",
    speed: "Up to 140 Mbps",
    home: "Fiber in 2026",
    bars: 3,
  },
  jayapura: {
    network: "4G",
    speed: "Up to 80 Mbps",
    home: "Fixed wireless",
    bars: 2,
  },
