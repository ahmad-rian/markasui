---

<konek-template class="contents" data-config={config}>
  <div class={cx(root, palette)}>
    <style is:inline set:html={motionCss}></style>
    <header class={header}>
      <div class={headerInner}>
        <a href="#home" class={brand} aria-label="Konek, home"><span class={brandMark} aria-hidden="true" set:html={icon("signal", "size-4")} />konek</a>
        <nav aria-label="Main" class={navList}>
          {nav.map((item) => (
            <a href={`#${item.id}`} aria-current={item.id === "home" ? "location" : undefined} class={cx(navLink, item.id === "home" ? navOn : navIdle)} data-konek-nav={item.id}>{item.label}</a>
          ))}
        </nav>
        <div class={headerActions}>
          <button type="button" class={appButton} data-konek-app>Get the app</button>
          <button type="button" class={menuButton} aria-expanded="false" aria-controls="konek-menu" aria-label="Open menu" data-konek-menu-toggle set:html={icon("menu", "size-5")} />
        </div>
        <template data-konek-menu>
          <nav id="konek-menu" aria-label="Mobile" class={menuPanel}>
            {nav.map((item) => (
              <a href={`#${item.id}`} class={menuLink} data-konek-menu-link={item.id}>{item.label}</a>
            ))}
          </nav>
        </template>
      </div>
    </header>

    <main>
      <section id="home" aria-labelledby="konek-title" class={hero}>
        <h1 id="konek-title" class={heroTitle}>
          <span class={heroLine}>Stay</span>
          <span class={heroLine}>Connected</span>
        </h1>
        <p class={heroLead}>We provide mobile and home internet to over 60 million customers across 34 provinces.</p>
        <div class={heroActions}>
          <a href="#pricing" class={cx(pillLink, outlineLink)}>View plans</a>
          <button type="button" class={cx(pillLink, redButton)} data-konek-sim>Order a SIM card</button>
        </div>
        <div class={artRow}>
          {arts.map(({ art, side }) => (
            <svg class={cx(artBase, side, art.float)} viewBox="0 0 320 320" fill="none" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={art.label}>
              {art.layers.map((layer) => (
                <g class={layer.c}>
                  {layer.s.map((shape) => <path d={shape.d} class={shape.c} />)}
                </g>
              ))}
            </svg>
          ))}
        </div>
      </section>

      <section id="about" aria-labelledby="konek-about-title" class={cx(wrap, section)}>
        <h2 id="konek-about-title" class={srOnly}>About Konek</h2>
        <ul class={cardGrid} data-reveal="">
          {cards.map((item) => (
            <li class={cx(bigCard, item.card)}>
              <svg class={cardArcs} viewBox="0 0 320 320" fill="none" aria-hidden="true">
                <path d={arcs} class={cx("[stroke-width:18]", item.arcs)} stroke-linecap="round" />
              </svg>
              <div class="relative">
                <span class={cx(cardIcon, item.iconTone)} aria-hidden="true" set:html={icon(item.icon, "size-6")} />
                <h3 class={cardTitle}>{item.title}</h3>
                <p class={cardText}>{item.text}</p>
              </div>
              <a href={item.href} class={cx(cardButton, item.button)}>Start building<span class={srOnly}>{`: ${item.title}`}</span><Fragment set:html={icon("arrow", "size-4")} /></a>
            </li>
          ))}
        </ul>
      </section>

      <section id="investors" aria-labelledby="konek-investors-title" class={cx(wrap, "scroll-mt-20")}>
        <h2 id="konek-investors-title" class={srOnly}>Konek in numbers</h2>
        <dl class={statGrid} data-reveal="">
          {stats.map(([value, label]) => (
            <div>
              <dt class={statValue}>{value}</dt>
              <dd class={statLabel}>{label}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="pricing" aria-labelledby="konek-pricing-title" class={cx(wrap, section)}>
        <div class={pricingHead} data-reveal="">
          <div>
            <h2 id="konek-pricing-title" class={h2}>Plans for every day</h2>
            <p class={sectionLead}>No contracts, no surprise fees. Switch plans whenever life changes.</p>
          </div>
          <div class={tabGroup} role="group" aria-label="Plan type">
            {tabs.map((item) => (
              <button type="button" aria-pressed={item.id === firstTab.id ? "true" : "false"} class={cx(tabBase, item.id === firstTab.id ? tabOn : tabIdle)} data-konek-tab={item.id}>{item.label}</button>
            ))}
          </div>
        </div>
        <div class={boostRow}>
          <Switch id="konek-boost" data-konek-boost />
          <label for="konek-boost" class={boostLabelClass} data-konek-boost-label>{firstTab.boost}</label>
        </div>
        {[{ live: true, item: firstTab }, ...tabs.map((item) => ({ live: false, item }))].map(({ live, item }) => {
          const list = (
            <ul class={planGrid} data-reveal="" data-konek-plans>
              {plans[item.id]!.map((plan, index) => (
                <li data-plan={plan.name} class={cx(planCard, index === FEATURED ? planFeatured : planIdle)}>
                  {index === FEATURED && <span class={planBadge}>Most popular</span>}
                  <div>
                    <h3 class={planName}>{plan.name}</h3>
                    <p class={planAmount} data-konek-amount>{plan.amount}</p>
                  </div>
                  <p class={planPrice}><span class="contents" data-konek-price>{plan.price}</span><span class={planPeriod}>{item.period}</span></p>
                  <ul class={perkList}>
                    {plan.perks.map((text) => <li class={perk}><Fragment set:html={icon("check", perkIcon)} />{text}</li>)}
                  </ul>
                  <Button variant={index === FEATURED ? "primary" : "secondary"} data-konek-choose={plan.name}>Choose {plan.name}</Button>
                </li>
              ))}
            </ul>
          );
          return live ? list : <template data-konek-tab-plans={item.id}>{list}</template>;
        })}
      </section>

      <section id="coverage" aria-labelledby="konek-coverage-title" class={cx(wrap, section)}>
        <div class={coverageGrid}>
          <div data-reveal="">
            <h2 id="konek-coverage-title" class={h2}>Check coverage for your home or business</h2>
            <p class={sectionLead}>See signal, speed, and home internet options in your city before you switch.</p>
            <form class={coverageForm} novalidate aria-label="Coverage check" data-konek-coverage>
              <Input id="konek-city" label="City" name="city" placeholder="Jakarta" />
              <Button type="submit">Check coverage</Button>
              <p id="konek-city-error" class={errorText} hidden />
            </form>
            <div class={chipRow}>
              Try
              {quickCities.map((name) => <button type="button" class={chip} data-konek-city={name}>{name}</button>)}
            </div>
          </div>
          <div class={resultCard} aria-live="polite" data-reveal="">
            <div class="flex items-start justify-between gap-4" data-konek-found hidden>
              <div>
                <p class={small}>Coverage in</p>
                <p class={resultTitle} data-result=""></p>
              </div>
              <div class={bars} aria-hidden="true">
                {barHeights.map((height) => <span class={cx(barBase, height, "bg-line")} data-konek-bar />)}
              </div>
            </div>
            <dl class={resultRows} data-konek-found hidden>
              <div class={resultCell}>
                <dt class={resultLabel}>Network</dt>
                <dd class={resultValue} data-konek-network></dd>
              </div>
              <div class={resultCell}>
                <dt class={resultLabel}>Speed</dt>
                <dd class={resultValue} data-konek-speed></dd>
              </div>
              <div class={resultCell}>
                <dt class={resultLabel}>Home internet</dt>
                <dd class={resultValue} data-konek-home></dd>
              </div>
            </dl>
            <div class={bars} aria-hidden="true" data-konek-empty>
              {barHeights.map((height) => <span class={cx(barBase, height, "bg-line")} />)}
            </div>
            <p class={resultTitle} data-konek-empty>Your signal, at a glance</p>
            <p class={small} data-konek-empty>Pick a city to see network, speed, and home internet. We cover 514 cities and regencies today.</p>
          </div>
        </div>
      </section>

      <div class={cx(wrap, faqWrap)} data-reveal="">
        <Faq id="faq" variant="split" title="Questions, answered" description="Everything people ask before they switch to Konek." items={faqs} exclusive />
      </div>

      <section id="careers" aria-labelledby="konek-careers-title" class={cx(wrap, "scroll-mt-20")}>
        <div class={careers} data-reveal="">
          <div>
            <h2 id="konek-careers-title" class={careersTitle}>Build the network with us</h2>
            <p class="mt-4 max-w-md text-base">320 open roles across 18 cities, from tower engineers to product designers.</p>
          </div>
          <a href="mailto:careers@konek.id" class={careersLink}>See open roles</a>
        </div>
      </section>
    </main>

    <footer class={footer}>
      <div class={footerInner}>
        <div>
          <p class={cx(brand, "text-xl")}>konek</p>
          <p class={cx(small, "mt-3 max-w-xs")}>Mobile and home internet for every corner of Indonesia.</p>
        </div>
        {footerColumns.map((column) => (
          <nav aria-label={column.title}>
            <p class={footerTitle}>{column.title}</p>
            <ul class={footerList}>
              {column.links.map((label) => <li><a href="#home" class={quietLink}>{label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
      <div class={footerBottom}>
        <p>&copy; 2026 Konek. Built with MarkasUI.</p>
        <a href="#home" class={quietLink}>Back to top</a>
      </div>
    </footer>
    <Toaster />
  </div>
</konek-template>

<script>
  type Plan = {
    name: string;
    amount: string;
    boosted: string;
    price: string;
    boostedPrice: string;
  };
  type Tab = { id: string; boost: string; period: string };
  type Coverage = { network: string; speed: string; home: string; bars: number };
  type Config = {
    sectionIds: string[];
    icons: Record<"menu" | "close", string>;
    nav: [string, string];
    tab: [string, string];
    tabs: Tab[];
    plans: Record<string, Plan[]>;
    coverage: Record<string, Coverage>;
    fallback: Coverage;
  };
  type ToastDetail = { title: string; description: string; variant?: string };

  const toast = (detail: ToastDetail) =>
    window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const setClasses = (element: Element, on: boolean, [active, idle]: string[]) => {
    element.classList.remove(...(on ? idle! : active!).split(" "));
    element.classList.add(...(on ? active! : idle!).split(" "));
  };

  /** Satu elemen per template: navbar dari hash, menu mobile, paket, cek jangkauan, dan animasi masuk. */
  class KonekTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private active = "home";
    private tab = "";
    private stopReveal = () => {};
    private readonly onHashChange = () => this.syncHash();
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && (event.target as Element).closest("#konek-menu"))
        this.toggleMenu(false);
    };
    private readonly onChange = (event: Event) => {
      if ((event.target as Element).matches("[data-konek-boost]")) this.renderPlans();
    };
    private readonly onSubmit = (event: Event) => {
      if (!(event.target as Element).matches("[data-konek-coverage]")) return;
      event.preventDefault();
      this.check(this.cityField.value);
    };

    connectedCallback() {
      this.tab = this.config.tabs[0]!.id;
      this.syncHash();
      this.stopReveal = this.startReveal();
      window.addEventListener("hashchange", this.onHashChange);
      this.addEventListener("click", this.onClick);
      this.addEventListener("keydown", this.onKeydown);
      this.addEventListener("change", this.onChange);
      this.addEventListener("submit", this.onSubmit);
    }

    disconnectedCallback() {
      this.stopReveal();
      window.removeEventListener("hashchange", this.onHashChange);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("keydown", this.onKeydown);
      this.removeEventListener("change", this.onChange);
      this.removeEventListener("submit", this.onSubmit);
    }

    private get cityField() {
      return this.querySelector<HTMLInputElement>("#konek-city")!;
    }

    /** Tampilkan elemen data-reveal saat masuk layar; dilewati saat reduced motion. */
    private startReveal() {
      const root = this.firstElementChild as HTMLElement;
      if (
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        !("IntersectionObserver" in window)
      )
        return () => {};
      root.dataset.motion = "on";
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute("data-shown", "");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      root.querySelectorAll("[data-reveal]").forEach((item) => observer.observe(item));
      return () => observer.disconnect();
    }

    /** Section aktif dibaca dari hash URL, sama seperti versi React. */
    private syncHash() {
      const id = window.location.hash.slice(1);
      this.active = this.config.sectionIds.includes(id) ? id : "home";
      this.querySelectorAll<HTMLElement>("[data-konek-nav]").forEach((link) =>
        setClasses(link, link.dataset.konekNav === this.active, this.config.nav),
      );
      this.querySelectorAll<HTMLElement>("[data-konek-nav], [data-konek-menu-link]").forEach(
        (link) => {
          const id = link.dataset.konekNav ?? link.dataset.konekMenuLink;
          if (id === this.active) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        },
      );
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      if (target.closest("[data-konek-menu-toggle]"))
        return this.toggleMenu(!document.getElementById("konek-menu"));
      if (target.closest("[data-konek-menu-link]")) return this.toggleMenu(false);
      if (target.closest("[data-konek-app]"))
        return toast({
          title: "Get the Konek app",
          description: "Search for Konek in the App Store or Google Play.",
        });
      if (target.closest("[data-konek-sim]"))
        return toast({
          title: "SIM card on its way",
          description: "Free delivery in 1 to 2 days anywhere in Indonesia.",
          variant: "success",
        });
      const tab = target.closest<HTMLElement>("[data-konek-tab]");
      if (tab) return this.selectTab(tab.dataset.konekTab!);
      const choose = target.closest<HTMLElement>("[data-konek-choose]");
      if (choose) return this.choosePlan(choose.dataset.konekChoose!);
      const city = target.closest<HTMLElement>("[data-konek-city]");
      if (city) this.check(city.dataset.konekCity!);
    }

    /** Menu mobile dipasang dari <template> saat dibuka dan dilepas saat ditutup. */
    private toggleMenu(open: boolean) {
      const button = this.querySelector<HTMLElement>("[data-konek-menu-toggle]")!;
      document.getElementById("konek-menu")?.remove();
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      button
        .querySelector("path")
        ?.setAttribute("d", this.config.icons[open ? "close" : "menu"]);
      if (!open) return;
      const template = this.querySelector<HTMLTemplateElement>("template[data-konek-menu]")!;
      template.after(template.content.cloneNode(true));
      this.syncHash();
    }

    private get boost() {
      return this.querySelector<HTMLInputElement>("[data-konek-boost]")!.checked;
    }

    private selectTab(id: string) {
      this.tab = id;
      this.querySelectorAll<HTMLElement>("[data-konek-tab]").forEach((button) => {
        const on = button.dataset.konekTab === id;
        button.setAttribute("aria-pressed", String(on));
        setClasses(button, on, this.config.tab);
      });
      const template = this.querySelector<HTMLTemplateElement>(
        `template[data-konek-tab-plans="${id}"]`,
      )!;
      const list = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      // Klon baru belum diamati observer reveal, jadi langsung tampil.
      list.setAttribute("data-shown", "");
      this.querySelector("[data-konek-plans]")!.replaceWith(list);
      const tab = this.config.tabs.find((item) => item.id === id)!;
      this.querySelector("[data-konek-boost-label]")!.textContent = tab.boost;
      this.renderPlans();
    }

    /** Kuota dan harga mengikuti switch boost. */
    private renderPlans() {
      const boost = this.boost;
      const plans = this.config.plans[this.tab]!;
      this.querySelectorAll<HTMLElement>("[data-konek-plans] > li").forEach((item) => {
        const plan = plans.find((entry) => entry.name === item.dataset.plan)!;
        item.querySelector("[data-konek-amount]")!.textContent = boost
          ? plan.boosted
          : plan.amount;
        item.querySelector("[data-konek-price]")!.textContent = boost
          ? plan.boostedPrice
          : plan.price;
      });
    }

    private choosePlan(name: string) {
      const boost = this.boost;
      const plan = this.config.plans[this.tab]!.find((item) => item.name === name)!;
      const tab = this.config.tabs.find((item) => item.id === this.tab)!;
      toast({
        title: `${plan.name} plan selected`,
        description: `${boost ? plan.boosted : plan.amount} for ${boost ? plan.boostedPrice : plan.price}${tab.period}.`,
        variant: "success",
      });
    }

    private check(name: string) {
      const trimmed = name.trim();
      const field = this.cityField;
      const error = this.querySelector<HTMLElement>("#konek-city-error")!;
      const found = this.querySelectorAll<HTMLElement>("[data-konek-found]");
      const empty = this.querySelectorAll<HTMLElement>("[data-konek-empty]");
      if (!trimmed) {
        error.textContent = "Enter a city name, like Jakarta.";
        error.hidden = false;
        field.setAttribute("aria-invalid", "true");
        field.setAttribute("aria-describedby", error.id);
        found.forEach((node) => (node.hidden = true));
        empty.forEach((node) => (node.hidden = false));
        return;
      }
      const coverage =
        this.config.coverage[trimmed.toLowerCase()] ?? this.config.fallback;
      error.textContent = "";
      error.hidden = true;
      field.removeAttribute("aria-invalid");
      field.removeAttribute("aria-describedby");
      field.value = trimmed;
      found.forEach((node) => (node.hidden = false));
      empty.forEach((node) => (node.hidden = true));
      this.querySelector("[data-result]")!.textContent = trimmed;
      this.querySelector("[data-konek-network]")!.textContent = coverage.network;
      this.querySelector("[data-konek-speed]")!.textContent = coverage.speed;
      this.querySelector("[data-konek-home]")!.textContent = coverage.home;
      this.querySelectorAll("[data-konek-bar]").forEach((bar, index) => {
        const lit = index < coverage.bars;
        bar.classList.toggle("bg-primary", lit);
        bar.classList.toggle("bg-line", !lit);
      });
      toast({
        title: "Coverage checked",
        description: `${coverage.network} in ${trimmed}, ${coverage.speed.toLowerCase()}.`,
      });
    }
  }

  if (!customElements.get("konek-template"))
    customElements.define("konek-template", KonekTemplate);
</script>
