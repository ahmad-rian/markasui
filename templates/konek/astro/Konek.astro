const footerColumns = [
  {
    title: "Products",
    links: ["Prepaid", "Postpaid", "Home internet", "eSIM"],
  },
  { title: "Company", links: ["About", "Investors", "Careers", "Newsroom"] },
  {
    title: "Support",
    links: ["Help center", "Store locator", "Network status", "Contact"],
  },
];


const icon = (name: IconName, className: string) =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}"></path></svg>`;
const firstTab = tabs[0]!;
const arts = [
  { art: catArt, side: "lg:left-4" },
  { art: dogArt, side: "lg:right-4" },
];

/** Data dan class yang dipakai script di klien. */
const config = JSON.stringify({
  sectionIds,
  icons: { menu: icons.menu, close: icons.close },
  nav: [navOn, navIdle],
  tab: [tabOn, tabIdle],
  tabs,
  plans,
  coverage: coverageByCity,
  fallback: fallbackCoverage,
