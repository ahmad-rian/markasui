  ] },
];
const reps = ["Budi Santoso", "Dewi Lestari", "Agus Pratama", "Fajar Nugroho"];

/* Files */
// prettier-ignore
const files = [
  { name: "Cloud migration proposal.pdf", kind: "PDF", size: "2.4 MB", updated: "Nov 4", owner: "Budi Santoso" },
  { name: "Q4 pipeline forecast.xlsx", kind: "XLSX", size: "860 KB", updated: "Nov 3", owner: "Dewi Lestari" },
  { name: "Master service agreement.docx", kind: "DOCX", size: "1.1 MB", updated: "Nov 1", owner: "Agus Pratama" },
  { name: "Expo Jakarta leads.csv", kind: "CSV", size: "148 KB", updated: "Oct 30", owner: "Sari Wulandari" },
  { name: "Brand guidelines.pdf", kind: "PDF", size: "6.8 MB", updated: "Oct 27", owner: "Andi Wijaya" },
  { name: "Onsite demo photos.zip", kind: "ZIP", size: "24.5 MB", updated: "Oct 24", owner: "Fajar Nugroho" },
  { name: "Pricing sheet 2027.xlsx", kind: "XLSX", size: "312 KB", updated: "Oct 22", owner: "Dewi Lestari" },
  { name: "QBR presentation.pptx", kind: "PPTX", size: "9.2 MB", updated: "Oct 20", owner: "Budi Santoso" },
];
// prettier-ignore
const kindColors: Record<string, string> = {
  PDF: "bg-danger/15", XLSX: "bg-success/15", CSV: "bg-success/15", DOCX: "bg-primary-soft", PPTX: "bg-warning/20", ZIP: "bg-subtle",
};
// prettier-ignore
const viewOptions: { value: "grid" | "list"; ariaLabel: string }[] = [
  { value: "grid", ariaLabel: "Grid view" }, { value: "list", ariaLabel: "List view" },
];

/* Settings */
// prettier-ignore
const initialProfile = { firstName: "Andi", lastName: "Wijaya", email: "andi.wijaya@lumen.co.id", phone: "+62 812 7788 9900", role: "Sales manager" };
type Profile = typeof initialProfile;
// prettier-ignore
const profileFields: { key: keyof Profile; label: string; type: string }[] = [
  { key: "firstName", label: "First name", type: "text" }, { key: "lastName", label: "Last name", type: "text" },
  { key: "email", label: "Email", type: "email" }, { key: "phone", label: "Phone", type: "tel" },
];
const roles = ["Account executive", "Sales manager", "Head of sales"];
// prettier-ignore
const notificationOptions = [
  { key: "deals", label: "Deal stage changes", description: "When a deal moves to another stage" },
  { key: "invoices", label: "Invoice reminders", description: "Overdue and upcoming invoices" },
  { key: "mentions", label: "Mentions", description: "When a teammate mentions you" },
  { key: "weekly", label: "Weekly report", description: "Summary every Monday at 08:00" },
];
const DEFAULT_PREFS = ["deals", "invoices", "mentions"];

const iconButton =
  "relative inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-line bg-surface text-ink transition-colors duration-150 hover:bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const pillBase =
  "inline-flex h-9 items-center rounded-full px-4 text-sm font-medium transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const navActive = "bg-primary text-on-primary";
const pillIdle = "text-muted hover:bg-surface hover:text-ink";
const railBase =
  "inline-flex size-10 items-center justify-center rounded-xl transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const railIdle = "text-muted hover:bg-subtle hover:text-ink";
// Label rail muncul saat hover atau fokus keyboard, cukup dengan CSS.
const railTip =
  "pointer-events-none absolute top-1/2 left-full z-30 ml-3 -translate-y-1/2 rounded-md bg-ink px-2 py-1 text-xs font-medium whitespace-nowrap text-canvas opacity-0 shadow-overlay transition-opacity duration-150 group-hover:opacity-100 group-has-focus-visible:opacity-100";
const menuItemBase =
  "flex h-10 w-full items-center gap-3 rounded-lg px-3 text-left text-sm font-medium transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const menuItemIdle = "text-ink hover:bg-subtle";
const tile = "rounded-xl border border-line bg-surface px-4 py-3";
const selectable =
  "text-left after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-primary";
const listRow =
  "relative flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors duration-150";
const dealBase =
  "relative flex min-h-44 flex-col gap-3 rounded-2xl border p-4 transition-colors duration-150";
const dealIdle = "border-line bg-surface hover:border-primary-line";
const dealSelected =
  "border-primary bg-primary text-on-primary [&_[role=img]]:ring-primary";
const kanbanCard =
  "relative grid gap-3 rounded-xl border bg-surface p-3 transition-colors duration-150";
const projectRow =
  "grid w-full gap-3 rounded-xl px-3 py-4 text-left transition-colors duration-150 hover:bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:grid-cols-[minmax(0,1fr)_120px_minmax(0,260px)_140px] md:items-center";
const dayCell =
  "flex min-h-14 flex-col items-start gap-1 p-1.5 text-left transition-colors duration-150 hover:bg-subtle focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary sm:min-h-24 sm:p-2";
const dayNumber =
  "inline-flex size-6 items-center justify-center rounded-full text-xs font-medium tabular-nums";
const chip = "truncate rounded-md px-1.5 py-0.5 text-xs font-medium";
const tableWrap =
  "relative overflow-x-auto rounded-xl contain-inline-size border border-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const th = "px-4 py-3 font-medium whitespace-nowrap";
const td = "px-4 py-2 whitespace-nowrap";
const thButton =
  "inline-flex items-center gap-1 rounded-md font-medium hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const fileKind =
  "inline-flex h-10 w-12 shrink-0 items-center justify-center rounded-lg text-xs font-semibold";
// prettier-ignore
const fileViews = {
  grid: { list: "grid gap-3 sm:grid-cols-2 xl:grid-cols-4", item: "grid gap-3 rounded-xl border border-line bg-surface p-4" },
  list: { list: "grid gap-2", item: "flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3" },
};

const cx = (...c: (string | false | null | undefined)[]) =>
  c.filter(Boolean).join(" ");
const rupiah = (value: number) => `Rp ${value.toLocaleString("id-ID")}`;
const formatNumber = (value: number) => value.toLocaleString("id-ID");
const percentOf = (value: number, max: number) =>
  Math.round((value / max) * 100);
const plural = (count: number, word: string) =>
  `${count} ${word}${count === 1 ? "" : "s"}`;

function shortDate(iso: string) {
  const [year = 0, month = 1, day = 1] = iso.split("-").map(Number);
  return `${monthNames[month - 1]?.slice(0, 3)} ${day}, ${year}`;
}

function longDate(iso: string) {
  const [year = 0, month = 1, day = 1] = iso.split("-").map(Number);
  const weekday = weekdayNames[new Date(year, month - 1, day).getDay()];
  return `${weekday}, ${monthNames[month - 1]} ${day}`;
}



type Row = [string, string];
type Bar = { label: string; value: number };

const icon = (name: IconName, className = "size-5") =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}"></path></svg>`;
const pageIds = Object.keys(pages) as PageId[];
/** Halaman bawaan dirender langsung (tanpa JS tetap tampil), lalu semua halaman sebagai <template>. */
const views = [
  { live: true, id: DEFAULT_PAGE },
  ...pageIds.map((id) => ({ live: false, id })),
];
const current = (id: PageId) => (id === DEFAULT_PAGE ? "page" : undefined);
const badgeVariants: Variant[] = [
  "neutral",
  "primary",
  "success",
  "warning",
  "danger",
];
const percent = percentOf(TARGET.value, TARGET.goal);
const firstCustomer = customerList[0]!;
const firstDeal = pipeline[0]!;
const firstProject = projects[0]!;
const overdue = invoices.filter((invoice) => invoice.status === "Overdue");
const invoicesByDue = [...invoices].sort((a, b) => a.due.localeCompare(b.due));
const todayEvents = initialEvents[TODAY] ?? [];

/** Data dan class yang dipakai script di klien. */
const config = JSON.stringify({
  defaultPage: DEFAULT_PAGE,
  titleId: TITLE_ID,
  pages,
  navActive,
  navIdle: { pill: pillIdle, rail: railIdle, menu: menuItemIdle },
  customers: customerList,
  tierVariant,
  history: history.map(({ id, date, value }) => ({ id, date, value })),
  sortLabels: Object.fromEntries(
    sortOptions.map((option) => [option.value, option.label]),
  ),
  dealSelected,
  dealIdle,
  pipeline: pipeline.map(({ id, value, stage }) => ({ id, value, stage })),
  deals: Object.fromEntries(
    pipeline.map((deal) => [
      deal.id,
      {
        title: deal.title,
        company: deal.company,
        value: rupiah(deal.value),
        owner: deal.owner,
        due: deal.due,
      },
    ]),
  ),
  invoices: Object.fromEntries(
    invoices.map((invoice) => [
      invoice.id,
      {
        customer: invoice.customer,
        due: invoice.due,
        amount: invoice.amount,
      },
    ]),
  ),
  sortIcons: { active: icons.up, idle: icons.sort },
  overdueText: `${overdue.length} overdue invoices, ${rupiah(overdue.reduce((sum, item) => sum + item.amount, 0))}`,
  projects: Object.fromEntries(
    projects.map((project) => [
      project.id,
      {
        name: project.name,
        client: project.client,
        progress: project.progress,
        rows: [
          ["Status", projectStatus[project.status]!.label],
          ["Lead", project.lead],
          ["Due date", project.due],
          ["Budget", rupiah(project.budget)],
          ["Tasks", project.tasks],
        ],
      },
    ]),
  ),
  projectStatus: Object.fromEntries(
    projects.map((project) => [project.id, project.status]),
  ),
  events: initialEvents,
  today: TODAY,
  monthNames,
  weekdays,
  weekdayNames,
  kindTones,
  dayCell,
  dayNumber,
  chip,
  reportLabels: Object.fromEntries(
    reportPeriods.map((period) => [period.value, period.label]),
  ),
  fileViews,
});
---

<lumen-template class="contents" data-config={config}>
  <div class="min-h-dvh bg-canvas text-ink">
    <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-line bg-surface px-4 lg:px-6">
      <Drawer title="Menu" side="left">
        <button slot="trigger" type="button" aria-label="Open menu" class={cx(iconButton, "lg:hidden")} set:html={icon("menu")} />
        <form method="dialog" class="grid gap-6">
          <div class="grid gap-1">
            <p class="px-3 text-xs font-medium text-muted">Pages</p>
            {topNav.map((id) => <button type="submit" data-lumen-go={id} data-lumen-nav="menu" aria-current={current(id)} class={cx(menuItemBase, id === DEFAULT_PAGE ? navActive : menuItemIdle)}>{pages[id].label}</button>)}
          </div>
          <div class="grid gap-1">
            <p class="px-3 text-xs font-medium text-muted">Workspace</p>
            {railNav.map((item) => <button type="submit" data-lumen-go={item.id} data-lumen-nav="menu" aria-current={current(item.id)} class={cx(menuItemBase, item.id === DEFAULT_PAGE ? navActive : menuItemIdle)}><Fragment set:html={icon(item.icon)} />{pages[item.id].label}</button>)}
          </div>
        </form>
      </Drawer>
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary text-sm font-semibold text-on-primary" aria-hidden="true">L</span>
        <div class="min-w-0 leading-tight">
          <p class="flex items-center gap-1.5 text-base font-semibold tracking-tight">Lumen<span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span></p>
          <p class="truncate text-xs text-muted">Sales workspace</p>
        </div>
      </div>
      <nav aria-label="Main" class="mx-auto hidden items-center gap-1 rounded-full border border-line bg-canvas p-1 lg:flex">
        {topNav.map((id) => <button type="button" data-lumen-go={id} data-lumen-nav="pill" aria-current={current(id)} class={cx(pillBase, id === DEFAULT_PAGE ? navActive : pillIdle)}>{pages[id].label}</button>)}
      </nav>
      <div class="ml-auto flex items-center gap-2 lg:ml-0">
        <button type="button" aria-label="Messages" class={iconButton} data-lumen-toast-title="No new messages" data-lumen-toast-text="Inbox is up to date" set:html={icon("message")} />
        <button type="button" aria-label="Notifications, 3 unread" class={iconButton} data-lumen-toast-title="3 unread notifications" data-lumen-toast-text="Rina Kusuma replied to your proposal"><Fragment set:html={icon("bell")} /><span class="absolute top-2 right-2.5 size-2 rounded-full bg-danger ring-2 ring-surface" aria-hidden="true"></span></button>
        <Avatar name="Andi Wijaya" size="md" class="ml-1" />
      </div>
    </header>

    <div class="flex">
      <div class="hidden w-18 shrink-0 border-r border-line bg-surface lg:block">
        <nav aria-label="Workspace" class="sticky top-16 z-10 flex h-[calc(100dvh-4rem)] flex-col items-center gap-2 py-4">
          {
            railNav.map((item) => (
              <span class={cx("group relative inline-flex", item.id === "settings" && "mt-auto")}>
                <button type="button" data-lumen-go={item.id} data-lumen-nav="rail" aria-label={pages[item.id].label} aria-current={current(item.id)} class={cx(railBase, item.id === DEFAULT_PAGE ? navActive : railIdle)} set:html={icon(item.icon)} />
                <span aria-hidden="true" class={railTip}>{pages[item.id].label}</span>
              </span>
            ))
          }
        </nav>
      </div>

      <main class="min-w-0 flex-1 p-4 lg:p-6">
        <div class="mb-6">
          <p class="text-sm text-muted" data-lumen-crumb>Lumen / {pages[DEFAULT_PAGE].label}</p>
          <h1 id={TITLE_ID} tabindex="-1" class="text-2xl font-semibold tracking-tight focus:outline-none">{pages[DEFAULT_PAGE].title}</h1>
        </div>
        {
          views.map(({ live, id }) => {
            const Wrapper = live ? "div" : "template";
            const panel = (labelId: string, heading: string, sub: string, body: unknown, className?: string, action?: unknown) => (
              <Card aria-labelledby={labelId} class={className}>
                <div class="grid gap-4">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <h2 id={labelId} class="text-base font-semibold">{heading}</h2>
                      <p class="text-sm text-muted">{sub}</p>
                    </div>
                    {action}
                  </div>
                  {body}
                </div>
              </Card>
            );
            const statTiles = (items: Stat[], className: string) => (
              <dl class={cx("grid gap-3", className)}>
                {items.map((stat) => (
                  <div class={tile}>
                    <dt class="text-xs text-muted">{stat.label}</dt>
                    <dd class="mt-1 flex flex-wrap items-center gap-2">
                      <span class="text-lg font-semibold tracking-tight tabular-nums">{stat.value}</span>
                      {stat.badge && <Badge variant={stat.variant ?? "success"}>{stat.badge}</Badge>}
                    </dd>
                    {stat.note && <dd class="text-xs text-muted">{stat.note}</dd>}
                  </div>
                ))}
              </dl>
            );
            const details = (rows: Row[]) => (
              <dl class="divide-y divide-line">
                {rows.map(([label, value]) => (
                  <div class="flex items-center justify-between gap-4 py-3">
                    <dt class="shrink-0 text-muted">{label}</dt>
                    <dd class="min-w-0 truncate text-right font-medium" data-lumen-detail={label}>{value}</dd>
                  </div>
                ))}
              </dl>
            );
            const barChart = (bars: Bar[], label: string) => {
              const peak = Math.max(...bars.map((bar) => bar.value));
              return (
                <div role="img" aria-label={`${label}: ${bars.map((bar) => `${bar.label} Rp ${bar.value} million`).join(", ")}`} class="flex h-56 items-stretch gap-2 sm:gap-3">
                  {bars.map((bar, index) => (
                    <div data-bar class="flex min-w-0 flex-1 flex-col gap-2">
                      <div class="relative flex-1">
                        <span class="absolute inset-x-0 hidden text-center text-xs font-medium tabular-nums sm:block" style={`bottom: calc(${percentOf(bar.value, peak)}% + 4px)`}>{bar.value}</span>
                        <div class={cx("absolute inset-x-0 bottom-0 rounded-md", index === bars.length - 1 ? "bg-primary" : "bg-primary/30")} style={`height: ${percentOf(bar.value, peak)}%`} />
                      </div>
                      <span class="truncate text-center text-xs text-muted">{bar.label}</span>
                    </div>
                  ))}
                </div>
              );
            };
            const report = (period: (typeof reportPeriods)[number]) => {
              const repPeak = Math.max(...period.reps);
              return (
                <>
                  {statTiles(period.kpis, "sm:grid-cols-3")}
                  <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
                    {panel("crm-report-chart", "Revenue", `${period.label}, in million Rupiah`, barChart(period.bars, `Revenue ${period.label}`))}
                    {panel("crm-report-reps", "Top sales reps", "Revenue in million Rupiah", (
                      <ol class="grid gap-4">
                        {reps.map((rep, index) => (
                          <li class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1.5">
                            <Avatar name={rep} size="sm" class="row-span-2" />
                            <span class="truncate font-medium">{rep}</span>
                            <span class="font-semibold tabular-nums">{formatNumber(period.reps[index]!)}</span>
                            <div class="col-span-2 h-1.5 rounded-full bg-subtle">
                              <div class="h-1.5 rounded-full bg-primary" style={`width: ${percentOf(period.reps[index]!, repPeak)}%`} />
                            </div>
                          </li>
                        ))}
                      </ol>
                    ), "content-start")}
                  </div>
                </>
              );
            };
            return (
              <Wrapper class={live ? "contents" : undefined} data-lumen-view={live ? "" : undefined} data-lumen-page={live ? undefined : id}>
                {id === "home" && (
                  <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_380px]">
                    <div class="grid content-start gap-6">
                      {panel("crm-target-title", "Monthly target", "November 2026", (
                        <div class="grid items-center gap-6 sm:grid-cols-[160px_minmax(0,1fr)]">
                          <div role="img" aria-label={`${percent}% of the monthly revenue target reached`} class="relative mx-auto size-40">
                            <svg viewBox="0 0 120 120" class="size-40 -rotate-90" aria-hidden="true">
                              <circle cx="60" cy="60" r="52" fill="none" stroke-width="12" class="stroke-subtle" />
                              <circle cx="60" cy="60" r="52" fill="none" stroke-width="12" stroke-linecap="round" pathLength="100" stroke-dasharray={`${percent} 100`} class="stroke-primary" />
                            </svg>
                            <div class="absolute inset-0 grid place-content-center text-center">
                              <span class="text-3xl font-semibold tracking-tight tabular-nums">{percent}%</span>
                              <span class="text-xs text-muted">of target</span>
                            </div>
                          </div>
                          <div class="grid gap-4">
                            <div>
                              <p class="text-2xl font-semibold tracking-tight tabular-nums">{rupiah(TARGET.value)}</p>
                              <p class="text-sm text-muted">of {rupiah(TARGET.goal)}, {rupiah(TARGET.goal - TARGET.value)} to go</p>
                            </div>
                            {goals.map((goal) => <Progress label={goal.label} value={goal.value} max={goal.max} />)}
                          </div>
                        </div>
                      ))}
                      {panel("crm-activity-title", "Recent activity", "Latest updates from your team", (
                        <ol class="grid gap-4">
                          {activity.map((item) => (
                            <li class="flex items-start gap-3">
                              <Avatar name={item.who} size="sm" />
                              <div class="min-w-0 flex-1">
                                <p><span class="font-medium">{item.who}</span> {item.what}</p>
                                <p class="text-xs text-muted">{item.when}</p>
                              </div>
                            </li>
                          ))}
                        </ol>
                      ))}
                    </div>
                    {panel("crm-today-title", "Today's tasks", `${DONE_TASKS.length} of ${todayTasks.length} done`, (
                      <>
                        <Progress value={DONE_TASKS.length} max={todayTasks.length} aria-label="Tasks completed" data-lumen-tasks-progress />
                        <ul class="grid gap-3">
                          {todayTasks.map((task) => (
                            <li class="rounded-xl border border-line p-3">
                              <Checkbox label={task.title} description={task.time} checked={DONE_TASKS.includes(task.id)} data-lumen-task />
                            </li>
                          ))}
                        </ul>
                      </>
                    ), "content-start")}
                  </div>
                )}

                {id === "customers" && (
                  <div class="grid gap-6">
                    {statTiles(stats, "sm:grid-cols-3")}
                    <div class="grid items-start gap-6 xl:grid-cols-[260px_minmax(0,1fr)_360px]">
                      {panel("crm-list-title", "Customers", `${customerList.length} accounts`, (
                        <ul class="-mx-3 grid gap-1">
                          {customerList.map((item) => (
                            <li class={cx(listRow, item.id === firstCustomer.id ? "bg-primary-soft" : "hover:bg-subtle")} data-lumen-customer={item.id}>
                              <Avatar name={`${item.firstName} ${item.lastName}`} size="sm" />
                              <div class="min-w-0 flex-1">
                                <button type="button" aria-pressed={item.id === firstCustomer.id ? "true" : "false"} class={cx(selectable, "block truncate text-sm font-medium")} data-lumen-pick-customer={item.id}>{item.firstName} {item.lastName}</button>
                                <p class="truncate text-xs text-muted">{item.company}</p>
                              </div>
                            </li>
                          ))}
                        </ul>
                      ), "content-start")}

                      <div class="grid gap-6">
                        {panel("crm-history-title", "Interaction history", `${history.length} deals with ${firstCustomer.firstName} this quarter`, (
                          <ul role="list" class="grid gap-4 sm:grid-cols-2" data-lumen-history>
                            {[...history].sort(sorters.newest).map((deal) => {
                              const selected = deal.id === "d1";
                              const muted = selected ? "text-on-primary/80" : "text-muted";
                              return (
                                <li data-deal={deal.id} class={cx(dealBase, selected ? dealSelected : dealIdle)}>
                                  <time datetime={deal.date} class={cx("text-xs font-medium", muted)} data-lumen-muted>{shortDate(deal.date)}</time>
                                  <h3 class="text-sm leading-snug font-semibold">
                                    <button type="button" aria-pressed={selected ? "true" : "false"} class={selectable} data-lumen-pick-history={deal.id}>{deal.title}</button>
                                  </h3>
                                  <p class="mt-auto text-xl font-semibold tracking-tight tabular-nums">{rupiah(deal.value)}</p>
                                  <div class="flex items-center justify-between gap-2">
                                    <div class="flex -space-x-1">
                                      {deal.team.map((member) => <Avatar name={member} size="sm" class="ring-2 ring-surface" />)}
                                    </div>
                                    <span class={cx("text-xs font-medium", muted)} data-lumen-muted>{deal.stage}</span>
                                  </div>
                                </li>
                              );
                            })}
                          </ul>
                        ), "content-start", (
                          <DropdownMenu items={sortOptions} data-lumen-sort>
                            <Fragment slot="trigger"><span class="text-muted">Sort:</span><span data-lumen-sort-label>{sortOptions[0]!.label}</span></Fragment>
                          </DropdownMenu>
                        ))}
                        {panel("crm-funnel-title", "Stage funnel", "Open pipeline by stage", (
                          <Tabs defaultValue="weighted" items={funnel.map(({ value, label }) => ({ value, label }))}>
                            {funnel.map((mode) => (
                              <div slot={mode.value} class="grid gap-4">
                                <div>
                                  <p class="text-2xl font-semibold tracking-tight tabular-nums">{mode.total}</p>
                                  <p class="text-xs text-muted">{mode.caption}</p>
                                </div>
                                <ol class="grid gap-3" aria-label={`${mode.caption} by stage`}>
                                  {mode.steps.map((step, index) => (
                                    <li class="grid gap-1.5">
                                      <div class="flex items-baseline justify-between gap-3">
                                        <span class="font-medium">{step.label}<span class="ml-2 text-xs font-normal text-muted">{step.deals} deals</span></span>
                                        <span class="font-semibold tabular-nums">{step.value}</span>
                                      </div>
                                      <div class="h-6 rounded-md bg-subtle">
                                        <div class={cx("mx-auto h-6 rounded-md", barTones[index])} style={`width: ${step.width}%`} />
                                      </div>
                                    </li>
                                  ))}
                                </ol>
                              </div>
                            ))}
                          </Tabs>
                        ))}
                      </div>

                      <div class="grid content-start gap-6">
                        <Card aria-labelledby="crm-profile-name">
                          <div class="grid justify-items-center gap-4 text-center" data-lumen-profile>
                            <Avatar name={`${firstCustomer.firstName} ${firstCustomer.lastName}`} size="lg" class="size-16! text-xl!" />
                            <div class="grid gap-1">
                              <h2 id="crm-profile-name" class="text-lg font-semibold">{firstCustomer.firstName} {firstCustomer.lastName}</h2>
                              <p class="text-sm text-muted" data-lumen-role>{firstCustomer.role}</p>
                              <p class="flex flex-wrap items-center justify-center gap-2 text-sm font-medium" data-lumen-company>{firstCustomer.company}<Badge variant={tierVariant[firstCustomer.tier]}>{firstCustomer.tier}</Badge></p>
                            </div>
                            <div class="flex justify-center gap-3">
                              {profileActions.map((action) => <button type="button" aria-label={action.label} class={iconButton} data-lumen-profile-action={action.label} set:html={icon(action.icon)} />)}
                            </div>
                          </div>
                        </Card>

                        {panel("crm-details-title", "Detailed information", `Updated ${firstCustomer.lastContacted}`, details(infoRows.map((row): Row => [row.label, firstCustomer[row.key]])), undefined, (
                          <Drawer title="Edit customer details" data-lumen-edit-drawer>
                            <Button slot="trigger" variant="secondary" size="sm" data-lumen-edit><Fragment set:html={icon("pencil", "size-4")} />Edit</Button>
                            <div class="grid gap-4">
                              {formFields.map((field) => <Input label={field.label} type={field.type as "text" | "email" | "tel"} name={field.key} value={firstCustomer[field.key]} />)}
                            </div>
                            <Fragment slot="footer">
                              <Button variant="secondary" type="submit" value="cancel">Cancel</Button>
                              <Button type="submit" value="save">Save changes</Button>
                            </Fragment>
                          </Drawer>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                {id === "deals" && (
                  <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_300px]">
                    <div class="grid content-start gap-4 md:grid-cols-2 lg:grid-cols-4">
                      {stages.map((stage) => {
                        const column = pipeline.filter((item) => item.stage === stage);
                        return (
                          <section aria-labelledby={`crm-stage-${stage}`} data-stage={stage} class="grid content-start gap-3 rounded-2xl bg-subtle p-3">
                            <div class="px-1">
                              <h2 id={`crm-stage-${stage}`} class="flex items-center justify-between gap-2 text-sm font-semibold">{stage}<span class="rounded-full bg-surface px-2 text-xs font-medium tabular-nums" data-lumen-count>{column.length}</span></h2>
                              <p data-total class="text-xs text-muted tabular-nums">{rupiah(column.reduce((sum, item) => sum + item.value, 0))}</p>
                            </div>
                            {column.map((item) => (
                              <article class={cx(kanbanCard, item.id === firstDeal.id ? "border-primary ring-1 ring-primary" : "border-line hover:border-primary-line")} data-lumen-deal={item.id}>
                                <h3 class="text-sm leading-snug font-semibold">
                                  <button type="button" aria-pressed={item.id === firstDeal.id ? "true" : "false"} class={selectable} data-lumen-pick-deal={item.id}>{item.title}</button>
                                </h3>
                                <p class="-mt-2 truncate text-xs text-muted">{item.company}</p>
                                <div class="flex items-center justify-between gap-2">
                                  <span class="text-sm font-semibold tabular-nums">{rupiah(item.value)}</span>
                                  <Avatar name={item.owner} size="sm" class="size-6! text-[10px]!" />
                                </div>
                              </article>
                            ))}
                            <p class="rounded-xl border border-dashed border-line p-3 text-center text-xs text-muted" data-lumen-empty hidden={column.length > 0}>No deals</p>
                          </section>
                        );
                      })}
                    </div>
                    {panel("crm-deal-title", "Deal details", firstDeal.company, (
                      <>
                        <div class="grid gap-1">
                          <p class="font-semibold" data-lumen-deal-title>{firstDeal.title}</p>
                          <p class="text-2xl font-semibold tracking-tight tabular-nums" data-lumen-deal-value>{rupiah(firstDeal.value)}</p>
                        </div>
                        {details([["Stage", firstDeal.stage], ["Owner", firstDeal.owner], ["Expected close", firstDeal.due]])}
                        <DropdownMenu items={stageItems} label="Move to stage" class="[&>button]:w-full" data-lumen-move />
                      </>
                    ), "content-start")}
                  </div>
                )}

                {id === "finance" && (
                  <div class="grid gap-6">
                    {statTiles(financeStats, "sm:grid-cols-2 xl:grid-cols-4")}
                    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
                      {panel("crm-invoices-title", "Invoices", "Sort by customer, due date, or amount", (
                        <div tabindex="0" role="region" aria-label="Invoices" class={tableWrap}>
                          <table class="w-full border-collapse text-sm">
                            <thead>
                              <tr class="bg-subtle text-left text-muted">
                                <th scope="col" class={th}>Invoice</th>
                                {invoiceColumns.map((column) => {
                                  const active = column.key === "due";
                                  return (
                                    <th scope="col" aria-sort={active ? "ascending" : undefined} class={cx(th, column.align)} data-lumen-column={column.key}>
                                      <button type="button" class={thButton} data-lumen-sort-by={column.key}>{column.label}<Fragment set:html={icon(active ? "up" : "sort", "size-3.5")} /></button>
                                    </th>
                                  );
                                })}
                                <th scope="col" class={th}>Status</th>
                                <th scope="col" class={th}><span class="sr-only">Actions</span></th>
                              </tr>
                            </thead>
                            <tbody>
                              {invoicesByDue.map((invoice) => (
                                <tr data-row={invoice.id} class="h-14 border-t border-line hover:bg-subtle/50">
                                  <td class={cx(td, "font-medium")}>{invoice.id}</td>
                                  <td class={td}>{invoice.customer}</td>
                                  <td class={cx(td, "text-muted")}>{shortDate(invoice.due)}</td>
                                  <td class={cx(td, "text-right font-medium tabular-nums")}>{rupiah(invoice.amount)}</td>
                                  <td class={td}><Badge variant={statusVariant[invoice.status]}>{invoice.status}</Badge></td>
                                  <td class={cx(td, "text-right")}>{invoice.status !== "Paid" && <Button variant="ghost" size="sm" aria-label={`Remind ${invoice.id}`} data-lumen-remind={invoice.id}>Remind</Button>}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      ), undefined, (
                        <Button size="sm" data-lumen-remind-all><Fragment set:html={icon("send", "size-4")} />Send reminders</Button>
                      ))}
                      {panel("crm-revenue-title", "Revenue", "Last 6 months, in million Rupiah", (
                        <>
                          {barChart(revenue, "Monthly revenue")}
                          <p class="text-sm text-muted">November is <span class="font-semibold text-ink">12.4%</span> above October.</p>
                        </>
                      ), "content-start")}
                    </div>
                  </div>
                )}

                {id === "growth" && (
                  <Tabs defaultValue="30d" items={growthPeriods.map(({ value, label }) => ({ value, label }))}>
                    {growthPeriods.map((period) => (
                      <div slot={period.value} class="grid gap-6">
                        {statTiles(period.metrics, "sm:grid-cols-2 xl:grid-cols-4")}
                        <div class="grid gap-6 lg:grid-cols-2">
                          {panel(`crm-funnel-${period.value}`, "Acquisition funnel", `Last ${period.label}`, (
                            <ol class="grid gap-3">
                              {period.funnel.map((count, index) => (
                                <li class="grid gap-1.5">
                                  <div class="flex items-baseline justify-between gap-3">
                                    <span class="font-medium">{funnelSteps[index]}</span>
                                    <span class="tabular-nums"><span class="font-semibold">{formatNumber(count)}</span>{index > 0 && <span class="ml-2 text-xs text-muted">{percentOf(count, period.funnel[index - 1]!)}%</span>}</span>
                                  </div>
                                  <div class="h-3 rounded-full bg-subtle">
                                    <div class="h-3 rounded-full bg-primary" style={`width: ${Math.round(Math.sqrt(count / period.funnel[0]!) * 100)}%`} />
                                  </div>
                                </li>
                              ))}
                            </ol>
                          ))}
                          {panel(`crm-sources-${period.value}`, "Lead sources", "Share of new leads", (
                            <>
                              <div role="img" aria-label={`Lead sources: ${period.sources.map((share, index) => `${leadSources[index]} ${share}%`).join(", ")}`} class="flex h-3 gap-1 overflow-hidden rounded-full">
                                {period.sources.map((share, index) => <div class={sourceTones[index]} style={`width: ${share}%`} />)}
                              </div>
                              <ul class="grid gap-3">
                                {period.sources.map((share, index) => (
                                  <li class="flex items-center gap-3">
                                    <span class={cx("size-2.5 rounded-full", sourceTones[index])} aria-hidden="true" />
                                    <span class="flex-1">{leadSources[index]}</span>
                                    <span class="font-semibold tabular-nums">{share}%</span>
                                  </li>
                                ))}
                              </ul>
                            </>
                          ))}
                        </div>
                      </div>
                    ))}
                  </Tabs>
                )}

                {id === "projects" && (
                  <div class="grid gap-6">
                    {statTiles(projectStats, "sm:grid-cols-3")}
                    {panel("crm-projects-title", "All projects", plural(projects.length, "project"), (
                      <Drawer title="Project details">
                        <ul slot="trigger" class="-mx-3 grid gap-1" data-lumen-projects>
                          {projects.map((item) => (
                            <li data-project={item.id}>
                              <button type="button" class={projectRow} data-lumen-project={item.id}>
                                <span class="min-w-0">
                                  <span class="block truncate font-medium">{item.name}</span>
                                  <span class="block truncate text-xs text-muted">{item.client}</span>
                                </span>
                                <span><Badge variant={projectStatus[item.status]!.variant}>{projectStatus[item.status]!.label}</Badge></span>
                                <span class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
                                  <Progress value={item.progress} aria-label={`${item.name} progress`} />
                                  <span class="w-10 shrink-0 text-right text-xs text-muted tabular-nums">{item.progress}%</span>
                                </span>
                                <span class="text-xs text-muted md:text-right">Due {item.due}</span>
                              </button>
                            </li>
                          ))}
                        </ul>
                        <div class="grid gap-5 text-ink" data-lumen-project-details>
                          <div>
                            <h3 class="text-base font-semibold" data-lumen-project-name>{firstProject.name}</h3>
                            <p class="text-sm text-muted" data-lumen-project-client>{firstProject.client}</p>
                          </div>
                          <div class="grid gap-1.5">
                            <div class="flex justify-between text-sm">
                              <span class="font-medium">Progress</span>
                              <span class="text-muted tabular-nums" data-lumen-project-percent>{firstProject.progress}%</span>
                            </div>
                            <Progress value={firstProject.progress} aria-label="Project progress" />
                          </div>
                          {details([["Status", projectStatus[firstProject.status]!.label], ["Lead", firstProject.lead], ["Due date", firstProject.due], ["Budget", rupiah(firstProject.budget)], ["Tasks", firstProject.tasks]])}
                        </div>
                        <Button slot="footer" variant="secondary" type="submit">Close</Button>
                      </Drawer>
                    ), undefined, (
                      <ToggleGroup label="Filter by status" items={projectFilters} value="all" data-lumen-filter />
                    ))}
                  </div>
                )}

                {id === "calendar" && (
                  <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
                    {panel("crm-month-title", `${monthNames[10]} 2026`, "Meetings, calls, and visits", (
                      <div class="grid grid-cols-7 gap-px overflow-hidden rounded-xl border border-line bg-line" data-lumen-month />
                    ), undefined, (
                      <div class="flex items-center gap-2">
                        <button type="button" aria-label="Previous month" class={cx(iconButton, "size-8")} data-lumen-shift="-1" set:html={icon("prev", "size-4")} />
                        <button type="button" aria-label="Next month" class={cx(iconButton, "size-8")} data-lumen-shift="1" set:html={icon("next", "size-4")} />
                        <Modal title="New event" data-lumen-event-modal>
                          <Button slot="trigger" size="sm" data-lumen-new-event><Fragment set:html={icon("plus", "size-4")} />New event</Button>
                          <div class="grid gap-4 sm:grid-cols-2">
                            <div class="sm:col-span-2">
                              <Input label="Title" name="title" value="" />
                            </div>
                            <Input label="Date" type="date" name="date" value={TODAY} />
                            <Input label="Time" type="time" name="time" value="09:00" />
                            <Select label="Type" name="kind">
                              {eventKinds.map((kind) => <option selected={kind === "Meeting"}>{kind}</option>)}
                            </Select>
                          </div>
                          <Fragment slot="footer">
                            <Button variant="secondary" type="submit" value="cancel">Cancel</Button>
                            <Button type="submit" value="save">Add event</Button>
                          </Fragment>
                        </Modal>
                      </div>
                    ))}
                    {panel("crm-agenda-title", longDate(TODAY), plural(todayEvents.length, "event"), (
                      <div class="contents" data-lumen-agenda />
                    ), "content-start")}
                  </div>
                )}

                {id === "reports" && (
                  <div class="grid gap-6">
                    <div class="flex flex-wrap items-end justify-between gap-3">
                      <div class="w-full sm:w-56">
                        <Select label="Period" data-lumen-period>
                          {reportPeriods.map((item) => <option value={item.value} selected={item.value === "month"}>{item.label}</option>)}
                        </Select>
                      </div>
                      <Button variant="secondary" data-lumen-export><Fragment set:html={icon("download", "size-4")} />Export PDF</Button>
                    </div>
                    <div class="contents" data-lumen-report-view>{report(reportPeriods[0]!)}</div>
                    {reportPeriods.map((period) => <template data-lumen-report={period.value}>{report(period)}</template>)}
                  </div>
                )}

                {id === "files" && panel("crm-files-title", "Shared files", `${files.length} of ${files.length} files`, (
                  <>
                    <div class="flex flex-wrap items-center gap-3">
                      <div class="relative min-w-0 flex-1 sm:max-w-sm">
                        <Fragment set:html={icon("search", "pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-muted")} />
                        <Input type="search" aria-label="Search files" placeholder="Search files" class="pl-9" data-lumen-file-search />
                      </div>
                      <ToggleGroup label="View" items={viewOptions.map((item) => ({ ...item, label: "" }))} value="grid" data-lumen-view-toggle>
                        <Fragment slot="grid" set:html={icon("grid")} />
                        <Fragment slot="list" set:html={icon("list")} />
                      </ToggleGroup>
                    </div>
                    <ul role="list" data-view="grid" class={fileViews.grid.list} data-lumen-files>
                      {files.map((file) => (
                        <li class={fileViews.grid.item} data-name={file.name.toLowerCase()}>
                          <span class={cx(fileKind, kindColors[file.kind])}>{file.kind}</span>
                          <span class="min-w-0 flex-1">
                            <span class="block truncate font-medium">{file.name}</span>
                            <span class="block truncate text-xs text-muted">{file.owner}</span>
                          </span>
                          <span class="text-xs text-muted tabular-nums">{file.size}, {file.updated}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="rounded-xl border border-dashed border-line p-6 text-center text-sm text-muted" data-lumen-files-empty hidden>No files match your search.</p>
                  </>
                ), undefined, (
                  <Button size="sm" data-lumen-toast-title="Upload started" data-lumen-toast-text="Choose a file to add to Shared files"><Fragment set:html={icon("upload", "size-4")} />Upload</Button>
                ))}

                {id === "settings" && (
                  <form class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_420px]" data-lumen-settings>
                    {panel("crm-profile-title", "Profile", "How teammates and customers see you", (
                      <div class="grid gap-4 sm:grid-cols-2">
                        {profileFields.map((field) => <Input label={field.label} type={field.type as "text" | "email" | "tel"} name={field.key} value={initialProfile[field.key]} />)}
                        <Select label="Role" name="role">
                          {roles.map((role) => <option selected={role === initialProfile.role}>{role}</option>)}
                        </Select>
                      </div>
                    ), "content-start")}
                    {panel("crm-notify-title", "Notifications", "Choose what reaches your inbox", (
                      <>
                        <ul class="divide-y divide-line">
                          {notificationOptions.map((option) => (
                            <li class="flex items-center justify-between gap-4 py-3">
                              <div>
                                <p class="font-medium">{option.label}</p>
                                <p class="text-xs text-muted">{option.description}</p>
                              </div>
                              <Switch aria-label={option.label} name={option.key} checked={DEFAULT_PREFS.includes(option.key)} />
                            </li>
                          ))}
                        </ul>
                        <div class="flex justify-end gap-2">
                          <Button variant="secondary" type="reset">Reset</Button>
                          <Button type="submit">Save changes</Button>
                        </div>
                      </>
                    ), "content-start")}
                  </form>
                )}
              </Wrapper>
            );
          })
        }
      </main>
    </div>
    {badgeVariants.map((variant) => <template data-lumen-badge={variant}><Badge variant={variant} /></template>)}
    <Toaster />
  </div>
</lumen-template>

<script>
  type Customer = Record<
    | "id"
    | "firstName"
    | "lastName"
    | "role"
    | "company"
    | "email"
    | "phone"
    | "source"
    | "lastContacted"
    | "tier",
    string
  >;
  type CalEvent = { time: string; title: string; kind: string };
  type Config = {
    defaultPage: string;
    titleId: string;
    pages: Record<string, { label: string; title: string }>;
    navActive: string;
    navIdle: Record<string, string>;
    customers: Customer[];
    tierVariant: Record<string, string>;
    history: { id: string; date: string; value: number }[];
    sortLabels: Record<string, string>;
    dealSelected: string;
    dealIdle: string;
    pipeline: { id: string; value: number; stage: string }[];
    deals: Record<
      string,
      { title: string; company: string; value: string; owner: string; due: string }
    >;
    invoices: Record<string, { customer: string; due: string; amount: number }>;
    sortIcons: { active: string; idle: string };
    overdueText: string;
    projects: Record<
      string,
      { name: string; client: string; progress: number; rows: [string, string][] }
    >;
    projectStatus: Record<string, string>;
    events: Record<string, CalEvent[]>;
    today: string;
    monthNames: string[];
    weekdays: string[];
    weekdayNames: string[];
    kindTones: Record<string, string>;
    dayCell: string;
    dayNumber: string;
    chip: string;
    reportLabels: Record<string, string>;
    fileViews: Record<string, { list: string; item: string }>;
  };
  type ToastDetail = { title: string; description: string; variant?: string };
  type InvoiceKey = "customer" | "due" | "amount";

  const toast = (detail: ToastDetail) =>
    window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const rupiah = (value: number) => `Rp ${value.toLocaleString("id-ID")}`;
  const pad = (value: number) => String(value).padStart(2, "0");
  const isoDate = (year: number, month: number, day: number) =>
    `${year}-${pad(month + 1)}-${pad(day)}`;
  const plural = (count: number, word: string) =>
    `${count} ${word}${count === 1 ? "" : "s"}`;
  const cx = (...c: (string | false | null | undefined)[]) =>
    c.filter(Boolean).join(" ");
  const escape = (value: string | number) =>
    String(value).replace(/[&<>"]/g, (char) => `&#${char.charCodeAt(0)};`);
  const setClasses = (element: Element, add: string, remove: string) => {
    element.classList.remove(...remove.split(" "));
    element.classList.add(...add.split(" "));
  };
  /** Huruf pertama kata pertama dan terakhir, sama dengan Avatar. */
  const initials = (name: string) => {
    const words = name.trim().split(/\s+/).filter(Boolean);
    const picked =
      words.length > 1 ? [words[0], words[words.length - 1]] : words;
    return picked
      .map((word) => Array.from(word ?? "")[0] ?? "")
      .join("")
      .toUpperCase();
  };
  const setAvatar = (avatar: Element | null, name: string) => {
    if (!avatar) return;
    avatar.setAttribute("aria-label", name);
    avatar.textContent = initials(name);
  };
  const sorters: Record<
    string,
    (a: { date: string; value: number }, b: { date: string; value: number }) => number
  > = {
    newest: (a, b) => b.date.localeCompare(a.date),
    oldest: (a, b) => a.date.localeCompare(b.date),
    high: (a, b) => b.value - a.value,
    low: (a, b) => a.value - b.value,
  };

  /** Satu elemen per template: navigasi hash dan interaksi tiap halaman. */
  class LumenTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private customers: Customer[] = [];
    private selectedId = "c1";
    private dealId = "k1";
    private pipeline: Config["pipeline"] = [];
    private invoiceSort: { key: InvoiceKey; dir: number } = {
      key: "due",
      dir: 1,
    };
    private projectRows: HTMLElement[] = [];
    private events: Record<string, CalEvent[]> = {};
    private view = { year: 2026, month: 10 };
    private selectedDay = "";
    private fileRows: HTMLElement[] = [];
    private fileView = "grid";
    private readonly onHashChange = () => {
      this.open(this.readHash());
      document.getElementById(this.config.titleId)?.focus();
    };
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onChange = (event: Event) => this.handleChange(event);
    private readonly onInput = (event: Event) => this.handleInput(event);
    private readonly onSubmit = (event: Event) => this.handleSubmit(event);
    private readonly onClose = (event: Event) => this.handleClose(event);
    private readonly onMenuSelect = (event: Event) => this.handleMenu(event);

    connectedCallback() {
      this.open(this.readHash());
      window.addEventListener("hashchange", this.onHashChange);
      this.addEventListener("click", this.onClick);
      this.addEventListener("change", this.onChange);
      this.addEventListener("input", this.onInput);
      this.addEventListener("submit", this.onSubmit);
      this.addEventListener("markas-select", this.onMenuSelect);
      // close tidak bubble: didengar di fase capture.
      this.addEventListener("close", this.onClose, true);
    }

    disconnectedCallback() {
      window.removeEventListener("hashchange", this.onHashChange);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("change", this.onChange);
      this.removeEventListener("input", this.onInput);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("markas-select", this.onMenuSelect);
      this.removeEventListener("close", this.onClose, true);
    }

    private find<T extends Element = HTMLElement>(selector: string) {
      return this.querySelector<T>(`[data-lumen-view] ${selector}`);
    }

    private findAll<T extends Element = HTMLElement>(selector: string) {
      return [...this.querySelectorAll<T>(`[data-lumen-view] ${selector}`)];
    }

    /** Teks keterangan di bawah judul panel. */
    private setSub(labelId: string, text: string) {
      const sub = document.getElementById(labelId)?.nextElementSibling;
      if (sub) sub.textContent = text;
    }

    private setDetail(label: string, value: string) {
      const cell = this.find(`[data-lumen-detail="${label}"]`);
      if (cell) cell.textContent = value;
    }

    private badge(variant: string, text: string) {
      const template = this.querySelector<HTMLTemplateElement>(
        `template[data-lumen-badge="${variant}"]`,
      );
      const badge = template?.content.firstElementChild?.cloneNode(true);
      if (!(badge instanceof HTMLElement)) return null;
      badge.append(text);
      return badge;
    }

    /** Halaman aktif disimpan di hash URL supaya bisa dibagikan dan tombol Back bekerja. */
    private readHash() {
      const id = window.location.hash.slice(1);
      return id in this.config.pages ? id : this.config.defaultPage;
    }

    /** Ganti isi halaman dengan klon baru dari <template>, lalu siapkan interaksinya. */
    private open(id: string) {
      const template = this.querySelector<HTMLTemplateElement>(
        `template[data-lumen-page="${id}"]`,
      );
      const view = this.querySelector("[data-lumen-view]");
      if (!template || !view) return;
      view.replaceChildren(template.content.cloneNode(true));
      const page = this.config.pages[id]!;
      this.querySelector("[data-lumen-crumb]")!.textContent =
        `Lumen / ${page.label}`;
      document.getElementById(this.config.titleId)!.textContent = page.title;
      this.querySelectorAll<HTMLElement>("[data-lumen-go]").forEach((button) => {
        const active = button.dataset.lumenGo === id;
        const idle = this.config.navIdle[button.dataset.lumenNav ?? ""] ?? "";
        if (active) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
        setClasses(
          button,
          active ? this.config.navActive : idle,
          active ? idle : this.config.navActive,
        );
      });
      if (id === "customers") {
        this.customers = this.config.customers.map((item) => ({ ...item }));
        this.selectedId = "c1";
      }
      if (id === "deals") {
        this.dealId = "k1";
        this.pipeline = this.config.pipeline.map((item) => ({ ...item }));
      }
      if (id === "finance") this.invoiceSort = { key: "due", dir: 1 };
      if (id === "projects")
        this.projectRows = this.findAll("[data-lumen-projects] > li");
      if (id === "calendar") {
        this.events = structuredClone(this.config.events);
        this.view = { year: 2026, month: 10 };
        this.selectedDay = this.config.today;
        this.renderCalendar();
      }
      if (id === "files") {
        this.fileRows = this.findAll("[data-lumen-files] > li");
        this.fileView = "grid";
      }
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      const pick = (name: string) =>
        target.closest<HTMLElement>(`[data-lumen-${name}]`);
      const go = pick("go");
      if (go) return window.location.assign(`#${go.dataset.lumenGo}`);
      const simple = pick("toast-title");
      if (simple)
        return toast({
          title: simple.dataset.lumenToastTitle!,
          description: simple.dataset.lumenToastText!,
        });
      const customer = pick("pick-customer");
      if (customer) {
        this.selectedId = customer.dataset.lumenPickCustomer!;
        return this.renderCustomer();
      }
      const historyDeal = pick("pick-history");
      if (historyDeal) return this.selectHistory(historyDeal.dataset.lumenPickHistory!);
      const action = pick("profile-action");
      if (action) {
        const person = this.customer();
        return toast({
          title: action.dataset.lumenProfileAction!,
          description: `${person.firstName} ${person.lastName}, ${person.company}`,
        });
      }
      if (pick("edit")) return this.fillEditForm();
      const deal = pick("pick-deal");
      if (deal) {
        this.dealId = deal.dataset.lumenPickDeal!;
        return this.renderDeal();
      }
      const sortBy = pick("sort-by");
      if (sortBy) return this.sortInvoices(sortBy.dataset.lumenSortBy as InvoiceKey);
      const remind = pick("remind");
      if (remind) {
        const invoice = this.config.invoices[remind.dataset.lumenRemind!]!;
        return toast({
          title: "Reminder sent",
          description: `${remind.dataset.lumenRemind} to ${invoice.customer}`,
        });
      }
      if (pick("remind-all"))
        return toast({
          title: "Reminders sent",
          description: this.config.overdueText,
          variant: "success",
        });
      const filter = target.closest<HTMLButtonElement>("[data-lumen-filter] > button");
      if (filter) return this.filterProjects(event, filter);
      const project = pick("project");
      if (project) return this.showProject(project.dataset.lumenProject!);
      const shift = pick("shift");
      if (shift) return this.shiftMonth(Number(shift.dataset.lumenShift));
      const day = pick("day");
      if (day) {
        this.selectedDay = day.dataset.lumenDay!;
        return this.renderCalendar();
      }
      if (pick("new-event")) return this.startEvent();
      if (pick("export")) {
        const select = this.find<HTMLSelectElement>("[data-lumen-period]");
        const label = this.config.reportLabels[select?.value ?? "month"];
        return toast({
          title: "Report exported",
          description: `${label} sales report (PDF)`,
          variant: "success",
        });
      }
      const viewToggle = target.closest<HTMLButtonElement>(
        "[data-lumen-view-toggle] > button",
      );
      if (viewToggle) this.setFileView(event, viewToggle);
    }

    private handleChange(event: Event) {
      const target = event.target as HTMLElement;
      if (target.matches("[data-lumen-task]")) {
        const done = this.findAll<HTMLInputElement>("[data-lumen-task]").filter(
          (box) => box.checked,
        ).length;
        this.setSub("crm-today-title", `${done} of 5 done`);
        const progress = this.find<HTMLProgressElement>(
          "[data-lumen-tasks-progress]",
        );
        if (progress) progress.value = done;
      }
      if (target.matches("[data-lumen-period]")) {
        const value = (target as HTMLSelectElement).value;
        const template = this.find<HTMLTemplateElement>(
          `template[data-lumen-report="${value}"]`,
        );
        if (template)
          this.find("[data-lumen-report-view]")?.replaceChildren(
            template.content.cloneNode(true),
          );
      }
    }

    private handleInput(event: Event) {
      const field = event.target as HTMLInputElement;
      if (field.matches("[data-lumen-file-search]")) this.filterFiles(field.value);
    }

    private handleSubmit(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-lumen-settings]")) return;
      event.preventDefault();
      const value = (name: string) =>
        form.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value ?? "";
      const on = form.querySelectorAll("[role=switch]:checked").length;
      toast({
        title: "Settings saved",
        description: `${value("firstName")} ${value("lastName")}, ${on} notifications on`,
        variant: "success",
      });
    }

    private handleClose(event: Event) {
      const dialog = event.target;
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (dialog.returnValue === "save") {
        if (dialog.matches("[data-lumen-edit-drawer]")) this.saveCustomer(dialog);
        if (dialog.matches("[data-lumen-event-modal]")) this.addEvent(dialog);
      }
      dialog.returnValue = "";
    }

    private handleMenu(event: Event) {
      const value = (event as CustomEvent<string>).detail;
      const target = event.target as Element;
      if (target.closest("[data-lumen-sort]")) this.sortHistory(value);
      if (target.closest("[data-lumen-move]")) this.moveDeal(value);
    }

    /* Customers */
    private customer() {
      return this.customers.find((item) => item.id === this.selectedId)!;
    }

    private renderCustomer() {
      const person = this.customer();
      const fullName = `${person.firstName} ${person.lastName}`;
      this.setSub("crm-list-title", `${this.customers.length} accounts`);
      for (const item of this.customers) {
        const row = this.find(`[data-lumen-customer="${item.id}"]`);
        if (!row) continue;
        const selected = item.id === this.selectedId;
        const name = `${item.firstName} ${item.lastName}`;
        setClasses(
          row,
          selected ? "bg-primary-soft" : "hover:bg-subtle",
          selected ? "hover:bg-subtle" : "bg-primary-soft",
        );
        setAvatar(row.querySelector("[role=img]"), name);
        const button = row.querySelector("button")!;
        button.textContent = name;
        button.setAttribute("aria-pressed", String(selected));
      }
      this.setSub(
        "crm-history-title",
        `${this.config.history.length} deals with ${person.firstName} this quarter`,
      );
      const profile = this.find("[data-lumen-profile]");
      setAvatar(profile?.querySelector("[role=img]") ?? null, fullName);
      document.getElementById("crm-profile-name")!.textContent = fullName;
      this.find("[data-lumen-role]")!.textContent = person.role;
      const badge = this.badge(this.config.tierVariant[person.tier]!, person.tier);
      if (badge) this.find("[data-lumen-company]")?.replaceChildren(person.company, badge);
      this.setSub("crm-details-title", `Updated ${person.lastContacted}`);
      const rows: [string, keyof Customer][] = [
        ["First name", "firstName"],
        ["Last name", "lastName"],
        ["Email", "email"],
        ["Phone", "phone"],
        ["Source", "source"],
        ["Last contacted", "lastContacted"],
      ];
      for (const [label, key] of rows) this.setDetail(label, person[key]);
    }

    private sortHistory(sort: string) {
      const list = this.find("[data-lumen-history]");
      const label = this.find("[data-lumen-sort-label]");
      if (!list || !label) return;
      label.textContent = this.config.sortLabels[sort] ?? "";
      const order = [...this.config.history].sort(sorters[sort]);
      list.append(
        ...order.map((deal) => list.querySelector(`[data-deal="${deal.id}"]`)!),
      );
    }

    private selectHistory(id: string) {
      for (const card of this.findAll("[data-lumen-history] > li")) {
        const selected = card.dataset.deal === id;
        setClasses(
          card,
          selected ? this.config.dealSelected : this.config.dealIdle,
          selected ? this.config.dealIdle : this.config.dealSelected,
        );
        card.querySelectorAll("[data-lumen-muted]").forEach((text) =>
          setClasses(
            text,
            selected ? "text-on-primary/80" : "text-muted",
            selected ? "text-muted" : "text-on-primary/80",
          ),
        );
        card
          .querySelector("button")
          ?.setAttribute("aria-pressed", String(selected));
      }
    }

    private fillEditForm() {
      const person = this.customer();
      this.findAll<HTMLInputElement>("[data-lumen-edit-drawer] input").forEach(
        (field) => (field.value = person[field.name as keyof Customer] ?? ""),
      );
    }

    private saveCustomer(dialog: HTMLDialogElement) {
      const person = { ...this.customer() };
      dialog.querySelectorAll<HTMLInputElement>("input").forEach((field) => {
        person[field.name as keyof Customer] = field.value;
      });
      this.customers = this.customers.map((item) =>
        item.id === person.id ? person : item,
      );
      this.renderCustomer();
      toast({
        title: "Customer details saved",
        description: `${person.firstName} ${person.lastName}`,
        variant: "success",
      });
    }

    /* Deals: kartu dipindah antarkolom, urutan tetap seperti data asal. */
    private renderDeal() {
      const deal = this.config.deals[this.dealId]!;
      const stage = this.pipeline.find(
        (item) => item.id === this.dealId,
      )!.stage;
      this.findAll("[data-lumen-deal]").forEach((card) => {
        const selected = card.dataset.lumenDeal === this.dealId;
        setClasses(
          card,
          selected
            ? "border-primary ring-1 ring-primary"
            : "border-line hover:border-primary-line",
          selected
            ? "border-line hover:border-primary-line"
            : "border-primary ring-1 ring-primary",
        );
        card
          .querySelector("button")
          ?.setAttribute("aria-pressed", String(selected));
      });
      this.setSub("crm-deal-title", deal.company);
      this.find("[data-lumen-deal-title]")!.textContent = deal.title;
      this.find("[data-lumen-deal-value]")!.textContent = deal.value;
      this.setDetail("Stage", stage);
      this.setDetail("Owner", deal.owner);
      this.setDetail("Expected close", deal.due);
    }

    private moveDeal(stage: string) {
      const entry = this.pipeline.find((item) => item.id === this.dealId)!;
      const title = this.config.deals[this.dealId]!.title;
      if (stage === entry.stage)
        return toast({ title: `Already in ${stage}`, description: title });
      entry.stage = stage;
      const card = this.find(`[data-lumen-deal="${this.dealId}"]`)!;
      const column = this.find(`section[data-stage="${stage}"]`)!;
      const order = this.pipeline.map((item) => item.id);
      const after = [...column.querySelectorAll<HTMLElement>("[data-lumen-deal]")].find(
        (other) =>
          order.indexOf(other.dataset.lumenDeal!) > order.indexOf(this.dealId),
      );
      column.insertBefore(card, after ?? column.querySelector("[data-lumen-empty]"));
      for (const section of this.findAll("section[data-stage]")) {
        const items = this.pipeline.filter(
          (item) => item.stage === section.dataset.stage,
        );
        section.querySelector("[data-lumen-count]")!.textContent = String(
          items.length,
        );
        section.querySelector("[data-total]")!.textContent = rupiah(
          items.reduce((sum, item) => sum + item.value, 0),
        );
        section.querySelector<HTMLElement>("[data-lumen-empty]")!.hidden =
          items.length > 0;
      }
      this.renderDeal();
      toast({ title: `Moved to ${stage}`, description: title, variant: "success" });
    }

    /* Finance */
    private sortInvoices(key: InvoiceKey) {
      const sort = this.invoiceSort;
      this.invoiceSort = { key, dir: sort.key === key ? -sort.dir : 1 };
      const { dir } = this.invoiceSort;
      const body = this.find("tbody");
      if (!body) return;
      const rows = this.findAll("tbody tr");
      const valueOf = (row: HTMLElement) =>
        this.config.invoices[row.dataset.row!]![key];
      rows.sort((a, b) => {
        const [x, y] = [valueOf(a), valueOf(b)];
        return (x < y ? -1 : x > y ? 1 : 0) * dir;
      });
      body.append(...rows);
      for (const header of this.findAll("[data-lumen-column]")) {
        const active = header.dataset.lumenColumn === key;
        if (active)
          header.setAttribute("aria-sort", dir === 1 ? "ascending" : "descending");
        else header.removeAttribute("aria-sort");
        const icon = header.querySelector("svg")!;
        icon.querySelector("path")!.setAttribute(
          "d",
          active ? this.config.sortIcons.active : this.config.sortIcons.idle,
        );
        icon.classList.toggle("rotate-180", active && dir === -1);
      }
    }

    /* Projects */
    private filterProjects(event: Event, button: HTMLButtonElement) {
      // Item aktif yang diklik lagi tidak mematikan filter, sama seperti React.
      if (button.getAttribute("aria-pressed") === "true")
        return event.stopPropagation();
      const filter = button.dataset.value!;
      const visible = this.projectRows.filter(
        (row) =>
          filter === "all" ||
          this.config.projectStatus[row.dataset.project!] === filter,
      );
      this.find("[data-lumen-projects]")?.replaceChildren(...visible);
      this.setSub("crm-projects-title", plural(visible.length, "project"));
    }

    private showProject(id: string) {
      const project = this.config.projects[id]!;
      const details = this.find("[data-lumen-project-details]");
      if (!details) return;
      details.querySelector("[data-lumen-project-name]")!.textContent =
        project.name;
      details.querySelector("[data-lumen-project-client]")!.textContent =
        project.client;
      details.querySelector("[data-lumen-project-percent]")!.textContent =
        `${project.progress}%`;
      details.querySelector("progress")!.value = project.progress;
      for (const [label, value] of project.rows) this.setDetail(label, value);
    }

    /* Calendar */
    private shiftMonth(step: number) {
      const next = new Date(this.view.year, this.view.month + step, 1);
      this.view = { year: next.getFullYear(), month: next.getMonth() };
      this.renderCalendar();
    }

    private startEvent() {
      const modal = this.find("[data-lumen-event-modal]");
      modal!.querySelector<HTMLInputElement>("[name=title]")!.value = "";
      modal!.querySelector<HTMLInputElement>("[name=date]")!.value =
        this.selectedDay;
    }

    private addEvent(dialog: HTMLDialogElement) {
      const value = (name: string) =>
        dialog.querySelector<HTMLInputElement>(`[name="${name}"]`)?.value ?? "";
      const title = value("title").trim() || "New event";
      const date = value("date") || this.selectedDay;
      const [year = 2026, month = 1] = date.split("-").map(Number);
      const added = { time: value("time"), title, kind: value("kind") };
      this.events = {
        ...this.events,
        [date]: [...(this.events[date] ?? []), added].sort((a, b) =>
          a.time.localeCompare(b.time),
        ),
      };
      this.selectedDay = date;
      this.view = { year, month: month - 1 };
      this.renderCalendar();
      toast({
        title: "Event added",
        description: `${title}, ${this.longDate(date)}`,
        variant: "success",
      });
    }

    private longDate(iso: string) {
      const [year = 0, month = 1, day = 1] = iso.split("-").map(Number);
      const weekday =
        this.config.weekdayNames[new Date(year, month - 1, day).getDay()];
      return `${weekday}, ${this.config.monthNames[month - 1]} ${day}`;
    }

    /** Sel bulan (minggu mulai Senin) dan agenda hari terpilih, sama dengan JSX React. */
    private renderCalendar() {
      const grid = this.find("[data-lumen-month]");
      const agendaView = this.find("[data-lumen-agenda]");
      if (!grid || !agendaView) return;
      const { year, month } = this.view;
      const { monthNames, kindTones, chip, today } = this.config;
      const offset = (new Date(year, month, 1).getDay() + 6) % 7;
      const days = new Date(year, month + 1, 0).getDate();
      const cells = [
        ...Array<null>(offset).fill(null),
        ...Array.from({ length: days }, (_, index) => index + 1),
      ];
      cells.push(...Array<null>((7 - (cells.length % 7)) % 7).fill(null));
      const weekdays = this.config.weekdays.map(
        (weekday) =>
          `<span aria-hidden="true" class="bg-subtle py-2 text-center text-xs font-medium text-muted">${weekday}</span>`,
      );
      const dayCells = cells.map((day) => {
        if (day === null) return `<span class="bg-canvas"></span>`;
        const iso = isoDate(year, month, day);
        const list = this.events[iso] ?? [];
        const selected = iso === this.selectedDay;
        const chips = list
          .slice(0, 2)
          .map(
            (item) =>
              `<span class="${cx(chip, "hidden w-full sm:block", kindTones[item.kind])}">${escape(item.title)}</span>`,
          )
          .join("");
        return [
          `<button type="button" aria-pressed="${selected}" data-lumen-day="${iso}" class="${cx(this.config.dayCell, selected ? "bg-primary-soft" : "bg-surface")}">`,
          `<span class="sr-only">${monthNames[month]} ${day}, ${plural(list.length, "event")}</span>`,
          `<span aria-hidden="true" class="${cx(this.config.dayNumber, iso === today && "bg-primary text-on-primary")}">${day}</span>`,
          list.length > 0
            ? `<span class="size-1.5 rounded-full bg-primary sm:hidden" aria-hidden="true"></span>`
            : "",
          chips,
          list.length > 2
            ? `<span class="hidden text-xs text-muted sm:block">+${list.length - 2} more</span>`
            : "",
          `</button>`,
        ].join("");
      });
      grid.innerHTML = [...weekdays, ...dayCells].join("");
      document.getElementById("crm-month-title")!.textContent =
        `${monthNames[month]} ${year}`;
      const agenda = this.events[this.selectedDay] ?? [];
      document.getElementById("crm-agenda-title")!.textContent = this.longDate(
        this.selectedDay,
      );
      this.setSub("crm-agenda-title", plural(agenda.length, "event"));
      agendaView.innerHTML = agenda.length
        ? `<ul role="list" class="grid gap-2">${agenda
            .map(
              (item) =>
                `<li class="flex gap-3 rounded-xl border border-line p-3"><span class="w-12 shrink-0 text-xs font-medium text-muted tabular-nums">${escape(item.time)}</span><span class="grid min-w-0 flex-1 gap-1"><span class="text-sm font-medium">${escape(item.title)}</span><span class="${cx(chip, "w-fit", kindTones[item.kind])}">${escape(item.kind)}</span></span></li>`,
            )
            .join("")}</ul>`
        : `<p class="rounded-xl border border-dashed border-line p-4 text-sm text-muted">No events on this day.</p>`;
    }

    /* Files */
    private filterFiles(query: string) {
      const needle = query.trim().toLowerCase();
      const visible = this.fileRows.filter((row) =>
        row.dataset.name!.includes(needle),
      );
      const list = this.find("[data-lumen-files]");
      const empty = this.find("[data-lumen-files-empty]");
      if (!list || !empty) return;
      list.replaceChildren(...visible);
      list.hidden = visible.length === 0;
      empty.hidden = visible.length > 0;
      this.setSub(
        "crm-files-title",
        `${visible.length} of ${this.fileRows.length} files`,
      );
    }

    private setFileView(event: Event, button: HTMLButtonElement) {
      if (button.getAttribute("aria-pressed") === "true")
        return event.stopPropagation();
      const next = button.dataset.value!;
      const { fileViews } = this.config;
      const previous = fileViews[this.fileView]!;
      const view = fileViews[next]!;
      this.fileView = next;
      const list = this.find("[data-lumen-files]");
      if (!list) return;
      list.dataset.view = next;
      setClasses(list, view.list, previous.list);
      for (const row of this.fileRows) setClasses(row, view.item, previous.item);
    }
  }

  if (!customElements.get("lumen-template"))
    customElements.define("lumen-template", LumenTemplate);
</script>
