  { label: "Track my order", href: "/orders" }, { label: "Help centre", href: "/help" }, { label: "Sell on Pasarloka", href: "/sell" },
];
// prettier-ignore
const footerColumns = [
  { title: "Shop", links: [{ label: "Categories", href: "#categories" }, { label: "Flash deals", href: "#deals" }, { label: "Best sellers", href: "#best" }] },
  { title: "Sell", links: [{ label: "Open a shop", href: "/sell" }, { label: "Seller centre", href: "/seller" }, { label: "Shipping rates", href: "/shipping" }] },
  { title: "Help", links: [{ label: "Track my order", href: "/orders" }, { label: "Returns", href: "/returns" }, { label: "Contact us", href: "/contact" }] },
];
// prettier-ignore
const legal = [{ label: "Privacy", href: "/privacy" }, { label: "Terms", href: "/terms" }];

const rupiah = (value: number) =>
  `Rp ${String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ".")}`;
const percentOff = (price: number, was: number) =>
  `-${Math.round((1 - price / was) * 100)}%`;
const productOf = (id: string) =>
  catalog.find((item) => item.id === id) ?? catalog[0]!;
const countLabel = (shown: number) =>
  shown === products.length
    ? `Showing all ${products.length} products`
    : `Showing ${shown} of ${products.length} products`;
const itemsLabel = (count: number) =>
  `${count} ${count === 1 ? "item" : "items"}`;
/** Sisa waktu flash deal dalam milidetik; null sebelum mount supaya render server dan klien sama. */
const timeLeft = (now: number) =>
  DEAL_CYCLE - ((now + WIB_OFFSET) % DEAL_CYCLE);
const timerParts = (now: number | null) => {
  if (now === null) return ["--", "--", "--", "--"];
  const seconds = Math.floor(timeLeft(now) / 1000);
  return [
    Math.floor(seconds / 86400),
    Math.floor(seconds / 3600) % 24,
    Math.floor(seconds / 60) % 60,
    seconds % 60,
  ].map((part) => String(part).padStart(2, "0"));
};
const shippingNote = (subtotal: number) =>
  subtotal >= FREE_SHIPPING
    ? "Free shipping applied to this order."
    : `Add ${rupiah(FREE_SHIPPING - subtotal)} more for free shipping.`;

type Cart = Record<string, number>;

const icon = (name: IconName, className: string) =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}" /></svg>`;
const brandMarkHtml = `<span class="${brandMark}">${icon("bag", "size-5")}</span>`;
const footerBrandHtml = `<a href="#top" class="${brandLink}">${brandMarkHtml}Pasarloka</a>`;
const initialCart: Cart = { mug: 1, sunglasses: 1 };
const initialWishlist = ["smartwatch"];
const lines = Object.entries(initialCart).map(([id, qty]) => ({ ...productOf(id), qty }));
const cartCount = lines.reduce((sum, line) => sum + line.qty, 0);
const subtotal = lines.reduce((sum, line) => sum + line.qty * line.price, 0);
const config = JSON.stringify({
  menuId: MENU_ID,
  cartId: CART_ID,
  emailId: EMAIL_ID,
  emailPattern: EMAIL_PATTERN.source,
  note: [fieldError, fieldHint],
  freeShipping: FREE_SHIPPING,
  cycle: DEAL_CYCLE,
  offset: WIB_OFFSET,
  cart: initialCart,
  wishlist: initialWishlist,
  catalog: Object.fromEntries(catalog.map((item) => [item.id, { name: item.name, price: item.price }])),
  total: products.length,
});
---

<pasar-template class="contents" data-config={config}>
  <div id="top" class={root}>
    <p class={promoBar}>Free shipping on orders over Rp 150.000. New here? Use <span class={promoCode}>PASARBARU</span> for 10% off.</p>
    <header class={header}>
      <div class={headerRow}>
        <button type="button" aria-label="Open menu" class={iconButton} data-pasar-open={MENU_ID}><Fragment set:html={icon("menu", iconSize)} /></button>
        <a href="#top" class={brandLink}><Fragment set:html={brandMarkHtml} /><span class="min-w-0"><span class={brandName}>Pasarloka</span><span class={brandTagline}>Shop from 40.000 local sellers</span></span></a>
        <form role="search" class={searchForm} data-pasar-search>
          <div class={searchField}>
            <label for={SEARCH_ID} class={srOnly}>Search products</label>
            <Fragment set:html={icon("search", searchIcon)} />
            <Input id={SEARCH_ID} type="search" name="q" placeholder="Search headphones, batik, rice..." class={searchInput} />
          </div>
          <Button type="submit" class={searchButton}>Search</Button>
        </form>
        <div class={actions}>
          <a href="/account" aria-label="Account" class={accountLink}><Fragment set:html={icon("user", iconSize)} /></a>
          <a href="#products" aria-label={`Wishlist, ${itemsLabel(initialWishlist.length)}`} class={iconButton} data-pasar-wishlist>
            <Fragment set:html={icon("heart", iconSize)} />
            <span aria-hidden="true" class={countBadge} data-pasar-wish-count>{initialWishlist.length}</span>
          </a>
          <button type="button" aria-label={`Cart, ${itemsLabel(cartCount)}`} class={iconButton} data-pasar-open={CART_ID} data-pasar-cart>
            <Fragment set:html={icon("bag", iconSize)} />
            <span aria-hidden="true" data-cart-count="" class={countBadge}>{cartCount}</span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <nav aria-label="Shop by category" class={categoryNav}>
        <ul class={categoryList}>
          {categoryRow.map((item) => <li><a href="#products" class={categoryLink} data-pasar-category={item.value}><span class={categoryBubble}><Fragment set:html={icon(item.icon, categoryIcon)} /></span>{item.label}</a></li>)}
        </ul>
      </nav>

      <section aria-labelledby="pasar-title" class={hero}>
        <div class={heroCard}>
          <div class={heroCopy}>
            <p class={eyebrow}><span aria-hidden="true" class={eyebrowDot}></span>Payday sale, until 30 November</p>
            <h1 id="pasar-title" class={h1}>{TITLE}</h1>
            <p class={heroLead}>Fashion, gadgets, groceries, and home goods from local sellers across Indonesia, with same-day delivery in 12 cities.</p>
            <div class={heroActions}>
              <a href="#deals" class={primaryLink}>Shop the sale<Fragment set:html={icon("arrow", "size-4")} /></a>
              <a href="#categories" class={secondaryLink}>Browse categories</a>
            </div>
          </div>
          <div class={heroMedia}>
            <img src={image("hero-bags")} alt="A hand holding red, white, and brown paper shopping bags" width="1200" height="900" fetchpriority="high" decoding="async" class={heroImage} />
            <p class={offerTag}><span class={offerSmall}>Up to</span><span class={offerBig}>60%</span><span class={offerSmall}>off</span></p>
            <div class={heroChip}>
              <img src={image("smartwatch")} alt="" width="48" height="48" decoding="async" class={chipImage} />
              <div class="min-w-0">
                <p class={chipName}>Fitness smartwatch</p>
                <p class={chipPrice}>Rp 449.000<span class={chipWas}>Rp 899.000</span></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <ul aria-label="Why shop with us" class={trustList}>
        {trust.map((item) => (
          <li class={trustItem}>
            <span class={trustIcon}><Fragment set:html={icon(item.icon, "size-5")} /></span>
            <div>
              <p class={trustTitle}>{item.title}</p>
              <p class={trustText}>{item.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <section id="deals" aria-labelledby="pasar-deals" class={section}>
        <div class={sectionHead}>
          <div>
            <h2 id="pasar-deals" class={h2}>Flash deal</h2>
            <p class={lead}>A new deal every three days, while stock lasts.</p>
          </div>
        </div>
        <div class={dealCard}>
          <div class={dealMedia}>
            <img src={image("flash-speaker")} alt="A dark grey portable speaker on a white table" width="600" height="600" loading="lazy" decoding="async" class={dealImage} />
          </div>
          <div class={dealBody}>
            <p class={dealLabel}><Fragment set:html={icon("bolt", dealIcon)} />Flash deal</p>
            <h3 class={dealTitle}>{deal.name}</h3>
            <p class={dealPriceRow}>
              <span class={dealPrice}>{rupiah(deal.price)}</span>
              <span class={dealWas}>{rupiah(deal.was)}</span>
              <span class={dealOff}>{percentOff(deal.price, deal.was)}</span>
            </p>
            <div>
              <p id="pasar-timer-label" class={timerLabel}>Deal ends in</p>
              <div role="timer" aria-labelledby="pasar-timer-label" class={timerGrid}>
                {timerUnits.map((unit) => <p class={timerCell}><span data-timer={unit} class={timerValue}>--</span><span class={timerUnit}>{unit}</span></p>)}
              </div>
            </div>
            <div>
              <p class={stockRow}><span>{deal.sold} of {deal.stock} sold</span><span class={dealNote}>Limit 2 per customer</span></p>
              <div class={stockTrack}><div class={stockBar}></div></div>
            </div>
            <div class={dealActions}>
              <Button class={dealButton} data-pasar-add={deal.id}><Fragment set:html={icon("bag", "size-5")} />Add to cart</Button>
              <span class={dealNote}>Ships from Jakarta Utara</span>
            </div>
          </div>
        </div>
      </section>

      <section id="categories" aria-labelledby="pasar-categories" class={section}>
        <div class={sectionHead}>
          <h2 id="pasar-categories" class={h2}>Popular categories</h2>
          <a href="#products" class={textLink} data-pasar-category="all">See all products<Fragment set:html={icon("arrow", "size-4")} /></a>
        </div>
        <ul class={tileGrid}>
          {tiles.map((tile) => (
            <li>
              <a href="#products" class={tileLink} data-pasar-category={tile.value}>
                <img src={image(tile.image)} alt="" width="480" height="600" loading="lazy" decoding="async" class={tileImage} />
                <p class={tileName}>{tile.label}</p>
                <p class={tileCount}>{tile.count}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="products" aria-labelledby="pasar-products" class={section}>
        <div class={sectionHead}>
          <div>
            <h2 id="pasar-products" class={h2}>Today's picks</h2>
            <p class={lead}>Prices drop at midnight WIB. Free returns on everything.</p>
          </div>
        </div>
        <div class={toolbar}>
          <div class={filterScroll}>
            <ToggleGroup label="Filter products by category" items={categoryItems} value="all" data-pasar-filter />
          </div>
          <p aria-live="polite" class={countText} data-pasar-count>{countLabel(products.length)}</p>
        </div>
        <ul class={productGrid} data-pasar-products>
          {products.map((product) => (
            <li data-product={product.id} data-category={product.category} class={productCard}>
              <div class={productMedia}>
                <img src={image(product.id)} alt="" width="480" height="480" loading="lazy" decoding="async" class={productImage} />
                <span class={discountBadge}>{percentOff(product.price, product.was)}</span>
                <button type="button" aria-label={`Save ${product.name}`} aria-pressed={initialWishlist.includes(product.id) ? "true" : "false"} class={wishButton} data-pasar-wish={product.id}><Fragment set:html={icon("heart", wishIcon)} /></button>
              </div>
              <div class={productBody}>
                <h3 class={productName}>{product.name}</h3>
                <p class={ratingRow}><Fragment set:html={icon("star", starIcon)} /><span class={ratingValue}>{product.rating}</span><span aria-hidden="true">·</span>{product.sold}</p>
                <p class={priceRow}><span class={priceNow}>{rupiah(product.price)}</span><span class={priceWas}>{rupiah(product.was)}</span></p>
                <p class={cityText}>{product.city}</p>
                <Button variant="secondary" size="sm" class={addButton} aria-label={`Add to cart, ${product.name}`} data-pasar-add={product.id}>Add to cart</Button>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="pasar-promos" class={section}>
        <h2 id="pasar-promos" class={h2}>Edits for the week</h2>
        <ul class={promoGrid}>
          {promos.map((promo) => (
            <li class={promoCard}>
              <div class={promoCopy}>
                <p class={promoKicker}>{promo.kicker}</p>
                <h3 class={promoTitle}>{promo.title}</h3>
                <p class={promoText}>{promo.text}</p>
                <a href="#products" class={promoLink} data-pasar-category={promo.category}>{promo.cta}<Fragment set:html={icon("arrow", "size-4")} /></a>
              </div>
              <img src={image(promo.image)} alt="" width="800" height="500" loading="lazy" decoding="async" class={promoImage} />
            </li>
          ))}
        </ul>
      </section>

      <section id="best" aria-labelledby="pasar-best" class={section}>
        <div class={sectionHead}>
          <div>
            <h2 id="pasar-best" class={h2}>Best sellers this week</h2>
            <p class={lead}>Ranked by orders in the last seven days.</p>
          </div>
        </div>
        <div class={carouselWrap}>
          <Carousel label="Best sellers" showDots items={bestPages}>
            {(page: (typeof bestSellers)[number][], pageIndex: number) => (
              <ol start={pageIndex * 4 + 1} class={slideGrid}>
                {page.map((item, index) => (
                  <li class={bestCard}>
                    <div class={bestMedia}>
                      <img src={image(item.id)} alt="" width="480" height="480" loading="lazy" decoding="async" class={bestImage} />
                      <span aria-hidden="true" class={bestRank}>{pageIndex * 4 + index + 1}</span>
                    </div>
                    <div class={bestBody}>
                      <h3 class={productName}>{item.name}</h3>
                      <p class={ratingRow}><Fragment set:html={icon("star", starIcon)} /><span class={ratingValue}>{item.rating}</span><span aria-hidden="true">·</span>{item.sold}</p>
                      <div class={bestFoot}>
                        <p class={priceNow}>{rupiah(item.price)}</p>
                        <button type="button" aria-label={`Add to cart, ${item.name}`} class={bestAdd} data-pasar-add={item.id}><Fragment set:html={icon("plus", "size-4")} /></button>
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </Carousel>
        </div>
      </section>

      <div class={container}>
        <div class={storyGrid}>
          <figure class={quoteCard}>
            <div>
              <p class={quoteStars}>{[1, 2, 3, 4, 5].map(() => <Fragment set:html={icon("star", quoteStar)} />)}<span class={srOnly}>Rated 5 out of 5</span></p>
              <blockquote class={quoteText}>I ordered a rice cooker on Tuesday night and it reached my door in Makassar on Thursday. The lid arrived cracked, and the seller sent a new one the same day I asked.</blockquote>
            </div>
            <figcaption class={person}>
              <Avatar name="Dewi Lestari" size="md" />
              <div>
                <p class={personName}>Dewi Lestari</p>
                <p class={personRole}>Bought from 14 sellers this year, Makassar</p>
              </div>
            </figcaption>
          </figure>
          <section aria-labelledby="pasar-sell" class={sellCard}>
            <h2 id="pasar-sell" class={sellTitle}>Sell on Pasarloka</h2>
            <p class={sellText}>Over 40.000 small businesses sell here, from batik makers in Pekalongan to coffee roasters in Toraja.</p>
            <ul class={sellList}>
              {sellPoints.map((point) => <li class={sellItem}><Fragment set:html={icon("check", sellIcon)} />{point}</li>)}
            </ul>
            <button type="button" class={sellButton} data-pasar-shop>Open your shop</button>
          </section>
        </div>
      </div>

      <div class={bandWrap}>
        <section aria-labelledby="pasar-newsletter" class={band}>
          <div>
            <h2 id="pasar-newsletter" class={bandTitle}>Get deals before they go live</h2>
            <p class={bandText}>Every Thursday: next week's flash deals and vouchers from new sellers. No spam.</p>
          </div>
          <form class={form} novalidate data-pasar-news>
            <label for={EMAIL_ID} class={fieldLabel}>Email address</label>
            <div class={fieldRow}>
              <Input id={EMAIL_ID} type="email" name="email" autocomplete="email" placeholder="nama@email.com" class={field} aria-describedby={`${EMAIL_ID}-note`} />
              <Button type="submit" class={fieldButton}>Subscribe</Button>
            </div>
            <p id={`${EMAIL_ID}-note`} class={fieldHint}>One email a week. Unsubscribe in one click.</p>
          </form>
        </section>
      </div>
    </main>

    <Footer class={footer} description="An online marketplace for local sellers across Indonesia." columns={footerColumns} legal={legal} copyright="© 2026 Pasarloka. Built with MarkasUI.">
      <Fragment slot="brand" set:html={footerBrandHtml} />
    </Footer>

    <Drawer id={MENU_ID} side="left" title="Shop by category">
      <ul class={drawerList}>
        {categoryRow.map((item) => <li><a href="#products" class={drawerLink} data-pasar-category={item.value} data-pasar-menu-pick><span class={drawerIcon}><Fragment set:html={icon(item.icon, "size-5")} /></span>{item.label}</a></li>)}
      </ul>
      <p class={drawerHeading}>Help and account</p>
      <ul>
        {menuLinks.map((link) => <li><a href={link.href} class={drawerPlain}>{link.label}</a></li>)}
      </ul>
    </Drawer>

    <Drawer id={CART_ID} title="Your cart">
      <p class={cartEmpty} hidden data-pasar-empty>Your cart is empty.</p>
      <ul class={cartList} data-pasar-lines>
        {lines.map((line) => (
          <li data-cart-line={line.id} class={cartLine}>
            <img src={image(line.id)} alt="" width="56" height="56" loading="lazy" decoding="async" class={cartImage} />
            <div class="min-w-0">
              <p class={cartName}>{line.name}</p>
              <p class={cartMeta}>{line.qty} x {rupiah(line.price)}</p>
            </div>
            <p class={cartTotal}>{rupiah(line.qty * line.price)}</p>
          </li>
        ))}
      </ul>
      <template data-pasar-line-template>
        <li class={cartLine}>
          <img alt="" width="56" height="56" loading="lazy" decoding="async" class={cartImage} />
          <div class="min-w-0">
            <p class={cartName} data-field="name"></p>
            <p class={cartMeta} data-field="meta"></p>
          </div>
          <p class={cartTotal} data-field="total"></p>
        </li>
      </template>
      <div class={cartSummary}>
        <p class={summaryRow}><span>Subtotal</span><span data-subtotal="">{rupiah(subtotal)}</span></p>
        <p class={shipNote} data-pasar-ship>{shippingNote(subtotal)}</p>
      </div>
      <Fragment slot="footer">
        <Button variant="secondary" type="submit" value="cancel">Keep shopping</Button>
        <Button type="submit" value="checkout" data-pasar-checkout>Checkout</Button>
      </Fragment>
    </Drawer>

    <BottomNavigation items={bottomItems} defaultValue="home" navLabel="Shop" class={bottomNav} />
    <Toaster />
  </div>
</pasar-template>

<script>
  type Item = { name: string; price: number };
  type Config = {
    menuId: string;
    cartId: string;
    emailId: string;
    emailPattern: string;
    note: [string, string];
    freeShipping: number;
    cycle: number;
    offset: number;
    cart: Record<string, number>;
    wishlist: string[];
    catalog: Record<string, Item>;
    total: number;
  };
  type ToastDetail = { title: string; description: string; variant?: string };

  const HINT = "One email a week. Unsubscribe in one click.";
  const toast = (detail: ToastDetail) => window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const rupiah = (value: number) => `Rp ${String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ".")}`;
  const itemsLabel = (count: number) => `${count} ${count === 1 ? "item" : "items"}`;
  const setClasses = (element: Element, on: boolean, [active, idle]: string[]) => {
    element.classList.remove(...(on ? idle! : active!).split(" "));
    element.classList.add(...(on ? active! : idle!).split(" "));
  };

  /** Satu elemen per template: kategori, keranjang, wishlist, hitung mundur, drawer, newsletter. */
  class PasarTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private cart: Record<string, number> = { ...this.config.cart };
    private wishlist: string[] = [...this.config.wishlist];
    private products: HTMLElement[] = [];
    private timer = 0;
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onSubmit = (event: Event) => this.handleSubmit(event);
    private readonly onClose = (event: Event) => this.drawerClosed(event);
    private readonly onTab = (event: Event) => this.tabChanged(event);

    connectedCallback() {
      this.products = [...this.querySelectorAll<HTMLElement>("[data-pasar-products] > li")];
      this.addEventListener("click", this.onClick);
      this.addEventListener("submit", this.onSubmit);
      // close tidak bubble: didengar di fase capture.
      this.addEventListener("close", this.onClose, true);
      this.addEventListener("markas-change", this.onTab);
      this.tick();
      this.timer = window.setInterval(() => this.tick(), 1000);
    }

    disconnectedCallback() {
      window.clearInterval(this.timer);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("close", this.onClose, true);
      this.removeEventListener("markas-change", this.onTab);
    }

    /** Sisa waktu flash deal: berganti setiap tiga hari, tepat tengah malam WIB. */
    private tick() {
      const { cycle, offset } = this.config;
      const seconds = Math.floor((cycle - ((Date.now() + offset) % cycle)) / 1000);
      const parts = [Math.floor(seconds / 86400), Math.floor(seconds / 3600) % 24, Math.floor(seconds / 60) % 60, seconds % 60];
      this.querySelectorAll<HTMLElement>("[data-timer]").forEach((cell, index) => {
        cell.textContent = String(parts[index]).padStart(2, "0");
      });
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      const toggle = target.closest<HTMLButtonElement>("[data-pasar-filter] > button");
      if (toggle) return this.pickToggle(event, toggle);
      const category = target.closest<HTMLElement>("[data-pasar-category]");
      if (category) {
        this.setCategory(category.dataset.pasarCategory!);
        if (category.hasAttribute("data-pasar-menu-pick")) (document.getElementById(this.config.menuId) as HTMLDialogElement).close();
        return;
      }
      const open = target.closest<HTMLElement>("[data-pasar-open]");
      if (open) return (document.getElementById(open.dataset.pasarOpen!) as HTMLDialogElement).showModal();
      const add = target.closest<HTMLElement>("[data-pasar-add]");
      if (add) return this.addToCart(add.dataset.pasarAdd!);
      const wish = target.closest<HTMLElement>("[data-pasar-wish]");
      if (wish) return this.toggleWish(wish.dataset.pasarWish!);
      if (target.closest("[data-pasar-shop]"))
        toast({ title: "Seller sign-up opened", description: "Have your KTP and a bank account ready. It takes about ten minutes." });
    }

    /** ToggleGroup mengosongkan pilihan saat item aktif diklik lagi; hentikan supaya selalu ada pilihan. */
    private pickToggle(event: Event, button: HTMLButtonElement) {
      if (button.getAttribute("aria-pressed") === "true") return event.stopPropagation();
      // Tombol grup ditekan oleh script ToggleGroup sendiri.
      this.setCategory(button.dataset.value!, false);
    }

    /* Filter produk: kartu disaring dengan memasang ulang <li>, seperti React. */
    private setCategory(category: string, syncToggle = true) {
      const visible = this.products.filter((product) => category === "all" || product.dataset.category === category);
      this.querySelector("[data-pasar-products]")!.replaceChildren(...visible);
      const { total } = this.config;
      this.querySelector("[data-pasar-count]")!.textContent =
        visible.length === total ? `Showing all ${total} products` : `Showing ${visible.length} of ${total} products`;
      if (!syncToggle) return;
      this.querySelectorAll<HTMLButtonElement>("[data-pasar-filter] > button").forEach((button) => {
        const on = button.dataset.value === category;
        button.setAttribute("aria-pressed", String(on));
        button.dataset.state = on ? "on" : "off";
        button.tabIndex = on ? 0 : -1;
      });
    }

    private addToCart(id: string) {
      const count = this.cartCount();
      this.cart = { ...this.cart, [id]: (this.cart[id] ?? 0) + 1 };
      this.renderCart();
      toast({ title: "Added to cart", description: `${this.config.catalog[id]!.name}. Your cart has ${itemsLabel(count + 1)}.`, variant: "success" });
    }

    private cartCount() {
      return Object.values(this.cart).reduce((sum, qty) => sum + qty, 0);
    }

    private subtotal() {
      return Object.entries(this.cart).reduce((sum, [id, qty]) => sum + qty * this.config.catalog[id]!.price, 0);
    }

    private renderCart() {
      const count = this.cartCount();
      const subtotal = this.subtotal();
      this.querySelector("[data-pasar-cart]")!.setAttribute("aria-label", `Cart, ${itemsLabel(count)}`);
      const badge = this.querySelector<HTMLElement>("[data-cart-count]")!;
      badge.textContent = String(count);
      badge.hidden = count === 0;
      const template = this.querySelector<HTMLTemplateElement>("[data-pasar-line-template]")!;
      const rows = Object.entries(this.cart).map(([id, qty]) => {
        const item = this.config.catalog[id]!;
        const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        row.dataset.cartLine = id;
        row.querySelector("img")!.src = `/template-images/pasar/${id}.webp`;
        row.querySelector("[data-field=name]")!.textContent = item.name;
        row.querySelector("[data-field=meta]")!.textContent = `${qty} x ${rupiah(item.price)}`;
        row.querySelector("[data-field=total]")!.textContent = rupiah(qty * item.price);
        return row;
      });
      this.querySelector("[data-pasar-lines]")!.replaceChildren(...rows);
      this.querySelector<HTMLElement>("[data-pasar-empty]")!.hidden = rows.length > 0;
      this.querySelector("[data-subtotal]")!.textContent = rupiah(subtotal);
      const { freeShipping } = this.config;
      this.querySelector("[data-pasar-ship]")!.textContent =
        subtotal >= freeShipping ? "Free shipping applied to this order." : `Add ${rupiah(freeShipping - subtotal)} more for free shipping.`;
      this.querySelector<HTMLButtonElement>("[data-pasar-checkout]")!.disabled = count === 0;
    }

    private toggleWish(id: string) {
      this.wishlist = this.wishlist.includes(id) ? this.wishlist.filter((item) => item !== id) : [...this.wishlist, id];
      this.querySelectorAll<HTMLElement>("[data-pasar-wish]").forEach((button) => {
        button.setAttribute("aria-pressed", String(this.wishlist.includes(button.dataset.pasarWish!)));
      });
      const count = this.wishlist.length;
      this.querySelector("[data-pasar-wishlist]")!.setAttribute("aria-label", `Wishlist, ${itemsLabel(count)}`);
      const badge = this.querySelector<HTMLElement>("[data-pasar-wish-count]")!;
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }

    private handleSubmit(event: Event) {
      const form = event.target as HTMLFormElement;
      if (form.matches("[data-pasar-search]")) {
        event.preventDefault();
        const value = form.querySelector("input")!.value.trim();
        return toast(
          value
            ? { title: `Results for ${value}`, description: "Sorted by best match. Filter by price, city, and rating on the next page." }
            : { title: "Type something to search", description: "Try headphones, batik, or rice." },
        );
      }
      if (form.matches("[data-pasar-news]")) this.subscribe(event, form);
    }

    private subscribe(event: Event, form: HTMLFormElement) {
      event.preventDefault();
      const field = form.querySelector<HTMLInputElement>(`#${this.config.emailId}`)!;
      const note = form.querySelector<HTMLElement>(`#${this.config.emailId}-note`)!;
      const value = field.value.trim();
      const valid = new RegExp(this.config.emailPattern).test(value);
      setClasses(note, !valid, this.config.note);
      note.textContent = valid ? HINT : "Enter a valid email address, like nama@email.com.";
      if (!valid) return field.setAttribute("aria-invalid", "true");
      field.removeAttribute("aria-invalid");
      field.value = "";
      toast({ title: "You are subscribed", description: `Next Thursday's deals are on their way to ${value}.`, variant: "success" });
    }

    private drawerClosed(event: Event) {
      const dialog = event.target;
      if (!(dialog instanceof HTMLDialogElement) || dialog.id !== this.config.cartId) return;
      if (dialog.returnValue === "checkout")
        toast({
          title: "Taking you to checkout",
          description: `${itemsLabel(this.cartCount())}, ${rupiah(this.subtotal())}. Pay with QRIS, virtual account, or card.`,
          variant: "success",
        });
      dialog.returnValue = "";
    }

    private tabChanged(event: Event) {
      if ((event as CustomEvent<string>).detail === "account")
        toast({ title: "Sign in to see your account", description: "Orders, saved addresses, and vouchers live here." });
    }
  }

  if (!customElements.get("pasar-template")) customElements.define("pasar-template", PasarTemplate);
</script>
