    features: ["Unlimited sources", "Row-level access control", "SSO and audit log", "Data processed in the Jakarta region", "Named success manager"] },
];
// prettier-ignore
const faqs = [
  { question: "Does Nalar copy our data?", answer: "No. Nalar queries your sources with read-only credentials and keeps only aggregated results and metadata. Raw rows stay in your database or warehouse." },
  { question: "Which data sources are supported?", answer: "PostgreSQL, MySQL, BigQuery, Snowflake, Google Sheets, Kafka, CSV uploads, and any REST API that returns JSON. New connectors ship every month." },
  { question: "How do we check that an explanation is right?", answer: "Every insight shows the query, the comparison window, and how much of the change each cause explains, so your analysts can check the work before anyone acts on it." },
  { question: "Where is our data processed?", answer: "In data centres in the Jakarta region by default, with Singapore available on the Scale plan. We follow Indonesia's Personal Data Protection Law (UU PDP)." },
  { question: "What happens after the early access beta?", answer: "Beta customers keep their price for 12 months after general availability, and every alert and workflow you build carries over." },
];
// prettier-ignore
const footerColumns = [
  { title: "Product", links: [{ label: "Features", href: "#features" }, { label: "Workflow", href: "#how" }, { label: "Pricing", href: "#pricing" }] },
  { title: "Resources", links: [{ label: "Docs", href: "/docs" }, { label: "Changelog", href: "/changelog" }, { label: "Status", href: "/status" }] },
  { title: "Company", links: [{ label: "Customers", href: "#customers" }, { label: "Careers", href: "/careers" }, { label: "Contact", href: "#start" }] },
];
// prettier-ignore
const legal = [{ label: "Privacy", href: "/privacy" }, { label: "Terms", href: "/terms" }];

const lineClass: Record<string, string> = {
  cmd: lineCmd,
  out: lineOut,
  ok: lineOk,
};
const rangeOf = (value: string) =>
  ranges.find((item) => item.value === value) ?? ranges[1];
const priceOf = (plan: (typeof plans)[number], period: BillingId) =>
  period === "yearly" ? plan.yearly : plan.monthly;
const unitOf = (plan: (typeof plans)[number], period: BillingId) =>
  plan.free
    ? "free, no card needed"
    : `per month, billed ${period === "yearly" ? "yearly" : "monthly"}`;

const rangeItems = ranges.map(({ value, label }) => ({ value, label }));
const initial = rangeOf("30d");
const icon = (name: IconName, className: string) =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}" /></svg>`;
const brandHtml = `<a href="#top" class="${brandLink}"><span class="${brandMark}">${icon("arc", "size-4")}</span>Nalar</a>`;
const config = JSON.stringify({
  formId: FORM_ID,
  emailPattern: EMAIL_PATTERN.source,
  emailError: EMAIL_ERROR,
  ranges: Object.fromEntries(ranges.map((item) => [item.value, { sub: item.sub, note: item.note }])),
  plans: plans.map((plan) => ({ monthly: plan.monthly, yearly: plan.yearly, unitMonthly: unitOf(plan, "monthly"), unitYearly: unitOf(plan, "yearly") })),
});
---

<nalar-template class="contents" data-config={config}>
  <div id="top" class={root}>
    <div class={shell}>
      <div class={palette}>
        <div class={navWrap}>
          <Navbar variant="floating" class={navbar} links={nav}>
            <Fragment slot="brand" set:html={brandHtml} />
            <Fragment slot="actions">
              <a href="/login" class={signIn}>Sign in</a>
              <a href="#start" class={startLink}>Get started</a>
            </Fragment>
          </Navbar>
        </div>

        <main>
          <section aria-labelledby="nalar-title" class={hero}>
            <div aria-hidden="true" class={horizon}></div>
            <div class={heroCopy}>
              <p class={chip}><span class={chipTag}>Beta</span>Nalar Agents are in early access</p>
              <h1 id="nalar-title" class={h1}>Find the reason behind <span class={h1Accent}>every metric</span></h1>
              <p class={heroText}>Nalar watches your revenue, product, and operations data, explains what changed in plain language, and sends it to the team that can act before the weekly report.</p>
              <div class={heroActions}>
                <a href="#start" class={heroCta}>Get started<Fragment set:html={icon("arrow", "size-4")} /></a>
                <a href="#how" class={heroGhost}><Fragment set:html={icon("play", "size-4")} />Watch demo</a>
              </div>
              <p class={heroNote}>Free for 3 data sources. No credit card needed.</p>
            </div>

            <div class={dashWrap}>
              <div role="group" aria-label="Nalar dashboard preview" class={dashFrame}>
                <div class={dashGrid}>
                  <div class={dashSide}>
                    <div class={workspace}>
                      <span aria-hidden="true" class={workspaceMark}>SC</span>
                      <div>
                        <p class={workspaceName}>Sagara Commerce</p>
                        <p class={workspacePlan}>Growth plan</p>
                      </div>
                    </div>
                    <ul class={sideNav}>
                      {
                        sideLinks.map((item, index) => (
                          <li aria-current={index === 0 ? "page" : undefined} class={index === 0 ? sideItemActive : sideItem}><Fragment set:html={icon(item.icon, index === 0 ? sideIconActive : sideIcon)} />{item.label}{item.count && <span class={sideCount}>{item.count}</span>}</li>
                        ))
                      }
                    </ul>
                  </div>

                  <div class={dashMain}>
                    <div class={dashHead}>
                      <div>
                        <p class={dashTitle}>Revenue overview</p>
                        <p data-range-sub="" class={dashSub}>{initial.sub}</p>
                      </div>
                      <ToggleGroup label="Date range" items={rangeItems} value="30d" data-nalar-ranges />
                    </div>
                    {
                      ranges.map((item) => (
                        <dl class={kpiGrid} data-nalar-kpis={item.value} hidden={item.value !== "30d"}>
                          {item.kpis.map((kpi) => (
                            <div class={kpiCard}>
                              <dt class={kpiLabel}>{kpi.label}</dt>
                              <dd class={kpiRow}><span class={kpiValue}>{kpi.value}</span><Badge variant={kpi.tone}>{kpi.delta}</Badge></dd>
                            </div>
                          ))}
                        </dl>
                      ))
                    }
                    <div data-range="30d" class={chartCard}>
                      <div class={chartHead}>
                        <p class={chartTitle}>Net revenue</p>
                        <p class={chartNote} data-range-note>{initial.note}</p>
                      </div>
                      {
                        ranges.map((item) => (
                          <div aria-hidden="true" class={chartBars} data-nalar-bars={item.value} hidden={item.value !== "30d"}>
                            {item.bars.map((value, index) => <div class={index === item.peak ? barPeak : bar} style={`height: ${value}%`} />)}
                          </div>
                        ))
                      }
                    </div>
                    <Table label="Accounts to watch" size="sm" columns={accountColumns} rows={accounts} class={dashTable}>
                      {(row: TableRow, key: string) => key === "signal" && <Badge variant={row.tone as "danger"}>{row.signal}</Badge>}
                    </Table>
                  </div>

                  <div class={dashPanel}>
                    <div class={insightCard}>
                      <p class={insightLabel}><span aria-hidden="true" class={insightDot}></span>Insight</p>
                      <p class={insightTitle}>Repeat orders in Medan fell 18% this week</p>
                      <p class={insightText}>Most of the drop comes from orders placed after the courier switch on 3 November.</p>
                      <ul class={driverList}>
                        {
                          drivers.map((driver) => (
                            <li class={driverRow}>
                              <p class={driverHead}><span>{driver.label}</span><span class={driverValue}>{driver.value}</span></p>
                              <div class={driverTrack}><div class={driverBar} style={`width: ${driver.width}`} /></div>
                            </li>
                          ))
                        }
                      </ul>
                      <Button size="sm" class={insightAction} data-nalar-alert>Create alert</Button>
                    </div>
                    <p class={feedTitle}>Recent alerts</p>
                    <ul class={feedList}>
                      {feed.map((item) => <li class={feedItem}><p class={feedText}>{item.text}</p><p class={feedTime}>{item.time}</p></li>)}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <div class={logoWrap}>
            <LogoCloud title="Data teams at retailers, marketplaces, and logistics companies ask Nalar first" logos={logos} variant="row" />
          </div>

          <section id="features" aria-labelledby="nalar-features" class={section}>
            <div class={sectionHead}>
              <h2 id="nalar-features" class={h2}>Everything between a question and the fix</h2>
              <p class={lead}>Nalar does the digging an analyst would do on a slow week, every hour, on every metric you care about.</p>
            </div>
            <ul class={featureGrid}>
              <li class={featureWide}>
                <div aria-hidden="true" class={featureArt}>
                  <p class={askBubble}>Why did repeat orders drop in Medan?</p>
                  <div class={answerBubble}>
                    <p>Delivery time rose from 2.1 to 3.4 days after the courier switch on 3 Nov. It explains 71% of the drop.</p>
                    <p class={answerSource}>From orders, shipments, and courier_events</p>
                  </div>
                </div>
                <div>
                  <span class={featureIcon}><Fragment set:html={icon("bulb", "size-5")} /></span>
                  <h3 class={featureTitle}>Answers in plain language</h3>
                  <p class={featureText}>Ask why a number moved. Nalar reads the tables behind it, tests the likely causes, and replies with the two or three that explain most of the change.</p>
                </div>
              </li>
              <li class={featureCard}>
                <div aria-hidden="true" class={featureArt}>
                  {
                    alerts.map((item) => (
                      <div class={alertRow}>
                        <div>
                          <Badge variant={item.tone}>{item.badge}</Badge>
                          <p class={alertText}>{item.text}</p>
                        </div>
                        <span class={alertTime}>{item.time}</span>
                      </div>
                    ))
                  }
                </div>
                <div>
                  <span class={featureIcon}><Fragment set:html={icon("bell", "size-5")} /></span>
                  <h3 class={featureTitle}>Alerts that explain themselves</h3>
                  <p class={featureText}>Thresholds and anomaly checks on any metric, with the likely cause attached, so the person on call knows where to look first.</p>
                </div>
              </li>
              <li class={featureCard}>
                <div aria-hidden="true" class={featureArt}>
                  <ol class={flowList}>
                    {
                      flowSteps.map((text, index) => (
                        <li>
                          {index > 0 && <div class={flowLink} />}
                          <p class={index === flowSteps.length - 1 ? flowStepLast : flowStep}><span class={flowNumber}>{index + 1}</span>{text}</p>
                        </li>
                      ))
                    }
                  </ol>
                </div>
                <div>
                  <span class={featureIcon}><Fragment set:html={icon("flow", "size-5")} /></span>
                  <h3 class={featureTitle}>Workflows that close the loop</h3>
                  <p class={featureText}>Post to a team channel, open a ticket, or pause an ad campaign. Every action is logged with the data that triggered it.</p>
                </div>
              </li>
              <li class={featureWide}>
                <div aria-hidden="true" class={featureArt}>
                  <ul class={sourceGrid}>
                    {sources.map((source) => <li class={sourceChip}><Fragment set:html={icon("database", sourceIcon)} />{source}<span class={sourceDot}></span></li>)}
                  </ul>
                </div>
                <div>
                  <span class={featureIcon}><Fragment set:html={icon("database", "size-5")} /></span>
                  <h3 class={featureTitle}>Connects to the data you already have</h3>
                  <p class={featureText}>Read-only connections to warehouses, databases, and spreadsheets. Most teams are live in an afternoon, without moving a single table.</p>
                </div>
              </li>
            </ul>
          </section>

          <section id="how" aria-labelledby="nalar-how" class={section}>
            <div class={sectionHead}>
              <h2 id="nalar-how" class={h2}>From raw tables to a decision in three steps</h2>
              <p class={lead}>Use the CLI, the web app, or both. Everything you set up in one shows up in the other.</p>
            </div>
            <Tabs class={howTabs} defaultValue="connect" items={steps.map(({ value, label }) => ({ value, label }))}>
              {
                steps.map((step) => (
                  <div slot={step.value} class={howPanel}>
                    <div>
                      <h3 class={howTitle}>{step.title}</h3>
                      <p class={howText}>{step.text}</p>
                    </div>
                    <div class={terminal}>
                      <p class={terminalHead}><span class={terminalTitle}><Fragment set:html={icon("terminal", terminalIcon)} />Terminal</span><span>{step.file}</span></p>
                      <div class={terminalBody}>
                        {step.lines.map((line) => <p class={lineClass[line.kind]}>{line.kind === "cmd" && <span aria-hidden="true" class={linePrompt}>$</span>}{line.text}</p>)}
                      </div>
                    </div>
                  </div>
                ))
              }
            </Tabs>
          </section>

          <section id="customers" aria-labelledby="nalar-customers" class={section}>
            <div class={sectionHead}>
              <h2 id="nalar-customers" class={h2}>Teams that stopped waiting for the Monday report</h2>
            </div>
            <div class={storyCard}>
              <figure>
                <blockquote class={storyQuote}>We used to spend Monday morning arguing about why a number moved. Now the reason is in the channel before anyone asks, and the meeting is about what to do next.</blockquote>
                <figcaption class={person}>
                  <img src="/template-images/nalar/clara.webp" alt="" width="48" height="48" loading="lazy" decoding="async" class={photoLg} />
                  <div>
                    <p class={personName}>Clara Wijaya</p>
                    <p class={personRole}>Head of Growth, Sagara Commerce</p>
                  </div>
                </figcaption>
              </figure>
              <dl class={metricList}>
                {metrics.map((item) => <div class={metric}><dt class={metricLabel}>{item.label}</dt><dd class={metricValue}>{item.value}</dd></div>)}
              </dl>
            </div>
            <ul class={quoteGrid}>
              {
                quotes.map((quote) => (
                  <li class={quoteCard}>
                    <blockquote class={quoteText}>{quote.text}</blockquote>
                    <div class={person}>
                      <img src={quote.photo} alt="" width="40" height="40" loading="lazy" decoding="async" class={photoMd} />
                      <div>
                        <p class={personName}>{quote.name}</p>
                        <p class={personRole}>{quote.role}</p>
                      </div>
                    </div>
                  </li>
                ))
              }
            </ul>
          </section>

          <section id="pricing" aria-labelledby="nalar-pricing" class={section}>
            <div class={pricingHead}>
              <div class={sectionHead}>
                <h2 id="nalar-pricing" class={h2}>Pricing that grows with your data</h2>
                <p class={lead}>Start free on three sources. Upgrade when Nalar is part of how your team works.</p>
              </div>
              <ToggleGroup label="Billing period" items={billing} value="monthly" data-nalar-billing />
            </div>
            <ul data-billing="monthly" class={planGrid}>
              {
                plans.map((plan) => (
                  <li class={plan.featured ? planFeatured : planCard}>
                    <div class={planTop}>
                      <h3 class={planName}>{plan.name}</h3>
                      {plan.featured && <Badge variant="primary">{plan.featured}</Badge>}
                    </div>
                    <p class={planPrice} data-plan-price>{priceOf(plan, "monthly")}</p>
                    <p class={planUnit} data-plan-unit>{unitOf(plan, "monthly")}</p>
                    <p class={planDesc}>{plan.desc}</p>
                    <ul class={planList}>
                      {plan.features.map((feature) => <li class={planItem}><Fragment set:html={icon("check", planIcon)} />{feature}</li>)}
                    </ul>
                    <div class={planSpacer}></div>
                    <a href="#start" class={plan.featured ? planCtaFeatured : planCta}>{plan.cta}</a>
                  </li>
                ))
              }
            </ul>
          </section>

          <section id="faq" aria-labelledby="nalar-faq" class={faqLayout}>
            <div class={faqAside}>
              <h2 id="nalar-faq" class={h2}>Questions before you connect</h2>
              <p class={lead}>Talk to the engineers who build Nalar, not a sales script.</p>
              <Button variant="secondary" data-nalar-call>Book a 20 minute call</Button>
            </div>
            <Faq items={faqs} exclusive class={faqList} />
          </section>

          <section id="start" aria-labelledby="nalar-start" class={ctaWrap}>
            <div class={ctaCard}>
              <div class={sectionHead}>
                <h2 id="nalar-start" class={h2}>Put Nalar on your own data this week</h2>
                <p class={lead}>Early access is open for teams in Indonesia and Southeast Asia. Connect a source, ask the first question, and keep everything you build.</p>
              </div>
              <form class={ctaForm} novalidate data-nalar-form>
                <label for={`${FORM_ID}-email`} class={fieldLabel}>Work email</label>
                <div class={fieldRow}>
                  <div class={fieldWrap}>
                    <Input id={`${FORM_ID}-email`} type="email" name="email" autocomplete="email" placeholder="nama@perusahaan.co.id" />
                    <p id={`${FORM_ID}-error`} class={fieldError} hidden></p>
                  </div>
                  <Button type="submit">Request access</Button>
                </div>
                <p class={ctaNote}>Free for 3 sources. No credit card needed.</p>
              </form>
            </div>
          </section>
        </main>

        <Footer class={footer} description="Nalar explains what changed in your business data and sends it to the team that can act." columns={footerColumns} legal={legal} copyright="© 2026 Nalar. Built with MarkasUI.">
          <Fragment slot="brand" set:html={brandHtml} />
        </Footer>
        <Toaster />
      </div>
    </div>
  </div>
</nalar-template>

<script>
  type PlanText = { monthly: string; yearly: string; unitMonthly: string; unitYearly: string };
  type Config = {
    formId: string;
    emailPattern: string;
    emailError: string;
    ranges: Record<string, { sub: string; note: string }>;
    plans: PlanText[];
  };
  type ToastDetail = { title: string; description: string; variant?: string };

  const toast = (detail: ToastDetail) => window.dispatchEvent(new CustomEvent("markas-toast", { detail }));

  /** Satu elemen per template: menu mobile, rentang dasbor, harga, form akses, toast. */
  class NalarTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onSubmit = (event: Event) => this.handleSubmit(event);

    connectedCallback() {
      this.addEventListener("click", this.onClick);
      this.addEventListener("submit", this.onSubmit);
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("submit", this.onSubmit);
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      // Navbar tidak menutup menu mobile saat link di-klik; tutup lewat tombolnya sendiri.
      if (target.closest("[data-state=open] a"))
        return this.querySelector<HTMLButtonElement>("header button[aria-expanded=true]")?.click();
      const range = target.closest<HTMLButtonElement>("[data-nalar-ranges] > button");
      if (range) return this.pick(event, range, (value) => this.showRange(value));
      const period = target.closest<HTMLButtonElement>("[data-nalar-billing] > button");
      if (period) return this.pick(event, period, (value) => this.showPeriod(value));
      if (target.closest("[data-nalar-alert]"))
        return toast({ title: "Alert created", description: "Nalar will post to #ops-medan when repeat orders in Medan drop again.", variant: "success" });
      if (target.closest("[data-nalar-call]"))
        toast({ title: "Call requested", description: "An engineer will email you a time slot within one working day." });
    }

    /** ToggleGroup mengosongkan pilihan saat item aktif diklik lagi; hentikan supaya selalu ada pilihan. */
    private pick(event: Event, button: HTMLButtonElement, apply: (value: string) => void) {
      if (button.getAttribute("aria-pressed") === "true") return event.stopPropagation();
      apply(button.dataset.value!);
    }

    private showRange(value: string) {
      for (const list of this.querySelectorAll<HTMLElement>("[data-nalar-kpis]")) list.hidden = list.dataset.nalarKpis !== value;
      for (const bars of this.querySelectorAll<HTMLElement>("[data-nalar-bars]")) bars.hidden = bars.dataset.nalarBars !== value;
      const text = this.config.ranges[value]!;
      this.querySelector("[data-range]")!.setAttribute("data-range", value);
      this.querySelector("[data-range-sub]")!.textContent = text.sub;
      this.querySelector("[data-range-note]")!.textContent = text.note;
    }

    private showPeriod(value: string) {
      const yearly = value === "yearly";
      this.querySelector("[data-billing]")!.setAttribute("data-billing", value);
      const prices = this.querySelectorAll("[data-plan-price]");
      const units = this.querySelectorAll("[data-plan-unit]");
      this.config.plans.forEach((plan, index) => {
        prices[index]!.textContent = yearly ? plan.yearly : plan.monthly;
        units[index]!.textContent = yearly ? plan.unitYearly : plan.unitMonthly;
      });
    }

    private handleSubmit(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-nalar-form]")) return;
      event.preventDefault();
      const { formId, emailPattern, emailError } = this.config;
      const field = form.querySelector<HTMLInputElement>(`#${formId}-email`)!;
      const note = form.querySelector<HTMLElement>(`#${formId}-error`)!;
      const value = field.value.trim();
      const invalid = !new RegExp(emailPattern).test(value);
      note.hidden = !invalid;
      note.textContent = invalid ? emailError : "";
      if (invalid) {
        field.setAttribute("aria-invalid", "true");
        field.setAttribute("aria-describedby", note.id);
        return;
      }
      field.removeAttribute("aria-invalid");
      field.removeAttribute("aria-describedby");
      toast({
        title: "You are on the list",
        description: `We sent setup steps to ${value}. Most teams connect their first source within a day.`,
        variant: "success",
      });
      form.reset();
    }
  }

  if (!customElements.get("nalar-template")) customElements.define("nalar-template", NalarTemplate);
</script>
