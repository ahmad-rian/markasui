const rupiah = (value: number) =>
  `Rp ${String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ".")}`;
const priceFrom = (category: string) =>
  `From ${rupiah(Math.min(...products.filter((item) => item.category === category).map((item) => item.price)))}`;
const countLabel = (shown: number) =>
  shown === products.length
    ? `Showing all ${products.length} bakes`
    : `Showing ${shown} of ${products.length} bakes`;
const itemsWord = (count: number) => (count === 1 ? "item" : "items");
const deliveryNote = (subtotal: number) =>
  subtotal >= FREE_DELIVERY
    ? "Free delivery applied. Arrives tomorrow, 7 to 10 am."
    : `Add ${rupiah(FREE_DELIVERY - subtotal)} more for free delivery in Jogja.`;
const chatToast = {
  title: "Opening WhatsApp",
  description:
    "Chat with Pawon Ragi at +62 812 2019 0600. We reply within 15 minutes, 7 am to 9 pm.",
};

const icon = (name: IconName, className: string) =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}" /></svg>`;
const footerBrandHtml = `<a href="#top" class="${footerBrand}"><span class="${footerMark}">${icon("wheat", iconMd)}</span>${BRAND}</a>`;
const config = JSON.stringify({
  cartId: CART_ID,
  emailId: EMAIL_ID,
  emailPattern: EMAIL_PATTERN.source,
  emailHint: EMAIL_HINT,
  emailError: EMAIL_ERROR,
  note: [fieldError, fieldHint],
  freeDelivery: FREE_DELIVERY,
  chat: chatToast,
  catalog: Object.fromEntries(products.map((item) => [item.id, { name: item.name, price: item.price }])),
  total: products.length,
});
---

<roti-template class="contents" data-config={config}>
  <div id="top" class={root}>
    <p class={promoBar}>Free delivery in Jogja on orders over Rp 150.000. Order by 10 pm for tomorrow morning.</p>
    <header class={header}>
      <div class={headerRow}>
        <a href="#top" class={brandLink}><span class={brandMark}><Fragment set:html={icon("wheat", iconMd)} /></span><span class={brandName}>{BRAND}</span></a>
        <nav aria-label="Main" class={navList}>
          {nav.map((link) => <a href={link.href} class={navLink}>{link.label}</a>)}
        </nav>
        <div class={headerActions}>
          <button type="button" class={chatButton} data-roti-chat><Fragment set:html={icon("chat", iconSm)} />Order on WhatsApp</button>
          <button type="button" class={basketButton} data-roti-open-cart><Fragment set:html={icon("bag", iconSm)} />Basket <span data-cart-count="" class={basketCount}>0</span> <span class={srOnly} data-roti-items-word>{itemsWord(0)}</span></button>
        </div>
      </div>
    </header>

    <main>
      <section aria-labelledby="roti-title" class={hero}>
        <div class={heroGrid}>
          <div class={heroCopy}>
            <p class={heroKicker}><Fragment set:html={icon("pin", iconSm)} />Baked daily in Kotabaru, Yogyakarta</p>
            <h1 id="roti-title" class={h1}>{TITLE}</h1>
            <p class={heroLead}>Croissants, roti sobek, and soft pretzels made with real butter and an 18-hour dough. Order by 10 pm and we deliver warm between 7 and 10 the next morning.</p>
            <div class={heroActions}>
              <a href="#menu" class={heroPrimary}>Order now<Fragment set:html={icon("arrow", iconSm)} /></a>
              <button type="button" class={heroSecondary} data-roti-chat><Fragment set:html={icon("chat", iconSm)} />Chat on WhatsApp</button>
            </div>
          </div>
          <div class={heroPhotoLeft}>
            <img src={image("hero-pretzels")} alt="A basket of glossy brown pretzels on the bakery counter" width="640" height="800" fetchpriority="high" decoding="async" class={heroImage} />
          </div>
          <div class={heroPhotoRight}>
            <img src={image("hero-buns")} alt="A tray of cinnamon buns fresh from the oven" width="640" height="800" fetchpriority="high" decoding="async" class={heroImage} />
          </div>
        </div>
        <div class={container}>
          <ul aria-label="Pawon Ragi in numbers" class={statsList}>
            {stats.map((stat) => (
              <li>
                <p class={statValue}>{stat.value}</p>
                <p class={statLabel}>{stat.label}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section aria-labelledby="roti-categories" class={section}>
        <p class={kicker}>Fresh today</p>
        <h2 id="roti-categories" class={h2}>What we bake</h2>
        <ul class={catGrid}>
          {categoryCards.map((card) => (
            <li>
              <a href="#menu" class={catLink} data-roti-category={card.value}>
                <div class={catMedia}>
                  <img src={image(card.image)} alt="" width="640" height="512" loading="lazy" decoding="async" class={catImage} />
                </div>
                <div class={catBody}>
                  <h3 class={catName}>{card.label}</h3>
                  <p class={catText}>{card.text}</p>
                  <p class={catFoot}>{priceFrom(card.value)}<span class={catArrow}><Fragment set:html={icon("arrow", iconSm)} /></span></p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="story" aria-labelledby="roti-story" class={storyGrid}>
        <figure class={storyMedia}>
          <img src={image("story")} alt="A baker in a hijab wrapping a loaf in brown paper in the Pawon Ragi kitchen" width="800" height="1000" loading="lazy" decoding="async" class={storyImage} />
          <figcaption class={storyNote}>Sekar wraps the first delivery run herself, every morning at 6.45.</figcaption>
        </figure>
        <div>
          <p class={kicker}>Our story</p>
          <h2 id="roti-story" class={h2}>Sekar and the team</h2>
          <p class={storyText}>Pawon Ragi started in 2019 with one oven in Sekar's garage and a WhatsApp group of twelve neighbours. She baked the roti sobek her grandmother made in Kotagede, then added the croissants and pretzels she learned to laminate and knot in a bakery job abroad.</p>
          <p class={storyText}>Today fourteen bakers and couriers work from a small kitchen on Jalan Suroto. The recipes have not changed: real butter, local flour, and no shortcuts on time.</p>
          <ul class={factList}>
            {facts.map((fact) => (
              <li>
                <p class={factValue}>{fact.value}</p>
                <p class={factLabel}>{fact.label}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section aria-labelledby="roti-rack" class={section}>
        <h2 id="roti-rack" class={rackHead}>On the racks this morning</h2>
        <ul class={rackList}>
          {rack.map((item) => (
            <li>
              <a href="#menu" class={rackLink} data-roti-category={item.value}>
                <img src={image(item.image)} alt="" width="320" height="320" loading="lazy" decoding="async" class={rackImage} />
                <span class={rackLabel}>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section id="menu" aria-labelledby="roti-menu" class={section}>
        <div class={sectionHead}>
          <div>
            <p class={kicker}>Order for tomorrow</p>
            <h2 id="roti-menu" class={h2}>Our bakes</h2>
            <p class={lead}>Prices are per piece unless noted. Everything is baked the morning it is delivered.</p>
          </div>
        </div>
        <div class={toolbar}>
          <div class={filterRow}>
            <div class={filterScroll}>
              <ToggleGroup label="Filter bakes by category" items={categories} value="all" class={filterGroup} data-roti-filter />
            </div>
            <p aria-live="polite" class={countText} data-roti-count>{countLabel(products.length)}</p>
          </div>
          <div class={stripControls}>
            <button type="button" aria-label="Scroll bakes back" aria-controls={STRIP_ID} class={stripButton} data-roti-scroll="-1"><Fragment set:html={icon("back", iconMd)} /></button>
            <button type="button" aria-label="Scroll more bakes" aria-controls={STRIP_ID} class={stripButton} data-roti-scroll="1"><Fragment set:html={icon("arrow", iconMd)} /></button>
          </div>
        </div>
        <ul id={STRIP_ID} class={strip} data-roti-strip>
          {products.map((product) => (
            <li data-product={product.id} data-category={product.category} class={productCard}>
              <div class={productMedia}>
                <img src={image(product.id)} alt="" width="560" height="560" loading="lazy" decoding="async" class={productImage} />
                {product.tag && <span class={productTag}>{product.tag}</span>}
              </div>
              <div class={productBody}>
                <h3 class={productName}>{product.name}</h3>
                <p class={productText}>{product.text}</p>
                <div class={productFoot}>
                  <p class={productPrice}>{rupiah(product.price)}</p>
                  <Button size="sm" class={addButton} aria-label={`Add to basket, ${product.name}`} data-roti-add={product.id}><Fragment set:html={icon("plus", iconSm)} />Add</Button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="how" aria-labelledby="roti-how" class={howBand}>
        <div class={howGrid}>
          <div>
            <p class={kicker}>How it's made</p>
            <h2 id="roti-how" class={h2}>Eighteen hours from flour to your table</h2>
            <ol class={stepList}>
              {steps.map((step, index) => (
                <li class={stepItem}>
                  <span aria-hidden="true" class={stepNumber}>{index + 1}</span>
                  <div>
                    <h3 class={stepTitle}>{step.title}</h3>
                    <p class={stepText}>{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <img src={image("oven")} alt="Two bakers shaping dough on a long table in front of a brick oven" width="1200" height="800" loading="lazy" decoding="async" class={howImage} />
        </div>
      </section>

      <section id="reviews" aria-labelledby="roti-reviews" class={section}>
        <div class={sectionHead}>
          <div>
            <p class={kicker}>Reviews</p>
            <h2 id="roti-reviews" class={h2}>What people are saying</h2>
          </div>
          <p class={ratingLine}><span class={ratingValue}>4.9 out of 5</span>from 6.100 reviews</p>
        </div>
        <ul class={reviewGrid}>
          {reviews.map((review) => (
            <li>
              <figure class={reviewCard}>
                <p class={stars}>{ratingStars.map(() => <Fragment set:html={icon("star", star)} />)}<span class={srOnly}>Rated 5 out of 5</span></p>
                <blockquote class={reviewText}>{review.text}</blockquote>
                <figcaption class={person}>
                  <Avatar name={review.name} size="md" />
                  <div>
                    <p class={personName}>{review.name}</p>
                    <p class={personMeta}>{review.meta}</p>
                  </div>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>

      <section id="faq" aria-labelledby="roti-faq" class={faqLayout}>
        <div class={faqAside}>
          <p class={kicker}>FAQ</p>
          <h2 id="roti-faq" class={h2}>Good to know</h2>
          <p class={lead}>Still wondering about something? Our team answers on WhatsApp from 7 am to 9 pm, every day.</p>
          <Button variant="secondary" class={faqButton} data-roti-chat><Fragment set:html={icon("chat", iconSm)} />Ask on WhatsApp</Button>
        </div>
        <Faq items={faqs} exclusive class={faqList} />
      </section>

      <div class={newsWrap}>
        <section aria-labelledby="roti-news" class={newsBand}>
          <div>
            <h2 id="roti-news" class={newsTitle}>Stay in the loop</h2>
            <p class={newsText}>New bakes every Friday, early pre-order slots for holiday hampers, and one discount code a month.</p>
          </div>
          <form class={form} novalidate data-roti-news>
            <label for={EMAIL_ID} class={fieldLabel}>Email address</label>
            <div class={fieldRow}>
              <Input id={EMAIL_ID} type="email" name="email" autocomplete="email" placeholder="nama@email.com" class={field} aria-describedby={`${EMAIL_ID}-note`} />
              <Button type="submit" class={fieldButton}>Subscribe</Button>
            </div>
            <p id={`${EMAIL_ID}-note`} class={fieldHint}>{EMAIL_HINT}</p>
          </form>
        </section>
      </div>
    </main>

    <Footer variant="big-brand" class={footer} description="An artisan bakery on Jalan Suroto, Kotabaru, Yogyakarta. Open every day, 6 am to 9 pm." columns={footerColumns} legal={legal} copyright="© 2026 Pawon Ragi. Built with MarkasUI." wordmark={BRAND}>
      <Fragment slot="brand" set:html={footerBrandHtml} />
      <ul slot="actions" aria-label="Payment methods" class={payRow}>
        {payments.map((method) => <li class={payBadge}>{method}</li>)}
      </ul>
    </Footer>

    <Drawer id={CART_ID} title="Your basket">
      <p class={cartEmpty} data-roti-empty>Your basket is empty. Add a bake to get started.</p>
      <ul class={cartList} hidden data-roti-lines></ul>
      <template data-roti-line-template>
        <li class={cartLine}>
          <img alt="" width="56" height="56" loading="lazy" decoding="async" class={cartImage} />
          <div class="min-w-0">
            <p class={cartName} data-field="name"></p>
            <p class={cartMeta} data-field="meta"></p>
          </div>
          <div class={stepper}>
            <button type="button" class={stepButton} data-roti-step="-1"><Fragment set:html={icon("minus", iconSm)} /></button>
            <span class={stepValue} data-field="qty"></span>
            <button type="button" class={stepButton} data-roti-step="1"><Fragment set:html={icon("plus", iconSm)} /></button>
          </div>
        </li>
      </template>
      <div class={cartSummary}>
        <p class={summaryRow}><span>Subtotal</span><span data-subtotal="">{rupiah(0)}</span></p>
        <p class={shipNote} data-roti-ship>{deliveryNote(0)}</p>
      </div>
      <Fragment slot="footer">
        <Button variant="secondary" type="submit" value="cancel">Keep browsing</Button>
        <Button type="submit" value="checkout" disabled data-roti-checkout>Order on WhatsApp</Button>
      </Fragment>
    </Drawer>

    <Toaster />
  </div>
</roti-template>

<script>
  type Item = { name: string; price: number };
  type ToastDetail = { title: string; description: string; variant?: string };
  type Config = {
    cartId: string;
    emailId: string;
    emailPattern: string;
    emailHint: string;
    emailError: string;
    note: [string, string];
    freeDelivery: number;
    chat: ToastDetail;
    catalog: Record<string, Item>;
    total: number;
  };

  const toast = (detail: ToastDetail) => window.dispatchEvent(new CustomEvent("markas-toast", { detail }));
  const rupiah = (value: number) => `Rp ${String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ".")}`;
  const itemsWord = (count: number) => (count === 1 ? "item" : "items");
  const itemsLabel = (count: number) => `${count} ${itemsWord(count)}`;
  const setClasses = (element: Element, on: boolean, [active, idle]: string[]) => {
    element.classList.remove(...(on ? idle! : active!).split(" "));
    element.classList.add(...(on ? active! : idle!).split(" "));
  };

  /** Satu elemen per template: filter kategori, strip bakes, keranjang, WhatsApp, newsletter. */
  class RotiTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private cart: Record<string, number> = {};
    private products: HTMLElement[] = [];
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onSubmit = (event: Event) => this.handleSubmit(event);
    private readonly onClose = (event: Event) => this.drawerClosed(event);

    connectedCallback() {
      this.products = [...this.querySelectorAll<HTMLElement>("[data-product]")];
      this.addEventListener("click", this.onClick);
      this.addEventListener("submit", this.onSubmit);
      // close tidak bubble: didengar di fase capture.
      this.addEventListener("close", this.onClose, true);
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("close", this.onClose, true);
    }

    private strip() {
      return this.querySelector<HTMLElement>("[data-roti-strip]")!;
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      const toggle = target.closest<HTMLButtonElement>("[data-roti-filter] > button");
      if (toggle) return this.pickToggle(event, toggle);
      const category = target.closest<HTMLElement>("[data-roti-category]");
      if (category) return this.setCategory(category.dataset.rotiCategory!);
      const add = target.closest<HTMLElement>("[data-roti-add]");
      if (add) return this.addToCart(add.dataset.rotiAdd!);
      const step = target.closest<HTMLElement>("[data-roti-step]");
      if (step) return this.changeQty(step.closest<HTMLElement>("[data-cart-line]")!.dataset.cartLine!, Number(step.dataset.rotiStep));
      const scroll = target.closest<HTMLElement>("[data-roti-scroll]");
      if (scroll) {
        const list = this.strip();
        return list.scrollBy({ left: Number(scroll.dataset.rotiScroll) * list.clientWidth * 0.8 });
      }
      if (target.closest("[data-roti-open-cart]")) return (document.getElementById(this.config.cartId) as HTMLDialogElement).showModal();
      if (target.closest("[data-roti-chat]")) toast(this.config.chat);
    }

    /** ToggleGroup mengosongkan pilihan saat item aktif diklik lagi; hentikan supaya selalu ada pilihan. */
    private pickToggle(event: Event, button: HTMLButtonElement) {
      if (button.getAttribute("aria-pressed") === "true") return event.stopPropagation();
      // Tombol grup ditekan oleh script ToggleGroup sendiri.
      this.setCategory(button.dataset.value!, false);
    }

    /* Filter bakes: kartu disaring dengan memasang ulang <li>, seperti React. */
    private setCategory(category: string, syncToggle = true) {
      const list = this.strip();
      const visible = this.products.filter((product) => category === "all" || product.dataset.category === category);
      list.replaceChildren(...visible);
      list.scrollTo({ left: 0 });
      const { total } = this.config;
      this.querySelector("[data-roti-count]")!.textContent =
        visible.length === total ? `Showing all ${total} bakes` : `Showing ${visible.length} of ${total} bakes`;
      if (!syncToggle) return;
      this.querySelectorAll<HTMLButtonElement>("[data-roti-filter] > button").forEach((button) => {
        const on = button.dataset.value === category;
        button.setAttribute("aria-pressed", String(on));
        button.dataset.state = on ? "on" : "off";
        button.tabIndex = on ? 0 : -1;
      });
    }

    private addToCart(id: string) {
      const count = this.cartCount();
      this.cart = { ...this.cart, [id]: (this.cart[id] ?? 0) + 1 };
      this.renderCart();
      toast({ title: "Added to your basket", description: `${this.config.catalog[id]!.name}. Your basket has ${itemsLabel(count + 1)}.`, variant: "success" });
    }

    private changeQty(id: string, step: number) {
      const qty = (this.cart[id] ?? 0) + step;
      this.cart = qty > 0 ? { ...this.cart, [id]: qty } : Object.fromEntries(Object.entries(this.cart).filter(([key]) => key !== id));
      this.renderCart();
    }

    private cartCount() {
      return Object.values(this.cart).reduce((sum, qty) => sum + qty, 0);
    }

    private subtotal() {
      return Object.entries(this.cart).reduce((sum, [id, qty]) => sum + qty * this.config.catalog[id]!.price, 0);
    }

    private renderCart() {
      const count = this.cartCount();
      const subtotal = this.subtotal();
      this.querySelector("[data-cart-count]")!.textContent = String(count);
      this.querySelector("[data-roti-items-word]")!.textContent = itemsWord(count);
      const template = this.querySelector<HTMLTemplateElement>("[data-roti-line-template]")!;
      const rows = Object.entries(this.cart).map(([id, qty]) => {
        const item = this.config.catalog[id]!;
        const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        row.dataset.cartLine = id;
        row.querySelector("img")!.src = `/template-images/roti/${id}.webp`;
        row.querySelector("[data-field=name]")!.textContent = item.name;
        row.querySelector("[data-field=meta]")!.textContent = `${qty} x ${rupiah(item.price)}`;
        row.querySelector("[data-field=qty]")!.textContent = String(qty);
        const [less, more] = row.querySelectorAll("button");
        less!.setAttribute("aria-label", `Remove one ${item.name}`);
        more!.setAttribute("aria-label", `Add one ${item.name}`);
        return row;
      });
      const list = this.querySelector<HTMLElement>("[data-roti-lines]")!;
      list.replaceChildren(...rows);
      list.hidden = rows.length === 0;
      this.querySelector<HTMLElement>("[data-roti-empty]")!.hidden = rows.length > 0;
      this.querySelector("[data-subtotal]")!.textContent = rupiah(subtotal);
      const { freeDelivery } = this.config;
      this.querySelector("[data-roti-ship]")!.textContent =
        subtotal >= freeDelivery ? "Free delivery applied. Arrives tomorrow, 7 to 10 am." : `Add ${rupiah(freeDelivery - subtotal)} more for free delivery in Jogja.`;
      this.querySelector<HTMLButtonElement>("[data-roti-checkout]")!.disabled = count === 0;
    }

    private handleSubmit(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-roti-news]")) return;
      event.preventDefault();
      const { emailId, emailPattern, emailHint, emailError, note } = this.config;
      const field = form.querySelector<HTMLInputElement>(`#${emailId}`)!;
      const hint = form.querySelector<HTMLElement>(`#${emailId}-note`)!;
      const value = field.value.trim();
      const valid = new RegExp(emailPattern).test(value);
      setClasses(hint, !valid, note);
      hint.textContent = valid ? emailHint : emailError;
      if (!valid) return field.setAttribute("aria-invalid", "true");
      field.removeAttribute("aria-invalid");
      field.value = "";
      toast({ title: "You are on the list", description: `The Friday bake list goes to ${value}.`, variant: "success" });
    }

    private drawerClosed(event: Event) {
      const dialog = event.target;
      if (!(dialog instanceof HTMLDialogElement) || dialog.id !== this.config.cartId) return;
      if (dialog.returnValue === "checkout")
        toast({
          title: "Sending your order on WhatsApp",
          description: `${itemsLabel(this.cartCount())}, ${rupiah(this.subtotal())}. We will confirm your delivery slot in a few minutes.`,
          variant: "success",
        });
      dialog.returnValue = "";
    }
  }

  if (!customElements.get("roti-template")) customElements.define("roti-template", RotiTemplate);
</script>
