  `<span class="${socket}"><button type="button" aria-label="${label}" class="${cornerButton}" data-pipe-lead="${leadId}">${icon("arrow")}</button></span>`;
const leadCardHtml = (lead: Lead) =>
  `<li data-lead="${lead.id}" class="${cx(card, "min-h-48 bg-surface")}"><div class="flex items-center gap-3 pr-14">${faceHtml(lead.name, "size-12 text-sm")}<div class="min-w-0"><h3 class="truncate text-xl font-semibold tracking-tight"><button type="button" class="${selectable}" data-pipe-lead="${lead.id}">${lead.name}</button></h3><p class="text-sm text-muted">${lead.role} @ ${lead.company}</p></div></div>${cornerHtml(`Open ${lead.name}`, lead.id)}<dl class="mt-auto grid grid-cols-2 gap-3 pt-6"><div><dt class="text-xs text-muted">Source</dt><dd class="mt-1.5"><span class="${sourceChip}">${lead.source}</span></dd></div><div><dt class="text-xs text-muted">Interest</dt><dd class="mt-1.5 flex h-7 items-center gap-2 text-sm font-medium"><span aria-hidden="true" class="${cx("size-2 rounded-full", interests[lead.interest].dot)}"></span>${interests[lead.interest].label}</dd></div></dl></li>`;
const chipsHtml = (label: string, items: { id: string; label: string }[], name: string) =>
  `<div role="group" aria-label="${label}" class="flex flex-wrap gap-2" data-pipe-chips="${name}">${items
    .map(
      (item) =>
        `<button type="button" aria-pressed="${item.id === "all"}" data-value="${item.id}" class="${cx(chip, item.id === "all" ? chipOn : chipOff)}">${item.id === "hot" ? icon("flame", "size-4 text-(--tpl-hot)") : ""}${item.label}</button>`,
    )
    .join("")}</div>`;
const leadFields = (lead: Lead) => [
  ["Interest", interests[lead.interest].label],
  ["Source", lead.source],
  ["Deal value", rupiah(lead.value)],
  ["Phone", lead.phone],
];

/** Data dan class yang dipakai script di klien. */
const config = JSON.stringify({
  pages,
  defaultPage: DEFAULT_PAGE,
  titleId: TITLE_ID,
  drawerId: LEAD_DRAWER,
  preview: LEAD_PREVIEW,
  leads: leads.map((lead) => ({
    ...lead,
    interestLabel: interests[lead.interest].label,
    fields: leadFields(lead),
  })),
  interestIds,
  meetings,
  tasks: tasks.map(({ id, title, time, meeting, status, tags }) => ({ id, title, time, meeting, status, tags })),
  stages,
  deals: dealList,
  week,
  threads: threadList,
  faceTones,
  classes: {
    railActive, railIdle, menuIdle, chipOn, chipOff, sortOn, slotOn, controlOn, controlOff,
    dayIdle, threadOn, threadOff, mineBubble, theirBubble, bubble,
    tones: taskTones,
  },
});
---

<pipeline-template class="contents" data-config={config}>
  <div class={shell}>
    <header class="flex h-20 items-center gap-4 px-4 lg:px-6">
      <Drawer title="Menu" side="left">
        <button slot="trigger" type="button" aria-label="Open menu" class={cx(roundButton, "lg:hidden")} set:html={icon("menu")} />
        <form method="dialog" class="grid gap-1">
          {pageIds.map((id) => (
            <button type="submit" aria-current={id === DEFAULT_PAGE ? "page" : undefined} data-pipe-go={id} data-pipe-idle={menuIdle} class={cx(menuItem, id === DEFAULT_PAGE ? railActive : menuIdle)}><Fragment set:html={icon(pages[id].icon)} />{pages[id].label}</button>
          ))}
        </form>
      </Drawer>
      <div class="flex shrink-0 items-center gap-2.5">
        <span aria-hidden="true" class="flex size-11 items-center justify-center rounded-full bg-(--tpl-night) text-(--tpl-lime) dark:ring-1 dark:ring-line">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 17V7M12 17V4M19 17v-6" /></svg>
        </span>
        <p class="text-lg font-bold tracking-tight">Pipeline</p>
      </div>
      <section aria-labelledby="pipeline-schedule-title" class="mx-auto hidden h-16 max-w-[880px] min-w-0 flex-1 items-center gap-5 rounded-full bg-(--tpl-night) pr-4 pl-6 text-(--tpl-on-night) xl:flex dark:ring-1 dark:ring-line">
        <div class="shrink-0 leading-tight">
          <h2 id="pipeline-schedule-title" class="text-sm font-semibold">Your Schedule</h2>
          <p class="text-xs text-(--tpl-night-muted)">Mon, 9 Nov 2026</p>
        </div>
        <div class="relative h-12 min-w-0 flex-1">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 flex text-[10px] text-(--tpl-night-muted)">
            {hourMarks.map((mark) => <span class="flex-1 border-l border-(--tpl-night-line) pl-1.5">{mark}</span>)}
          </div>
          <ul aria-label="Meetings today" class="absolute inset-x-0 bottom-0 h-8">
            {meetings.map((item) => (
              <li>
                <button type="button" aria-pressed={item.id === meeting.id ? "true" : "false"} data-pipe-meeting={item.id} class={cx(slotBase, item.id === meeting.id && slotOn)} style={`left: ${at(item.start)}; width: calc(${(MEETING_SPAN / DAY_HOURS) * 100}% - 4px)`}><Fragment set:html={faceHtml(item.who, "size-6 text-[9px]")} />{item.time}<span class="sr-only">{`, ${item.title} with ${item.who}`}</span></button>
              </li>
            ))}
          </ul>
          <span aria-hidden="true" class="absolute -top-1 bottom-0 w-0.5 rounded-full bg-(--tpl-lime) before:absolute before:-top-1 before:-left-[3px] before:size-2 before:rounded-full before:bg-(--tpl-lime)" style={`left: ${at(NOW)}`}></span>
          <span class="sr-only">Now 1:20 pm</span>
        </div>
      </section>
      <div class="ml-auto flex shrink-0 items-center gap-2 xl:ml-0">
        <button type="button" aria-label="Notifications, 3 unread" class={roundButton} data-pipe-toast="3 unread notifications" data-description="Sinta Maharani signed the NDA">
          <Fragment set:html={icon("bell")} />
          <span aria-hidden="true" class="absolute top-2.5 right-2.5 size-2 rounded-full bg-danger ring-2 ring-surface"></span>
        </button>
        <Avatar name="Ahmad Fauzi" size="md" class="ring-2 ring-surface" />
      </div>
    </header>

    <div class="px-4 pb-10 lg:grid lg:grid-cols-[48px_minmax(0,1fr)] lg:gap-6 lg:px-6">
      <div class="hidden lg:block">
        <nav aria-label="Workspace" class="sticky top-6 flex flex-col items-center gap-2">
          {pageIds.map((id) => (
            <button type="button" aria-label={pages[id].label} aria-current={id === DEFAULT_PAGE ? "page" : undefined} data-pipe-go={id} data-pipe-idle={railIdle} class={cx(railBase, id === DEFAULT_PAGE ? railActive : railIdle)} set:html={icon(pages[id].icon)} />
          ))}
          <span aria-hidden="true" class="my-1 h-px w-6 bg-line"></span>
          <button type="button" aria-label="Settings" class={cx(railBase, railIdle)} data-pipe-toast="Settings" data-description="Workspace settings are up to date" set:html={icon("settings")} />
        </nav>
      </div>

      <main class="grid min-w-0 content-start gap-8">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5 pt-2">
          <div class="flex flex-wrap items-end gap-4">
            <div>
              <p class="text-sm text-muted" data-pipe-crumb>{`Pipeline / ${pages[DEFAULT_PAGE].label}`}</p>
              <h1 id={TITLE_ID} tabindex="-1" class="mt-1 text-[34px] leading-none font-extrabold tracking-[0.14em] uppercase focus:outline-none sm:text-[56px]">{pages[DEFAULT_PAGE].title}</h1>
            </div>
            <button type="button" class={cx(pillButton, "mb-1")} data-pipe-new-task><Fragment set:html={icon("plus", "size-4")} />New Task</button>
          </div>
          <dl class="flex flex-wrap gap-x-8 gap-y-3">
            {stats.map((stat) => (
              <div class="flex items-start gap-2">
                <dt class="sr-only">{stat.unit}</dt>
                <dd class="flex items-baseline gap-1.5">
                  <span class="text-[44px] leading-none font-semibold tracking-tight tabular-nums">{stat.value}</span>
                  <span class="text-base text-muted">{stat.unit}</span>
                </dd>
                <dd class={cx("rounded-full px-2 py-0.5 text-xs font-semibold", statBadges[stat.tone])}>{stat.badge}</dd>
              </div>
            ))}
          </dl>
        </div>
        {
          /* Halaman bawaan dirender langsung (tanpa JS tetap tampil), lalu semua halaman sebagai <template>. */
          [{ live: true, id: DEFAULT_PAGE }, ...pageIds.map((id) => ({ live: false, id }))].map(({ live, id }) => {
            const Wrapper = live ? "div" : "template";
            return (
              <Wrapper class={live ? "contents" : undefined} data-pipe-view={live ? "" : undefined} data-pipe-page={live ? undefined : id}>
                {id === "workspace" && (
                  <div class="grid min-w-0 content-start gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
                    <div class="grid min-w-0 content-start gap-8">
                      <section aria-labelledby="pipeline-leads-title" class="grid gap-4">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                          <h2 id="pipeline-leads-title" class={h2}>New Leads <span class="ml-1 text-muted underline decoration-2 underline-offset-[6px]">{leads.length}</span></h2>
                          <div class="flex gap-2">
                            <button type="button" aria-label="Search leads" aria-expanded="false" class={roundButton} data-pipe-search-toggle set:html={icon("search")} />
                            <button type="button" aria-label="Sort by interest" aria-pressed="false" class={roundButton} data-pipe-sort set:html={icon("filter")} />
                          </div>
                        </div>
                        <div class="contents" hidden data-pipe-search>
                          <Input label="Search by name" type="search" class="max-w-sm" data-pipe-query="name" />
                        </div>
                        <Fragment set:html={chipsHtml("Filter leads by interest", leadChips, "leads")} />
                        <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-pipe-leads={LEAD_PREVIEW} set:html={leads.slice(0, LEAD_PREVIEW).map(leadCardHtml).join("")} />
                        <p class="text-sm text-muted" hidden data-pipe-leads-empty>No leads match this filter.</p>
                        <template data-pipe-lead-cards set:html={leads.map(leadCardHtml).join("")} />
                      </section>

                      <section aria-labelledby="pipeline-tasks-title" class="grid gap-4">
                        <h2 id="pipeline-tasks-title" class={h2}>Your Days Tasks <span class="ml-1 text-muted underline decoration-2 underline-offset-[6px]">{tasks.length}</span></h2>
                        <Fragment set:html={chipsHtml("Filter tasks", taskFilters, "tasks")} />
                        <p class="text-sm text-muted" hidden data-pipe-tasks-empty>No tasks in this view.</p>
                        <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-pipe-tasks>
                          {tasks.map((task, index) => {
                            const owner = leadById(task.lead);
                            const style = taskTones[index === 0 ? "lime" : "plain"];
                            return (
                              <li data-task={task.id} class={cx(card, "min-h-64", style.card)} data-tone="card">
                                <div class="flex items-center gap-3 pr-24">
                                  <Fragment set:html={faceHtml(owner.name, "size-11 text-sm")} />
                                  <div class="min-w-0">
                                    <p class="truncate font-semibold">{owner.name}</p>
                                    <p class={cx("truncate text-xs", style.sub)} data-tone="sub">{owner.role}</p>
                                  </div>
                                </div>
                                <button type="button" aria-label={`Remind me about ${task.title}`} class={cx("absolute top-1 right-[66px] inline-flex size-10 items-center justify-center rounded-full", style.soft, focusRing)} data-tone="soft" data-pipe-toast="Reminder set" data-description={`${task.title}, ${task.time}`} set:html={icon("bell", "size-4")} />
                                <Fragment set:html={cornerHtml(`Open ${task.title}`, task.lead)} />
                                <span aria-hidden="true" class={cx("mt-5 inline-flex size-11 items-center justify-center rounded-2xl", style.soft)} data-tone="soft" set:html={icon(task.app)} />
                                <h3 class="mt-3 text-2xl font-semibold tracking-tight">{task.title}</h3>
                                <p class={cx("mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm", style.sub)} data-tone="sub">
                                  <span class="inline-flex items-center gap-1.5"><Fragment set:html={icon("calendar", "size-4")} />{task.date}</span>
                                  <span class="inline-flex items-center gap-1.5"><Fragment set:html={icon("clock", "size-4")} />{task.time}</span>
                                </p>
                                {task.amount > 0 && <p class="mt-2 text-lg font-semibold tabular-nums">{rupiah(task.amount)}</p>}
                                <div class="mt-auto flex items-center justify-between gap-2 pt-5">
                                  <DropdownMenu items={statusMenu} class={cx(statusTrigger, style.menu)} data-tone="menu" data-pipe-status={task.id}>
                                    <Fragment slot="trigger"><span class="sr-only">{`${task.title} status: `}</span><span data-status>{task.status}</span></Fragment>
                                  </DropdownMenu>
                                  <div class="flex gap-2">
                                    <button type="button" aria-label={`Message ${owner.name}`} class={darkButton} data-pipe-goto="messages" set:html={icon("chat", "size-4")} />
                                    <button type="button" aria-label={`Video call with ${owner.name}`} aria-pressed={task.meeting === meeting.id ? "true" : "false"} class={darkButton} data-pipe-video={task.meeting} set:html={icon("video", "size-4")} />
                                  </div>
                                </div>
                              </li>
                            );
                          })}
                        </ul>
                      </section>
                    </div>

                    <aside aria-label="Call and summary" class="grid content-start gap-4 xl:sticky xl:top-6">
                      <div class="contents" data-pipe-call-slot>
                        <section aria-labelledby="pipeline-call-title" data-call class="rounded-[28px] bg-surface p-3 shadow-(--tpl-shadow)">
                          <div class="relative aspect-[4/3] overflow-hidden rounded-3xl bg-linear-160 from-(--tpl-portrait-a) to-(--tpl-portrait-b)">
                            <span aria-hidden="true" class="absolute bottom-0 left-1/2 h-[34%] w-[62%] -translate-x-1/2 rounded-t-full bg-(--tpl-white)/45"></span>
                            <Fragment set:html={faceHtml(meeting.who, "absolute top-[22%] left-1/2 size-24 -translate-x-1/2 text-2xl ring-4 ring-(--tpl-white)/60").replace("data-face", "data-face data-pipe-who-face")} />
                            <span class="absolute top-3 left-3 inline-flex h-7 items-center gap-1.5 rounded-full bg-(--tpl-night) px-2.5 text-xs font-medium text-(--tpl-on-night) tabular-nums"><span aria-hidden="true" class="size-2 rounded-full bg-danger"></span>12:48</span>
                            <span class="absolute top-3 right-3 inline-flex size-14 items-center justify-center rounded-2xl bg-(--tpl-night)" set:html={faceHtml("Ahmad Fauzi", "size-8 text-[11px]")} />
                            <span class="absolute bottom-3 left-3 inline-flex h-7 items-center rounded-full bg-surface px-3 text-xs font-semibold" data-pipe-who>{meeting.who}</span>
                          </div>
                          <div class="px-2 pt-3">
                            <h2 id="pipeline-call-title" class="font-semibold" data-pipe-meeting-title>{meeting.title}</h2>
                            <p class="text-xs text-muted" data-pipe-meeting-time>{`${meeting.time} with ${meeting.who}`}</p>
                          </div>
                          <div class="flex items-center justify-center gap-2 pt-3 pb-1">
                            {callControls.map((item) => (
                              <button type="button" aria-label={item.label} aria-pressed="true" class={cx(callControl, controlOn)} data-pipe-control set:html={icon(item.icon, "size-5")} />
                            ))}
                            <button type="button" aria-label="End call" class={endButton} data-pipe-end set:html={icon("end", "size-5")} />
                          </div>
                        </section>
                      </div>
                      <template data-pipe-call-closed>
                        <section aria-labelledby="pipeline-call-title" data-call-closed class={panel}>
                          <h2 id="pipeline-call-title" class="font-semibold">No active call</h2>
                          <p class="mt-1 text-sm text-muted">Pick a meeting from your schedule or start a video call from a task.</p>
                          <button type="button" class={cx(pillButton, "mt-4")} data-pipe-join><Fragment set:html={icon("video", "size-4")} /><span class="contents" data-pipe-join-text>{`Join ${meeting.title}`}</span></button>
                        </section>
                      </template>
                      <section aria-labelledby="pipeline-summary-title" class="rounded-[28px] bg-(--tpl-night) p-5 text-(--tpl-on-night) dark:ring-1 dark:ring-line">
                        <div class="flex items-start justify-between gap-3">
                          <div>
                            <h2 id="pipeline-summary-title" class="text-lg font-semibold">Summary</h2>
                            <p class="text-xs text-(--tpl-night-muted)">Last call with Bagus Hartono</p>
                          </div>
                          <button type="button" aria-label="Open summary" class={summaryButton} data-pipe-toast="Summary opened" data-description="Call notes, 3 highlights" set:html={icon("arrow", "size-4")} />
                        </div>
                        <ol class="mt-4 grid gap-3">
                          {summary.map((item) => (
                            <li class="grid grid-cols-[44px_1fr] gap-3">
                              <span class="pt-0.5 text-xs text-(--tpl-night-muted) tabular-nums">{item.time}</span>
                              <p class="border-l border-(--tpl-night-line) pl-3 text-sm">{item.text}</p>
                            </li>
                          ))}
                        </ol>
                        <h3 class="mt-5 text-sm font-semibold">Documents</h3>
                        <ul class="mt-2 grid grid-cols-2 gap-3">
                          {documents.map((doc) => (
                            <li class="rounded-2xl bg-(--tpl-night-soft) p-3">
                              <span aria-hidden="true" class="grid h-16 content-start gap-1.5 rounded-xl bg-(--tpl-night-line) p-2.5">
                                <span class="h-1.5 w-3/4 rounded-full bg-(--tpl-night-muted)"></span>
                                <span class="h-1.5 w-full rounded-full bg-(--tpl-night-soft)"></span>
                                <span class="h-1.5 w-2/3 rounded-full bg-(--tpl-night-soft)"></span>
                              </span>
                              <p class="mt-2 truncate text-xs font-medium">{doc.name}</p>
                              <p class="text-xs text-(--tpl-night-muted)">{doc.size}</p>
                            </li>
                          ))}
                        </ul>
                        <h3 class="mt-5 text-sm font-semibold">Goal</h3>
                        <p class="mt-1 text-sm text-(--tpl-night-muted)">Close the 40 seat annual plan before 30 Nov, starting with a pilot in the Bandung branch.</p>
                      </section>
                    </aside>
                  </div>
                )}
                {id === "leads" && (
                  <section aria-labelledby="pipeline-all-leads" class="grid gap-4">
                    <div class="flex flex-wrap items-end justify-between gap-3">
                      <h2 id="pipeline-all-leads" class={h2} data-pipe-lead-count>{plural(leads.length, "lead")}</h2>
                      <div class="w-full max-w-xs">
                        <Input label="Search leads" type="search" data-pipe-query="company" />
                      </div>
                    </div>
                    <Fragment set:html={chipsHtml("Filter leads by interest", leadChips, "leads")} />
                    <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-pipe-leads="all" set:html={leads.map(leadCardHtml).join("")} />
                    <p class="text-sm text-muted" hidden data-pipe-leads-empty>No leads match this filter.</p>
                    <template data-pipe-lead-cards set:html={leads.map(leadCardHtml).join("")} />
                  </section>
                )}

                {id === "pipeline" && (
                  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                    {stages.map((stage) => {
                      const items = dealList.filter((deal) => deal.stage === stage);
                      const total = items.reduce((sum, deal) => sum + deal.value, 0);
                      return (
                        <section aria-label={stage} data-stage={stage} class="grid content-start gap-3 rounded-[28px] p-3 ring-1 ring-line ring-inset">
                          <div class="flex items-baseline justify-between gap-2 px-2 pt-1">
                            <h2 class="font-semibold">{stage}</h2>
                            <p class="text-xs text-muted tabular-nums" data-pipe-stage-total>{`${items.length} · ${rupiah(total)}`}</p>
                          </div>
                          {items.map((deal) => (
                            <article data-deal={deal.id} class="grid gap-3 rounded-3xl bg-surface p-4">
                              <div class="flex items-center gap-3">
                                <Fragment set:html={faceHtml(deal.who, "size-9 text-xs")} />
                                <div class="min-w-0">
                                  <h3 class="truncate font-semibold">{deal.company}</h3>
                                  <p class="truncate text-xs text-muted">{deal.who}</p>
                                </div>
                              </div>
                              <div class="flex items-center justify-between gap-2">
                                <p class="font-semibold tabular-nums">{rupiah(deal.value)}</p>
                                {stage !== "Won" && (
                                  <button type="button" aria-label={`Move ${deal.company} to ${stages[stages.indexOf(stage) + 1]}`} class={darkButton} data-pipe-move={deal.id} set:html={icon("next", "size-4")} />
                                )}
                              </div>
                            </article>
                          ))}
                        </section>
                      );
                    })}
                  </div>
                )}

                {id === "calendar" && (
                  <section aria-labelledby="pipeline-agenda-title" class={cx(panel, "grid gap-5")}>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <h2 id="pipeline-agenda-title" class={h2} data-pipe-day-title>November 9</h2>
                      <button type="button" class={pillButton} data-pipe-add-meeting><Fragment set:html={icon("plus", "size-4")} />Add meeting</button>
                    </div>
                    <div role="group" aria-label="Pick a day" class="grid grid-cols-5 gap-2">
                      {week.map((item) => (
                        <button type="button" aria-pressed={item.day === "9" ? "true" : "false"} data-pipe-day={item.day} class={cx("grid h-16 place-content-center rounded-2xl text-center transition-colors duration-150", focusRing, item.day === "9" ? railActive : dayIdle)}>
                          <span class="text-xs">{item.label}</span>
                          <span class="text-lg font-semibold tabular-nums">{item.day}</span>
                        </button>
                      ))}
                    </div>
                    <div class="contents" data-pipe-agenda></div>
                    {week.map((item) => (
                      <template data-pipe-agenda-day={item.day}>
                        {item.items.length === 0 ? (
                          <p data-agenda class="text-sm text-muted">No meetings on this day.</p>
                        ) : (
                          <ul data-agenda class="grid gap-2">
                            {item.items.map((entry) => (
                              <li class="flex items-center gap-3 rounded-2xl bg-subtle p-3">
                                <span class="w-20 shrink-0 text-sm font-semibold tabular-nums">{entry.time}</span>
                                <Fragment set:html={faceHtml(entry.who, "size-8 text-[11px]")} />
                                <div class="min-w-0">
                                  <p class="truncate text-sm font-medium">{entry.title}</p>
                                  <p class="truncate text-xs text-muted">{entry.who}</p>
                                </div>
                              </li>
                            ))}
                          </ul>
                        )}
                      </template>
                    ))}
                  </section>
                )}

                {id === "messages" && (
                  <div class="grid gap-4 md:grid-cols-[280px_minmax(0,1fr)]">
                    <ul aria-label="Conversations" class={cx(panel, "grid grid-cols-1 content-start gap-1 p-2")}>
                      {threadList.map((item) => (
                        <li>
                          <button type="button" aria-pressed={item.id === "c1" ? "true" : "false"} data-pipe-thread={item.id} class={cx("flex w-full items-center gap-3 rounded-3xl p-3 text-left transition-colors duration-150", focusRing, item.id === "c1" ? threadOn : threadOff)}>
                            <Fragment set:html={faceHtml(item.who, "size-10 text-xs")} />
                            <span class="min-w-0">
                              <span class="block truncate text-sm font-semibold">{item.who}</span>
                              <span class="block truncate text-xs text-muted" data-pipe-last>{item.messages[item.messages.length - 1]!.text}</span>
                            </span>
                          </button>
                        </li>
                      ))}
                    </ul>
                    <section aria-labelledby="pipeline-thread-title" class={cx(panel, "grid content-start gap-4")}>
                      <h2 id="pipeline-thread-title" class="text-lg font-semibold" data-pipe-thread-title>{threadList[0]!.who}</h2>
                      <ol data-thread class="grid gap-2">
                        {threadList[0]!.messages.map((message) => (
                          <li class={cx(bubble, message.mine ? mineBubble : theirBubble)}>
                            <p>{message.text}</p>
                            <p class={cx("mt-1 text-xs", message.mine ? "text-(--tpl-night-muted)" : "text-muted")}>{message.time}</p>
                          </li>
                        ))}
                      </ol>
                      <form class="flex items-end gap-2" data-pipe-send>
                        <div class="min-w-0 flex-1">
                          <Input label="Message" data-pipe-draft />
                        </div>
                        <button type="submit" class={pillButton}><Fragment set:html={icon("send", "size-4")} />Send</button>
                      </form>
                    </section>
                  </div>
                )}
              </Wrapper>
            );
          })
        }
      </main>
    </div>

    <Drawer id={LEAD_DRAWER} title="Lead details">
      <div class="grid gap-5 text-ink">
        <div class="flex items-center gap-3">
          <Fragment set:html={faceHtml(firstLead.name, "size-14 text-base").replace("data-face", "data-face data-pipe-drawer-face")} />
          <div class="min-w-0">
            <p class="text-lg font-semibold" data-pipe-drawer-name>{firstLead.name}</p>
            <p class="text-sm text-muted" data-pipe-drawer-role>{`${firstLead.role} @ ${firstLead.company}`}</p>
          </div>
        </div>
        <dl class="grid grid-cols-2 gap-3">
          {leadFields(firstLead).map(([label, value]) => (
            <div class="rounded-2xl bg-subtle p-3">
              <dt class="text-xs text-muted">{label}</dt>
              <dd data-field={label} class="mt-1 text-sm font-medium">{value}</dd>
            </div>
          ))}
        </dl>
        <p class="text-sm text-muted" data-pipe-drawer-email>{`Email ${firstLead.email}`}</p>
      </div>
      <Fragment slot="footer">
        <Button variant="secondary" type="submit" value="close">Close</Button>
        <Button type="submit" value="schedule" data-pipe-schedule>Schedule call</Button>
      </Fragment>
    </Drawer>
    <Toaster />
  </div>
</pipeline-template>

<script>
  type Pair = { card: string; sub: string; soft: string; menu: string };
  type Lead = {
    id: string;
    name: string;
    role: string;
    company: string;
    interest: string;
    email: string;
    fields: string[][];
  };
  type Meeting = { id: string; title: string; time: string; who: string };
  type Task = {
    id: string;
    title: string;
    time: string;
    meeting: string;
    status: string;
    tags: string[];
  };
  type Deal = { id: string; company: string; value: number; stage: string };
  type Message = { mine: boolean; text: string; time: string };
  type Thread = { id: string; who: string; messages: Message[] };
  type Config = {
    pages: Record<string, { label: string; title: string }>;
    defaultPage: string;
    titleId: string;
    drawerId: string;
    preview: number;
    leads: Lead[];
    interestIds: string[];
    meetings: Meeting[];
    tasks: Task[];
    stages: string[];
    deals: Deal[];
    week: { day: string; label: string }[];
    threads: Thread[];
    faceTones: string[];
    classes: {
      railActive: string;
      chipOn: string;
      chipOff: string;
      sortOn: string;
      slotOn: string;
      controlOn: string;
      controlOff: string;
      dayIdle: string;
      threadOn: string;
      threadOff: string;
      mineBubble: string;
      theirBubble: string;
      bubble: string;
      tones: { lime: Pair; plain: Pair };
    };
  };

  const toast = (title: string, description = "", variant?: string) =>
    window.dispatchEvent(
      new CustomEvent("markas-toast", {
        detail: { title, description, variant },
      }),
    );
  const swap = (element: Element, add: string, remove: string) => {
    if (remove) element.classList.remove(...remove.split(" "));
    if (add) element.classList.add(...add.split(" "));
  };
  const rupiah = (value: number) => `Rp ${value.toLocaleString("id-ID")}`;
  const plural = (count: number, word: string) =>
    `${count} ${word}${count === 1 ? "" : "s"}`;
  const initials = (name: string) =>
    name
      .split(" ")
      .filter((_, index, words) => index === 0 || index === words.length - 1)
      .map((word) => word.charAt(0))
      .join("")
      .toUpperCase();

  /** Satu elemen per template: navigasi hash, lead, rapat, panel call, dan interaksi tiap halaman. */
  class PipelineTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private leadId = "l1";
    private meetingId = "m2";
    private callOpen = true;
    /* State halaman, direset setiap kali halaman dibuka. */
    private leadFilter = "all";
    private taskFilter = "all";
    private byInterest = false;
    private query = "";
    private status: Record<string, string> = {};
    private deals: Deal[] = [];
    private day = "9";
    private threads: Thread[] = [];
    private activeId = "c1";
    private leadCards: HTMLElement[] = [];
    private callNode: Node | undefined;
    private readonly onHashChange = () => {
      this.open(this.readHash());
      document.getElementById(this.config.titleId)?.focus();
    };
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onInput = (event: Event) => this.handleInput(event);
    private readonly onSubmit = (event: Event) => this.handleSubmit(event);
    private readonly onSelect = (event: Event) => this.changeStatus(event);

    connectedCallback() {
      this.open(this.readHash());
      window.addEventListener("hashchange", this.onHashChange);
      this.addEventListener("click", this.onClick);
      this.addEventListener("input", this.onInput);
      this.addEventListener("submit", this.onSubmit);
      this.addEventListener("markas-select", this.onSelect);
    }

    disconnectedCallback() {
      window.removeEventListener("hashchange", this.onHashChange);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("input", this.onInput);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("markas-select", this.onSelect);
    }

    private find<T extends Element = HTMLElement>(selector: string) {
      return this.querySelector<T>(`[data-pipe-view] ${selector}`);
    }

    private findAll<T extends Element = HTMLElement>(selector: string) {
      return [...this.querySelectorAll<T>(`[data-pipe-view] ${selector}`)];
    }

    /** Halaman aktif disimpan di hash URL supaya bisa dibagikan dan tombol Back bekerja. */
    private readHash() {
      const id = window.location.hash.slice(1);
      return id in this.config.pages ? id : this.config.defaultPage;
    }

    private faceTone(name: string) {
      const tones = this.config.faceTones;
      const sum = [...name].reduce((total, char) => total + char.charCodeAt(0), 0);
      return tones[sum % tones.length]!;
    }

    /** Ganti inisial dan warna avatar inisial untuk nama lain. */
    private setFace(element: Element | null, name: string) {
      if (!element) return;
      element.classList.remove(...this.config.faceTones);
      element.classList.add(this.faceTone(name));
      element.textContent = initials(name);
    }

    /** Ganti isi halaman dengan klon baru dari <template>, lalu siapkan state-nya. */
    private open(id: string) {
      const template = this.querySelector<HTMLTemplateElement>(
        `template[data-pipe-page="${id}"]`,
      );
      const view = this.querySelector("[data-pipe-view]");
      if (!template || !view) return;
      view.replaceChildren(template.content.cloneNode(true));
      const { pages, classes } = this.config;
      this.querySelectorAll<HTMLElement>("[data-pipe-go]").forEach((button) => {
        const active = button.dataset.pipeGo === id;
        if (active) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
        const idle = button.dataset.pipeIdle ?? "";
        swap(button, active ? classes.railActive : idle, active ? idle : classes.railActive);
      });
      this.querySelector("[data-pipe-crumb]")!.textContent =
        `Pipeline / ${pages[id]!.label}`;
      document.getElementById(this.config.titleId)!.textContent =
        pages[id]!.title;
      this.leadFilter = "all";
      this.taskFilter = "all";
      this.byInterest = false;
      this.query = "";
      this.status = Object.fromEntries(
        this.config.tasks.map((task) => [task.id, task.status]),
      );
      this.deals = this.config.deals.map((deal) => ({ ...deal }));
      this.day = "9";
      this.threads = structuredClone(this.config.threads);
      this.activeId = "c1";
      const cards = this.find<HTMLTemplateElement>("template[data-pipe-lead-cards]");
      this.leadCards = cards
        ? [...cards.content.children].map((card) => card as HTMLElement)
        : [];
      const slot = this.find("[data-pipe-call-slot]");
      this.callNode = slot?.firstElementChild?.cloneNode(true);
      if (id === "workspace") {
        this.renderTasks();
        this.renderCall(true);
      }
      if (id === "calendar") this.renderDay();
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      const closest = (selector: string) => target.closest<HTMLElement>(selector);
      const go = closest("[data-pipe-go], [data-pipe-goto]");
      if (go)
        return window.location.assign(
          `#${go.dataset.pipeGo ?? go.dataset.pipeGoto}`,
        );
      const lead = closest("[data-pipe-lead]");
      if (lead) return this.openLead(lead.dataset.pipeLead!);
      const meeting = closest("[data-pipe-meeting]");
      if (meeting) {
        this.meetingId = meeting.dataset.pipeMeeting!;
        return this.setCallOpen(true);
      }
      const chip = closest("[data-pipe-chips] > button");
      if (chip) return this.pickChip(chip);
      const video = closest("[data-pipe-video]");
      if (video) {
        const same = this.callOpen && this.meetingId === video.dataset.pipeVideo;
        this.meetingId = video.dataset.pipeVideo!;
        return this.setCallOpen(!same);
      }
      const control = closest("[data-pipe-control]");
      if (control) {
        const { controlOn, controlOff } = this.config.classes;
        const on = control.getAttribute("aria-pressed") !== "true";
        control.setAttribute("aria-pressed", String(on));
        return swap(control, on ? controlOn : controlOff, on ? controlOff : controlOn);
      }
      const move = closest("[data-pipe-move]");
      if (move) return this.move(move.dataset.pipeMove!);
      const day = closest("[data-pipe-day]");
      if (day) {
        this.day = day.dataset.pipeDay!;
        return this.renderDay();
      }
      const thread = closest("[data-pipe-thread]");
      if (thread) {
        this.activeId = thread.dataset.pipeThread!;
        return this.renderThread();
      }
      const message = closest("[data-pipe-toast]");
      if (message)
        return toast(message.dataset.pipeToast!, message.dataset.description);
      if (closest("[data-pipe-search-toggle]")) return this.toggleSearch();
      if (closest("[data-pipe-sort]")) {
        this.byInterest = !this.byInterest;
        const button = this.find("[data-pipe-sort]")!;
        button.setAttribute("aria-pressed", String(this.byInterest));
        swap(
          button,
          this.byInterest ? this.config.classes.sortOn : "",
          this.byInterest ? "" : this.config.classes.sortOn,
        );
        return this.renderLeads();
      }
      if (closest("[data-pipe-end]")) {
        const current = this.meeting();
        this.setCallOpen(false);
        return toast("Call ended", `${current.title} with ${current.who}`);
      }
      if (closest("[data-pipe-join]")) return this.setCallOpen(true);
      if (closest("[data-pipe-new-task]"))
        return toast(
          "Task created",
          "Follow up with Maya Puspita, tomorrow 10:00 am",
          "success",
        );
      if (closest("[data-pipe-add-meeting]")) {
        const current = this.config.week.find((item) => item.day === this.day);
        return toast(
          "Meeting added",
          `${current?.label}, ${this.day} Nov at 4:00 pm`,
        );
      }
      if (closest("[data-pipe-schedule]")) {
        const current = this.lead();
        toast("Call scheduled", `${current.name}, tomorrow 10:00 am`, "success");
      }
    }

    private handleInput(event: Event) {
      const field = event.target as HTMLInputElement;
      if (!field.matches("[data-pipe-query]")) return;
      this.query = field.value;
      this.renderLeads();
    }

    private handleSubmit(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-pipe-send]")) return;
      event.preventDefault();
      const field = form.querySelector("input")!;
      const text = field.value.trim();
      if (!text) return;
      const active = this.threads.find((item) => item.id === this.activeId)!;
      active.messages = [...active.messages, { mine: true, text, time: "Now" }];
      field.value = "";
      this.renderThread();
      toast("Message sent", active.who);
    }

    /* Lead dan drawer */
    private lead() {
      return (
        this.config.leads.find((item) => item.id === this.leadId) ??
        this.config.leads[0]!
      );
    }

    private openLead(id: string) {
      this.leadId = id;
      const lead = this.lead();
      this.setFace(this.querySelector("[data-pipe-drawer-face]"), lead.name);
      this.querySelector("[data-pipe-drawer-name]")!.textContent = lead.name;
      this.querySelector("[data-pipe-drawer-role]")!.textContent =
        `${lead.role} @ ${lead.company}`;
      for (const [label, value] of lead.fields)
        this.querySelector(`[data-field="${label}"]`)!.textContent = value ?? "";
      this.querySelector("[data-pipe-drawer-email]")!.textContent =
        `Email ${lead.email}`;
      const dialog = document.getElementById(this.config.drawerId);
      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
        dialog.dataset.state = "open";
      }
    }

    private toggleSearch() {
      const wrap = this.find("[data-pipe-search]")!;
      wrap.hidden = !wrap.hidden;
      this.find("[data-pipe-search-toggle]")!.setAttribute(
        "aria-expanded",
        String(!wrap.hidden),
      );
    }

    private pickChip(button: HTMLElement) {
      const group = button.parentElement!;
      const value = button.dataset.value!;
      const { chipOn, chipOff } = this.config.classes;
      group.querySelectorAll<HTMLElement>(":scope > button").forEach((item) => {
        const on = item === button;
        item.setAttribute("aria-pressed", String(on));
        swap(item, on ? chipOn : chipOff, on ? chipOff : chipOn);
      });
      if (group.dataset.pipeChips === "tasks") {
        this.taskFilter = value;
        this.renderTasks();
      } else {
        this.leadFilter = value;
        this.renderLeads();
      }
    }

    /** Kartu lead dipasang ulang (bukan disembunyikan), seperti daftar di React. */
    private renderLeads() {
      const list = this.find("[data-pipe-leads]");
      if (!list) return;
      const workspace = list.dataset.pipeLeads !== "all";
      const needle = this.query.trim().toLowerCase();
      const { leads, interestIds, preview } = this.config;
      const leadOf = (card: HTMLElement) =>
        leads.find((item) => item.id === card.dataset.lead)!;
      let shown = this.leadCards.filter((card) => {
        const lead = leadOf(card);
        const text = workspace ? lead.name : `${lead.name} ${lead.company}`;
        return (
          (this.leadFilter === "all" || lead.interest === this.leadFilter) &&
          text.toLowerCase().includes(needle)
        );
      });
      if (workspace) {
        if (this.byInterest)
          shown = [...shown].sort(
            (a, b) =>
              interestIds.indexOf(leadOf(a).interest) -
              interestIds.indexOf(leadOf(b).interest),
          );
        shown = shown.slice(0, preview);
      } else {
        this.find("[data-pipe-lead-count]")!.textContent = plural(
          shown.length,
          "lead",
        );
      }
      list.replaceChildren(...shown);
      list.hidden = shown.length === 0;
      this.find("[data-pipe-leads-empty]")!.hidden = shown.length > 0;
    }

    /* Tugas: kartu pertama yang tampil memakai nada lime, sisanya polos. */
    private renderTasks() {
      const list = this.find("[data-pipe-tasks]");
      if (!list) return;
      const { tones } = this.config.classes;
      let index = 0;
      for (const task of this.config.tasks) {
        const item = list.querySelector<HTMLElement>(`[data-task="${task.id}"]`)!;
        const status = this.status[task.id]!;
        const shown =
          this.taskFilter === "all" ||
          (this.taskFilter === "done"
            ? status === "Done"
            : task.tags.includes(this.taskFilter));
        item.hidden = !shown;
        const [tone, other] =
          shown && index === 0 ? [tones.lime, tones.plain] : [tones.plain, tones.lime];
        if (shown) index += 1;
        [item, ...item.querySelectorAll("[data-tone]")].forEach((part) => {
          const key = (part as HTMLElement).dataset.tone as keyof Pair;
          swap(part, tone[key], other[key]);
        });
        item.querySelector("[data-status]")!.textContent = status;
        item
          .querySelector("[data-pipe-video]")!
          .setAttribute(
            "aria-pressed",
            String(this.callOpen && this.meetingId === task.meeting),
          );
      }
      list.hidden = index === 0;
      this.find("[data-pipe-tasks-empty]")!.hidden = index > 0;
    }

    private changeStatus(event: Event) {
      const menu = (event.target as Element).closest<HTMLElement>(
        "[data-pipe-status]",
      );
      const value = String((event as CustomEvent).detail);
      const task = this.config.tasks.find(
        (item) => item.id === menu?.dataset.pipeStatus,
      );
      if (!task) return;
      this.status = { ...this.status, [task.id]: value };
      this.renderTasks();
      toast("Status updated", `${task.title}: ${value}`, "success");
    }

    /* Rapat dan panel call */
    private meeting() {
      return (
        this.config.meetings.find((item) => item.id === this.meetingId) ??
        this.config.meetings[0]!
      );
    }

    private setCallOpen(open: boolean) {
      // Panel yang baru dibuka mulai dengan kamera, mikrofon, dan speaker menyala.
      const fresh = open && !this.callOpen;
      this.callOpen = open;
      this.renderCall(fresh);
      this.renderTasks();
    }

    private renderCall(fresh: boolean) {
      const { slotOn } = this.config.classes;
      this.querySelectorAll<HTMLElement>("[data-pipe-meeting]").forEach(
        (button) => {
          const on = button.dataset.pipeMeeting === this.meetingId;
          button.setAttribute("aria-pressed", String(on));
          swap(button, on ? slotOn : "", on ? "" : slotOn);
        },
      );
      const slot = this.find("[data-pipe-call-slot]");
      if (!slot) return;
      const meeting = this.meeting();
      if (!this.callOpen) {
        const closed = this.find<HTMLTemplateElement>(
          "template[data-pipe-call-closed]",
        )!;
        slot.replaceChildren(closed.content.cloneNode(true));
        slot.querySelector("[data-pipe-join-text]")!.textContent =
          `Join ${meeting.title}`;
        return;
      }
      if (fresh || !slot.querySelector("[data-call]"))
        slot.replaceChildren(this.callNode!.cloneNode(true));
      this.setFace(slot.querySelector("[data-pipe-who-face]"), meeting.who);
      slot.querySelector("[data-pipe-who]")!.textContent = meeting.who;
      slot.querySelector("[data-pipe-meeting-title]")!.textContent =
        meeting.title;
      slot.querySelector("[data-pipe-meeting-time]")!.textContent =
        `${meeting.time} with ${meeting.who}`;
    }

    /* Papan pipeline: kartu dipindah ke kolom tahap berikutnya. */
    private move(id: string) {
      const { stages } = this.config;
      const deal = this.deals.find((item) => item.id === id)!;
      const next = stages[stages.indexOf(deal.stage) + 1]!;
      deal.stage = next;
      for (const stage of stages) {
        const column = this.find(`[data-stage="${stage}"]`)!;
        const items = this.deals.filter((item) => item.stage === stage);
        const total = items.reduce((sum, item) => sum + item.value, 0);
        column.querySelector("[data-pipe-stage-total]")!.textContent =
          `${items.length} · ${rupiah(total)}`;
        for (const item of items) {
          const card = this.find(`[data-deal="${item.id}"]`)!;
          const button = card.querySelector("[data-pipe-move]");
          const after = stages[stages.indexOf(stage) + 1];
          if (!after) button?.remove();
          else
            button?.setAttribute(
              "aria-label",
              `Move ${item.company} to ${after}`,
            );
          column.append(card);
        }
      }
      toast(`Moved to ${next}`, deal.company, "success");
    }

    /* Kalender */
    private renderDay() {
      const { railActive, dayIdle } = this.config.classes;
      this.findAll("[data-pipe-day]").forEach((button) => {
        const on = button.dataset.pipeDay === this.day;
        button.setAttribute("aria-pressed", String(on));
        swap(button, on ? railActive : dayIdle, on ? dayIdle : railActive);
      });
      this.find("[data-pipe-day-title]")!.textContent = `November ${this.day}`;
      const agenda = this.find<HTMLTemplateElement>(
        `template[data-pipe-agenda-day="${this.day}"]`,
      )!;
      this.find("[data-pipe-agenda]")!.replaceChildren(
        agenda.content.cloneNode(true),
      );
    }

    /* Pesan */
    private renderThread() {
      const { threadOn, threadOff, bubble, mineBubble, theirBubble } =
        this.config.classes;
      const active = this.threads.find((item) => item.id === this.activeId)!;
      for (const thread of this.threads) {
        const button = this.find(`[data-pipe-thread="${thread.id}"]`)!;
        const on = thread.id === this.activeId;
        button.setAttribute("aria-pressed", String(on));
        swap(button, on ? threadOn : threadOff, on ? threadOff : threadOn);
        button.querySelector("[data-pipe-last]")!.textContent =
          thread.messages[thread.messages.length - 1]!.text;
      }
      this.find("[data-pipe-thread-title]")!.textContent = active.who;
      this.find("[data-thread]")!.replaceChildren(
        ...active.messages.map((message) => {
          const item = document.createElement("li");
          const text = document.createElement("p");
          const time = document.createElement("p");
          item.className = `${bubble} ${message.mine ? mineBubble : theirBubble}`;
          time.className = `mt-1 text-xs ${message.mine ? "text-(--tpl-night-muted)" : "text-muted"}`;
          text.textContent = message.text;
          time.textContent = message.time;
          item.append(text, time);
          return item;
        }),
      );
    }
  }

  if (!customElements.get("pipeline-template"))
    customElements.define("pipeline-template", PipelineTemplate);
</script>
