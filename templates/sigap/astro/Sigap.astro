  "bg-(--tpl-av5)",
];
const scroller = `overflow-x-auto ${focusRing}`;
const table = "w-full border-collapse text-sm";
const th =
  "h-10 bg-subtle px-4 text-left text-xs font-medium whitespace-nowrap text-muted";
const td = "border-t border-line px-4 py-2.5 whitespace-nowrap";
const num = "text-right tabular-nums";
const person = "flex items-center gap-3";
const personName = "truncate text-sm font-medium";
const personMeta = "truncate text-xs text-muted";
const listRow =
  "flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line px-4 py-3 last:border-b-0";
const dayOn =
  "border-primary bg-primary text-on-primary hover:bg-primary-strong";
const dayOff = "border-line bg-surface text-muted hover:text-ink";
const dayButton = `inline-flex h-9 min-w-11 items-center justify-center rounded-md border px-2 text-sm font-medium transition-colors duration-150 ${focusRing}`;
const column = "grid content-start gap-2";
const columnHead =
  "flex items-center justify-between border-b-2 border-line pb-2 text-sm font-semibold";
const candidateCard = "grid gap-3 rounded-lg border border-line bg-surface p-3";
const moveButton = `inline-flex size-8 items-center justify-center rounded-md border border-line text-muted transition-colors duration-150 hover:bg-subtle hover:text-ink ${focusRing}`;

const cx = (...c: (string | false | null | undefined)[]) =>
  c.filter(Boolean).join(" ");
const rupiah = (value: number) => `Rp ${value.toLocaleString("id-ID")}`;
/** Huruf pertama kata pertama dan terakhir. */
const initials = (name: string) =>
  name
    .split(" ")
    .filter((_, index, words) => index === 0 || index === words.length - 1)
    .map((word) => word.charAt(0))
    .join("")
    .toUpperCase();
/** Warna avatar inisial yang selalu sama untuk nama yang sama. */
const faceTone = (name: string) =>
  faceTones[
    [...name].reduce((sum, char) => sum + char.charCodeAt(0), 0) %
      faceTones.length
  ];
const emailOf = (name: string) =>
  `${name.toLowerCase().replace(/\s+/g, ".")}@sigapkarya.co.id`;
const matchesEmployee = (
  item: Employee,
  query: string,
  dept: string,
  type: string,
) =>
  `${item.name} ${item.id}`
    .toLowerCase()
    .includes(query.trim().toLowerCase()) &&
  (dept === "all" || item.dept === dept) &&
  (type === "all" || item.type === type);

const minutes = (time: string) =>
  Number(time.slice(0, 2)) * 60 + Number(time.slice(3));
/** Baris absensi dari catatan mentah: jam, durasi, dan status terhadap awal shift. */
function dayRow(record: string, shift: string) {
  if (record === "" || record === "absent" || record === "leave")
    return { in: "", out: "", hours: "", status: record || "scheduled" };
  const [start = "", end = ""] = record.split("-");
  const worked = (minutes(end) - minutes(start) + DAY_MINUTES) % DAY_MINUTES;
  const late = minutes(start) - minutes(shiftStart[shift]!) > LATE_AFTER;
  return {
    in: start,
    out: end,
    hours: end
      ? `${Math.floor(worked / 60)}h ${String(worked % 60).padStart(2, "0")}m`
      : "",
    status: late ? "late" : "ontime",
  };
}

const leaveDates = (item: LeaveRequest) =>
  item.from === item.to ? `${item.from} Nov` : `${item.from} to ${item.to} Nov`;
const dayWord = (count: number) => `${count} ${count === 1 ? "day" : "days"}`;
const initialLeave = (): LeaveState =>
  Object.fromEntries(leaveRequests.map((item) => [item.id, item.status]));
const leaveCount = (state: LeaveState, status: LeaveStatus) =>
  leaveRequests.filter((item) => state[item.id] === status).length;
/** Jumlah orang cuti (disetujui) pada tanggal itu. */
const outOn = (state: LeaveState, day: number) =>
  leaveRequests.filter(
    (item) =>
      state[item.id] === "approved" && item.from <= day && day <= item.to,
  ).length;
/** Hari terpakai: angka dasar ditambah permintaan contoh yang baru disetujui. */
const usedDays = (state: LeaveState, type: string, base: number) =>
  leaveRequests
    .filter(
      (item) =>
        item.type === type &&
        item.status === "pending" &&
        state[item.id] === "approved",
    )
    .reduce((sum, item) => sum + item.days, base);

function payslip(item: Employee) {
  const position =
    item.type === "Permanent" ? Math.round(item.salary * POSITION_RATE) : 0;
  const gross = item.salary + FIXED_ALLOWANCE + position;
  const health = Math.round(item.salary * HEALTH_RATE);
  const pension = Math.round(item.salary * PENSION_RATE);
  const rate = taxBands.find(([floor]) => gross > floor)?.[1] ?? 0;
  const tax = Math.round(gross * rate);
  const lines: [string, number][] = [
    ["Basic salary", item.salary],
    ["Transport and meals", FIXED_ALLOWANCE],
    ["Position allowance", position],
    ["BPJS Kesehatan 1%", -health],
    ["BPJS JHT and JP 3%", -pension],
    ["PPh 21", -tax],
  ];
  return {
    allowance: FIXED_ALLOWANCE + position,
    deduction: health + pension + tax,
    net: gross - health - pension - tax,
    lines,
  };
}

/** Garis tren tingkat kehadiran untuk n hari kerja terakhir. */
function trendOf(range: string) {
  const count = Number(range);
  const from = trend.day.length - count;
  const points = trend.day.slice(from).map((day, index) => {
    const late = trend.late[from + index]!;
    const rate = ((trend.present[from + index]! + late) / HEADCOUNT) * 100;
    const x = ((index + 0.5) / count) * 100;
    const y = ((RATE_MAX - rate) / (RATE_MAX - RATE_MIN)) * 100;
    return { day, late, rate, at: `${x.toFixed(2)},${y.toFixed(2)}` };
  });
  const line = points.map((point) => point.at).join(" ");
  const first = (0.5 / count) * 100;
  const average = points.reduce((sum, point) => sum + point.rate, 0) / count;
  const lowest = points.reduce((a, b) => (b.rate < a.rate ? b : a));
  return {
    points,
    line,
    area: `${first.toFixed(2)},100 ${line} ${(100 - first).toFixed(2)},100`,
    average: average.toFixed(1),
    summary: `Attendance rate over the last ${count} working days: average ${average.toFixed(1)}%, lowest ${lowest.rate.toFixed(1)}% on ${lowest.day} Nov.`,
  };
}

/** Halaman aktif disimpan di hash URL supaya bisa dibagikan dan tombol Back bekerja. */
function readHash(): PageId {
  const id = window.location.hash.slice(1);
  return id in pages ? (id as PageId) : DEFAULT_PAGE;
}

const dialogOf = (id: string) => {
  const dialog = document.getElementById(id);
  return dialog instanceof HTMLDialogElement ? dialog : null;
};
const openDialog = (id: string) => dialogOf(id)?.showModal();
const closeDialog = (id: string) => dialogOf(id)?.close();
/** Fokus ke elemen yang baru dirender ulang (kartu yang pindah kolom). */
const focusLater = (selector: string) =>
  requestAnimationFrame(() =>
    document.querySelector<HTMLElement>(selector)?.focus(),
  );

const pageIds = Object.keys(pages) as PageId[];
const leaveNow = initialLeave();
const today = dates[dates.length - 1]!;
const firstEmployee = employeeList[0]!;
const tallyKeys = ["ontime", "late", "absent", "leave"];
const todayRows = employeeList.map((item, index) => ({
  item,
  index,
  ...dayRow(attendance[today.id]![index]!, item.shift),
}));
const drawerClass =
  "max-w-64 bg-(--tpl-side) lg:hidden [&_h2]:sr-only [&>div]:gap-0 [&>div>div:first-child]:absolute [&>div>div:first-child]:top-3 [&>div>div:first-child]:right-3 [&>div>div:first-child]:z-10 [&>div>div:first-child_button]:text-(--tpl-side-ink) [&>div>div:first-child_button]:hover:bg-(--tpl-side-hover)";
const employeeFields = (item: Employee) => [
  ["Employee ID", item.id],
  ["Status", item.type],
  ["Shift", `${item.shift}, starts ${shiftStart[item.shift]}`],
  ["Joined", item.joined],
  ["Base salary", rupiah(item.salary)],
  ["Email", emailOf(item.name)],
];

/** Ikon garis 24px sebagai HTML, seperti di versi Blade. */
const icon = (name: IconName, className = "size-4") =>
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${icons[name]}"></path></svg>`;
const faceHtml = (name: string, className: string) =>
  `<span aria-hidden="true" class="${cx(face, faceTone(name), className)}" data-sg-face>${initials(name)}</span>`;
const pillHtml = (tone: string, text: string) =>
  `<span class="${pill}"><span aria-hidden="true" class="${cx(dotBase, dots[tone])}" data-sg-dot></span><span data-sg-text>${text}</span></span>`;
const personHtml = (name: string, meta: string) =>
  `<div class="${person}">${faceHtml(name, "size-8 text-[11px]")}<div class="min-w-0"><p class="${personName}" data-sg-name>${name}</p><p class="${personMeta}" data-sg-meta>${meta}</p></div></div>`;
/** Isi sidebar, dipakai di aside desktop dan Drawer menu mobile. */
const sidebarHtml = (sheet: boolean) =>
  `<div class="flex items-center gap-2.5 px-3"><span aria-hidden="true" class="flex size-8 items-center justify-center rounded-md bg-primary text-on-primary">${icon("check", "size-4.5")}</span><div class="leading-tight"><p class="text-sm font-semibold">Sigap</p><p class="text-xs text-(--tpl-side-muted)">Sigap Karya Nusantara</p></div></div><nav aria-label="${sheet ? "Mobile" : "Main"}" class="grid gap-5">${navGroups
    .map(
      (group) =>
        `<div><p class="${navLabel}">${group.label}</p><div class="grid gap-0.5">${group.ids
          .map(
            (id) =>
              `<button type="${sheet ? "submit" : "button"}"${id === DEFAULT_PAGE ? ' aria-current="page"' : ""} class="${cx(navItem, id === DEFAULT_PAGE ? navOn : navOff)}" data-sg-go="${id}">${icon(pages[id].icon)}${pages[id].label}${id === "leave" ? `<span class="${navCount}" data-sg-pending><span data-sg-pending-count>${leaveCount(leaveNow, "pending")}</span><span class="sr-only"> pending</span></span>` : ""}</button>`,
          )
          .join("")}</div></div>`,
    )
    .join(
      "",
    )}</nav><div class="mt-auto rounded-md border border-(--tpl-side-line) p-3"><p class="text-xs text-(--tpl-side-muted)">Payroll cutoff</p><p class="mt-1 text-sm font-semibold">5 days left</p><span aria-hidden="true" class="mt-2.5 block h-1 overflow-hidden rounded-full bg-(--tpl-side-line)"><span class="block h-full w-4/5 rounded-full bg-primary"></span></span><p class="mt-2 text-xs text-(--tpl-side-muted)">Attendance for 1 to 25 Nov locks on Wednesday.</p></div>`;
/** Isi panel tren untuk satu rentang; kedua rentang disimpan di <template> dan ditukar saat dipilih. */
const chartHtml = (range: string) => {
  const chart = trendOf(range);
  return `<p class="flex flex-wrap items-baseline gap-x-2"><span data-average class="text-2xl font-semibold tracking-tight tabular-nums">${chart.average}%</span><span class="text-xs text-muted">average attendance rate</span></p><p class="sr-only">${chart.summary}</p><div aria-hidden="true" class="mt-4 grid grid-cols-[32px_minmax(0,1fr)] gap-x-2"><div class="flex h-36 flex-col justify-between text-[11px] leading-none text-muted tabular-nums">${rateMarks.map((mark) => `<span>${mark}</span>`).join("")}</div><div class="relative h-36 border-b border-line bg-linear-to-b from-line from-[1px] to-transparent to-[1px] bg-size-[100%_50%]"><svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none"><polygon points="${chart.area}" class="fill-primary/10"></polygon><polyline points="${chart.line}" fill="none" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" class="stroke-primary"></polyline></svg></div><span class="pt-2 text-[11px] leading-none text-muted">Late</span><div data-bars class="flex h-10 items-end pt-2">${chart.points.map((point) => `<span class="flex h-full flex-1 items-end justify-center"><span class="w-2/5 max-w-4 rounded-t-sm bg-(--tpl-late)" style="height: ${(point.late / LATE_SCALE) * 100}%"></span></span>`).join("")}</div><span class="pt-1.5 text-[11px] leading-none text-muted">Nov</span><div class="flex pt-1.5 text-[11px] leading-none text-muted tabular-nums">${chart.points.map((point) => `<span class="flex-1 text-center">${point.day}</span>`).join("")}</div></div>`;
};

// prettier-ignore
const config = JSON.stringify({
  pages, defaultPage: DEFAULT_PAGE, titleId: TITLE_ID,
  ids: { drawer: EMPLOYEE_DRAWER, add: ADD_MODAL, correct: CORRECT_MODAL, run: RUN_MODAL },
  me: ME, headcount: HEADCOUNT, preview: WAITING_PREVIEW,
  employees: employeeList, newHire: NEW_HIRE, newIdStart: NEW_ID_START, typeTones,
  dates, attendance, shiftStart, lateAfter: LATE_AFTER, dayMinutes: DAY_MINUTES, dayStatus,
  requests: leaveRequests, balances, leaveTones,
  runStatus, runStep: RUN_STEP, runTick: RUN_TICK, net: PAYROLL_NET,
  stages, candidates: candidateList,
  weekdays, workDays: defaultWorkDays, policies, npwpDigits: NPWP_DIGITS,
  faceTones, dots, dotBase,
  classes: { navOn, navOff, dayOn, dayOff },
});
---

<sigap-template class="contents" data-config={config}>
  <div class={shell}>
    <aside class={side} set:html={sidebarHtml(false)} />

    <div class="min-w-0">
      <header class="sticky top-0 z-20 flex h-14 items-center gap-2 border-b border-line bg-surface px-4 lg:px-8">
        <Drawer title="Menu" side="left" class={drawerClass}>
          <button slot="trigger" type="button" aria-label="Open menu" class={cx(iconButton, "lg:hidden")} set:html={icon("menu", "size-5")} />
          <form method="dialog" class={sideSheet} set:html={sidebarHtml(true)} />
        </Drawer>
        <form role="search" class="relative min-w-0 flex-1 sm:max-w-xs" data-sg-search>
          <Fragment set:html={icon("search", "pointer-events-none absolute top-2.5 left-3 z-10 size-4 text-muted")} />
          <Input type="search" aria-label="Search people" placeholder="Search people" class="h-9 pl-9" data-sg-query />
        </form>
        <p class="ml-auto hidden text-xs text-muted md:block">Fri, 20 Nov 2026, 16:20 WIB</p>
        <Popover align="end" class={cx(bellTrigger, "max-md:ml-auto")}>
          <Fragment slot="trigger"><Fragment set:html={icon("bell", "size-5")} /><span class="sr-only" data-sg-unread>{`Notifications, ${notifications.length} unread`}</span><span aria-hidden="true" class="absolute top-2 right-2 size-2 rounded-full bg-primary ring-2 ring-surface" data-sg-unread-dot></span></Fragment>
          <div class="grid gap-3">
            <div class="flex items-center justify-between gap-3">
              <p class="font-semibold">Notifications</p>
              <Button size="sm" variant="ghost" data-sg-read>Mark all read</Button>
            </div>
            <ul class="grid gap-3">
              {notifications.map((item) => (
                <li class="flex gap-2.5">
                  <span aria-hidden="true" class={cx(dotBase, "mt-1.5 bg-primary")} data-sg-note-dot></span>
                  <div>
                    <p>{item.title}</p>
                    <p class="text-xs text-muted">{item.time}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </Popover>
        <DropdownMenu items={userMenu} class={userTrigger} data-sg-user>
          <Fragment slot="trigger"><Fragment set:html={faceHtml(ME, "size-7 text-[11px]")} /><span class="sr-only sm:not-sr-only">{ME}</span></Fragment>
        </DropdownMenu>
      </header>

      <main class="grid content-start gap-5 px-4 py-6 lg:px-8">
        <div>
          <h1 id={TITLE_ID} tabindex="-1" class="text-xl font-semibold tracking-tight focus:outline-none">{pages[DEFAULT_PAGE].title}</h1>
          <p class="mt-1 max-w-2xl text-sm text-muted" data-sg-sub>{pages[DEFAULT_PAGE].sub}</p>
        </div>
        {
          /* Halaman bawaan dirender langsung (tanpa JS tetap tampil), lalu semua halaman sebagai <template>. */
          [{ live: true, id: DEFAULT_PAGE }, ...pageIds.map((id) => ({ live: false, id }))].map(({ live, id }) => {
            const Wrapper = live ? "div" : "template";
            return (
              <Wrapper class={live ? "contents" : undefined} data-sg-main={live ? "" : undefined} data-sg-page={live ? undefined : id}>
                {id === "overview" && (
                  <div class="grid gap-4">
                    <dl class={cx(strip, "grid-cols-2 md:grid-cols-3 xl:grid-cols-6")}>
                      {stats.map((stat) => (
                        <div class={cell}>
                          <dt class={statLabel}>{stat.tone && <span aria-hidden="true" class={cx(dotBase, dots[stat.tone])}></span>}{stat.label}</dt>
                          <dd class={statValue}>{stat.value}</dd>
                          <dd class={statNote}>{stat.note}</dd>
                        </div>
                      ))}
                      <div class={cx(cell, "col-span-2")}>
                        <dt class={statLabel}>Payroll this month</dt>
                        <dd class={statValue}>{rupiah(PAYROLL_GROSS)}</dd>
                        <dd class={statNote}>{`${rupiah(PAYROLL_NET)} net after BPJS and PPh 21`}</dd>
                      </div>
                    </dl>

                    <div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_380px]">
                      <section aria-labelledby="sigap-trend-title" class={panel}>
                        <div class={panelHead}>
                          <h2 id="sigap-trend-title" class={panelTitle}>Attendance trend</h2>
                          <ToggleGroup label="Trend range" items={rangeOptions} value="14" data-sg-toggle="range" />
                        </div>
                        <div class="p-4" data-sg-chart-view set:html={chartHtml("14")} />
                        {rangeOptions.map((option) => <template data-sg-chart={option.value} set:html={chartHtml(option.value)} />)}
                      </section>

                      <section aria-labelledby="sigap-waiting-title" class={panel}>
                        <div class={panelHead}>
                          <h2 id="sigap-waiting-title" class={panelTitle}>Awaiting approval</h2>
                          <Badge variant="primary" dot={false} data-waiting>{`${leaveCount(leaveNow, "pending")} pending`}</Badge>
                        </div>
                        <p class="p-4 text-sm text-muted" hidden data-sg-waiting-empty>All caught up. No leave requests are waiting.</p>
                        <ul data-sg-waiting>
                          {leaveRequests.filter((item) => item.status === "pending").map((item) => (
                            <li data-request={item.id} class={listRow}>
                              <div class="min-w-0 flex-1" set:html={personHtml(item.who, `${item.type} leave, ${leaveDates(item)}`)} />
                              <div class="flex gap-2">
                                <Button size="sm" variant="secondary" aria-label={`Reject ${item.who}`} data-sg-decide="rejected" data-sg-id={item.id}>Reject</Button>
                                <Button size="sm" aria-label={`Approve ${item.who}`} data-sg-decide="approved" data-sg-id={item.id}>Approve</Button>
                              </div>
                            </li>
                          ))}
                        </ul>
                        <div class="border-t border-line p-2">
                          <Button variant="ghost" size="sm" class="w-full" data-sg-link="leave">Open leave</Button>
                        </div>
                      </section>
                    </div>

                    <div class="grid gap-4 xl:grid-cols-2">
                      <section aria-labelledby="sigap-dept-title" class={panel}>
                        <div class={panelHead}>
                          <h2 id="sigap-dept-title" class={panelTitle}>On site by department</h2>
                          <span class="text-xs text-muted tabular-nums">116 of 128</span>
                        </div>
                        <ul class="grid gap-3 p-4">
                          {deptToday.map((item) => (
                            <li class="grid grid-cols-[88px_minmax(0,1fr)_56px] items-center gap-3 text-sm">
                              <span class="truncate">{item.dept}</span>
                              <span aria-hidden="true" class="h-2 overflow-hidden rounded-full bg-subtle"><span class="block h-full rounded-full bg-(--tpl-on)" style={`width: ${(item.present / item.total) * 100}%`}></span></span>
                              <span class="text-right text-xs text-muted tabular-nums">{`${item.present} / ${item.total}`}</span>
                            </li>
                          ))}
                        </ul>
                      </section>

                      <section aria-labelledby="sigap-upcoming-title" class={panel}>
                        <div class={panelHead}>
                          <h2 id="sigap-upcoming-title" class={panelTitle}>Birthdays and contract dates</h2>
                          <span class="text-xs text-muted">Next 30 days</span>
                        </div>
                        <ul>
                          {upcoming.map((item) => (
                            <li class="grid grid-cols-[52px_minmax(0,1fr)] items-center gap-3 border-b border-line px-4 py-2.5 text-sm last:border-b-0 sm:grid-cols-[52px_minmax(0,1fr)_auto]">
                              <span class="text-xs font-medium tabular-nums">{item.date}</span>
                              <div class="min-w-0">
                                <p class="truncate font-medium">{item.who}</p>
                                <p class={personMeta}>{item.note}</p>
                              </div>
                              <span class="hidden items-center gap-1.5 text-xs text-muted sm:inline-flex"><Fragment set:html={icon(item.icon)} />{item.kind}</span>
                            </li>
                          ))}
                        </ul>
                      </section>
                    </div>
                  </div>
                )}

                {id === "employees" && (
                  <section aria-label="Employee directory" class={panel}>
                    <div class="grid items-end gap-3 p-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_180px_180px_auto]">
                      <Input label="Search by name or ID" type="search" data-sg-query />
                      <Select label="Department" data-sg-filter="dept">
                        <option value="all">All departments</option>
                        {departments.map((item) => <option>{item}</option>)}
                      </Select>
                      <Select label="Status" data-sg-filter="type">
                        <option value="all">All statuses</option>
                        {employmentTypes.map((item) => <option>{item}</option>)}
                      </Select>
                      <Button data-sg-open={ADD_MODAL}><Fragment set:html={icon("plus")} />Add employee</Button>
                    </div>
                    <div tabindex="0" role="region" aria-label="Employees table" class={scroller}>
                      <table class={table}>
                        <thead>
                          <tr>
                            <th scope="col" class={th}>Employee</th>
                            <th scope="col" class={cx(th, "max-md:hidden")}>Department</th>
                            <th scope="col" class={cx(th, "max-xl:hidden")}>Role</th>
                            <th scope="col" class={th}>Status</th>
                            <th scope="col" class={cx(th, "max-lg:hidden")}>Shift</th>
                            <th scope="col" class={cx(th, "max-xl:hidden")}>Joined</th>
                            <th scope="col" class={th}><span class="sr-only">Actions</span></th>
                          </tr>
                        </thead>
                        <tbody data-sg-employees>
                          {employeeList.map((item) => (
                            <tr data-employee={item.id}>
                              <td class={td} set:html={personHtml(item.name, item.id)} />
                              <td class={cx(td, "max-md:hidden")} data-sg-cell="dept">{item.dept}</td>
                              <td class={cx(td, "max-xl:hidden")} data-sg-cell="role">{item.role}</td>
                              <td class={td} set:html={pillHtml(typeTones[item.type]!, item.type)} />
                              <td class={cx(td, "max-lg:hidden")} data-sg-cell="shift">{item.shift}</td>
                              <td class={cx(td, "text-muted max-xl:hidden")} data-sg-cell="joined">{item.joined}</td>
                              <td class={cx(td, "text-right")}><Button size="sm" variant="ghost" aria-label={`View ${item.name}`} data-sg-employee={item.id}>View</Button></td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p data-count class="border-t border-line px-4 py-3 text-xs text-muted">{`Showing ${employeeList.length} of ${employeeList.length} sample records, ${HEADCOUNT} employees in total`}</p>

                    <Drawer id={EMPLOYEE_DRAWER} title="Employee details">
                      <div class="grid gap-5 text-ink">
                        <div class={person}>
                          <Fragment set:html={faceHtml(firstEmployee.name, "size-12 text-sm")} />
                          <div class="min-w-0">
                            <p class="text-base font-semibold" data-sg-current="name">{firstEmployee.name}</p>
                            <p class="text-sm text-muted" data-sg-current="role">{`${firstEmployee.role}, ${firstEmployee.dept}`}</p>
                          </div>
                        </div>
                        <dl class="grid grid-cols-[112px_minmax(0,1fr)] gap-y-2.5 text-sm">
                          {employeeFields(firstEmployee).map(([label, value]) => (
                            <div class="contents">
                              <dt class="text-muted">{label}</dt>
                              <dd data-field={label} class="truncate font-medium">{value}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                      <Fragment slot="footer">
                        <Button variant="secondary" type="submit">Close</Button>
                        <Button type="submit" data-sg-link="payroll">Open payroll</Button>
                      </Fragment>
                    </Drawer>

                    <Modal id={ADD_MODAL} title="Add employee">
                      <div class="grid gap-4 text-ink">
                        <div class="grid gap-1.5">
                          <Input label="Full name" data-sg-draft="name" />
                          <p id="sigap-name-error" class="text-sm text-danger" hidden data-sg-error="name"></p>
                        </div>
                        <div class="grid gap-1.5">
                          <Input label="Work email" type="email" data-sg-draft="email" />
                          <p id="sigap-email-error" class="text-sm text-danger" hidden data-sg-error="email"></p>
                        </div>
                        <div class="grid gap-4 sm:grid-cols-2">
                          <Select label="Assign to department" data-sg-draft="dept">
                            {departments.map((item) => <option selected={item === emptyDraft.dept}>{item}</option>)}
                          </Select>
                          <Select label="Employment status" data-sg-draft="type">
                            {employmentTypes.map((item) => <option selected={item === emptyDraft.type}>{item}</option>)}
                          </Select>
                        </div>
                      </div>
                      <Fragment slot="footer">
                        <Button variant="secondary" type="submit">Cancel</Button>
                        <Button data-sg-save="employee">Save employee</Button>
                      </Fragment>
                    </Modal>
                  </section>
                )}

                {id === "attendance" && (
                  <section aria-label="Daily attendance" class={panel}>
                    <div class={cx(panelHead, "py-3")}>
                      <div class="flex items-center gap-1">
                        <button type="button" aria-label="Previous day" class={cx(iconButton, "disabled:opacity-40")} data-sg-day="-1" set:html={icon("prev")} />
                        <h2 data-date class="min-w-36 text-center text-sm font-semibold tabular-nums">{today.label}</h2>
                        <button type="button" aria-label="Next day" disabled class={cx(iconButton, "disabled:opacity-40")} data-sg-day="1" set:html={icon("next")} />
                      </div>
                      <ToggleGroup label="Filter by shift" items={shiftOptions} value="all" data-sg-toggle="shift" />
                    </div>
                    <dl class="flex flex-wrap gap-x-5 gap-y-1 border-b border-line px-4 py-2.5 text-xs text-muted">
                      {tallyKeys.map((status) => (
                        <div class="flex items-center gap-1.5">
                          <span aria-hidden="true" class={cx(dotBase, dots[dayStatus[status]!.tone])}></span>
                          <dt>{dayStatus[status]!.label}</dt>
                          <dd data-tally={status} class="font-semibold text-ink tabular-nums">{todayRows.filter((row) => row.status === status).length}</dd>
                        </div>
                      ))}
                    </dl>
                    <div tabindex="0" role="region" aria-label="Attendance table" class={scroller}>
                      <table class={table}>
                        <thead>
                          <tr>
                            <th scope="col" class={th}>Employee</th>
                            <th scope="col" class={cx(th, "max-lg:hidden")}>Shift</th>
                            <th scope="col" class={th}>Clock in</th>
                            <th scope="col" class={cx(th, "max-sm:hidden")}>Clock out</th>
                            <th scope="col" class={cx(th, "max-md:hidden")}>Hours</th>
                            <th scope="col" class={th}>Status</th>
                            <th scope="col" class={cx(th, "max-sm:hidden")}><span class="sr-only">Actions</span></th>
                          </tr>
                        </thead>
                        <tbody data-sg-attendance>
                          {todayRows.map((row) => (
                            <tr data-row={row.item.id}>
                              <td class={td} set:html={personHtml(row.item.name, row.item.dept)} />
                              <td class={cx(td, "max-lg:hidden")}>{row.item.shift}</td>
                              <td data-in class={cx(td, "tabular-nums")}>{row.in}</td>
                              <td data-out class={cx(td, "tabular-nums max-sm:hidden")}>{row.out}</td>
                              <td data-hours class={cx(td, "text-muted tabular-nums max-md:hidden")}>{row.hours}</td>
                              <td data-status class={td} set:html={pillHtml(dayStatus[row.status]!.tone, dayStatus[row.status]!.label)} />
                              <td class={cx(td, "text-right max-sm:hidden")}><Button size="sm" variant="ghost" aria-label={`Correct ${row.item.name}`} data-sg-correct={row.index}>Correct</Button></td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>

                    <Modal id={CORRECT_MODAL} title="Correct attendance">
                      <div class="grid gap-4 text-ink">
                        <p data-fix-who class="text-sm text-muted"></p>
                        <div class="grid grid-cols-2 gap-4">
                          <div class="grid gap-1.5">
                            <Input label="Clock in" type="time" data-sg-fix="in" />
                            <p id="sigap-in-error" class="text-sm text-danger" hidden data-sg-error="in"></p>
                          </div>
                          <Input label="Clock out" type="time" data-sg-fix="out" />
                        </div>
                        <div class="grid gap-1.5">
                          <Input label="Reason" data-sg-fix="reason" />
                          <p id="sigap-reason-error" class="text-sm text-danger" hidden data-sg-error="reason"></p>
                        </div>
                      </div>
                      <Fragment slot="footer">
                        <Button variant="secondary" type="submit">Cancel</Button>
                        <Button data-sg-save="fix">Save correction</Button>
                      </Fragment>
                    </Modal>
                  </section>
                )}

                {id === "leave" && (
                  <div class="grid gap-4">
                    <ul class={cx(strip, "sm:grid-cols-3")}>
                      {balances.map((item) => (
                        <li data-balance={item.type} class={cell}>
                          <p class={statLabel}>{item.label}</p>
                          <p class={statValue}><span data-sg-used>{item.used}</span><span class="ml-1.5 text-sm font-normal text-muted">{`of ${item.total.toLocaleString("id-ID")} days used`}</span></p>
                          <Progress value={item.used} max={item.total} aria-label={`${item.label} used`} class="mt-3 h-1.5" />
                          <p class={statNote}>{item.note}</p>
                        </li>
                      ))}
                    </ul>

                    <section aria-labelledby="sigap-out-title" class={panel}>
                      <div class={panelHead}>
                        <h2 id="sigap-out-title" class={panelTitle}>Who is out</h2>
                        <span class="text-xs text-muted">16 to 29 November</span>
                      </div>
                      <ol class="grid grid-cols-7 gap-px bg-line md:grid-cols-14">
                        {stripDays.map((item) => (
                          <li data-day={item.day} class={cx("grid h-20 content-start justify-items-center gap-1 pt-2 text-xs", item.weekend ? "bg-subtle text-muted" : "bg-surface")}>
                            <span class="text-muted">{item.weekday}</span>
                            <span class={cx("inline-flex size-6 items-center justify-center rounded-full text-sm font-semibold tabular-nums", item.day === TODAY && "bg-primary text-on-primary")}>{item.day}</span>
                            <span class="rounded-sm bg-primary-soft px-1.5 font-medium text-primary tabular-nums" hidden={outOn(leaveNow, item.day) === 0} data-sg-out>{outOn(leaveNow, item.day) > 0 ? `${outOn(leaveNow, item.day)} out` : ""}</span>
                          </li>
                        ))}
                      </ol>
                    </section>

                    <section aria-labelledby="sigap-requests-title" class={panel}>
                      <div class={panelHead}>
                        <h2 id="sigap-requests-title" class={panelTitle}>Requests</h2>
                        <ToggleGroup label="Filter requests" items={leaveFilters} value="pending" data-sg-toggle="filter" />
                      </div>
                      <dl data-counts class="flex flex-wrap gap-x-5 gap-y-1 border-b border-line px-4 py-2.5 text-xs text-muted">
                        {leaveFilters.map((item) => (
                          <div class="flex items-center gap-1.5">
                            <span aria-hidden="true" class={cx(dotBase, dots[leaveTones[item.value]!])}></span>
                            <dt>{item.label}</dt>
                            <dd data-count={item.value} class="font-semibold text-ink tabular-nums">{leaveCount(leaveNow, item.value as LeaveStatus)}</dd>
                          </div>
                        ))}
                      </dl>
                      <p class="p-4 text-sm text-muted" hidden data-sg-requests-empty>No requests in this view.</p>
                      {
                        /* Daftar awal berisi yang pending; semua baris ada di <template> dan dipasang ulang saat filter atau status berubah. */
                        [false, true].map((pool) => {
                          const List = pool ? "template" : "ul";
                          return (
                            <List data-sg-requests={pool ? undefined : ""} data-sg-request-pool={pool ? "" : undefined}>
                              {leaveRequests.filter((item) => pool || item.status === "pending").map((item) => (
                                <li data-request={item.id} class={listRow}>
                                  <div class="w-full min-w-0 sm:w-56" set:html={personHtml(item.who, item.id)} />
                                  <div class="min-w-0 flex-1 basis-48 text-sm">
                                    <p class="font-medium">{`${item.type} leave, ${leaveDates(item)} (${dayWord(item.days)})`}</p>
                                    <p class={personMeta}>{item.reason}</p>
                                  </div>
                                  <div class="flex gap-2" data-sg-actions>
                                    <Button size="sm" variant="secondary" aria-label={`Reject ${item.who}`} data-sg-decide="rejected" data-sg-id={item.id}>Reject</Button>
                                    <Button size="sm" aria-label={`Approve ${item.who}`} data-sg-decide="approved" data-sg-id={item.id}>Approve</Button>
                                  </div>
                                  <span class="contents" hidden data-sg-state set:html={pillHtml("on", "Approved")} />
                                </li>
                              ))}
                            </List>
                          );
                        })
                      }
                    </section>
                  </div>
                )}

                {id === "payroll" && (
                  <div class="grid gap-4">
                    <dl class={cx(strip, "grid-cols-2 xl:grid-cols-4")}>
                      {payrollTotals.map((item) => (
                        <div class={cell}>
                          <dt class={statLabel}>{item.label}</dt>
                          <dd class={cx(statValue, "text-xl")}>{rupiah(item.value)}</dd>
                          <dd class={statNote}>{item.note}</dd>
                        </div>
                      ))}
                    </dl>

                    <section aria-labelledby="sigap-run-title" class={panel}>
                      <div class={cx(panelHead, "py-3")}>
                        <div class="flex items-center gap-3">
                          <h2 id="sigap-run-title" class={panelTitle}>November 2026 run</h2>
                          <span data-run-status class="inline-flex" set:html={pillHtml(runStatus.draft!.tone, runStatus.draft!.label)} />
                        </div>
                        <Button size="sm" data-sg-open={RUN_MODAL} data-sg-run>Run payroll</Button>
                      </div>
                      <div tabindex="0" role="region" aria-label="Payroll table" class={scroller}>
                        <table class={table}>
                          <thead>
                            <tr>
                              <th scope="col" class={cx(th, "w-10 pr-0")}><span class="sr-only">Payslip</span></th>
                              <th scope="col" class={th}>Employee</th>
                              <th scope="col" class={cx(th, num, "max-lg:hidden")}>Basic salary</th>
                              <th scope="col" class={cx(th, num, "max-xl:hidden")}>Allowances</th>
                              <th scope="col" class={cx(th, num, "max-md:hidden")}>Deductions</th>
                              <th scope="col" class={cx(th, num)}>Net pay</th>
                              <th scope="col" class={cx(th, "max-sm:hidden")}>Status</th>
                            </tr>
                          </thead>
                          {employeeList.map((item) => {
                            const slip = payslip(item);
                            return (
                              <tbody data-slip={item.id}>
                                <tr>
                                  <td class={cx(td, "pr-0")}><button type="button" aria-label={`Payslip for ${item.name}`} aria-expanded="false" class={cx(iconButton, "size-8")} data-sg-slip={item.id} set:html={icon("next", "size-4 transition-transform duration-150")} /></td>
                                  <td class={td} set:html={personHtml(item.name, item.role)} />
                                  <td class={cx(td, num, "max-lg:hidden")}>{rupiah(item.salary)}</td>
                                  <td class={cx(td, num, "max-xl:hidden")}>{rupiah(slip.allowance)}</td>
                                  <td class={cx(td, num, "text-muted max-md:hidden")}>{rupiah(slip.deduction)}</td>
                                  <td data-net class={cx(td, num, "font-semibold")}>{rupiah(slip.net)}</td>
                                  <td class={cx(td, "max-sm:hidden")} data-sg-row-status set:html={pillHtml(runStatus.draft!.tone, runStatus.draft!.label)} />
                                </tr>
                                <template data-sg-detail>
                                  <tr>
                                    <td colspan="7" class="border-t border-line bg-subtle px-4 py-3">
                                      <dl data-lines class="grid max-w-md grid-cols-[minmax(0,1fr)_auto] gap-x-6 gap-y-1.5 text-sm sm:ml-10">
                                        {slip.lines.map(([label, amount]) => (
                                          <div class="contents">
                                            <dt class="text-muted">{label}</dt>
                                            <dd class={num}>{amount < 0 ? `- ${rupiah(-amount)}` : rupiah(amount)}</dd>
                                          </div>
                                        ))}
                                        <dt class="border-t border-line pt-1.5 font-semibold">Net pay</dt>
                                        <dd class={cx(num, "border-t border-line pt-1.5 font-semibold")}>{rupiah(slip.net)}</dd>
                                      </dl>
                                    </td>
                                  </tr>
                                </template>
                              </tbody>
                            );
                          })}
                        </table>
                      </div>
                      <p class="border-t border-line px-4 py-3 text-xs text-muted">{`Showing ${employeeList.length} of ${HEADCOUNT} payslips`}</p>
                    </section>

                    <section aria-labelledby="sigap-rates-title" class={panel}>
                      <div class={panelHead}>
                        <h2 id="sigap-rates-title" class={panelTitle}>Statutory contribution rates</h2>
                        <span class="text-xs text-muted">Share of basic salary</span>
                      </div>
                      <Table caption="Statutory contribution rates" label="Contribution rates table" columns={rateColumns} rows={rateRows} size="sm" square class="border-0" />
                    </section>

                    <Modal id={RUN_MODAL} title="Run November payroll">
                      <div class="grid gap-4">
                        <p>{`${HEADCOUNT} payslips will be locked and ${rupiah(PAYROLL_NET)} queued for transfer from Bank Mandiri on 25 Nov.`}</p>
                        <div class="contents" hidden data-sg-progress>
                          <Progress label="Processing payslips" value={0} />
                        </div>
                      </div>
                      <Fragment slot="footer">
                        <Button variant="secondary" type="submit" data-sg-run-button>Cancel</Button>
                        <Button data-sg-run-button data-sg-save="run">Confirm and run</Button>
                      </Fragment>
                    </Modal>
                  </div>
                )}

                {id === "recruitment" && (
                  <div class="grid gap-x-4 gap-y-6 md:grid-cols-2 xl:grid-cols-4">
                    {stages.map((stage, index) => {
                      const items = candidateList.filter((item) => item.stage === stage);
                      return (
                        <section aria-label={stage} data-stage={stage} class={column}>
                          <div class={columnHead}>
                            <h2>{stage}</h2>
                            <span class="text-xs font-medium text-muted tabular-nums" data-sg-stage-count>{items.length}</span>
                          </div>
                          <p class="py-3 text-xs text-muted" hidden data-sg-stage-empty>No candidates here.</p>
                          {items.map((item) => (
                            <article data-candidate={item.id} class={candidateCard}>
                              <Fragment set:html={personHtml(item.name, item.role)} />
                              <div class="flex items-center justify-between gap-2">
                                <p class="text-xs text-muted" data-sg-note>{`${item.source}, ${dayWord(item.days)} in stage`}</p>
                                <div class="flex gap-1.5">
                                  <button type="button" aria-label={`Move ${item.name} back to ${stages[index - 1]}`} class={moveButton} hidden={index === 0} data-sg-move="-1" set:html={icon("prev")} />
                                  <button type="button" aria-label={`Move ${item.name} to ${stages[index + 1]}`} class={moveButton} hidden={index === stages.length - 1} data-sg-move="1" set:html={icon("next")} />
                                </div>
                              </div>
                            </article>
                          ))}
                        </section>
                      );
                    })}
                  </div>
                )}

                {id === "settings" && (
                  <div class="grid items-start gap-4 xl:grid-cols-2">
                    <section aria-labelledby="sigap-profile-title" class={panel}>
                      <div class={panelHead}>
                        <h2 id="sigap-profile-title" class={panelTitle}>Company profile</h2>
                      </div>
                      <form novalidate class="grid gap-4 p-4 sm:grid-cols-2" data-sg-profile>
                        {profileFields.map((field) => (
                          <div class="grid gap-1.5">
                            <Input label={field.label} type={field.type} value={profileDefaults[field.key]} data-sg-field={field.key} />
                            <p id={`sigap-${field.key}-error`} class="text-sm text-danger" hidden data-sg-error={field.key}></p>
                          </div>
                        ))}
                        <div class="sm:col-span-2">
                          <Button type="submit">Save profile</Button>
                        </div>
                      </form>
                    </section>

                    <div class="grid gap-4">
                      <section aria-labelledby="sigap-schedule-title" class={panel}>
                        <div class={panelHead}>
                          <h2 id="sigap-schedule-title" class={panelTitle}>Work schedule</h2>
                          <span data-workdays class="text-xs text-muted">{`${defaultWorkDays.length} work days a week`}</span>
                        </div>
                        <div class="grid gap-4 p-4">
                          <div role="group" aria-label="Work days" class="flex flex-wrap gap-1.5">
                            {weekdays.map((day) => (
                              <button type="button" aria-pressed={defaultWorkDays.includes(day) ? "true" : "false"} class={cx(dayButton, defaultWorkDays.includes(day) ? dayOn : dayOff)} data-sg-workday={day}>{day}</button>
                            ))}
                          </div>
                          <div class="grid gap-4 sm:grid-cols-2">
                            <Select label="Late tolerance" data-sg-schedule="tolerance">
                              {tolerances.map((item, index) => <option selected={index === 1}>{item}</option>)}
                            </Select>
                            <Select label="Payroll cutoff" data-sg-schedule="cutoff">
                              {cutoffs.map((item, index) => <option selected={index === 1}>{item}</option>)}
                            </Select>
                          </div>
                          <div>
                            <Button variant="secondary" data-sg-save="schedule">Save schedule</Button>
                          </div>
                        </div>
                      </section>

                      <section aria-labelledby="sigap-policy-title" class={panel}>
                        <div class={panelHead}>
                          <h2 id="sigap-policy-title" class={panelTitle}>Attendance policies</h2>
                          <span data-enabled class="text-xs text-muted">{`${policies.filter((item) => item.on).length} of ${policies.length} on`}</span>
                        </div>
                        <ul>
                          {policies.map((item) => (
                            <li class={cx(listRow, "flex-nowrap")}>
                              <div class="min-w-0 flex-1 text-sm">
                                <p class="font-medium">{item.label}</p>
                                <p class="text-xs text-muted">{item.note}</p>
                              </div>
                              <Switch aria-label={item.label} checked={item.on} data-sg-policy={item.label} />
                            </li>
                          ))}
                        </ul>
                      </section>
                    </div>
                  </div>
                )}
              </Wrapper>
            );
          })
        }
      </main>
    </div>
    <Toaster />
  </div>
</sigap-template>

<script>
  type Named = { label: string; tone: string };
  type Employee = {
    id: string;
    name: string;
    dept: string;
    role: string;
    type: string;
    shift: string;
    joined: string;
    salary: number;
  };
  type LeaveRequest = {
    id: string;
    who: string;
    type: string;
    from: number;
    to: number;
    days: number;
    status: string;
  };
  type Candidate = {
    id: string;
    name: string;
    role: string;
    source: string;
    days: number;
    stage: string;
  };
  type Config = {
    pages: Record<string, { title: string; sub: string }>;
    defaultPage: string;
    titleId: string;
    ids: { drawer: string; add: string; correct: string; run: string };
    me: string;
    headcount: number;
    preview: number;
    employees: Employee[];
    newHire: { role: string; shift: string; joined: string; salary: number };
    newIdStart: number;
    typeTones: Record<string, string>;
    dates: { id: string; label: string }[];
    attendance: Record<string, string[]>;
    shiftStart: Record<string, string>;
    lateAfter: number;
    dayMinutes: number;
    dayStatus: Record<string, Named>;
    requests: LeaveRequest[];
    balances: { type: string; used: number }[];
    leaveTones: Record<string, string>;
    runStatus: Record<string, Named>;
    runStep: number;
    runTick: number;
    net: number;
    stages: string[];
    candidates: Candidate[];
    weekdays: string[];
    workDays: string[];
    policies: { label: string; on: boolean }[];
    npwpDigits: number;
    faceTones: string[];
    dots: Record<string, string>;
    dotBase: string;
    classes: { navOn: string; navOff: string; dayOn: string; dayOff: string };
  };
  type Field = HTMLInputElement | HTMLSelectElement;

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const toast = (title: string, description = "", variant?: string) =>
    window.dispatchEvent(
      new CustomEvent("markas-toast", {
        detail: { title, description, variant },
      }),
    );
  const swap = (element: Element, add: string, remove: string) => {
    element.classList.remove(...remove.split(" "));
    element.classList.add(...add.split(" "));
  };
  const rupiah = (value: number) => `Rp ${value.toLocaleString("id-ID")}`;
  const initials = (name: string) =>
    name
      .split(" ")
      .filter((_, index, words) => index === 0 || index === words.length - 1)
      .map((word) => word.charAt(0))
      .join("")
      .toUpperCase();
  const emailOf = (name: string) =>
    `${name.toLowerCase().replace(/\s+/g, ".")}@sigapkarya.co.id`;
  const minutes = (time: string) =>
    Number(time.slice(0, 2)) * 60 + Number(time.slice(3));
  const leaveDates = (item: LeaveRequest) =>
    item.from === item.to
      ? `${item.from} Nov`
      : `${item.from} to ${item.to} Nov`;
  const dialogOf = (id: string) => {
    const dialog = document.getElementById(id);
    return dialog instanceof HTMLDialogElement ? dialog : null;
  };

  /** Satu elemen per template: navigasi hash, state bersama, dan interaksi tiap halaman. */
  class SigapTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    /* State bersama */
    private page = "";
    private query = "";
    private leave: Record<string, string> = Object.fromEntries(
      this.config.requests.map((item) => [item.id, item.status]),
    );
    /* State halaman, direset setiap kali halaman dibuka. */
    private list: Employee[] = [];
    private employeeRows = new Map<string, HTMLElement>();
    private dateIndex = 0;
    private records: Record<string, string[]> = {};
    private attendanceRows = new Map<string, HTMLElement>();
    private fixIndex = -1;
    private toggles: Record<string, string> = {};
    private requestRows = new Map<string, HTMLElement>();
    private waitingRows = new Map<string, HTMLElement>();
    private timer = 0;
    private candidates: Candidate[] = [];
    private workDays: string[] = [];
    private readonly onHashChange = () => {
      this.open(this.readHash());
      document.getElementById(this.config.titleId)?.focus();
    };
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onInput = (event: Event) => this.handleInput(event);
    private readonly onChange = (event: Event) => this.handleChange(event);
    private readonly onSubmit = (event: Event) => this.handleSubmit(event);
    private readonly onSelect = (event: Event) =>
      this.pickMenu((event as CustomEvent<string>).detail);
    private readonly onClose = (event: Event) => {
      if ((event.target as Element).id === this.config.ids.add)
        this.resetDraft();
    };

    connectedCallback() {
      this.open(this.readHash());
      window.addEventListener("hashchange", this.onHashChange);
      this.addEventListener("click", this.onClick);
      this.addEventListener("input", this.onInput);
      this.addEventListener("change", this.onChange);
      this.addEventListener("submit", this.onSubmit);
      this.addEventListener("markas-select", this.onSelect);
      this.addEventListener("close", this.onClose, true);
    }

    disconnectedCallback() {
      window.clearInterval(this.timer);
      window.removeEventListener("hashchange", this.onHashChange);
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("input", this.onInput);
      this.removeEventListener("change", this.onChange);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("markas-select", this.onSelect);
      this.removeEventListener("close", this.onClose, true);
    }

    private find<T extends Element = HTMLElement>(selector: string) {
      return this.querySelector<T>(`[data-sg-main] ${selector}`);
    }

    private findAll<T extends Element = HTMLElement>(selector: string) {
      return [...this.querySelectorAll<T>(`[data-sg-main] ${selector}`)];
    }

    private setText(selector: string, value: string | number) {
      const element = this.find(selector);
      if (element) element.textContent = String(value);
    }

    /** Halaman aktif disimpan di hash URL supaya bisa dibagikan dan tombol Back bekerja. */
    private readHash() {
      const id = window.location.hash.slice(1);
      return id in this.config.pages ? id : this.config.defaultPage;
    }

    private go(id: string) {
      window.location.assign(`#${id}`);
    }

    private setFace(root: Element, name: string) {
      const element = root.querySelector("[data-sg-face]");
      if (!element) return;
      const tones = this.config.faceTones;
      const sum = [...name].reduce((total, char) => total + char.charCodeAt(0), 0);
      element.classList.remove(...tones);
      element.classList.add(tones[sum % tones.length]!);
      element.textContent = initials(name);
    }

    private setPill(root: Element | null, tone: string, text: string) {
      const { dots, dotBase } = this.config;
      const dot = root?.querySelector("[data-sg-dot]");
      const label = root?.querySelector("[data-sg-text]");
      if (dot) dot.className = `${dotBase} ${dots[tone]}`;
      if (label) label.textContent = text;
    }

    private setError(key: string, message: string, field: Field | null) {
      const note = this.find(`[data-sg-error="${key}"]`);
      if (!note) return;
      note.textContent = message;
      note.hidden = !message;
      if (message) {
        field?.setAttribute("aria-invalid", "true");
        field?.setAttribute("aria-describedby", note.id);
      } else {
        field?.removeAttribute("aria-invalid");
        field?.removeAttribute("aria-describedby");
      }
    }

    /** Ganti isi halaman dengan klon baru dari <template>, lalu siapkan state-nya. */
    private open(id: string) {
      const template = this.querySelector<HTMLTemplateElement>(
        `template[data-sg-page="${id}"]`,
      );
      const view = this.querySelector("[data-sg-main]");
      if (!template || !view) return;
      if (id === this.page) return;
      window.clearInterval(this.timer);
      view.replaceChildren(template.content.cloneNode(true));
      const { pages, classes, employees, dates } = this.config;
      this.page = id;
      this.querySelectorAll<HTMLElement>("[data-sg-go]").forEach((button) => {
        const active = button.dataset.sgGo === id;
        if (active) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
        swap(
          button,
          active ? classes.navOn : classes.navOff,
          active ? classes.navOff : classes.navOn,
        );
      });
      document.getElementById(this.config.titleId)!.textContent =
        pages[id]!.title;
      this.querySelector("[data-sg-sub]")!.textContent = pages[id]!.sub;
      this.list = employees;
      this.employeeRows = new Map(
        this.findAll("tr[data-employee]").map((row) => [
          row.dataset.employee!,
          row,
        ]),
      );
      this.dateIndex = dates.length - 1;
      this.records = this.config.attendance;
      this.attendanceRows = new Map(
        this.findAll("tr[data-row]").map((row) => [row.dataset.row!, row]),
      );
      this.toggles = { range: "14", shift: "all", filter: "pending" };
      const pool = this.find<HTMLTemplateElement>("[data-sg-request-pool]");
      this.requestRows = new Map(
        [...(pool?.content.querySelectorAll<HTMLElement>("li") ?? [])].map(
          (row) => [row.dataset.request!, row],
        ),
      );
      this.waitingRows = new Map(
        this.findAll("[data-sg-waiting] li").map((row) => [
          row.dataset.request!,
          row,
        ]),
      );
      this.candidates = this.config.candidates;
      this.workDays = this.config.workDays;
      this.findAll<HTMLInputElement>("[data-sg-query]").forEach(
        (input) => (input.value = this.query),
      );
      this.renderEmployees();
      this.renderLeave();
    }

    private handleClick(event: Event) {
      const target = (event.target as Element).closest<HTMLElement>(
        "[data-sg-go], [data-sg-link], [data-sg-open], [data-sg-read], [data-sg-decide], [data-sg-employee], [data-sg-save], [data-sg-day], [data-sg-correct], [data-sg-toggle] > button, [data-sg-slip], [data-sg-move], [data-sg-workday]",
      );
      if (!target) return;
      const data = target.dataset;
      if (data.sgGo) return this.go(data.sgGo);
      if (data.sgLink) return this.go(data.sgLink);
      if (data.sgOpen) return dialogOf(data.sgOpen)?.showModal();
      if ("sgRead" in data) return this.markRead();
      if (data.sgDecide) return this.decide(data.sgId!, data.sgDecide);
      if (data.sgEmployee) return this.view(data.sgEmployee);
      if (data.sgSave === "employee") return this.addEmployee();
      if (data.sgSave === "fix") return this.saveFix();
      if (data.sgSave === "run") return this.startRun();
      if (data.sgSave === "schedule") return this.saveSchedule();
      if (data.sgDay) return this.changeDay(Number(data.sgDay));
      if (data.sgCorrect) return this.correct(Number(data.sgCorrect));
      if (data.sgSlip) return this.toggleSlip(target);
      if (data.sgMove) return this.move(target, Number(data.sgMove));
      if (data.sgWorkday) return this.toggleDay(data.sgWorkday);
      const group = target.parentElement!;
      // ToggleGroup memperbarui tombolnya di listener document, jadi baca setelah itu selesai.
      window.setTimeout(() => this.syncToggle(group, target));
    }

    /** Pilihan aktif yang diklik lagi tetap aktif, sama dengan versi React. */
    private syncToggle(group: HTMLElement, button: HTMLElement) {
      if (button.getAttribute("aria-pressed") !== "true") {
        button.setAttribute("aria-pressed", "true");
        button.dataset.state = "on";
      }
      const name = group.dataset.sgToggle!;
      if (this.toggles[name] === button.dataset.value) return;
      this.toggles[name] = button.dataset.value!;
      if (name === "range") this.renderChart();
      if (name === "shift") this.renderAttendance();
      if (name === "filter") this.renderLeave();
    }

    private handleInput(event: Event) {
      const target = event.target as HTMLInputElement;
      if (!("sgQuery" in target.dataset)) return;
      this.query = target.value;
      this.querySelectorAll<HTMLInputElement>("[data-sg-query]").forEach(
        (input) => {
          if (input !== target) input.value = this.query;
        },
      );
      this.renderEmployees();
    }

    private handleChange(event: Event) {
      const target = event.target as HTMLInputElement;
      if (target.dataset.sgFilter) this.renderEmployees();
      if (target.dataset.sgPolicy) {
        const on = this.findAll<HTMLInputElement>("[data-sg-policy]").filter(
          (input) => input.checked,
        ).length;
        this.setText(
          "[data-enabled]",
          `${on} of ${this.config.policies.length} on`,
        );
        toast(
          `${target.dataset.sgPolicy} ${target.checked ? "enabled" : "disabled"}`,
        );
      }
    }

    private handleSubmit(event: Event) {
      const form = event.target as HTMLElement;
      if ("sgSearch" in form.dataset) {
        event.preventDefault();
        this.go("employees");
      }
      if ("sgProfile" in form.dataset) {
        event.preventDefault();
        this.saveProfile();
      }
    }

    private pickMenu(value: string) {
      if (value === "settings") return this.go("settings");
      if (value === "signout") toast("Signed out", "See you tomorrow, Dewi.");
      else toast("Profile", `${this.config.me}, HR Manager`);
    }

    private markRead() {
      this.querySelector("[data-sg-unread]")!.textContent =
        "Notifications, 0 unread";
      this.querySelector<HTMLElement>("[data-sg-unread-dot]")!.hidden = true;
      this.querySelector<HTMLButtonElement>("[data-sg-read]")!.disabled = true;
      this.querySelectorAll("[data-sg-note-dot]").forEach((dot) =>
        swap(dot, "bg-line", "bg-primary"),
      );
    }

    /* Overview */
    private renderChart() {
      const template = this.find<HTMLTemplateElement>(
        `template[data-sg-chart="${this.toggles.range}"]`,
      );
      if (template)
        this.find("[data-sg-chart-view]")?.replaceChildren(
          template.content.cloneNode(true),
        );
    }

    /* Leave (bersama Overview) */
    private count(status: string) {
      return this.config.requests.filter(
        (item) => this.leave[item.id] === status,
      ).length;
    }

    private decide(id: string, status: string) {
      const item = this.config.requests.find((entry) => entry.id === id)!;
      this.leave = { ...this.leave, [id]: status };
      this.renderLeave();
      toast(
        status === "approved" ? "Leave approved" : "Leave rejected",
        `${item.who}, ${leaveDates(item)}`,
        status === "approved" ? "success" : "default",
      );
    }

    private renderLeave() {
      const { requests, balances, leaveTones, preview } = this.config;
      const pending = this.count("pending");
      this.querySelectorAll<HTMLElement>("[data-sg-pending]").forEach(
        (badge) => {
          badge.hidden = pending === 0;
          badge.querySelector("[data-sg-pending-count]")!.textContent =
            String(pending);
        },
      );
      const approved = requests.filter(
        (item) => this.leave[item.id] === "approved",
      );
      const waiting = this.find("[data-sg-waiting]");
      if (waiting) {
        const rows = requests
          .filter((item) => this.leave[item.id] === "pending")
          .slice(0, preview)
          .map((item) => this.waitingRows.get(item.id)!);
        waiting.replaceChildren(...rows);
        waiting.hidden = rows.length === 0;
        this.find("[data-sg-waiting-empty]")!.hidden = rows.length > 0;
        this.setText("[data-waiting]", `${pending} pending`);
      }
      const list = this.find("[data-sg-requests]");
      if (!list) return;
      const filter = this.toggles.filter!;
      const rows = requests
        .filter((item) => this.leave[item.id] === filter)
        .map((item) => {
          const row = this.requestRows.get(item.id)!;
          const state = row.querySelector<HTMLElement>("[data-sg-state]")!;
          row.querySelector<HTMLElement>("[data-sg-actions]")!.hidden =
            filter !== "pending";
          state.hidden = filter === "pending";
          this.setPill(
            state,
            leaveTones[filter]!,
            filter === "approved" ? "Approved" : "Rejected",
          );
          return row;
        });
      list.replaceChildren(...rows);
      list.hidden = rows.length === 0;
      this.find("[data-sg-requests-empty]")!.hidden = rows.length > 0;
      for (const status of ["pending", "approved", "rejected"])
        this.setText(`[data-count="${status}"]`, this.count(status));
      for (const balance of balances) {
        const used = approved
          .filter(
            (item) => item.type === balance.type && item.status === "pending",
          )
          .reduce((sum, item) => sum + item.days, balance.used);
        const card = this.find(`[data-balance="${balance.type}"]`)!;
        card.querySelector("[data-sg-used]")!.textContent = String(used);
        card.querySelector("progress")!.value = used;
      }
      for (const cell of this.findAll("[data-day]")) {
        const day = Number(cell.dataset.day);
        const out = approved.filter(
          (item) => item.from <= day && day <= item.to,
        ).length;
        const chip = cell.querySelector<HTMLElement>("[data-sg-out]")!;
        chip.hidden = out === 0;
        chip.textContent = out > 0 ? `${out} out` : "";
      }
    }

    /* Employees */
    private renderEmployees() {
      const body = this.find("[data-sg-employees]");
      if (!body) return;
      const needle = this.query.trim().toLowerCase();
      const dept = this.find<HTMLSelectElement>('[data-sg-filter="dept"]')!;
      const type = this.find<HTMLSelectElement>('[data-sg-filter="type"]')!;
      const shown = this.list.filter(
        (item) =>
          `${item.name} ${item.id}`.toLowerCase().includes(needle) &&
          (dept.value === "all" || item.dept === dept.value) &&
          (type.value === "all" || item.type === type.value),
      );
      body.replaceChildren(
        ...shown.map((item) => this.employeeRows.get(item.id)!),
      );
      this.setText(
        "[data-count]",
        shown.length === 0
          ? "No employees match these filters."
          : `Showing ${shown.length} of ${this.list.length} sample records, ${this.config.headcount} employees in total`,
      );
    }

    private view(id: string) {
      const item = this.list.find((entry) => entry.id === id)!;
      const drawer = dialogOf(this.config.ids.drawer);
      if (!drawer) return;
      const fields: Record<string, string> = {
        "Employee ID": item.id,
        Status: item.type,
        Shift: `${item.shift}, starts ${this.config.shiftStart[item.shift]}`,
        Joined: item.joined,
        "Base salary": rupiah(item.salary),
        Email: emailOf(item.name),
      };
      this.setFace(drawer, item.name);
      drawer.querySelector('[data-sg-current="name"]')!.textContent = item.name;
      drawer.querySelector('[data-sg-current="role"]')!.textContent =
        `${item.role}, ${item.dept}`;
      drawer.querySelectorAll<HTMLElement>("[data-field]").forEach((field) => {
        field.textContent = fields[field.dataset.field!]!;
      });
      drawer.showModal();
    }

    private draftField(key: string) {
      return this.find<Field>(`[data-sg-draft="${key}"]`)!;
    }

    private resetDraft() {
      for (const key of ["name", "email"]) {
        this.draftField(key).value = "";
        this.setError(key, "", this.draftField(key));
      }
      this.draftField("dept").value = "Production";
      this.draftField("type").value = "Contract";
    }

    private addEmployee() {
      const { employees, newHire, newIdStart, typeTones, ids } = this.config;
      const name = this.draftField("name").value.trim();
      const email = this.draftField("email").value;
      const errors = {
        name: name ? "" : "Enter the employee's full name",
        email: EMAIL.test(email) ? "" : "Enter a valid work email",
      };
      this.setError("name", errors.name, this.draftField("name"));
      this.setError("email", errors.email, this.draftField("email"));
      if (errors.name || errors.email) return;
      const item: Employee = {
        ...newHire,
        id: `SG-${newIdStart + this.list.length - employees.length}`,
        name,
        dept: this.draftField("dept").value,
        type: this.draftField("type").value,
      };
      const row = this.employeeRows
        .get(employees[0]!.id)!
        .cloneNode(true) as HTMLElement;
      row.dataset.employee = item.id;
      this.setFace(row, name);
      row.querySelector("[data-sg-name]")!.textContent = name;
      row.querySelector("[data-sg-meta]")!.textContent = item.id;
      for (const key of ["dept", "role", "shift", "joined"] as const)
        row.querySelector(`[data-sg-cell="${key}"]`)!.textContent = item[key];
      this.setPill(row, typeTones[item.type]!, item.type);
      const button = row.querySelector<HTMLElement>("[data-sg-employee]")!;
      button.dataset.sgEmployee = item.id;
      button.setAttribute("aria-label", `View ${name}`);
      this.employeeRows.set(item.id, row);
      this.list = [item, ...this.list];
      this.renderEmployees();
      dialogOf(ids.add)?.close();
      toast("Employee added", `${name}, ${item.dept}`, "success");
    }

    /* Attendance */
    private dayRow(record: string, shift: string) {
      const { shiftStart, lateAfter, dayMinutes } = this.config;
      if (record === "" || record === "absent" || record === "leave")
        return { in: "", out: "", hours: "", status: record || "scheduled" };
      const [start = "", end = ""] = record.split("-");
      const worked = (minutes(end) - minutes(start) + dayMinutes) % dayMinutes;
      const late = minutes(start) - minutes(shiftStart[shift]!) > lateAfter;
      return {
        in: start,
        out: end,
        hours: end
          ? `${Math.floor(worked / 60)}h ${String(worked % 60).padStart(2, "0")}m`
          : "",
        status: late ? "late" : "ontime",
      };
    }

    private get date() {
      return this.config.dates[this.dateIndex]!;
    }

    private changeDay(step: number) {
      this.dateIndex += step;
      this.renderAttendance();
    }

    private renderAttendance() {
      const { employees, dates, dayStatus } = this.config;
      const body = this.find("[data-sg-attendance]");
      if (!body) return;
      const shift = this.toggles.shift;
      const tally: Record<string, number> = {};
      const rows = employees.flatMap((item, index) => {
        if (shift !== "all" && item.shift !== shift) return [];
        const day = this.dayRow(this.records[this.date.id]![index]!, item.shift);
        const row = this.attendanceRows.get(item.id)!;
        row.querySelector("[data-in]")!.textContent = day.in;
        row.querySelector("[data-out]")!.textContent = day.out;
        row.querySelector("[data-hours]")!.textContent = day.hours;
        const status = dayStatus[day.status]!;
        this.setPill(row, status.tone, status.label);
        tally[day.status] = (tally[day.status] ?? 0) + 1;
        return [row];
      });
      body.replaceChildren(...rows);
      this.setText("[data-date]", this.date.label);
      this.find<HTMLButtonElement>('[data-sg-day="-1"]')!.disabled =
        this.dateIndex === 0;
      this.find<HTMLButtonElement>('[data-sg-day="1"]')!.disabled =
        this.dateIndex === dates.length - 1;
      for (const cell of this.findAll("[data-tally]"))
        cell.textContent = String(tally[cell.dataset.tally!] ?? 0);
    }

    private fixField(key: string) {
      return this.find<HTMLInputElement>(`[data-sg-fix="${key}"]`)!;
    }

    private correct(index: number) {
      const item = this.config.employees[index]!;
      const day = this.dayRow(this.records[this.date.id]![index]!, item.shift);
      this.fixIndex = index;
      this.fixField("in").value = day.in;
      this.fixField("out").value = day.out;
      this.fixField("reason").value = "";
      this.setError("in", "", this.fixField("in"));
      this.setError("reason", "", this.fixField("reason"));
      this.setText("[data-fix-who]", `${item.name}, ${this.date.label}`);
      dialogOf(this.config.ids.correct)?.showModal();
    }

    private saveFix() {
      const start = this.fixField("in").value;
      const reason = this.fixField("reason").value.trim();
      const errors = {
        in: start ? "" : "Enter a clock-in time",
        reason: reason ? "" : "Add a reason for the audit log",
      };
      this.setError("in", errors.in, this.fixField("in"));
      this.setError("reason", errors.reason, this.fixField("reason"));
      if (errors.in || errors.reason) return;
      const date = this.date;
      this.records = {
        ...this.records,
        [date.id]: this.records[date.id]!.map((record, index) =>
          index === this.fixIndex
            ? `${start}-${this.fixField("out").value}`
            : record,
        ),
      };
      this.renderAttendance();
      dialogOf(this.config.ids.correct)?.close();
      toast(
        "Attendance corrected",
        `${this.config.employees[this.fixIndex]!.name}, ${date.label}`,
        "success",
      );
    }

    /* Payroll */
    private toggleSlip(button: HTMLElement) {
      const open = button.getAttribute("aria-expanded") !== "true";
      for (const other of this.findAll("[data-sg-slip]")) {
        const body = other.closest("tbody")!;
        const expanded = other === button && open;
        other.setAttribute("aria-expanded", String(expanded));
        other.querySelector("svg")!.classList.toggle("rotate-90", expanded);
        body.querySelector("[data-lines]")?.closest("tr")?.remove();
        if (expanded)
          body.append(
            body
              .querySelector<HTMLTemplateElement>("[data-sg-detail]")!
              .content.cloneNode(true),
          );
      }
    }

    private setRun(run: string) {
      const status = this.config.runStatus[run]!;
      this.setPill(this.find("[data-run-status]"), status.tone, status.label);
      for (const cell of this.findAll("[data-sg-row-status]"))
        this.setPill(cell, status.tone, status.label);
      this.find<HTMLButtonElement>("[data-sg-run]")!.disabled = run !== "draft";
      for (const button of this.findAll<HTMLButtonElement>(
        "[data-sg-run-button]",
      ))
        button.disabled = run === "running";
      this.find("[data-sg-progress]")!.hidden = run === "draft";
    }

    private startRun() {
      const { runStep, runTick, headcount, net, ids } = this.config;
      const holder = this.find("[data-sg-progress]")!;
      let value = 0;
      this.setRun("running");
      this.timer = window.setInterval(() => {
        value += runStep;
        holder.querySelector("progress")!.value = value;
        holder.querySelector("label + span")!.textContent = `${value}%`;
        if (value < 100) return;
        window.clearInterval(this.timer);
        dialogOf(ids.run)?.close();
        this.setRun("paid");
        toast(
          "Payroll completed",
          `${headcount} payslips sent, ${rupiah(net)} queued for transfer`,
          "success",
        );
      }, runTick);
    }

    /* Recruitment */
    private move(button: HTMLElement, step: number) {
      const { stages } = this.config;
      const card = button.closest<HTMLElement>("[data-candidate]")!;
      const item = this.candidates.find(
        (entry) => entry.id === card.dataset.candidate,
      )!;
      const stage = stages[stages.indexOf(item.stage) + step]!;
      this.candidates = this.candidates.map((entry) =>
        entry.id === item.id ? { ...entry, stage, days: 0 } : entry,
      );
      const index = stages.indexOf(stage);
      const [back, forward] = card.querySelectorAll<HTMLElement>("[data-sg-move]");
      back!.hidden = index === 0;
      back!.setAttribute(
        "aria-label",
        `Move ${item.name} back to ${stages[index - 1]}`,
      );
      forward!.hidden = index === stages.length - 1;
      forward!.setAttribute(
        "aria-label",
        `Move ${item.name} to ${stages[index + 1]}`,
      );
      card.querySelector("[data-sg-note]")!.textContent =
        `${item.source}, moved today`;
      for (const section of this.findAll("[data-stage]")) {
        const items = this.candidates.filter(
          (entry) => entry.stage === section.dataset.stage,
        );
        section.append(
          ...items.map(
            (entry) => this.find(`[data-candidate="${entry.id}"]`)!,
          ),
        );
        section.querySelector("[data-sg-stage-count]")!.textContent = String(
          items.length,
        );
        section.querySelector<HTMLElement>("[data-sg-stage-empty]")!.hidden =
          items.length > 0;
      }
      toast(`Moved to ${stage}`, `${item.name}, ${item.role}`, "success");
      card.querySelector<HTMLElement>("button:not([hidden])")?.focus();
    }

    /* Settings */
    private saveProfile() {
      const field = (key: string) =>
        this.find<HTMLInputElement>(`[data-sg-field="${key}"]`)!;
      const errors: Record<string, string> = {
        company: field("company").value.trim() ? "" : "Enter the company name",
        npwp:
          field("npwp").value.replace(/\D/g, "").length ===
          this.config.npwpDigits
            ? ""
            : "NPWP must have 15 digits",
        email: EMAIL.test(field("email").value)
          ? ""
          : "Enter a valid email address",
      };
      for (const key of Object.keys(errors))
        this.setError(key, errors[key]!, field(key));
      if (errors.company || errors.npwp || errors.email) return;
      toast("Company profile saved", field("company").value, "success");
    }

    private toggleDay(day: string) {
      const { weekdays, classes } = this.config;
      this.workDays = weekdays.filter(
        (item) => (item === day) !== this.workDays.includes(item),
      );
      for (const button of this.findAll("[data-sg-workday]")) {
        const on = this.workDays.includes(button.dataset.sgWorkday!);
        button.setAttribute("aria-pressed", String(on));
        swap(
          button,
          on ? classes.dayOn : classes.dayOff,
          on ? classes.dayOff : classes.dayOn,
        );
      }
      this.setText(
        "[data-workdays]",
        `${this.workDays.length} work days a week`,
      );
    }

    private saveSchedule() {
      const value = (key: string) =>
        this.find<HTMLSelectElement>(`[data-sg-schedule="${key}"]`)!.value;
      toast(
        "Work schedule saved",
        `${this.workDays.join(", ")}. Late after ${value("tolerance")}, cutoff on the ${value("cutoff").toLowerCase()}.`,
        "success",
      );
    }
  }

  if (!customElements.get("sigap-template"))
    customElements.define("sigap-template", SigapTemplate);
</script>
