const brandHtml = `<a href="#top" class="${brand}"><span class="${brandMark}" aria-hidden="true">${icon("logo", "size-4")}</span>${BRAND}</a>`;

/** Data dan class yang dipakai script di klien. */
const config = JSON.stringify({
  artworks: artworks.map(({ title, artist }) => ({ title, artist })),
  dragThreshold: DRAG_THRESHOLD,
  startIndex: START_INDEX,
  emailPattern: EMAIL_PATTERN.source,
  artists: artists.map(({ id, name, medium, followers }) => ({ id, name, medium, followers })),
  plans: plans.map(({ monthly, yearly }) => ({ monthly, yearly })),
  icons: { menu: icons.menu, close: icons.close },
  classes: { fanHidden, chipActive, chipIdle, followIdle, billingActive, billingIdle },
});
---

<galeri-template class="contents" data-config={config}>
  <div class={cx(root, palette)}>
    <style is:inline set:html={keyframes}></style>
    <header class={header} data-galeri-header>
      <div class={cx(headerInner, "relative")}>
        <Fragment set:html={brandHtml} />
        <nav aria-label="Main" class={navList}>
          {navItems.map((item) => <a href={item.href} class={navLink}>{item.label}</a>)}
        </nav>
        <div class={iconRow}>
          <a href="/login" class={iconButton} aria-label="Sign in" set:html={icon("user")} />
          <button type="button" class={iconButton} aria-label="Open menu" aria-expanded="false" aria-controls={MENU_ID} data-galeri-menu-toggle set:html={icon("menu")} />
        </div>
        <nav id={MENU_ID} aria-label="Menu" class={menuPanel} hidden data-galeri-menu>
          {navItems.map((item) => <a href={item.href} class={menuLink}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="top">
      <section aria-labelledby="galeri-title" class={hero}>
        <p class={eyebrow}><span class={eyebrowDot} aria-hidden="true"></span>1,240 new works from Indonesian artists this month</p>
        <h1 id="galeri-title" class={heroTitle}>A place to display your masterpiece.</h1>
        <p class={heroLead}>Sanggar is a marketplace where painters, illustrators, and printmakers show their work, find collectors, and get paid in Rupiah.</p>
        <div class={heroActions}>
          <a href="#pricing" class={cx(pillBase, pillPrimary)}>Join for Rp149k/mo</a>
          <a href="#how" class={cx(pillBase, pillGhost)}>Read more</a>
        </div>

        <div class={cx(stage, focusRing)} role="region" aria-roledescription="carousel" aria-label="Featured artworks" tabindex="0" data-galeri-stage>
          <ul class={fanList}>
            {artworks.map((work, index) => {
              const offset = index - START_INDEX;
              return (
                <li class={cx(fanCard, Math.abs(offset) > 4 && fanHidden)} style={`--off: ${offset}; --lift: ${offset === 0 ? "-24px" : "0px"}; z-index: ${10 - Math.abs(offset)}`} aria-hidden={offset === 0 ? undefined : "true"} aria-roledescription="slide" aria-label={`${index + 1} of ${artworks.length}`} data-active={offset === 0 ? "" : undefined} data-galeri-card={index}>
                  <div class={cx(fanArt, paintings[work.art])} aria-hidden="true"></div>
                  <div class={fanCaption}>
                    <div class="min-w-0">
                      <p class={fanTitle}>{work.title}</p>
                      <p class={fanArtist}>{work.artist}</p>
                    </div>
                    <p class={fanPrice}>{work.price}</p>
                  </div>
                </li>
              );
            })}
          </ul>
          <div class={cursorA} aria-hidden="true">
            <svg class="size-5 fill-(--tpl-tag-a)" viewBox="0 0 20 20"><path d={cursorPath} /></svg>
            <span class={cx(cursorTag, "bg-(--tpl-tag-a)")}>@coplin</span>
          </div>
          <div class={cursorB} aria-hidden="true">
            <svg class="size-5 fill-(--tpl-tag-b)" viewBox="0 0 20 20"><path d={cursorPath} /></svg>
            <span class={cx(cursorTag, "bg-(--tpl-tag-b)")}>@ercobs</span>
          </div>
        </div>
        <div class={controls}>
          <button type="button" class={roundButton} aria-label="Previous artwork" data-galeri-step="-1" set:html={icon("left")} />
          <p class={nowShowing} aria-live="polite" data-now="">
            <span class="block truncate text-sm font-medium" data-galeri-now-title>{artworks[START_INDEX]!.title}</span>
            <span class="block truncate text-xs text-muted" data-galeri-now-meta>{`${artworks[START_INDEX]!.artist}, ${START_INDEX + 1} of ${artworks.length}`}</span>
          </p>
          <button type="button" class={roundButton} aria-label="Next artwork" data-galeri-step="1" set:html={icon("right")} />
        </div>
      </section>

      <section id="categories" aria-labelledby="galeri-categories" class={section}>
        <div class={cx(sectionHead, reveal)} data-reveal="">
          <h2 id="galeri-categories" class={sectionTitle}>Every medium has a room</h2>
          <p class={sectionLead}>Collectors browse by the way a work was made. List yours where the right people already look.</p>
        </div>
        <ul class={cx(categoryGrid, reveal)} data-reveal="">
          {categories.map((category) => (
            <li class={categoryTile}>
              <div class={cx(categoryArt, paintings[category.art])} aria-hidden="true"></div>
              <div>
                <p class={categoryName}>{category.name}</p>
                <p class={categoryCount}>{category.count}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="artists" aria-labelledby="galeri-artists" class={cx(section, "pt-0 lg:pt-0")}>
        <div class={cx(sectionHead, reveal)} data-reveal="">
          <h2 id="galeri-artists" class={sectionTitle}>Featured artists this week</h2>
          <p class={sectionLead}>Hand picked by our curators from studios across the archipelago.</p>
        </div>
        <div class={chips} role="group" aria-label="Filter by medium">
          {filters.map((item) => (
            <button type="button" class={cx(chip, item === "All" ? chipActive : chipIdle)} aria-pressed={item === "All" ? "true" : "false"} data-galeri-filter={item}>{item}</button>
          ))}
        </div>
        <ul class={artistGrid} data-galeri-artists>
          {artists.map((artist) => (
            <li class={artistCard} data-artist="" data-id={artist.id}>
              <div class={artistHead}>
                <span class={cx(avatar, tones[artist.tone])} aria-hidden="true">{artist.initials}</span>
                <div class="min-w-0">
                  <h3 class={artistName}>{artist.name}</h3>
                  <p class={artistMeta}>{`${artist.medium}, ${artist.city}`}</p>
                </div>
              </div>
              <div class={thumbs} aria-hidden="true">
                {artist.art.map((art) => <div class={cx(thumb, paintings[art])}></div>)}
              </div>
              <div class={artistFoot}>
                <p class={statText} data-galeri-stat>{`${formatCount(artist.followers)} followers, ${artist.works} works`}</p>
                <button type="button" class={cx(chip, "h-8 px-3", followIdle)} aria-pressed="false" aria-label={`Follow ${artist.name}`} data-galeri-follow={artist.id}>Follow</button>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="how" aria-labelledby="galeri-how" class={section}>
        <div class={cx(sectionHead, reveal)} data-reveal="">
          <h2 id="galeri-how" class={sectionTitle}>From studio to collector in three steps</h2>
          <p class={sectionLead}>No website to build and no gallery contract to sign.</p>
        </div>
        <ol class={stepGrid}>
          {steps.map((step, index) => (
            <li class={cx(stepCard, reveal)} data-reveal="">
              <span class={stepNumber} aria-hidden="true">{`0${index + 1}`}</span>
              <h3 class={stepTitle}>{step.title}</h3>
              <p class={stepText}>{step.text}</p>
              <div class={cx(stepArt, paintings[step.art])} aria-hidden="true"></div>
            </li>
          ))}
        </ol>
      </section>

      <section id="pricing" aria-labelledby="galeri-pricing" class={cx(section, "pt-0 lg:pt-0")}>
        <div class={cx(sectionHead, reveal)} data-reveal="">
          <h2 id="galeri-pricing" class={sectionTitle}>Simple pricing in Rupiah</h2>
          <p class={sectionLead}>Start free, upgrade when your first collectors arrive.</p>
        </div>
        <div class={billing} role="group" aria-label="Billing period">
          <button type="button" class={cx(billingButton, billingActive)} aria-pressed="true" data-galeri-billing="monthly">Monthly</button>
          <button type="button" class={cx(billingButton, billingIdle)} aria-pressed="false" data-galeri-billing="yearly">Yearly<span class={saveTag}>-20%</span></button>
        </div>
        <ul class={planGrid}>
          {plans.map((plan) => (
            <li class={cx(planCard, plan.featured && planFeatured)}>
              <div class={planTop}>
                <h3 class={planName}>{plan.name}</h3>
                {plan.featured && <span class={popular}>Popular</span>}
              </div>
              <p class={statText}>{plan.blurb}</p>
              <p class={priceRow}>
                <span class={priceValue} data-price="">{rupiah(plan.monthly)}</span>
                <span class={priceUnit} data-galeri-unit>/mo</span>
              </p>
              <Button variant={plan.featured ? "primary" : "secondary"} data-galeri-plan={plan.name}>{plan.cta}</Button>
              <ul class={featureList}>
                {plan.features.map((feature) => (
                  <li class={featureItem}><Fragment set:html={icon("check", check)} />{feature}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <section id="faq" aria-labelledby="galeri-faq" class={cx(section, "pt-0 lg:pt-0")}>
        <div class={cx(sectionHead, reveal)} data-reveal="">
          <h2 id="galeri-faq" class={sectionTitle}>Questions artists ask us</h2>
        </div>
        <div class={faqWrap}>
          <Accordion items={faqs} defaultValue="fee" />
        </div>
      </section>

      <section id="contact" aria-labelledby="galeri-contact" class={cx(section, "pt-0 lg:pt-0")}>
        <div class={cx(contactCard, reveal)} data-reveal="">
          <div class={cx(contactArt, paintings[0])} aria-hidden="true"></div>
          <div>
            <h2 id="galeri-contact" class={sectionTitle}>Get the weekly drop</h2>
            <p class={cx(sectionLead, "mb-6")}>Twelve new works, one artist interview, and open calls for exhibitions. Every Monday, no spam.</p>
            <form novalidate data-galeri-subscribe>
              <div class={contactForm}>
                <div class={grow}>
                  <Input label="Email address" type="email" name="email" placeholder="you@studio.id" />
                </div>
                <Button type="submit">Subscribe</Button>
              </div>
              <p id="galeri-email-error" class={errorText} hidden></p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class={footer}>
      <div class={footerInner}>
        <div class={footerBrand}>
          <Fragment set:html={brandHtml} />
          <p class={cx(statText, "max-w-xs")}>A marketplace for Indonesian art, from Yogyakarta studios to your living room wall.</p>
        </div>
        {footerGroups.map((group) => (
          <nav aria-label={group.title}>
            <p class={footerTitle}>{group.title}</p>
            <ul class={footerLinks}>
              {group.links.map((link) => (
                <li><a href={link.href} class={footerLink}>{link.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <div class={footerBottom}>
        <p>&copy; 2026 Sanggar Studio. Prices include VAT.</p>
        <p>Built with MarkasUI</p>
      </div>
    </footer>
    <Toaster />
  </div>
</galeri-template>

<script>
  type Config = {
    artworks: { title: string; artist: string }[];
    dragThreshold: number;
    startIndex: number;
    emailPattern: string;
    artists: { id: string; name: string; medium: string; followers: number }[];
    plans: { monthly: number; yearly: number }[];
    icons: { menu: string; close: string };
    classes: Record<
      | "fanHidden"
      | "chipActive"
      | "chipIdle"
      | "followIdle"
      | "billingActive"
      | "billingIdle",
      string
    >;
  };

  const toast = (title: string, description: string, variant = "success") =>
    window.dispatchEvent(
      new CustomEvent("markas-toast", { detail: { title, description, variant } }),
    );
  const swap = (element: Element, add: string, remove: string) => {
    element.classList.remove(...remove.split(" "));
    element.classList.add(...add.split(" "));
  };
  const rupiah = (thousands: number) => (thousands ? `Rp${thousands}k` : "Rp0");
  const ERROR = "Enter a valid email address, like you@studio.id.";

  /** Satu elemen per template: menu, carousel kipas, filter, follow, harga, form, dan animasi masuk. */
  class GaleriTemplate extends HTMLElement {
    private readonly config = JSON.parse(this.dataset.config ?? "{}") as Config;
    private active = this.config.startIndex;
    private dragStart: number | null = null;
    private dragged = false;
    private following: string[] = [];
    private yearly = false;
    private cards: HTMLElement[] = [];
    private observer: IntersectionObserver | undefined;
    private readonly onClick = (event: Event) => this.handleClick(event);
    private readonly onKeydown = (event: KeyboardEvent) => this.handleKey(event);
    private readonly onSubmit = (event: Event) => this.subscribe(event);
    private readonly onPointerDown = (event: PointerEvent) => {
      if (!(event.target as Element).closest("[data-galeri-stage]")) return;
      this.dragStart = event.clientX;
      this.dragged = false;
    };
    private readonly onPointerUp = (event: PointerEvent) => {
      if (this.dragStart === null) return;
      const delta = event.clientX - this.dragStart;
      this.dragStart = null;
      if (Math.abs(delta) < this.config.dragThreshold) return;
      this.dragged = true;
      this.go(this.active + (delta < 0 ? 1 : -1));
    };
    private readonly onPointerCancel = () => (this.dragStart = null);

    connectedCallback() {
      this.cards = [
        ...this.querySelectorAll<HTMLElement>("[data-galeri-artists] > li"),
      ];
      this.addEventListener("click", this.onClick);
      this.addEventListener("keydown", this.onKeydown);
      this.addEventListener("submit", this.onSubmit);
      this.addEventListener("pointerdown", this.onPointerDown);
      this.addEventListener("pointerup", this.onPointerUp);
      this.addEventListener("pointercancel", this.onPointerCancel);
      this.observeReveal();
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.onClick);
      this.removeEventListener("keydown", this.onKeydown);
      this.removeEventListener("submit", this.onSubmit);
      this.removeEventListener("pointerdown", this.onPointerDown);
      this.removeEventListener("pointerup", this.onPointerUp);
      this.removeEventListener("pointercancel", this.onPointerCancel);
      this.observer?.disconnect();
    }

    /* Animasi masuk saat scroll: data-in dipasang sekali, CSS motion-safe yang menyembunyikan. */
    private observeReveal() {
      const items = this.querySelectorAll("[data-reveal]");
      if (!("IntersectionObserver" in window)) {
        items.forEach((item) => item.setAttribute("data-in", ""));
        return;
      }
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.setAttribute("data-in", "");
            observer.unobserve(entry.target);
          }),
        { rootMargin: "0px 0px -10% 0px" },
      );
      items.forEach((item) => observer.observe(item));
      this.observer = observer;
    }

    private handleClick(event: Event) {
      const target = event.target as Element;
      const closest = (selector: string) => target.closest<HTMLElement>(selector);
      if (closest("[data-galeri-menu-toggle]")) return this.setMenu(!this.menuOpen());
      if (closest("[data-galeri-menu] a")) return this.setMenu(false);
      const step = closest("[data-galeri-step]");
      if (step) return this.go(this.active + Number(step.dataset.galeriStep));
      const card = closest("[data-galeri-card]");
      if (card) {
        if (!this.dragged) this.go(Number(card.dataset.galeriCard));
        return;
      }
      const filter = closest("[data-galeri-filter]");
      if (filter) return this.filterArtists(filter);
      const follow = closest("[data-galeri-follow]");
      if (follow) return this.toggleFollow(follow.dataset.galeriFollow!);
      const billing = closest("[data-galeri-billing]");
      if (billing) return this.setBilling(billing.dataset.galeriBilling === "yearly");
      const plan = closest("[data-galeri-plan]");
      if (plan)
        toast(
          `${plan.dataset.galeriPlan} plan selected`,
          `Billed ${this.yearly ? "yearly" : "monthly"}. You can switch any time.`,
        );
    }

    private handleKey(event: KeyboardEvent) {
      const target = event.target as Element;
      if (event.key === "Escape" && target.closest("[data-galeri-header]"))
        return this.setMenu(false);
      if (!target.matches("[data-galeri-stage]")) return;
      if (event.key === "ArrowRight") this.go(this.active + 1);
      else if (event.key === "ArrowLeft") this.go(this.active - 1);
      else return;
      event.preventDefault();
    }

    /* Menu */
    private menuOpen() {
      return !this.querySelector<HTMLElement>("[data-galeri-menu]")!.hidden;
    }

    private setMenu(open: boolean) {
      const toggle = this.querySelector("[data-galeri-menu-toggle]")!;
      this.querySelector<HTMLElement>("[data-galeri-menu]")!.hidden = !open;
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.setAttribute("aria-expanded", String(open));
      toggle
        .querySelector("path")!
        .setAttribute("d", open ? this.config.icons.close : this.config.icons.menu);
    }

    /* Carousel kipas */
    private go(index: number) {
      const { artworks, classes } = this.config;
      this.active = Math.min(artworks.length - 1, Math.max(0, index));
      this.querySelectorAll<HTMLElement>("[data-galeri-card]").forEach((card) => {
        const offset = Number(card.dataset.galeriCard) - this.active;
        card.style.setProperty("--off", String(offset));
        card.style.setProperty("--lift", offset === 0 ? "-24px" : "0px");
        card.style.zIndex = String(10 - Math.abs(offset));
        if (Math.abs(offset) > 4) card.classList.add(...classes.fanHidden.split(" "));
        else card.classList.remove(...classes.fanHidden.split(" "));
        if (offset === 0) {
          card.removeAttribute("aria-hidden");
          card.dataset.active = "";
        } else {
          card.setAttribute("aria-hidden", "true");
          delete card.dataset.active;
        }
      });
      const work = artworks[this.active]!;
      this.querySelector("[data-galeri-now-title]")!.textContent = work.title;
      this.querySelector("[data-galeri-now-meta]")!.textContent =
        `${work.artist}, ${this.active + 1} of ${artworks.length}`;
      this.querySelectorAll<HTMLButtonElement>("[data-galeri-step]").forEach(
        (button) => {
          button.disabled =
            button.dataset.galeriStep === "-1"
              ? this.active === 0
              : this.active === artworks.length - 1;
        },
      );
    }

    /* Seniman: kartu yang tidak cocok dilepas dari DOM, seperti React. */
    private filterArtists(button: HTMLElement) {
      const value = button.dataset.galeriFilter!;
      const { chipActive, chipIdle } = this.config.classes;
      this.querySelectorAll<HTMLElement>("[data-galeri-filter]").forEach((item) => {
        const on = item === button;
        item.setAttribute("aria-pressed", String(on));
        swap(item, on ? chipActive : chipIdle, on ? chipIdle : chipActive);
      });
      const mediumOf = (card: HTMLElement) =>
        this.config.artists.find((artist) => artist.id === card.dataset.id)!.medium;
      this.querySelector("[data-galeri-artists]")!.replaceChildren(
        ...this.cards.filter(
          (card) => value === "All" || mediumOf(card) === value,
        ),
      );
    }

    private toggleFollow(id: string) {
      const artist = this.config.artists.find((item) => item.id === id)!;
      const card = this.cards.find((item) => item.dataset.id === id)!;
      const button = card.querySelector("[data-galeri-follow]")!;
      const isFollowing = this.following.includes(id);
      this.following = isFollowing
        ? this.following.filter((entry) => entry !== id)
        : [...this.following, id];
      const now = !isFollowing;
      const { chipActive, followIdle } = this.config.classes;
      button.setAttribute("aria-pressed", String(now));
      button.textContent = now ? "Following" : "Follow";
      swap(button, now ? chipActive : followIdle, now ? followIdle : chipActive);
      const stat = card.querySelector("[data-galeri-stat]")!;
      stat.textContent = (stat.textContent ?? "").replace(
        /^[\d,]+/,
        (artist.followers + (now ? 1 : 0)).toLocaleString("en-US"),
      );
      if (now)
        toast(
          `You follow ${artist.name}`,
          "New works will show up in your weekly drop.",
        );
    }

    /* Harga */
    private setBilling(yearly: boolean) {
      this.yearly = yearly;
      const { billingActive, billingIdle } = this.config.classes;
      this.querySelectorAll<HTMLElement>("[data-galeri-billing]").forEach(
        (button) => {
          const on = (button.dataset.galeriBilling === "yearly") === yearly;
          button.setAttribute("aria-pressed", String(on));
          swap(button, on ? billingActive : billingIdle, on ? billingIdle : billingActive);
        },
      );
      this.querySelectorAll("[data-price]").forEach((price, index) => {
        const plan = this.config.plans[index]!;
        price.textContent = rupiah(yearly ? plan.yearly : plan.monthly);
      });
      this.querySelectorAll("[data-galeri-unit]").forEach(
        (unit) => (unit.textContent = yearly ? "/mo, billed yearly" : "/mo"),
      );
    }

    /* Form email */
    private subscribe(event: Event) {
      const form = event.target as HTMLFormElement;
      if (!form.matches("[data-galeri-subscribe]")) return;
      event.preventDefault();
      const field = form.querySelector("input")!;
      const error = form.querySelector<HTMLElement>("#galeri-email-error")!;
      const value = field.value.trim();
      const valid = new RegExp(this.config.emailPattern).test(value);
      error.hidden = valid;
      error.textContent = valid ? "" : ERROR;
      if (!valid) {
        field.setAttribute("aria-invalid", "true");
        field.setAttribute("aria-describedby", error.id);
        return;
      }
      field.removeAttribute("aria-invalid");
      field.removeAttribute("aria-describedby");
      field.value = "";
      toast("You are on the list", `The weekly drop will reach ${value} every Monday.`);
    }
  }

  if (!customElements.get("galeri-template"))
    customElements.define("galeri-template", GaleriTemplate);
</script>
