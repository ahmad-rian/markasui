---
import type { HTMLAttributes } from "astro/types";

const dialogClass =
  "fixed inset-y-0 m-0 h-dvh max-h-dvh w-full max-w-sm border-line bg-surface p-0 text-ink shadow-overlay transition-transform duration-200 ease-out backdrop:bg-ink/40 motion-reduce:transition-none";
const sides = {
  right: "right-0 left-auto border-l starting:open:translate-x-full",
  left: "right-auto left-0 border-r starting:open:-translate-x-full",
};
const panel = "flex h-full flex-col gap-4 p-6";
const header = "flex items-start justify-between gap-4";
const titleClass = "text-lg font-semibold text-ink";
const body = "flex-1 overflow-y-auto text-sm text-muted";
const footerClass = "flex flex-wrap justify-end gap-2";
const close =
  "inline-flex size-8 shrink-0 items-center justify-center rounded-md text-muted transition-colors duration-150 ease-out hover:bg-subtle hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none";

type Props = Omit<HTMLAttributes<"dialog">, "title" | "open"> & {
  title: string;
  side?: keyof typeof sides;
  /** Accessible label of the close button. */
  closeLabel?: string;
};

const {
  title,
  side = "right",
  closeLabel = "Close",
  id,
  class: className,
  ...rest
} = Astro.props;
const dialogId = id ?? `markas-drawer-${crypto.randomUUID().slice(0, 8)}`;
---

<div class="contents">
  {
    Astro.slots.has("trigger") && (
      <div class="contents" data-markas-drawer-trigger={dialogId}>
        <slot name="trigger" />
      </div>
    )
  }
  <dialog
    id={dialogId}
    aria-labelledby={`${dialogId}-title`}
    data-state="closed"
    data-markas-drawer
    class:list={[dialogClass, sides[side], className]}
    {...rest}
  >
    <div class={panel}>
      <div class={header}>
        <h2 id={`${dialogId}-title`} class={titleClass}>{title}</h2>
        <form method="dialog">
          <button type="submit" class={close} aria-label={closeLabel}>
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </form>
      </div>
      <div class={body}><slot /></div>
      {
        Astro.slots.has("footer") && (
          <form method="dialog" class={footerClass}>
            <slot name="footer" />
          </form>
        )
      }
    </div>
  </dialog>
</div>

<script>
  // One listener per page serves every drawer, including markup added later and pages
  // reached through view transitions.
  const isDrawer = (node: EventTarget | null): node is HTMLDialogElement =>
    node instanceof HTMLDialogElement && node.hasAttribute("data-markas-drawer");

  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const trigger = target.closest<HTMLElement>("[data-markas-drawer-trigger]");
    if (trigger) {
      const dialog = document.getElementById(
        trigger.dataset.markasDrawerTrigger ?? "",
      );
      if (isDrawer(dialog)) {
        dialog.showModal();
        dialog.dataset.state = "open";
      }
      return;
    }
    // A click on the dialog itself (not its content) is a click on the backdrop.
    if (isDrawer(target)) target.close();
  });

  // The close event does not bubble, so listen in the capture phase.
  document.addEventListener(
    "close",
    (event) => {
      if (isDrawer(event.target)) event.target.dataset.state = "closed";
    },
    true,
  );
</script>
