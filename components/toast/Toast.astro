---
import type { HTMLAttributes } from "astro/types";

const region =
  "pointer-events-none fixed right-4 bottom-4 z-50 flex w-[calc(100%-2rem)] max-w-sm flex-col gap-2";
const card =
  "pointer-events-auto flex items-start gap-3 rounded-lg border bg-surface p-4 text-sm text-ink shadow-overlay transition-[opacity,translate] duration-200 ease-out starting:translate-y-2 starting:opacity-0 motion-reduce:transition-none";
const variants = {
  default: "border-line",
  success: "border-success/40",
  danger: "border-danger/40",
};
const iconBase = "mt-0.5 size-4 shrink-0";
const iconVariants = {
  default: "",
  success: "text-success",
  danger: "text-danger",
};
const icons = {
  default: "",
  success: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM8.5 12l2.5 2.5 4.5-5",
  danger: "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM15 9l-6 6M9 9l6 6",
};
const content = "grid flex-1 gap-1";
const titleClass = "font-semibold";
const descriptionClass = "text-muted";
const close =
  "-mt-1 -mr-1 inline-flex size-6 shrink-0 items-center justify-center rounded-md text-muted transition-colors duration-150 ease-out hover:bg-subtle hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none";

export type ToastOptions = {
  title: string;
  description?: string;
  variant?: keyof typeof variants;
  /** Milliseconds before the toast dismisses itself. 0 keeps it open. */
  duration?: number;
};

type Props = HTMLAttributes<"div"> & {
  /** Toasts shown right away, for example from a session flash. */
  initial?: ToastOptions[];
  /** Accessible label of the close button on each toast. */
  closeLabel?: string;
  /** Accessible label of the live region. */
  regionLabel?: string;
};

const {
  initial = [],
  closeLabel = "Close",
  regionLabel = "Notifications",
  class: className,
  ...rest
} = Astro.props;
const config = JSON.stringify({ variants, iconVariants, icons, initial });
---

<markas-toaster class="contents" data-config={config}>
  <div
    role="status"
    aria-live="polite"
    aria-label={regionLabel}
    class:list={[region, className]}
    {...rest}></div>
  <template>
    <div data-state="open" class={card}>
      <svg
        class={iconBase}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path></path>
      </svg>
      <div class={content}>
        <p class={titleClass}></p>
        <p class={descriptionClass}></p>
      </div>
      <button type="button" class={close} aria-label={closeLabel}>
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </template>
</markas-toaster>

<script>
  type Variant = "default" | "success" | "danger";
  type Detail = {
    title?: unknown;
    description?: unknown;
    variant?: unknown;
    duration?: unknown;
  };
  type Config = {
    variants: Record<Variant, string>;
    iconVariants: Record<Variant, string>;
    icons: Record<Variant, string>;
    initial: Detail[];
  };
  type Timer = {
    handle?: ReturnType<typeof setTimeout>;
    remaining: number;
    startedAt: number;
  };

  const DEFAULT_DURATION = 5000;

  /**
   * Listens for the markas-toast event on window, like the Blade version. One custom element
   * per Toaster, so markup added later and view transitions keep working.
   */
  class MarkasToaster extends HTMLElement {
    private timers = new Map<HTMLElement, Timer>();
    private readonly onToast = (event: Event) =>
      this.add((event as CustomEvent<Detail | null>).detail ?? {});

    connectedCallback() {
      const config = this.config();
      window.addEventListener("markas-toast", this.onToast);
      config.initial.forEach((detail) => this.add(detail));
    }

    disconnectedCallback() {
      window.removeEventListener("markas-toast", this.onToast);
      this.timers.forEach((timer) => clearTimeout(timer.handle));
      this.timers.clear();
    }

    private config(): Config {
      return JSON.parse(this.dataset.config ?? "{}") as Config;
    }

    private add(detail: Detail) {
      const config = this.config();
      const region = this.querySelector<HTMLElement>("[role=status]");
      const template = this.querySelector("template");
      if (!region || !template) return;
      const variant: Variant =
        typeof detail.variant === "string" && detail.variant in config.variants
          ? (detail.variant as Variant)
          : "default";
      const duration =
        typeof detail.duration === "number" && Number.isFinite(detail.duration)
          ? detail.duration
          : DEFAULT_DURATION;
      const item = (
        template.content.firstElementChild as HTMLElement
      ).cloneNode(true) as HTMLElement;
      item.classList.add(config.variants[variant]);

      const icon = item.querySelector("svg")!;
      if (config.icons[variant]) {
        icon.classList.add(config.iconVariants[variant]);
        icon.querySelector("path")!.setAttribute("d", config.icons[variant]);
      } else icon.remove();

      const [title, description] = item.querySelectorAll("p");
      title.textContent = String(detail.title ?? "");
      if (detail.description) description.textContent = String(detail.description);
      else description.remove();

      item
        .querySelector("button")!
        .addEventListener("click", () => this.dismiss(item));
      item.addEventListener("mouseenter", () => this.pause(item));
      item.addEventListener("mouseleave", () => {
        if (!item.contains(document.activeElement)) this.resume(item);
      });
      item.addEventListener("focusin", () => this.pause(item));
      item.addEventListener("focusout", (event) => {
        if (item.contains(event.relatedTarget as Node | null)) return;
        if (item.matches(":hover")) return;
        this.resume(item);
      });

      region.append(item);
      if (duration > 0) this.start(item, duration);
    }

    private start(item: HTMLElement, ms: number) {
      this.timers.set(item, {
        handle: setTimeout(() => this.dismiss(item), ms),
        remaining: ms,
        startedAt: Date.now(),
      });
    }

    private dismiss(item: HTMLElement) {
      clearTimeout(this.timers.get(item)?.handle);
      this.timers.delete(item);
      item.remove();
    }

    private pause(item: HTMLElement) {
      const timer = this.timers.get(item);
      if (!timer?.handle) return;
      clearTimeout(timer.handle);
      this.timers.set(item, {
        remaining: timer.remaining - (Date.now() - timer.startedAt),
        startedAt: 0,
      });
    }

    private resume(item: HTMLElement) {
      const timer = this.timers.get(item);
      if (!timer || timer.handle) return;
      this.start(item, Math.max(timer.remaining, 0));
    }
  }

  if (!customElements.get("markas-toaster"))
    customElements.define("markas-toaster", MarkasToaster);
</script>
