---
import type { HTMLAttributes } from "astro/types";

const dialogClass =
  "m-auto w-full max-w-md rounded-xl border border-line bg-surface p-0 text-ink shadow-overlay backdrop:bg-ink/40";
const panel = "grid gap-4 p-6";
const titleClass = "text-lg font-semibold text-ink";
const body = "text-sm text-muted";
const footerClass = "flex flex-wrap justify-end gap-2";
const button =
  "inline-flex h-10 items-center justify-center gap-2 rounded-lg px-4 text-sm font-medium whitespace-nowrap transition-colors duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none";
const cancelClass = "border border-line bg-surface text-ink hover:bg-subtle";
const actionTones = {
  default: "bg-primary text-on-primary hover:bg-primary-strong",
  danger: "bg-danger text-on-primary hover:bg-danger/90",
};

type Props = Omit<HTMLAttributes<"dialog">, "title" | "open"> & {
  title: string;
  /** Color of the action button. Use danger for destructive or irreversible actions. */
  variant?: keyof typeof actionTones;
  cancelLabel?: string;
  actionLabel?: string;
};

const {
  title,
  variant = "default",
  cancelLabel = "Cancel",
  actionLabel = "Continue",
  id,
  class: className,
  ...rest
} = Astro.props;
const dialogId = id ?? `markas-alert-dialog-${crypto.randomUUID().slice(0, 8)}`;
---

<div class="contents">
  {
    Astro.slots.has("trigger") && (
      <div class="contents" data-markas-alert-dialog-trigger={dialogId}>
        <slot name="trigger" />
      </div>
    )
  }
  <dialog
    id={dialogId}
    role="alertdialog"
    aria-labelledby={`${dialogId}-title`}
    aria-describedby={`${dialogId}-description`}
    data-state="closed"
    data-markas-alert-dialog
    class:list={[dialogClass, className]}
    {...rest}
  >
    <div class={panel}>
      <h2 id={`${dialogId}-title`} class={titleClass}>{title}</h2>
      <div id={`${dialogId}-description`} class={body}><slot /></div>
      <form method="dialog" class={footerClass}>
        <button
          type="submit"
          value="cancel"
          data-markas-alert-dialog-cancel
          class:list={[button, cancelClass]}
        >
          {cancelLabel}
        </button>
        <button
          type="submit"
          value="action"
          class:list={[button, actionTones[variant] ?? actionTones.default]}
        >
          {actionLabel}
        </button>
      </form>
    </div>
  </dialog>
</div>

<script>
  // One listener per page serves every alert dialog, including markup added later and pages
  // reached through view transitions. A backdrop click does nothing on purpose.
  const isAlertDialog = (node: EventTarget | null): node is HTMLDialogElement =>
    node instanceof HTMLDialogElement &&
    node.hasAttribute("data-markas-alert-dialog");

  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element).closest<HTMLElement>(
      "[data-markas-alert-dialog-trigger]",
    );
    if (!trigger) return;
    const dialog = document.getElementById(
      trigger.dataset.markasAlertDialogTrigger ?? "",
    );
    if (!isAlertDialog(dialog)) return;
    dialog.returnValue = "";
    dialog.showModal();
    dialog.dataset.state = "open";
    dialog
      .querySelector<HTMLButtonElement>("[data-markas-alert-dialog-cancel]")
      ?.focus();
  });

  // Anything but the action button (cancel button, Escape, close() from code) counts as cancel.
  // The close event does not bubble, so listen in the capture phase.
  document.addEventListener(
    "close",
    (event) => {
      const dialog = event.target;
      if (!isAlertDialog(dialog)) return;
      dialog.dataset.state = "closed";
      const isAction = dialog.returnValue === "action";
      if (!isAction) dialog.returnValue = "cancel";
      dialog.dispatchEvent(
        new CustomEvent(isAction ? "markas-action" : "markas-cancel", {
          bubbles: true,
        }),
      );
    },
    true,
  );
</script>
