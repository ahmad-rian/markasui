---
import type { HTMLAttributes } from "astro/types";

const base =
  "inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full align-middle";
const image = "object-cover";
const fallback = "bg-primary-soft font-medium text-primary select-none";
const sizes = {
  sm: "size-8 text-xs",
  md: "size-10 text-sm",
  lg: "size-12 text-base",
};

type Props = Omit<HTMLAttributes<"img">, "src" | "alt"> & {
  name: string;
  src?: string | null;
  alt?: string;
  size?: keyof typeof sizes;
};

const { name, src, alt, size = "md", class: className, ...rest } = Astro.props;

// First letter of the first and last word, same as getInitials() in the other versions.
const words = name.trim().split(/\s+/).filter(Boolean);
const picked = words.length > 1 ? [words[0], words[words.length - 1]] : words;
const initials = picked
  .map((word) => Array.from(word ?? "")[0] ?? "")
  .join("")
  .toUpperCase();
const label = alt ?? name;
---

{
  src && (
    <img
      src={src}
      alt={label}
      data-markas-avatar
      class:list={[base, image, sizes[size], className]}
      {...rest}
    />
  )
}
<span
  role={label ? "img" : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
  hidden={Boolean(src)}
  class:list={[base, fallback, sizes[size], className]}>{initials}</span
>

<script>
  // The fallback right after a broken image takes its place. One listener per page serves
  // every avatar; error does not bubble, so it is caught in the capture phase.
  const isAvatar = (node: EventTarget | null): node is HTMLImageElement =>
    node instanceof HTMLImageElement && node.hasAttribute("data-markas-avatar");

  const showFallback = (img: HTMLImageElement) => {
    img.hidden = true;
    const fallback = img.nextElementSibling;
    if (fallback instanceof HTMLElement) fallback.hidden = false;
  };

  document.addEventListener(
    "error",
    (event) => {
      if (isAvatar(event.target)) showFallback(event.target);
    },
    true,
  );

  // Images that already failed before this script ran.
  document
    .querySelectorAll<HTMLImageElement>("img[data-markas-avatar]")
    .forEach((img) => {
      if (img.complete && img.naturalWidth === 0) showFallback(img);
    });
</script>
