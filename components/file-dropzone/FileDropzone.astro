---
import type { HTMLAttributes } from "astro/types";

const root = "grid gap-3";
const zone =
  "group/zone grid cursor-pointer justify-items-center gap-2 rounded-xl border-2 border-dashed border-line bg-surface px-6 py-8 text-center transition duration-200 ease-out hover:border-primary-line hover:bg-subtle has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary has-[:disabled]:opacity-50 data-[state=over]:border-primary data-[state=over]:bg-primary-soft data-[state=over]:ring-4 data-[state=over]:ring-primary/10 motion-reduce:transition-none";
const badge =
  "size-11 rounded-full bg-subtle p-3 text-ink transition duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-data-[state=over]/zone:-translate-y-1.5 group-data-[state=over]/zone:scale-110 group-data-[state=over]/zone:bg-surface motion-reduce:transition-none";
const titleClass = "text-sm text-ink";
const browseClass = "font-medium underline underline-offset-4";
const hintClass = "text-xs text-muted";
const srOnly = "sr-only";
const list = "grid gap-2";
const item =
  "group/item flex items-center gap-3 rounded-lg border border-line bg-surface p-3 data-[state=error]:border-danger/40 data-[state=error]:bg-danger/5";
const fileIcon =
  "size-9 shrink-0 rounded-md bg-subtle p-2 text-ink group-data-[state=error]/item:bg-danger/10 group-data-[state=error]/item:text-danger";
const body = "grid min-w-0 flex-1 gap-1.5";
const row = "flex items-baseline justify-between gap-3 text-sm";
const nameClass = "truncate font-medium text-ink";
const sizeClass = "shrink-0 text-xs text-muted tabular-nums";
const errorClass = "text-xs text-danger";
const track = "h-1.5 overflow-hidden rounded-full bg-subtle";
const bar =
  "h-full rounded-full transition-[width] duration-300 ease-out motion-reduce:transition-none";
const bars = { busy: "bg-primary", done: "bg-success" };
const remove =
  "size-8 shrink-0 rounded-md p-2 text-muted transition-colors duration-150 ease-out hover:bg-subtle hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none";
const smallIcon = "size-4";

/** 24px stroked icons: the drop prompt, remove, and one per file kind. */
const UPLOAD = "M12 16V4M7 9l5-5 5 5M4 16v4h16v-4";
const REMOVE = "M6 6l12 12M18 6 6 18";
const FILE = "M14 3H5v18h14V8zM14 3v5h5M9 13h6M9 17h4";
const KINDS: Record<string, string> = {
  image: "M4 4h16v16H4zM4 16l5-5 4 4 3-3 4 4M15 8h.01",
  video: "M3 6h13v12H3zM16 10l5-3v10l-5-3",
  audio:
    "M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z",
};

export type DropzoneFile = {
  name: string;
  /** Size in bytes. */
  size: number;
  type?: string;
  /** Upload progress 0 to 100. Leave out to hide the bar. */
  progress?: number;
  error?: string;
};

const fill = (template: string, value: string | number) =>
  template.replace(/\{\w+\}/, () => String(value));

/** 1536 -> "2 KB", 2400000 -> "2.3 MB". */
function formatSize(bytes: number) {
  let value = bytes;
  let unit = 0;
  while (value >= 1024 && unit < 3) {
    value /= 1024;
    unit++;
  }
  return `${unit < 2 ? Math.round(value) : Number(value.toFixed(1))} ${["B", "KB", "MB", "GB"][unit]}`;
}

/** Same rules as the accept attribute: .ext, type/*, or an exact MIME type. */
function accepts(file: { name: string; type?: string }, accept = "") {
  const type = (file.type ?? "").toLowerCase();
  return (
    !accept ||
    accept.split(",").some((raw) => {
      const rule = raw.trim().toLowerCase();
      if (rule.startsWith(".")) return file.name.toLowerCase().endsWith(rule);
      if (rule.endsWith("/*")) return type.startsWith(rule.slice(0, -1));
      return type === rule;
    })
  );
}

const iconOf = ({ type = "" }: DropzoneFile) =>
  KINDS[type.split("/")[0]!] ?? FILE;

type Props = HTMLAttributes<"div"> & {
  name?: string;
  accept?: string;
  multiple?: boolean;
  /** Largest file in bytes. */
  maxSize?: number;
  /** Most files kept when multiple is on. */
  maxFiles?: number;
  disabled?: boolean;
  required?: boolean;
  /** Files already in the list, such as earlier uploads. They are shown, not submitted. */
  files?: DropzoneFile[];
  hint?: string;
  dropLabel?: string;
  browseLabel?: string;
  removeLabel?: string;
  tooLargeLabel?: string;
  typeLabel?: string;
  tooManyLabel?: string;
};

const {
  name,
  accept,
  multiple = false,
  maxSize,
  maxFiles,
  disabled,
  required,
  files = [],
  hint,
  dropLabel = "Drop files here or",
  browseLabel = "browse",
  removeLabel = "Remove {name}",
  tooLargeLabel = "Larger than {size}",
  typeLabel = "File type not allowed",
  tooManyLabel = "Only {max} files allowed",
  id,
  class: className,
  ...rest
} = Astro.props;

const inputId = id ?? `markas-file-dropzone-${crypto.randomUUID().slice(0, 8)}`;
const limit = multiple ? (maxFiles ?? Infinity) : 1;
// Messages the browser fills in for picked files, worked out here so the script stays small.
const labels = {
  remove: removeLabel,
  type: typeLabel,
  tooLarge: maxSize === undefined ? "" : fill(tooLargeLabel, formatSize(maxSize)),
  tooMany: fill(tooManyLabel, limit),
};
const svg = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.5",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
} as const;
---

<markas-file-dropzone
  class="contents"
  data-accept={accept}
  data-max-size={maxSize}
  data-limit={limit}
  data-multiple={multiple ? "" : undefined}
  data-disabled={disabled ? "" : undefined}
  data-labels={JSON.stringify(labels)}
  data-kinds={JSON.stringify({ ...KINDS, file: FILE })}
>
  <div {...rest} class:list={[root, className]}>
    <label data-state="idle" class={zone}>
      <input
        id={inputId}
        type="file"
        name={name}
        accept={accept}
        multiple={multiple}
        disabled={disabled}
        required={required}
        class={srOnly}
      />
      <svg class={badge} {...svg}><path d={UPLOAD}></path></svg>
      <span class={titleClass}>{dropLabel} <span class={browseClass}>{browseLabel}</span></span>
      {hint && <span class={hintClass}>{hint}</span>}
    </label>
    <ul class={list} hidden={files.length === 0}>
      {
        files.map((file) => (
          <li data-state={file.error ? "error" : "ok"} class={item}>
            <svg class={fileIcon} {...svg}><path d={iconOf(file)}></path></svg>
            <div class={body}>
              <div class={row}>
                <span class={nameClass}>{file.name}</span>
                <span class={sizeClass}>{formatSize(file.size)}</span>
              </div>
              {file.error ? (
                <p role="alert" class={errorClass}>{file.error}</p>
              ) : file.progress !== undefined ? (
                <div role="progressbar" aria-valuenow={file.progress} aria-label={file.name} class={track}>
                  <div class:list={[bar, bars[file.progress < 100 ? "busy" : "done"]]} style={`width: ${file.progress}%`}></div>
                </div>
              ) : null}
            </div>
            <button type="button" aria-label={fill(removeLabel, file.name)} class={remove} data-remove>
              <svg class={smallIcon} {...svg}><path d={REMOVE}></path></svg>
            </button>
          </li>
        ))
      }
    </ul>
    <template data-item>
      <li data-state="ok" class={item}>
        <svg class={fileIcon} {...svg}><path></path></svg>
        <div class={body}>
          <div class={row}>
            <span class={nameClass}></span>
            <span class={sizeClass}></span>
          </div>
          <p role="alert" class={errorClass}></p>
          <div role="progressbar" class={track}>
            <div class={bar} data-busy={bars.busy} data-done={bars.done}></div>
          </div>
        </div>
        <button type="button" class={remove} data-remove>
          <svg class={smallIcon} {...svg}><path d={REMOVE}></path></svg>
        </button>
      </li>
    </template>
  </div>
</markas-file-dropzone>

<script>
  const fill = (template: string, value: string | number) =>
    template.replace(/\{\w+\}/, () => String(value));

  /** 1536 -> "2 KB", 2400000 -> "2.3 MB". */
  function formatSize(bytes: number) {
    let value = bytes;
    let unit = 0;
    while (value >= 1024 && unit < 3) {
      value /= 1024;
      unit++;
    }
    return `${unit < 2 ? Math.round(value) : Number(value.toFixed(1))} ${["B", "KB", "MB", "GB"][unit]}`;
  }

  /** Same rules as the accept attribute: .ext, type/*, or an exact MIME type. */
  function accepts(file: File, accept = "") {
    const type = file.type.toLowerCase();
    return (
      !accept ||
      accept.split(",").some((raw) => {
        const rule = raw.trim().toLowerCase();
        if (rule.startsWith(".")) return file.name.toLowerCase().endsWith(rule);
        if (rule.endsWith("/*")) return type.startsWith(rule.slice(0, -1));
        return type === rule;
      })
    );
  }

  // Each dropzone keeps its own list, so it is a custom element: it also works for markup
  // added later and for pages reached through view transitions. Picked files are drawn from
  // the template next to the list.
  class MarkasFileDropzone extends HTMLElement {
    private picked = new Map<HTMLElement, File>();
    private ready = false;

    connectedCallback() {
      const zone = this.querySelector("label");
      const input = this.querySelector<HTMLInputElement>("input[type=file]");
      if (this.ready || !zone || !input) return;
      this.ready = true;
      const drag = (event: DragEvent, entering: boolean) => {
        event.preventDefault();
        if (entering) zone.dataset.state = this.disabled ? "idle" : "over";
        else if (!zone.contains(event.relatedTarget as Node | null))
          zone.dataset.state = "idle";
      };
      zone.addEventListener("dragenter", (event) => drag(event, true));
      zone.addEventListener("dragover", (event) => drag(event, true));
      zone.addEventListener("dragleave", (event) => drag(event, false));
      zone.addEventListener("drop", (event) => {
        event.preventDefault();
        zone.dataset.state = "idle";
        if (!this.disabled) this.add(input, [...(event.dataTransfer?.files ?? [])]);
      });
      input.addEventListener("change", () => this.add(input, [...(input.files ?? [])]));
      this.addEventListener("click", (event) => {
        const row = (event.target as Element).closest("[data-remove]")?.closest("li");
        if (!row) return;
        row.remove();
        this.picked.delete(row);
        this.sync(input);
      });
    }

    private get disabled() {
      return this.dataset.disabled !== undefined;
    }

    private add(input: HTMLInputElement, incoming: File[]) {
      const list = this.querySelector("ul");
      const template = this.querySelector<HTMLTemplateElement>("template[data-item]");
      if (!list || !template) return;
      const labels = JSON.parse(this.dataset.labels ?? "{}");
      const kinds = JSON.parse(this.dataset.kinds ?? "{}");
      const maxSize = this.dataset.maxSize ? Number(this.dataset.maxSize) : Infinity;
      const limit = Number(this.dataset.limit);
      if (this.dataset.multiple === undefined) {
        list.replaceChildren();
        this.picked.clear();
      }
      let count = list.querySelectorAll("li[data-state=ok]").length;
      for (const file of incoming) {
        const error = !accepts(file, this.dataset.accept)
          ? labels.type
          : file.size > maxSize
            ? labels.tooLarge
            : count >= limit
              ? labels.tooMany
              : "";
        if (!error) count++;
        const row = (template.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
        row.dataset.state = error ? "error" : "ok";
        row.querySelector("path")?.setAttribute("d", kinds[file.type.split("/")[0] ?? ""] ?? kinds.file);
        const [name, size] = row.querySelectorAll("span");
        if (name) name.textContent = file.name;
        if (size) size.textContent = formatSize(file.size);
        const alert = row.querySelector("[role=alert]");
        if (error && alert) alert.textContent = error;
        else alert?.remove();
        row.querySelector("[role=progressbar]")?.remove();
        row.querySelector("[data-remove]")?.setAttribute("aria-label", fill(labels.remove, file.name));
        list.append(row);
        if (!error) this.picked.set(row, file);
      }
      this.sync(input);
    }

    /** Show upload progress (0 to 100) for a listed file: dropzone.setProgress("a.pdf", 40). */
    setProgress(name: string, percent: number) {
      const template = this.querySelector<HTMLTemplateElement>("template[data-item]");
      const proto = template?.content.querySelector("[role=progressbar]");
      for (const row of this.querySelectorAll<HTMLElement>("ul > li[data-state=ok]")) {
        if (row.querySelector("span")?.textContent !== name) continue;
        let track = row.querySelector("[role=progressbar]");
        if (!track && proto) {
          track = proto.cloneNode(true) as Element;
          track.setAttribute("aria-label", name);
          row.querySelector("span")?.closest("div")?.parentElement?.append(track);
        }
        const fill = track?.firstElementChild as HTMLElement | null | undefined;
        if (!track || !fill) continue;
        track.setAttribute("aria-valuenow", String(percent));
        fill.style.width = `${percent}%`;
        const model = proto?.firstElementChild as HTMLElement | null | undefined;
        const tone = percent < 100 ? model?.dataset.busy : model?.dataset.done;
        fill.className = `${model?.getAttribute("class") ?? ""} ${tone ?? ""}`;
      }
    }

    /** Keep the native input's files equal to the valid picked files, so a form posts them. */
    private sync(input: HTMLInputElement) {
      const list = this.querySelector("ul");
      if (list) list.hidden = list.children.length === 0;
      const transfer = new DataTransfer();
      const files = [...this.picked.values()];
      files.forEach((file) => transfer.items.add(file));
      input.files = transfer.files;
      this.dispatchEvent(new CustomEvent("markas-change", { detail: files, bubbles: true }));
    }
  }

  if (!customElements.get("markas-file-dropzone"))
    customElements.define("markas-file-dropzone", MarkasFileDropzone);
</script>
