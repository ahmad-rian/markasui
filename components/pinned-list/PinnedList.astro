---
import type { HTMLAttributes } from "astro/types";

const root = "grid gap-5";
const group = "grid gap-2";
const heading =
  "flex items-center gap-2 px-1 text-xs font-medium text-muted transition-opacity duration-300 ease-out starting:opacity-0 motion-reduce:transition-none";
const count =
  "rounded-full bg-subtle px-1.5 text-[11px] leading-4 text-muted tabular-nums";
const list = "grid gap-1.5";
const itemClass =
  "relative flex items-center gap-3 rounded-xl border border-line bg-surface px-3 py-2.5 transition-colors duration-300 ease-out data-[pinned=true]:border-primary-line data-[pinned=true]:bg-primary-soft motion-reduce:transition-none";
const iconTile =
  "grid size-9 shrink-0 place-items-center rounded-lg bg-subtle text-ink transition-colors duration-300 ease-out in-data-[pinned=true]:bg-surface motion-reduce:transition-none";
const iconClass = "size-5";
const body = "grid min-w-0 flex-1";
const labelClass = "truncate text-sm font-medium text-ink";
const descriptionClass = "truncate text-xs text-muted";
const metaClass = "shrink-0 text-xs text-muted tabular-nums";
const pinButton =
  "group/pin grid size-8 shrink-0 place-items-center rounded-lg text-muted transition-colors duration-150 ease-out hover:bg-subtle hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:text-ink motion-reduce:transition-none";
const pinIcon =
  "size-4 rotate-45 transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-aria-pressed/pin:rotate-0 group-aria-pressed/pin:fill-current motion-reduce:transition-none";
const srOnly = "sr-only";

const PIN_PATH =
  "M12 17v5M9 10.8a2 2 0 0 1-1.1 1.8l-1.8.9A2 2 0 0 0 5 15.2v.8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.8a2 2 0 0 0-1.1-1.8l-1.8-.9a2 2 0 0 1-1.1-1.8V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z";

export type PinnedListItem = {
  value: string;
  label: string;
  description?: string;
  /** Short text on the right, such as a time or count. */
  meta?: string;
  /** Path data (the d attribute) for a 24x24 stroked icon. */
  icon?: string;
};

type Props = HTMLAttributes<"div"> & {
  items: PinnedListItem[];
  defaultPinned?: string[];
  pinLabel?: string;
  unpinLabel?: string;
  pinnedLabel?: string;
  allLabel?: string;
  pinnedMessage?: string;
  unpinnedMessage?: string;
};

const {
  items,
  defaultPinned = [],
  pinLabel = "Pin {label}",
  unpinLabel = "Unpin {label}",
  pinnedLabel = "Pinned",
  allLabel = "All",
  pinnedMessage = "{label} pinned",
  unpinnedMessage = "{label} unpinned",
  class: className,
  ...rest
} = Astro.props;

const indexed = items.map((item, index) => ({ ...item, index }));
const groups = [
  {
    label: pinnedLabel,
    items: defaultPinned
      .map((value) => indexed.find((item) => item.value === value))
      .filter((item) => item !== undefined),
  },
  {
    label: allLabel,
    items: indexed.filter((item) => !defaultPinned.includes(item.value)),
  },
];
---

<div
  class:list={[root, className]}
  data-markas-pinned-list
  data-pin-label={pinLabel}
  data-unpin-label={unpinLabel}
  data-pinned-message={pinnedMessage}
  data-unpinned-message={unpinnedMessage}
  {...rest}
>
  {
    groups.map((part) => (
      <div hidden={!part.items.length} class={group}>
        <p class={heading}>
          {part.label}<span class={count} data-markas-pinned-count>{part.items.length}</span>
        </p>
        <ul aria-label={part.label} class={list}>
          {part.items.map((item) => {
            const on = defaultPinned.includes(item.value);
            return (
              <li
                data-value={item.value}
                data-pinned={String(on)}
                data-index={item.index}
                data-label={item.label}
                class={itemClass}
              >
                {item.icon && (
                  <span aria-hidden="true" class={iconTile}>
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={item.icon} />
                    </svg>
                  </span>
                )}
                <span class={body}>
                  <span class={labelClass}>{item.label}</span>
                  {item.description && (
                    <span class={descriptionClass}>{item.description}</span>
                  )}
                </span>
                {item.meta && <span class={metaClass}>{item.meta}</span>}
                <button
                  type="button"
                  aria-pressed={on ? "true" : "false"}
                  aria-label={pinLabel.replace("{label}", item.label)}
                  title={(on ? unpinLabel : pinLabel).replace(
                    "{label}",
                    item.label,
                  )}
                  class={pinButton}
                  data-markas-pin
                >
                  <svg
                    class={pinIcon}
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={PIN_PATH} />
                  </svg>
                </button>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
  <p role="status" class={srOnly}></p>
</div>

<script>
  /** Length and curve of the move between groups. */
  const FLIP_DURATION = 350;
  const FLIP_EASING = "cubic-bezier(0.2, 0.8, 0.2, 1)";

  const rows = (host: HTMLElement) =>
    Array.from(host.querySelectorAll<HTMLElement>("[data-value]"));

  /** FLIP: start each row where it was and let it glide to its new place, then refocus the moved pin button. */
  function flip(
    host: HTMLElement,
    before: Map<string | undefined, DOMRect>,
    moved: string,
  ) {
    const still = window.matchMedia?.(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    for (const row of rows(host)) {
      if (row.dataset.value === moved) row.querySelector("button")?.focus();
      const old = before.get(row.dataset.value);
      const now = row.getBoundingClientRect();
      if (still || !old || !row.animate) continue;
      const [x, y] = [old.left - now.left, old.top - now.top];
      if (!x && !y) continue;
      const zIndex = row.dataset.value === moved ? 1 : 0;
      row.animate(
        [
          { transform: `translate(${x}px, ${y}px)`, zIndex },
          { transform: "none", zIndex },
        ],
        { duration: FLIP_DURATION, easing: FLIP_EASING },
      );
    }
  }

  // One listener per page serves every list. Pinning moves the row into the Pinned group; unpinning
  // puts it back in its original place in All. A change event carries the pinned values.
  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>(
      "[data-markas-pin]",
    );
    const host = button?.closest<HTMLElement>("[data-markas-pinned-list]");
    const row = button?.closest<HTMLElement>("li[data-value]");
    const [pinnedList, allList] = host?.querySelectorAll("ul") ?? [];
    if (!button || !host || !row || !pinnedList || !allList) return;
    const value = row.dataset.value ?? "";
    const label = row.dataset.label ?? "";
    const on = row.dataset.pinned !== "true";
    const before = new Map(
      rows(host).map((item) => [
        item.dataset.value,
        item.getBoundingClientRect(),
      ]),
    );
    if (on) pinnedList.append(row);
    else {
      const index = Number(row.dataset.index);
      const next = [...allList.children].find(
        (item) => Number((item as HTMLElement).dataset.index) > index,
      );
      allList.insertBefore(row, next ?? null);
    }
    row.dataset.pinned = String(on);
    button.setAttribute("aria-pressed", String(on));
    button.title = (
      (on ? host.dataset.unpinLabel : host.dataset.pinLabel) ?? ""
    ).replace("{label}", label);
    for (const list of [pinnedList, allList]) {
      const part = list.parentElement!;
      part.hidden = !list.children.length;
      const counter = part.querySelector("[data-markas-pinned-count]");
      if (counter) counter.textContent = String(list.children.length);
    }
    const status = host.querySelector("[role=status]");
    if (status)
      status.textContent = (
        (on ? host.dataset.pinnedMessage : host.dataset.unpinnedMessage) ?? ""
      ).replace("{label}", label);
    const pinned = [...pinnedList.children].map(
      (item) => (item as HTMLElement).dataset.value ?? "",
    );
    host.dispatchEvent(
      new CustomEvent("change", { detail: pinned, bubbles: true }),
    );
    flip(host, before, value);
  });
</script>
