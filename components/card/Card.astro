---
import type { HTMLAttributes } from "astro/types";

const base = "grid gap-4 rounded-xl border border-line bg-surface p-6 text-ink";
const header = "grid gap-1.5";
const titleClass = "text-base font-semibold text-ink";
const descriptionClass = "text-sm text-muted";
const body = "text-sm text-ink";
const footerClass = "flex flex-wrap items-center gap-2";

type Props = Omit<HTMLAttributes<"article">, "title"> & {
  title?: string;
  description?: string;
};

const { title, description, class: className, ...rest } = Astro.props;
---

<article class:list={[base, className]} {...rest}>
  {
    (title || description) && (
      <header class={header}>
        {title && <h3 class={titleClass}>{title}</h3>}
        {description && <p class={descriptionClass}>{description}</p>}
      </header>
    )
  }
  {
    Astro.slots.has("default") && (
      <div class={body}>
        <slot />
      </div>
    )
  }
  {
    Astro.slots.has("footer") && (
      <div class={footerClass}>
        <slot name="footer" />
      </div>
    )
  }
</article>
