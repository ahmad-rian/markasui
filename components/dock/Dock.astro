---
import type { HTMLAttributes } from "astro/types";

export type DockItem =
  | {
      separator?: false;
      label: string;
      /** Path data (the d attribute) for a 24x24 stroked icon. */
      icon: string;
      value?: string;
      href?: string;
      /** Shows the dot under the item, like an open app. */
      active?: boolean;
    }
  | { separator: true };

const root =
  "relative inline-flex h-[60px] items-end gap-2 rounded-2xl border border-line bg-surface/80 px-2.5 pb-2.5 shadow-overlay backdrop-blur-md";
const itemWrap =
  "relative h-10 w-[calc(2.5rem*var(--dock-scale,1))] shrink-0 transition-[width] duration-150 ease-out motion-reduce:transition-none";
const itemClass =
  "group/dock absolute bottom-0 left-0 grid aspect-square w-full place-items-center rounded-xl border border-line bg-linear-to-b from-surface to-subtle text-ink transition-colors duration-150 ease-out hover:to-primary-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none";
const iconClass = "size-[55%]";
const tooltip =
  "pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 rounded-md bg-primary px-2 py-1 text-xs font-medium whitespace-nowrap text-on-primary opacity-0 shadow-overlay transition-[opacity,translate] duration-150 ease-out group-hover/dock:translate-y-0 group-hover/dock:opacity-100 group-focus-visible/dock:translate-y-0 group-focus-visible/dock:opacity-100 motion-reduce:transition-none";
const dot =
  "absolute -bottom-1.5 left-1/2 size-1 -translate-x-1/2 rounded-full bg-ink";
const separator = "mx-0.5 mb-1 h-8 w-px shrink-0 bg-line";

/** Href with a scheme other than http, https, mailto, or tel (such as javascript:) becomes "#". */
const safeHref = (href: string) =>
  /^(?!https?:|mailto:|tel:)[a-z][\w+.-]*:/i.test(href.replace(/[\0- ]/g, ""))
    ? "#"
    : href;

type Props = HTMLAttributes<"div"> & {
  items: DockItem[];
  /** How large the item under the pointer or focus grows. 1 turns it off. */
  magnification?: number;
  dockLabel?: string;
};

const {
  items,
  magnification = 1.6,
  dockLabel = "Dock",
  class: className,
  ...rest
} = Astro.props;

let position = 0;
---

<markas-dock class="contents" data-magnification={magnification}>
  <div
    role="toolbar"
    aria-label={dockLabel}
    aria-orientation="horizontal"
    class:list={[root, className]}
    {...rest}
  >
    {
      items.map((item) => {
        if (item.separator)
          return <div role="separator" aria-orientation="vertical" class={separator} />;
        const Tag = item.href ? "a" : "button";
        const tabindex = position++ === 0 ? "0" : "-1";
        return (
          <div data-dock-item="" class={itemWrap}>
            <Tag
              href={item.href ? safeHref(item.href) : undefined}
              type={item.href ? undefined : "button"}
              tabindex={tabindex}
              aria-current={item.active ? "true" : undefined}
              data-value={item.value ?? item.label}
              class={itemClass}
            >
              <svg
                class={iconClass}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={item.icon} />
              </svg>
              <span class={tooltip}>{item.label}</span>
            </Tag>
            {item.active && <span aria-hidden="true" class={dot} />}
          </div>
        );
      })
    }
  </div>
</markas-dock>

<script>
  /** Pointer distance in px over which neighbours still grow, and the launch bounce. */
  const RANGE = 140;
  const BOUNCE = [
    { transform: "none" },
    { transform: "translateY(-12px)" },
    { transform: "none" },
  ];
  const BOUNCE_TIMING = { duration: 450, easing: "cubic-bezier(0.3, 0, 0.3, 1)" };

  const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  const centerOf = (element: Element) => {
    const rect = element.getBoundingClientRect();
    return rect.left + rect.width / 2;
  };

  // Each dock tracks the pointer and its own tab stop, so it is a custom element: it also
  // works for markup added later and for pages reached through view transitions.
  class MarkasDock extends HTMLElement {
    private ready = false;

    connectedCallback() {
      const toolbar = this.querySelector<HTMLElement>("[role=toolbar]");
      if (this.ready || !toolbar) return;
      this.ready = true;
      toolbar.addEventListener("keydown", (event) => {
        const all = this.controls();
        const index = all.indexOf(event.target as HTMLElement);
        const targets: Record<string, number> = {
          ArrowRight: (index + 1) % all.length,
          ArrowLeft: (index - 1 + all.length) % all.length,
          Home: 0,
          End: all.length - 1,
        };
        const target = targets[event.key];
        if (index < 0 || target === undefined) return;
        event.preventDefault();
        all[target]?.focus();
      });
      toolbar.addEventListener("focusin", (event) => {
        const all = this.controls();
        const index = all.indexOf(event.target as HTMLElement);
        if (index < 0) return;
        all.forEach((control, i) => (control.tabIndex = i === index ? 0 : -1));
        this.magnify(centerOf(event.target as Element));
      });
      toolbar.addEventListener("focusout", (event) => {
        if (!toolbar.contains(event.relatedTarget as Node | null))
          this.magnify(null);
      });
      toolbar.addEventListener("pointermove", (event) =>
        this.magnify(event.clientX),
      );
      toolbar.addEventListener("pointerleave", () => {
        const focused = toolbar.contains(document.activeElement);
        this.magnify(focused ? centerOf(document.activeElement!) : null);
      });
      toolbar.addEventListener("click", (event) => {
        const control = (event.target as Element).closest<HTMLElement>(
          "[data-value]",
        );
        if (!control) return;
        if (!still()) control.animate?.(BOUNCE, BOUNCE_TIMING);
        this.dispatchEvent(
          new CustomEvent("markas-select", {
            detail: control.dataset.value,
            bubbles: true,
          }),
        );
      });
    }

    private controls() {
      return Array.from(
        this.querySelectorAll<HTMLElement>("[data-dock-item] > :first-child"),
      );
    }

    /** Grow every item by its distance to x with a cosine falloff. x null resets the dock. */
    private magnify(x: number | null) {
      const magnification = Number(this.dataset.magnification);
      const off = x === null || still();
      for (const item of this.querySelectorAll<HTMLElement>("[data-dock-item]")) {
        const rect = item.getBoundingClientRect();
        const distance = off ? RANGE : Math.abs(x - rect.left - rect.width / 2);
        const scale =
          distance >= RANGE
            ? 1
            : 1 +
              ((magnification - 1) * (1 + Math.cos((Math.PI * distance) / RANGE))) /
                2;
        item.style.setProperty("--dock-scale", String(scale));
      }
    }
  }

  if (!customElements.get("markas-dock")) customElements.define("markas-dock", MarkasDock);
</script>
