---
import type { HTMLAttributes } from "astro/types";

const wrapper = "grid gap-1.5";
const labelClass = "text-sm font-medium text-ink";
const control = "relative";
const field =
  "h-10 w-full cursor-pointer appearance-none rounded-md border border-line bg-surface pr-9 pl-3 text-sm text-ink transition-colors duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger motion-reduce:transition-none";
const icon =
  "pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted";
const hintClass = "text-sm text-muted";
const errorClass = "text-sm text-danger";

type Props = HTMLAttributes<"select"> & {
  label?: string;
  hint?: string;
  error?: string;
};

const { label, hint, error, id, class: className, ...rest } = Astro.props;
const selectId = id ?? `markas-select-${crypto.randomUUID().slice(0, 8)}`;
const describedBy = error
  ? `${selectId}-error`
  : hint
    ? `${selectId}-hint`
    : undefined;
---

<div class={wrapper}>
  {
    label && (
      <label for={selectId} class={labelClass}>
        {label}
      </label>
    )
  }
  <div class={control}>
    <select
      id={selectId}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
      class:list={[field, className]}
      {...rest}
    >
      <slot />
    </select>
    <svg
      class={icon}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>
  {
    error ? (
      <p id={`${selectId}-error`} class={errorClass}>
        {error}
      </p>
    ) : hint ? (
      <p id={`${selectId}-hint`} class={hintClass}>
        {hint}
      </p>
    ) : null
  }
</div>
