---
import type { HTMLAttributes } from "astro/types";

const wrapper = "grid gap-1.5";
const labelClass = "text-sm font-medium text-ink";
const field =
  "block w-full resize-y rounded-md border border-line bg-surface px-3 py-2 text-sm text-ink transition-colors duration-150 ease-out placeholder:text-faint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger motion-reduce:transition-none";
const hintClass = "text-sm text-muted";
const errorClass = "text-sm text-danger";

type Props = HTMLAttributes<"textarea"> & {
  label?: string;
  hint?: string;
  error?: string;
  /** Initial text. A textarea has no value attribute, so it is rendered as content. */
  value?: string;
};

const {
  label,
  hint,
  error,
  id,
  rows = 4,
  value,
  class: className,
  ...rest
} = Astro.props;
const textareaId = id ?? `markas-textarea-${crypto.randomUUID().slice(0, 8)}`;
const describedBy = error
  ? `${textareaId}-error`
  : hint
    ? `${textareaId}-hint`
    : undefined;
---

<div class={wrapper}>
  {
    label && (
      <label for={textareaId} class={labelClass}>
        {label}
      </label>
    )
  }
  <textarea
    id={textareaId}
    rows={rows}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
    class:list={[field, className]}
    {...rest}>{value}</textarea>
  {
    error ? (
      <p id={`${textareaId}-error`} class={errorClass}>
        {error}
      </p>
    ) : hint ? (
      <p id={`${textareaId}-hint`} class={hintClass}>
        {hint}
      </p>
    ) : null
  }
</div>
