---
import type { HTMLAttributes } from "astro/types";

const wrapper = "contents";
const base =
  "group inline-flex items-center justify-center gap-2 font-medium whitespace-nowrap transition-colors duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:pointer-events-none disabled:opacity-50 motion-reduce:transition-none";
const variants = {
  primary: "bg-primary text-on-primary hover:bg-primary-strong",
  secondary: "border border-line bg-surface text-ink hover:bg-subtle",
  ghost: "text-ink hover:bg-subtle",
  danger: "bg-danger text-on-primary hover:bg-danger/90",
};
const sizes = {
  sm: "h-8 rounded-md px-3 text-sm",
  md: "h-10 rounded-lg px-4 text-sm",
  lg: "h-12 rounded-lg px-6 text-base",
};
const iconSizes = {
  sm: "size-8 rounded-md text-sm",
  md: "size-10 rounded-lg text-sm",
  lg: "size-12 rounded-lg text-base",
};
const iconStack = "grid size-4 shrink-0 place-items-center";
const copyIcon =
  "col-start-1 row-start-1 size-4 transition-[opacity,scale] duration-200 ease-out group-data-[state=copied]:scale-50 group-data-[state=copied]:opacity-0 motion-reduce:transition-none";
const checkIcon =
  "col-start-1 row-start-1 size-4 scale-50 opacity-0 transition-[opacity,scale] duration-200 ease-out group-data-[state=copied]:scale-100 group-data-[state=copied]:opacity-100 motion-reduce:transition-none";
const checkPath =
  "[stroke-dasharray:24] [stroke-dashoffset:24] transition-[stroke-dashoffset] delay-100 duration-300 ease-out group-data-[state=copied]:[stroke-dashoffset:0] motion-reduce:transition-none";
const srOnly = "sr-only";

type Props = HTMLAttributes<"button"> & {
  /** Text written to the clipboard. */
  text: string;
  variant?: keyof typeof variants;
  size?: keyof typeof sizes;
  copyLabel?: string;
  copiedLabel?: string;
};

const {
  text,
  variant = "primary",
  size = "md",
  copyLabel = "Copy",
  copiedLabel = "Copied",
  type = "button",
  class: className,
  ...rest
} = Astro.props;
const hasLabel = Astro.slots.has("default");
---

<span class={wrapper}>
  <button
    type={type}
    data-state="idle"
    data-markas-copy-button={text}
    data-copied-label={copiedLabel}
    class:list={[
      base,
      variants[variant],
      hasLabel ? sizes[size] : iconSizes[size],
      className,
    ]}
    {...rest}
  >
    <span class={iconStack} aria-hidden="true">
      <svg
        class={copyIcon}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="9" y="9" width="12" height="12" rx="2"></rect>
        <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
      </svg>
      <svg
        class={checkIcon}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path class={checkPath} d="m4 12 5 5L20 6"></path>
      </svg>
    </span>
    {hasLabel ? <slot /> : <span class={srOnly}>{copyLabel}</span>}
  </button>
  <span role="status" class={srOnly}></span>
</span>

<script>
  /** How long the check mark stays before the button returns to idle. */
  const RESET_DELAY = 2000;
  const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();

  const setState = (button: HTMLElement, copied: boolean) => {
    button.dataset.state = copied ? "copied" : "idle";
    const status = button.nextElementSibling;
    if (status) status.textContent = copied ? (button.dataset.copiedLabel ?? "") : "";
  };

  // One listener per page serves every copy button. It runs after the user's own click
  // listeners, so preventDefault() there skips the copy.
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLElement>(
      "[data-markas-copy-button]",
    );
    if (!button || event.defaultPrevented) return;
    try {
      await navigator.clipboard.writeText(button.dataset.markasCopyButton ?? "");
    } catch {
      // Clipboard blocked or unavailable: stay idle so the check mark never lies.
      return;
    }
    setState(button, true);
    clearTimeout(timers.get(button));
    timers.set(button, setTimeout(() => setState(button, false), RESET_DELAY));
  });
</script>
