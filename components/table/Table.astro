---
import type { HTMLAttributes } from "astro/types";

export type TableColumn = {
  key: string;
  label: string;
  align?: "left" | "center" | "right";
};

export type TableRow = Record<string, string | number | null | undefined>;

const wrapper =
  "overflow-x-auto border border-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const tableClass = "w-full border-collapse text-sm";
const captionClasses = {
  hidden: "sr-only",
  visible: "px-4 py-3 text-left font-medium text-ink",
};
const headRow = "bg-subtle text-left text-sm font-medium text-muted";
const rounded = "rounded-xl";
const borderedHeadRow = "border-b-2 border-line";
const headCell = "font-medium whitespace-nowrap";
const rowClass =
  "border-t border-line transition-colors duration-150 ease-out hover:bg-subtle/50 motion-reduce:transition-none";
const stripedRow = "even:bg-subtle/40";
const footRow = "border-t-2 border-line bg-subtle font-medium";
const cell = "whitespace-nowrap text-ink";
const borderedCell = "border-l border-line first:border-l-0";
const sizes = {
  sm: "px-3 py-2 text-[13px]",
  md: "px-4 py-3",
};
const aligns = {
  left: "text-left",
  center: "text-center",
  right: "text-right",
};

type Props = HTMLAttributes<"div"> & {
  columns: TableColumn[];
  rows: TableRow[];
  caption?: string;
  showCaption?: boolean;
  label?: string;
  /** Lines around every cell, like a grid. */
  bordered?: boolean;
  /** Square corners (no radius), like a classic table. */
  square?: boolean;
  /** Alternating background on even rows. */
  striped?: boolean;
  size?: keyof typeof sizes;
  /** One optional tfoot row, values per column key (for example a total). */
  footer?: TableRow;
};

const {
  columns,
  rows,
  caption,
  showCaption = false,
  label,
  bordered = false,
  square = false,
  striped = false,
  size = "md",
  footer,
  class: className,
  ...rest
} = Astro.props;

const cellClass = (base: string, column: TableColumn) => [
  base,
  sizes[size] ?? sizes.md,
  bordered && borderedCell,
  aligns[column.align ?? "left"],
];

// A function child, (row, key) => markup, renders custom cells. Empty output falls back to the value.
const hasRenderer = Astro.slots.has("default");
const body = await Promise.all(
  rows.map((row) =>
    Promise.all(
      columns.map(async (column) => ({
        column,
        html: hasRenderer
          ? (await Astro.slots.render("default", [row, column.key])).trim()
          : "",
        text: row[column.key] ?? "",
      })),
    ),
  ),
);
---

<div
  tabindex="0"
  role="region"
  aria-label={label ?? caption ?? "Table"}
  class:list={[wrapper, !square && rounded, className]}
  {...rest}
>
  <table class={tableClass}>
    {
      caption && (
        <caption class={captionClasses[showCaption ? "visible" : "hidden"]}>
          {caption}
        </caption>
      )
    }
    <thead>
      <tr class:list={[headRow, bordered && borderedHeadRow]}>
        {
          columns.map((column) => (
            <th scope="col" class:list={cellClass(headCell, column)}>
              {column.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        body.map((cells) => (
          <tr class:list={[rowClass, striped && stripedRow]}>
            {cells.map(({ column, html, text }) =>
              html ? (
                <td class:list={cellClass(cell, column)} set:html={html} />
              ) : (
                <td class:list={cellClass(cell, column)}>{text}</td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
    {
      footer && (
        <tfoot>
          <tr class={footRow}>
            {columns.map((column) => (
              <td class:list={cellClass(cell, column)}>
                {footer[column.key] ?? ""}
              </td>
            ))}
          </tr>
        </tfoot>
      )
    }
  </table>
</div>
