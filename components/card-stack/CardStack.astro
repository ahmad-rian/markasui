---
import type { HTMLAttributes } from "astro/types";

const root = "w-full";
const stack =
  "relative grid touch-pan-y rounded-xl pb-4 select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const card =
  "group col-start-1 row-start-1 origin-bottom overflow-hidden rounded-xl border border-line bg-surface transition-[translate,scale,opacity,background-color] duration-300 ease-out data-[depth=0]:z-30 data-[depth=0]:cursor-grab data-[depth=1]:z-20 data-[depth=1]:translate-y-2 data-[depth=1]:scale-[0.95] data-[depth=1]:bg-subtle data-[depth=2]:z-10 data-[depth=2]:translate-y-4 data-[depth=2]:scale-[0.9] data-[depth=2]:bg-subtle data-[depth=3]:translate-y-4 data-[depth=3]:scale-[0.9] data-[depth=3]:opacity-0 data-dragging:cursor-grabbing data-dragging:transition-none data-leaving:z-40 motion-reduce:transition-none";
const content =
  "h-full opacity-0 transition-opacity duration-300 ease-out group-data-leaving:opacity-100 group-data-[depth=0]:opacity-100 motion-reduce:transition-none";
const controls = "mt-3 flex items-center justify-between gap-3";
const navButton =
  "inline-flex size-9 items-center justify-center rounded-full border border-line bg-surface text-ink transition-[background-color,scale] duration-150 ease-out hover:bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-95 disabled:pointer-events-none disabled:opacity-50 motion-reduce:transition-none";
const dots = "flex items-center gap-1.5";
const dot =
  "h-1.5 w-1.5 rounded-full bg-primary-line transition-all duration-300 ease-out data-[state=active]:w-5 data-[state=active]:bg-primary motion-reduce:transition-none";
const icon = "size-4";
const srOnly = "sr-only";
const MAX_DEPTH = 3;

type Props = HTMLAttributes<"div"> & {
  /** One card per item, drawn by the function passed as the default slot. */
  items: unknown[];
  /** Accessible name of the stack region. */
  label?: string;
  prevLabel?: string;
  nextLabel?: string;
  /** Name of each card and the live position text. Accepts {index} and {total}. */
  cardLabel?: string;
};

const {
  items,
  label = "Card stack",
  prevLabel = "Previous card",
  nextLabel = "Next card",
  cardLabel = "{index} of {total}",
  id,
  class: className,
  ...rest
} = Astro.props;

/** Fill {index} and {total} in a label. */
const formatLabel = (template: string, index: number, total: number) =>
  template
    .replaceAll("{index}", String(index))
    .replaceAll("{total}", String(total));

const total = items.length;
const stackId = `${id ?? `markas-card-stack-${crypto.randomUUID().slice(0, 8)}`}-cards`;
const cards = await Promise.all(
  items.map((item, index) => Astro.slots.render("default", [item, index])),
);
---

<markas-card-stack class="contents" data-card-label={cardLabel}>
  <div
    id={id}
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
    class:list={[root, className]}
    {...rest}
  >
    <div id={stackId} tabindex="0" class={stack} data-stack>
      {
        cards.map((html, index) => (
          <div
            role="group"
            aria-roledescription="slide"
            aria-label={formatLabel(cardLabel, index + 1, total)}
            data-depth={Math.min(index, MAX_DEPTH)}
            inert={index !== 0}
            class={card}
          >
            <div class={content} set:html={html} />
          </div>
        ))
      }
    </div>
    <div class={controls}>
      <button
        type="button"
        aria-label={prevLabel}
        aria-controls={stackId}
        disabled={total < 2}
        data-step="-1"
        class={navButton}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={icon}
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <div aria-hidden="true" class={dots}>
        {
          cards.map((_, index) => (
            <span
              data-state={index === 0 ? "active" : "inactive"}
              data-dot
              class={dot}
            />
          ))
        }
      </div>
      <button
        type="button"
        aria-label={nextLabel}
        aria-controls={stackId}
        disabled={total < 2}
        data-step="1"
        class={navButton}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={icon}
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
    <p aria-live="polite" class={srOnly} data-live>
      {formatLabel(cardLabel, 1, total)}
    </p>
  </div>
</markas-card-stack>

<script>
  const FLING_MS = 450;
  const SETTLE_MS = 250;
  const EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)";
  /** Share of the stack width a drag must pass to throw the card. */
  const SWIPE_RATIO = 0.25;
  /** Pixels of movement before a press becomes a drag, so clicks inside cards still work. */
  const DRAG_START = 4;
  const MAX_DEPTH = 3;

  const away = (direction: number) =>
    `translateX(${direction * 120}%) rotate(${direction * 14}deg)`;

  function play(el: HTMLElement, keyframes: Keyframe[], duration: number) {
    if (
      matchMedia("(prefers-reduced-motion: reduce)").matches ||
      typeof el.animate !== "function"
    )
      return undefined;
    el.getAnimations().forEach((animation) => animation.finish());
    return el.animate(keyframes, { duration, easing: EASE });
  }

  /** Throw the card off to one side; it then fades in at the back of the stack. */
  function fling(el: HTMLElement, direction: number) {
    const from = el.style.transform || "none";
    el.style.transform = "";
    delete el.dataset.dragging;
    el.dataset.leaving = "";
    const animation = play(
      el,
      [
        { transform: from, opacity: 1 },
        { opacity: 1, offset: 0.5 },
        { transform: away(direction), opacity: 0 },
      ],
      FLING_MS,
    );
    if (!animation) {
      delete el.dataset.leaving;
      return;
    }
    animation.onfinish = () => {
      delete el.dataset.leaving;
      play(el, [{ opacity: 0, offset: 0 }], SETTLE_MS);
    };
  }

  /** Spring a dragged card back to the middle. */
  function settle(el: HTMLElement) {
    const from = el.style.transform;
    el.style.transform = "";
    delete el.dataset.dragging;
    if (from) play(el, [{ transform: from }, { transform: "none" }], SETTLE_MS);
  }

  // Each stack keeps its own position, so it is a custom element: it also works for markup
  // added later and for pages reached through view transitions.
  class MarkasCardStack extends HTMLElement {
    private index = 0;
    private drag: { x: number; moved: boolean } | null = null;
    private ready = false;

    connectedCallback() {
      const stack = this.querySelector<HTMLElement>("[data-stack]");
      if (this.ready || !stack) return;
      this.ready = true;
      this.addEventListener("click", (event) => {
        const button = (event.target as Element).closest<HTMLElement>(
          "[data-step]",
        );
        if (button) this.go(stack, Number(button.dataset.step) as 1 | -1);
      });
      this.addEventListener("keydown", (event) => {
        const steps: Record<string, 1 | -1 | undefined> = {
          ArrowRight: 1,
          ArrowLeft: -1,
        };
        const step = steps[event.key];
        if (step === undefined || event.defaultPrevented) return;
        event.preventDefault();
        this.go(stack, step);
      });
      stack.addEventListener("pointerdown", (event) => {
        if (event.button !== 0 || stack.children.length < 2) return;
        this.drag = { x: event.clientX, moved: false };
      });
      stack.addEventListener("pointermove", (event) => {
        const top = stack.children[this.index] as HTMLElement | undefined;
        if (!this.drag || !top) return;
        const dx = event.clientX - this.drag.x;
        if (!this.drag.moved) {
          if (Math.abs(dx) < DRAG_START) return;
          this.drag.moved = true;
          stack.setPointerCapture?.(event.pointerId);
          top.dataset.dragging = "";
        }
        top.style.transform = `translateX(${dx}px) rotate(${dx / 20}deg)`;
      });
      stack.addEventListener("pointerup", (event) => {
        const state = this.drag;
        this.drag = null;
        const top = stack.children[this.index] as HTMLElement | undefined;
        if (!state?.moved || !top) return;
        const dx = event.clientX - state.x;
        if (Math.abs(dx) > stack.offsetWidth * SWIPE_RATIO)
          this.go(stack, 1, Math.sign(dx));
        else settle(top);
      });
      stack.addEventListener("pointercancel", () => {
        const top = stack.children[this.index] as HTMLElement | undefined;
        if (this.drag?.moved && top) settle(top);
        this.drag = null;
      });
    }

    /** Step forward (throw the top card) or back (bring the last card in). */
    private go(stack: HTMLElement, step: 1 | -1, direction = -1) {
      const cards = Array.from(stack.children) as HTMLElement[];
      const total = cards.length;
      if (total < 2) return;
      const target = (this.index + step + total) % total;
      const top = cards[this.index];
      const incoming = cards[target];
      if (step === 1 && top) fling(top, direction);
      if (step === -1 && incoming)
        play(
          incoming,
          [
            { transform: away(direction), opacity: 0 },
            { transform: "none", opacity: 1 },
          ],
          FLING_MS,
        );
      this.index = target;
      cards.forEach((card, i) => {
        const depth = Math.min((i - target + total) % total, MAX_DEPTH);
        card.dataset.depth = String(depth);
        card.inert = depth !== 0;
      });
      this.querySelectorAll<HTMLElement>("[data-dot]").forEach((dot, i) => {
        dot.dataset.state = i === target ? "active" : "inactive";
      });
      const live = this.querySelector("[data-live]");
      if (live)
        live.textContent = (this.dataset.cardLabel ?? "")
          .replaceAll("{index}", String(target + 1))
          .replaceAll("{total}", String(total));
    }
  }

  if (!customElements.get("markas-card-stack"))
    customElements.define("markas-card-stack", MarkasCardStack);
</script>
