---
import type { HTMLAttributes } from "astro/types";

export type BottomNavigationItem = {
  value: string;
  label: string;
  /** Path data (the d attribute) for a 24x24 stroked icon. */
  icon: string;
  href?: string;
  /** Small count shown on the icon. */
  badge?: number | string;
};

const root =
  "flex items-center gap-2 transition-transform duration-300 ease-out data-[state=collapsed]:translate-y-1 motion-reduce:transition-none";
const nav =
  "relative min-w-0 flex-1 rounded-full border border-line bg-surface/85 p-1.5 shadow-overlay backdrop-blur-md";
const pill =
  "absolute inset-y-1.5 left-1.5 w-[calc((100%-0.75rem)/var(--bn-count))] translate-x-[calc(var(--bn-index)*100%)] rounded-full bg-primary-soft transition-transform duration-500 ease-[cubic-bezier(0.34,1.36,0.5,1)] motion-reduce:transition-none";
const list = "relative grid auto-cols-fr grid-flow-col";
const itemClass =
  "group/item relative flex h-14 w-full items-center justify-center rounded-full text-muted transition-[color,height] duration-300 ease-out select-none hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-[current=page]:text-ink motion-reduce:transition-none [[data-bottom-nav=collapsed]_&]:h-11";
const iconWrap =
  "relative transition-transform duration-300 ease-out group-active/item:scale-90 motion-reduce:transition-none [[data-bottom-nav=expanded]_[aria-current=page]_&]:-translate-y-2.5";
const iconClass = "size-6";
const badgeClass =
  "absolute -top-1 -right-2 h-4 min-w-4 rounded-full bg-danger px-1 text-center text-[10px] leading-4 font-semibold text-on-primary";
const labelClass =
  "pointer-events-none absolute inset-x-1 bottom-1.5 translate-y-1 truncate text-center text-xs leading-4 font-medium opacity-0 transition-[opacity,translate] duration-300 ease-out motion-reduce:transition-none [[data-bottom-nav=expanded]_[aria-current=page]_&]:translate-y-0 [[data-bottom-nav=expanded]_[aria-current=page]_&]:opacity-100";
const srOnly = "sr-only";
const actionClass =
  "grid size-14 shrink-0 place-items-center rounded-full bg-primary text-on-primary shadow-overlay transition-[background-color,width,height,scale] duration-300 ease-out hover:bg-primary-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-95 motion-reduce:transition-none [[data-bottom-nav=collapsed]_&]:size-11";

/** Href with a scheme other than http, https, mailto, or tel (such as javascript:) becomes "#". */
const safeHref = (href: string) =>
  /^(?!https?:|mailto:|tel:)[a-z][\w+.-]*:/i.test(href.replace(/[\0- ]/g, ""))
    ? "#"
    : href;

type Props = HTMLAttributes<"div"> & {
  items: BottomNavigationItem[];
  defaultValue?: string;
  /** Collapse to icons while the content around the bar scrolls down. */
  shrinkOnScroll?: boolean;
  navLabel?: string;
  actionLabel?: string;
  badgeLabel?: string;
};

const {
  items,
  defaultValue,
  shrinkOnScroll = false,
  navLabel = "Main",
  actionLabel = "Create",
  badgeLabel = "{count} new",
  class: className,
  ...rest
} = Astro.props;
const active = defaultValue ?? items[0]?.value;
const index = Math.max(
  items.findIndex((item) => item.value === active),
  0,
);
const hasAction = Astro.slots.has("action");
---

<markas-bottom-navigation
  class="contents"
  data-shrink-on-scroll={shrinkOnScroll ? "" : undefined}
>
  <div
    data-state="expanded"
    data-bottom-nav="expanded"
    class:list={[root, className]}
    {...rest}
  >
    <nav
      aria-label={navLabel}
      class={nav}
      style={`--bn-count: ${items.length}; --bn-index: ${index}`}
    >
      <span aria-hidden="true" class={pill}></span>
      <ul class={list}>
        {
          items.map((item) => {
            const Tag = item.href ? "a" : "button";
            return (
              <li>
                <Tag
                  href={item.href ? safeHref(item.href) : undefined}
                  type={item.href ? undefined : "button"}
                  aria-current={item.value === active ? "page" : undefined}
                  data-value={item.value}
                  class={itemClass}
                >
                  <span class={iconWrap}>
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={item.icon} />
                    </svg>
                    {item.badge !== undefined && (
                      <span aria-hidden="true" class={badgeClass}>
                        {item.badge}
                      </span>
                    )}
                  </span>
                  <span class={labelClass}>{item.label}</span>
                  {item.badge !== undefined && (
                    <span class={srOnly}>
                      {badgeLabel.replace("{count}", String(item.badge))}
                    </span>
                  )}
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </nav>
    {
      hasAction && (
        <button
          type="button"
          aria-label={actionLabel}
          data-action
          class={actionClass}
        >
          <slot name="action" />
        </button>
      )
    }
  </div>
</markas-bottom-navigation>

<script>
  /** Scroll distance before the bar reacts, and how far down the content must be before it collapses. */
  const SCROLL_DELTA = 4;
  const COLLAPSE_AFTER = 32;

  // Each bar tracks its own scroll position, so it is a custom element: it also works for
  // markup added later and for pages reached through view transitions.
  class MarkasBottomNavigation extends HTMLElement {
    private last: EventTarget | null = null;
    private lastTop = 0;
    private readonly onScroll = (event: Event) => {
      const target = event.target as Element | Document;
      if (target !== document && !this.parentElement?.contains(target as Element))
        return;
      const top = target === document ? scrollY : (target as Element).scrollTop;
      if (target !== this.last) [this.last, this.lastTop] = [target, 0];
      if (Math.abs(top - this.lastTop) < SCROLL_DELTA) return;
      this.setCollapsed(top > this.lastTop && top > COLLAPSE_AFTER);
      this.lastTop = top;
    };
    private readonly options = { capture: true, passive: true };

    connectedCallback() {
      this.addEventListener("click", this.onClick);
      if (this.hasAttribute("data-shrink-on-scroll"))
        document.addEventListener("scroll", this.onScroll, this.options);
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.onClick);
      document.removeEventListener("scroll", this.onScroll, this.options);
    }

    private setCollapsed(collapsed: boolean) {
      const bar = this.querySelector<HTMLElement>("[data-bottom-nav]");
      if (!bar) return;
      const state = collapsed ? "collapsed" : "expanded";
      bar.dataset.state = state;
      bar.dataset.bottomNav = state;
    }

    private readonly onClick = (event: Event) => {
      const target = event.target as Element;
      if (target.closest("[data-action]")) {
        this.dispatchEvent(new CustomEvent("markas-action", { bubbles: true }));
        return;
      }
      const item = target.closest<HTMLElement>("[data-value]");
      if (!item) return;
      const items = [...this.querySelectorAll<HTMLElement>("[data-value]")];
      items.forEach((other) =>
        other === item
          ? other.setAttribute("aria-current", "page")
          : other.removeAttribute("aria-current"),
      );
      this.querySelector("nav")?.style.setProperty(
        "--bn-index",
        String(items.indexOf(item)),
      );
      this.setCollapsed(false);
      this.dispatchEvent(
        new CustomEvent("markas-change", {
          detail: item.dataset.value,
          bubbles: true,
        }),
      );
    };
  }

  if (!customElements.get("markas-bottom-navigation"))
    customElements.define("markas-bottom-navigation", MarkasBottomNavigation);
</script>
