---
import type { HTMLAttributes } from "astro/types";

export type DynamicIslandState = "idle" | "compact" | "expanded";

/** The island re-scopes the theme with the dark class, so it reads as a black pill in both modes. */
const root =
  "dark relative mx-auto max-w-full overflow-hidden bg-canvas text-ink ring-1 ring-line transition-[width,height,border-radius] duration-500 ease-[cubic-bezier(0.32,1.2,0.5,1)] motion-reduce:transition-none data-[state=compact]:h-9 data-[state=compact]:w-[var(--island-compact-width,15rem)] data-[state=compact]:rounded-[18px] data-[state=expanded]:h-[var(--island-expanded-height,9.5rem)] data-[state=expanded]:w-[var(--island-expanded-width,22rem)] data-[state=expanded]:rounded-[32px] data-[state=idle]:h-9 data-[state=idle]:w-[var(--island-idle-width,7.5rem)] data-[state=idle]:rounded-[18px]";
const panel =
  "absolute top-0 left-1/2 max-w-[100cqw] origin-top -translate-x-1/2 transition-[opacity,scale,filter] duration-300 ease-out motion-reduce:transition-none data-[state=active]:delay-150 data-[state=inactive]:pointer-events-none data-[state=inactive]:scale-90 data-[state=inactive]:opacity-0 data-[state=inactive]:blur-sm";
const panels = {
  idle: "grid h-9 w-[var(--island-idle-width,7.5rem)] place-items-center",
  compact:
    "flex h-9 w-[var(--island-compact-width,15rem)] items-center justify-between gap-3 px-3 text-xs font-medium",
  expanded:
    "h-[var(--island-expanded-height,9.5rem)] w-[var(--island-expanded-width,22rem)] p-4",
};
const side = "flex min-w-0 items-center gap-2";
const srOnly = "sr-only";

type Props = HTMLAttributes<"div"> & {
  /** First state. Change it later with setAttribute("state", ...) on markas-dynamic-island. */
  state?: DynamicIslandState;
  /** Text read by screen readers when the island moves to a state. */
  announcements?: Partial<Record<DynamicIslandState, string>>;
  islandLabel?: string;
};

const {
  state = "idle",
  announcements = {},
  islandLabel = "Live activity",
  class: className,
  ...rest
} = Astro.props;

const stateOf = (name: DynamicIslandState) => (state === name ? "active" : "inactive");
---

<markas-dynamic-island
  class="contents"
  state={state}
  data-announcements={JSON.stringify(announcements)}
>
  <div
    role="region"
    aria-label={islandLabel}
    data-state={state}
    class:list={[root, className]}
    {...rest}
  >
    <div
      data-state={stateOf("idle")}
      data-panel="idle"
      inert={state !== "idle"}
      class:list={[panel, panels.idle]}
    >
      <slot name="idle" />
    </div>
    <div
      data-state={stateOf("compact")}
      data-panel="compact"
      inert={state !== "compact"}
      class:list={[panel, panels.compact]}
    >
      <div class={side}><slot name="leading" /></div>
      <div class={side}><slot name="trailing" /></div>
    </div>
    <div
      data-state={stateOf("expanded")}
      data-panel="expanded"
      inert={state !== "expanded"}
      class:list={[panel, panels.expanded]}
    >
      <slot name="expanded" />
    </div>
    <p aria-live="polite" class={srOnly}>{announcements[state] ?? ""}</p>
  </div>
</markas-dynamic-island>

<script>
  // Controlled from outside: set the state attribute (island.setAttribute("state", "expanded"))
  // and the island morphs. A custom element, so it also works for markup added later.
  class MarkasDynamicIsland extends HTMLElement {
    static observedAttributes = ["state"];

    attributeChangedCallback() {
      const state = this.getAttribute("state") ?? "idle";
      const region = this.querySelector<HTMLElement>("[role=region]");
      if (!region) return;
      region.dataset.state = state;
      this.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        const active = panel.dataset.panel === state;
        panel.dataset.state = active ? "active" : "inactive";
        panel.inert = !active;
      });
      const announcements = JSON.parse(this.dataset.announcements ?? "{}");
      const live = region.querySelector("[aria-live]");
      if (live) live.textContent = announcements[state] ?? "";
    }
  }

  if (!customElements.get("markas-dynamic-island"))
    customElements.define("markas-dynamic-island", MarkasDynamicIsland);
</script>
