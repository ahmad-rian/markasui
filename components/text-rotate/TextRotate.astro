---
import type { HTMLAttributes } from "astro/types";

const root = "relative inline-flex overflow-hidden align-bottom";
const unit = "inline-block whitespace-pre";

type Props = Omit<HTMLAttributes<"span">, "children"> & {
  words: string[];
  split?: "chars" | "words";
  from?: "first" | "last" | "center" | "random";
  interval?: number;
  stagger?: number;
  duration?: number;
  pauseOnHover?: boolean;
};

const {
  words,
  split = "chars",
  from = "first",
  interval = 2500,
  stagger = 25,
  duration = 400,
  pauseOnHover = true,
  class: className,
  ...rest
} = Astro.props;
const first = words[0] ?? "";
// Split a phrase into letters, or into words with the space after them.
const parts = split === "chars" ? Array.from(first) : first.split(/(?<= )/);
---

<span {...rest} class:list={[root, className]}><markas-text-rotate class="sr-only" data-words={JSON.stringify(words)} data-split={split} data-from={from} data-interval={interval} data-stagger={stagger} data-duration={duration} data-pause-on-hover={String(pauseOnHover)}>{words.join(", ")}</markas-text-rotate>{parts.map((part) => <span aria-hidden="true" data-unit="" class={unit}>{part}</span>)}</span>

<script>
  const UNIT = "inline-block whitespace-pre";
  const EASE_IN = "cubic-bezier(0.55, 0, 1, 0.45)";
  const EASE_OUT = "cubic-bezier(0.22, 1, 0.36, 1)";

  /** Splits a phrase into letters, or into words with the space after them. */
  const splitText = (text: string, split: string | undefined) =>
    split === "chars" ? Array.from(text) : text.split(/(?<= )/);

  /** Stagger rank of each unit from the starting point. Random uses a fixed shuffled order (hash). */
  function ranks(count: number, from: string | undefined) {
    const order = [...Array(count).keys()];
    const hash = (i: number) => Math.imul(i + 1, 2654435761) >>> 0;
    if (from === "random") order.sort((a, b) => hash(a) - hash(b));
    const rank: number[] = [];
    order.forEach((index, position) => {
      const middle = Math.abs(index - (count - 1) / 2);
      rank[index] =
        from === "last"
          ? count - 1 - index
          : from === "center"
            ? middle
            : position;
    });
    return rank;
  }

  /**
   * The element is the visually hidden copy of the words, inside the root span. That keeps
   * the root a plain span (like the other frameworks) while setup still runs per instance,
   * for markup added later and after view transitions.
   */
  class MarkasTextRotate extends HTMLElement {
    private cleanup = () => {};

    connectedCallback() {
      const host = this.parentElement;
      const words = JSON.parse(this.dataset.words ?? "[]") as string[];
      if (!host || words.length < 2) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const { split, from } = this.dataset;
      const interval = Number(this.dataset.interval);
      const stagger = Number(this.dataset.stagger);
      const duration = Number(this.dataset.duration);
      const pauseOnHover = this.dataset.pauseOnHover !== "false";
      const units = () => [
        ...host.querySelectorAll<HTMLElement>("[data-unit]"),
      ];
      let index = 0;
      let hovered = false;
      let busy = false;
      let timer: ReturnType<typeof setInterval> | undefined;

      // Render the next word, rise it in unit by unit, and let the width of the wrapper follow smoothly.
      const swap = () => {
        const width = host.offsetWidth;
        units().forEach((el) => el.remove());
        splitText(words[index] ?? "", split).forEach((part) => {
          const el = document.createElement("span");
          el.setAttribute("aria-hidden", "true");
          el.dataset.unit = "";
          el.className = UNIT;
          el.textContent = part;
          host.append(el);
        });
        const list = units();
        const rank = ranks(list.length, from);
        list.forEach((el, i) =>
          el.animate?.(
            [
              { transform: "translateY(100%)", opacity: 0 },
              { transform: "none", opacity: 1 },
            ],
            {
              duration,
              delay: rank[i]! * stagger,
              easing: EASE_OUT,
              fill: "backwards",
            },
          ),
        );
        host.animate?.(
          [{ width: `${width}px` }, { width: `${host.offsetWidth}px` }],
          { duration, easing: EASE_OUT },
        );
      };

      // The old word leaves upward, then the next one is rendered. Paused on hover, off screen, or in a hidden tab.
      const next = () => {
        if (busy || (hovered && pauseOnHover) || document.hidden) return;
        busy = true;
        const list = units();
        const rank = ranks(list.length, from);
        const exits = list.map((el, i) =>
          el.animate?.(
            [
              { transform: "none", opacity: 1 },
              { transform: "translateY(-100%)", opacity: 0 },
            ],
            {
              duration,
              delay: rank[i]! * stagger,
              easing: EASE_IN,
              fill: "forwards",
            },
          ),
        );
        Promise.all(exits.map((animation) => animation?.finished))
          .then(() => {
            index = (index + 1) % words.length;
            swap();
          })
          .catch(() => {})
          .finally(() => (busy = false));
      };
      const onEnter = () => (hovered = true);
      const onLeave = () => (hovered = false);
      host.addEventListener("pointerenter", onEnter);
      host.addEventListener("pointerleave", onLeave);
      const observer =
        typeof IntersectionObserver === "undefined"
          ? undefined
          : new IntersectionObserver((entries) => {
              clearInterval(timer);
              if (entries.some((entry) => entry.isIntersecting))
                timer = setInterval(next, interval);
            });
      if (observer) observer.observe(host);
      else timer = setInterval(next, interval);
      this.cleanup = () => {
        observer?.disconnect();
        clearInterval(timer);
        host.removeEventListener("pointerenter", onEnter);
        host.removeEventListener("pointerleave", onLeave);
      };
    }

    disconnectedCallback() {
      this.cleanup();
    }
  }

  if (!customElements.get("markas-text-rotate"))
    customElements.define("markas-text-rotate", MarkasTextRotate);
</script>
