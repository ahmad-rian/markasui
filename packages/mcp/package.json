{
  "name": "@markasui/mcp",
  "version": "0.1.0",
  "description": "MarkasUI MCP server: lets AI coding agents search Tailwind CSS components and fetch Blade, React, Vue, Svelte, Astro, or Angular code.",
  "license": "MIT",
  "author": "CV Jenderal Solusi Digital (https://jenderalcorp.com)",
  "bugs": {
    "url": "https://github.com/ahmad-rian/markasui/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmad-rian/markasui.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://markas.jenderalcorp.com/docs/mcp",
  "keywords": [
    "markasui",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "ai-agents",
    "tailwindcss",
    "ui-components",
    "react",
    "vue",
    "blade",
    "laravel",
    "svelte",
    "astro",
    "angular"
  ],
  "bin": {
    "markasui-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@markasui/registry": "workspace:*",
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "markasui": "workspace:*",
    "zod": "4.6.7"
  }
}
