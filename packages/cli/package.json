{
  "name": "markasui",
  "version": "0.1.0",
  "description": "MarkasUI CLI: add Tailwind CSS v4 UI components to Laravel Blade, React, Vue, Svelte, Astro, and Angular projects with one command.",
  "license": "MIT",
  "author": "CV Jenderal Solusi Digital (https://jenderalcorp.com)",
  "bugs": {
    "url": "https://github.com/ahmad-rian/markasui/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmad-rian/markasui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://markasui.pages.dev/docs/cli",
  "keywords": [
    "markasui",
    "cli",
    "tailwindcss",
    "tailwind",
    "tailwind-components",
    "ui-components",
    "component-library",
    "design-system",
    "copy-paste",
    "react",
    "react-components",
    "vue",
    "vue-components",
    "laravel",
    "blade",
    "blade-components",
    "livewire",
    "alpinejs",
    "svelte",
    "svelte-components",
    "astro",
    "astro-components",
    "angular",
    "angular-components",
    "accessibility",
    "dark-mode"
  ],
  "bin": {
    "markasui": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@markasui/registry": "workspace:*"
  }
}
