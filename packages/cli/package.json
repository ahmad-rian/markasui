{
  "name": "markasui",
  "version": "0.1.0",
  "description": "CLI MarkasUI: tambahkan komponen Blade, React, Vue, Svelte, Astro, atau Angular ke project Anda.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmad-rian/markasui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://markasui.pages.dev",
  "keywords": [
    "markasui",
    "ui",
    "components",
    "blade",
    "laravel",
    "react",
    "vue",
    "svelte",
    "astro",
    "angular",
    "tailwind",
    "cli"
  ],
  "bin": {
    "markasui": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@markasui/registry": "workspace:*"
  }
}
