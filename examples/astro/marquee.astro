---
import Marquee from "../../components/marquee/Marquee.astro";

const stack = ["Laravel", "React", "Vue", "Alpine.js", "Tailwind CSS", "Vite"];
---

<Marquee>
  {
    stack.map((name) => (
      <span class="rounded-full border border-line bg-surface px-3 py-1.5 text-sm font-medium whitespace-nowrap text-ink">
        {name}
      </span>
    ))
  }
</Marquee>
