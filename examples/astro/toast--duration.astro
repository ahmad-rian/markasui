---
import Button from "../../components/button/Button.astro";
import Toaster from "../../components/toast/Toast.astro";
---

<div class="flex flex-wrap items-center gap-3">
  <Button variant="secondary" data-toast={JSON.stringify({ title: "Message archived", duration: 3000 })}>Short (3s)</Button>
  <Button variant="secondary" data-toast={JSON.stringify({ title: "Report is ready", description: "Download it from the exports page." })}>Default (5s)</Button>
  <Button data-toast={JSON.stringify({ title: "New version available", description: "Reload the page to update.", duration: 0 })}>Stay open</Button>
</div>
<Toaster />

<script>
  // Toaster listens for the markas-toast event on window.
  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLElement>("[data-toast]");
    if (!button) return;
    window.dispatchEvent(
      new CustomEvent("markas-toast", { detail: JSON.parse(button.dataset.toast!) }),
    );
  });
</script>
