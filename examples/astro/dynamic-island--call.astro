---
import DynamicIsland, { type DynamicIslandState } from "../../components/dynamic-island/DynamicIsland.astro";

const panel = "grid gap-4";
const stage = "@container h-[150px] rounded-[2rem] border border-line bg-surface px-3 pt-3";
const island = "[--island-expanded-height:4.75rem]";
const controls = "flex justify-center gap-1.5";
const demoButton =
  "h-8 rounded-full border border-line bg-surface px-3 text-sm font-medium text-ink transition-colors duration-150 ease-out hover:bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-on-primary motion-reduce:transition-none";
const caller = "text-success";
const callIcon = "size-4 text-success";
const timer = "text-success tabular-nums";
const row = "flex h-full items-center gap-3";
const avatar =
  "grid size-11 shrink-0 place-items-center rounded-full bg-subtle text-sm font-semibold";
const who = "min-w-0 flex-1";
const label = "text-xs text-muted";
const name = "truncate text-base font-semibold";
const round =
  "grid size-11 shrink-0 place-items-center rounded-full text-canvas transition-[scale] duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-90 motion-reduce:transition-none";
const decline = `${round} bg-danger`;
const accept = `${round} bg-success`;
const icon = "size-5";

const PHONE =
  "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2";
const HANG_UP =
  "M3 15.5c5-4.5 13-4.5 18 0l-1.5 2.5-4-1v-2.5a10 10 0 0 0-7 0V17l-4 1z";
const states: { value: DynamicIslandState; label: string }[] = [
  { value: "idle", label: "Idle" },
  { value: "compact", label: "On call" },
  { value: "expanded", label: "Ringing" },
];
---

<div class={panel} data-island-demo>
  <div class={stage}>
    <DynamicIsland
      state="expanded"
      class={island}
      announcements={{
        expanded: "Incoming call from Rina Santoso",
        compact: "Call connected",
      }}
    >
      <Fragment slot="leading">
        <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class={callIcon}
          >
            <path d={PHONE}></path>
          </svg>
        <span class={caller}>Rina</span>
      </Fragment>
      <span slot="trailing" class={timer}>0:42</span>
      <div slot="expanded" class={row}>
        <span aria-hidden="true" class={avatar}>RS</span>
        <div class={who}>
          <p class={label}>Mobile</p>
          <p class={name}>Rina Santoso</p>
        </div>
        <button type="button" aria-label="Decline" class={decline} data-island-set="idle">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class={icon}
          >
            <path d={HANG_UP}></path>
          </svg>
        </button>
        <button type="button" aria-label="Accept" class={accept} data-island-set="compact">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class={icon}
          >
            <path d={PHONE}></path>
          </svg>
        </button>
      </div>
    </DynamicIsland>
  </div>
  <div role="group" aria-label="Call state" class={controls}>
    {
      states.map((item) => (
        <button
          type="button"
          aria-pressed={item.value === "expanded" ? "true" : "false"}
          data-island-set={item.value}
          class={demoButton}
        >
          {item.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  // Demo wiring: buttons with data-island-set move the island to that state.
  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLElement>(
      "[data-island-set]",
    );
    const demo = button?.closest("[data-island-demo]");
    if (!button || !demo) return;
    const state = button.dataset.islandSet ?? "idle";
    demo.querySelector("markas-dynamic-island")?.setAttribute("state", state);
    demo.querySelectorAll("[aria-pressed]").forEach((other) =>
      other.setAttribute(
        "aria-pressed",
        String(other.getAttribute("data-island-set") === state),
      ),
    );
  });
</script>
