---
import Slider from "../../components/slider/Slider.astro";
---

<div class="grid gap-5 rounded-xl border border-line bg-surface p-5">
  <div class="grid gap-1">
    <h3 class="text-base font-medium text-ink">Sound</h3>
    <p class="text-sm text-muted">
      Changes apply to every device on this account.
    </p>
  </div>
  <Slider name="master" label="Master volume" value={75} />
  <Slider name="music" label="Music" value={50} />
  <Slider name="effects" label="Effects" value={20} />
</div>
