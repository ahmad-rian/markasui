---
import BackgroundLines from "../../components/background-lines/BackgroundLines.astro";
import Button from "../../components/button/Button.astro";
---

<BackgroundLines
  color="success"
  count={8}
  speed="fast"
  class="rounded-xl border border-line bg-surface p-6"
>
  <div class="grid gap-3">
    <h3 class="text-2xl font-semibold text-ink">
      Your first month is on us
    </h3>
    <p class="text-sm text-muted">
      Invite the whole team and keep every project in sync from day one.
    </p>
    <div class="flex gap-2">
      <Button>Start free trial</Button>
      <Button variant="ghost">Talk to sales</Button>
    </div>
  </div>
</BackgroundLines>
