{
  "name": "markasui-monorepo",
  "private": true,
  "description": "Tailwind CSS v4 UI components for Laravel Blade, React, Vue, Svelte, Astro, and Angular.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "playground": "pnpm blade:playground && pnpm astro:playground && vite playground",
    "blade:playground": "php scripts/render-blade.php examples/blade playground/public/blade && node scripts/render-templates.ts playground/public/templates",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check . && composer lint",
    "format": "prettier --write . && composer format",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && svelte-check --tsconfig tsconfig.svelte.json --fail-on-warnings && ngc -p tsconfig.angular.spec.json && pnpm --filter @markasui/docs exec astro check",
    "registry": "node packages/registry/src/build.ts",
    "dev": "pnpm --filter @markasui/docs dev",
    "build": "pnpm --filter @markasui/docs build",
    "test:docs": "playwright test -c playwright.docs.config.ts",
    "test:livewire": "node tests/livewire/run.ts",
    "size": "node scripts/check-budget.ts",
    "thumbs": "node scripts/thumbnails.ts",
    "og": "node scripts/og-images.ts",
    "build:packages": "pnpm --filter markasui build && pnpm --filter @markasui/mcp build",
    "astro:playground": "node scripts/render-astro.ts playground/public/astro",
    "deploy:site": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.7",
    "@angular/build": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "alpinejs": "3.17.5",
    "astro": "7.4.5",
    "cookie": "2.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "lottie-web": "5.13.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}
