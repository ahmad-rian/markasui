{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowImportingTsExtensions": true,
    "customConditions": [
      "source"
    ]
  },
  "include": [
    "components",
    "playground",
    "tests",
    "packages/*/src",
    "packages/*/test",
    "*.config.ts",
    "env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "playground/public"
  ]
}
