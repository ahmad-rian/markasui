---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import LanguageOverlay from "../components/LanguageOverlay.astro";
import { LOCALES, getLocale, localePath, pagePath, stripLocale, t } from "../lib/i18n";
import { SITE } from "../lib/site";
import sansFont from "../../node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /** Tampilkan splash di landing (sekali per sesi). */
  splash?: boolean;
  /** Header dan footer versi landing: bilah di dalam bingkai hero dan footer berbingkai. */
  hero?: boolean;
  /**
   * URL stylesheet halaman (dari src/generated/css/ lewat ?url). Tanpa ini, halaman mengimpor sendiri
   * styles/global.css atau entry CSS lain: Base sengaja tidak mengimpor CSS supaya setiap halaman hanya
   * memuat class yang ia tampilkan.
   */
  stylesheet?: string;
}

const locale = getLocale(Astro.url);
const strings = t(locale);
const { title, description = strings.meta.description, splash = false, hero = false, stylesheet } = Astro.props;
const fullTitle = title ? `${title} - ${SITE.name}` : strings.meta.title;
const canonical = new URL(pagePath(Astro.url), Astro.site);
const path = stripLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} data-framework="blade" class={hero ? "dark" : undefined} data-landing={hero ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {stylesheet && <link rel="stylesheet" href={stylesheet} />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((code) => <link rel="alternate" hreflang={code} href={new URL(localePath(code, path), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={localePath(locale, "/llms.txt")} title="llms.txt" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "id" ? "id_ID" : "en_US"} />
    <meta name="theme-color" content={hero ? "#151915" : "#ffffff"} />
    <script is:inline>
      // Tema dan framework dipasang sebelum render pertama, dan dipasang ulang setiap navigasi
      // karena ClientRouter menyalin atribut <html> dari halaman baru. Tanpa pilihan tersimpan,
      // landing (data-landing) gelap dan halaman lain terang; pilihan lewat toggle berlaku di semua halaman.
      // Saat navigasi, halaman tujuan (newDocument) yang menentukan, jadi tidak ada kilatan tema.
      (() => {
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const apply = (root) => {
          const framework = read("markas-framework");
          if (framework === "blade" || framework === "react" || framework === "vue") root.dataset.framework = framework;
          const theme = read("markas-theme");
          root.classList.toggle("dark", theme ? theme === "dark" : root.hasAttribute("data-landing"));
        };
        apply(document.documentElement);
        document.addEventListener("astro:before-swap", (event) => apply(event.newDocument.documentElement));
      })();
    </script>
    {
      splash && (
        <script is:inline>
  // Dijalankan sebelum render: tandai <html> agar splash langsung menutupi halaman.
  (() => {
    const KEY = "markas-splash";
    let seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === "1";
      sessionStorage.setItem(KEY, "1");
    } catch {}
    if (seen || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const root = document.documentElement;
    root.dataset.splash = "";
    setTimeout(() => {
      root.dataset.splash = "leaving";
      setTimeout(() => delete root.dataset.splash, 450);
    }, 1500);
  })();
</script>
      )
    }
    <ClientRouter fallback="swap" />
  </head>
  <body class="flex min-h-dvh flex-col bg-surface font-sans text-ink">
    <a
      href="#konten"
      class="sr-only rounded-lg bg-brand px-3 py-2 text-sm text-on-brand focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
      >{strings.header.skip}</a
    >
    <Header variant={hero ? "hero" : "default"} />
    <div class="flex-1"><slot /></div>
    <Footer variant={hero ? "landing" : "default"} />
    <LanguageOverlay />
    <script>
      // Satu bundle untuk semua skrip situs: lebih sedikit request saat halaman dimuat.
      // preview dulu: HTML asli preview disimpan sebelum Alpine mengubah DOM.
      import "../scripts/preview";
      import "../scripts/alpine";
      import "../scripts/code";
      import "../scripts/tabs";
      import "../scripts/framework-switcher";
      import "../scripts/toc";
      import "../scripts/sidebar";
      import "../scripts/header";
      import "../scripts/language-overlay";
      import "../scripts/copy-page";
      import "../scripts/search";
    </script>
  </body>
</html>
