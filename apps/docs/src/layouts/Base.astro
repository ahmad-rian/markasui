---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { LOCALES, getLocale, localePath, pagePath, stripLocale, t } from "../lib/i18n";
import { SITE } from "../lib/site";
import sansFont from "../../node_modules/@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.url);
const strings = t(locale);
const { title, description = strings.meta.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : strings.meta.title;
const canonical = new URL(pagePath(Astro.url), Astro.site);
const path = stripLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} data-framework="blade">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((code) => <link rel="alternate" hreflang={code} href={new URL(localePath(code, path), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={localePath(locale, "/llms.txt")} title="llms.txt" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "id" ? "id_ID" : "en_US"} />
    <meta name="theme-color" content="#f4f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e110e" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Tema dan framework dipasang sebelum render pertama, dan dipasang ulang setiap navigasi
      // karena ClientRouter menyalin atribut <html> dari halaman baru.
      (() => {
        const read = (key) => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const apply = (root) => {
          const framework = read("markas-framework");
          if (framework === "blade" || framework === "react" || framework === "vue") root.dataset.framework = framework;
          const theme = read("markas-theme");
          root.classList.toggle("dark", theme ? theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches);
        };
        apply(document.documentElement);
        document.addEventListener("astro:before-swap", (event) => apply(event.newDocument.documentElement));
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas font-sans text-ink">
    <a
      href="#konten"
      class="sr-only rounded-lg bg-primary px-3 py-2 text-sm text-on-primary focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
      >{strings.header.skip}</a
    >
    <Header />
    <div class="flex-1"><slot /></div>
    <Footer />
    <script>
      import "../scripts/alpine";
    </script>
  </body>
</html>
