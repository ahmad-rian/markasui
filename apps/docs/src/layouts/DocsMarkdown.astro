---
import type { MarkdownHeading } from "astro";
import Docs from "./Docs.astro";

interface Props {
  frontmatter: { title: string; description: string };
  headings: MarkdownHeading[];
}
const { frontmatter, headings } = Astro.props;
---

<Docs title={frontmatter.title} description={frontmatter.description} headings={headings}>
  <h1 class="text-[32px] leading-tight font-medium tracking-[-0.02em] sm:text-4xl">{frontmatter.title}</h1>
  <p class="mt-3 max-w-2xl text-lg leading-7 text-muted">{frontmatter.description}</p>
  <div class="prose mt-10"><slot /></div>
</Docs>
