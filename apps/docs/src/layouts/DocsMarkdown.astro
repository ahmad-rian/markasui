---
import type { MarkdownHeading } from "astro";
import Docs from "./Docs.astro";

interface Props {
  frontmatter: { title: string; description: string };
  headings: MarkdownHeading[];
}
const { frontmatter, headings } = Astro.props;
---

<Docs title={frontmatter.title} description={frontmatter.description} headings={headings}>
  <p class="label-mono mb-3">Docs</p>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{frontmatter.title}</h1>
  <p class="mt-3 text-lg text-muted">{frontmatter.description}</p>
  <div class="prose mt-10"><slot /></div>
</Docs>
