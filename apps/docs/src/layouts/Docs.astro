---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import SidebarNav from "../components/SidebarNav.astro";
import Toc from "../components/Toc.astro";
import { getLocale, t } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}
const { title, description, headings = [] } = Astro.props;
---

<Base title={title} description={description}>
  <div class="mx-auto flex max-w-screen-2xl gap-10 px-4 sm:px-6 lg:px-8 xl:gap-12">
    <aside class="sticky top-16 hidden h-[calc(100dvh-4rem)] w-60 shrink-0 overflow-y-auto py-8 pr-2 lg:block" aria-label={t(getLocale(Astro.url)).sidebar.label}>
      <SidebarNav />
    </aside>

    <main id="konten" class="min-w-0 flex-1 pt-8 pb-16 sm:pt-12" data-pagefind-body>
      <div class="mx-auto max-w-3xl min-w-0">
        <slot />
      </div>
    </main>

    <aside class="hidden w-52 shrink-0 py-12 xl:block">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>
