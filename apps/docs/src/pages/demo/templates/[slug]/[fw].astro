---
import "../../../../styles/global.css";
import TemplateReact from "../../../../components/templates/TemplateReact";
import TemplateVue from "../../../../components/templates/TemplateVue.vue";
import { accentCss } from "../../../../lib/accents";
import { getTemplates } from "../../../../lib/templates";

/** Halaman demo layar penuh tanpa chrome situs, dipakai iframe di halaman detail template. */
export function getStaticPaths() {
  return getTemplates().flatMap((template) =>
    (["blade", "react", "vue"] as const).map((fw) => ({ params: { slug: template.name, fw }, props: { template } })),
  );
}

const { template } = Astro.props;
const { fw } = Astro.params;
const bladeFiles = import.meta.glob<string>("../../../../generated/templates/*.html", { query: "?raw", import: "default", eager: true });
const bladeHtml = bladeFiles[`../../../../generated/templates/${template.name}.html`] ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{template.title} - MarkasUI</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const theme = new URLSearchParams(location.search).get("theme") ?? localStorage.getItem("markas-theme");
        document.documentElement.classList.toggle("dark", theme ? theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches);
        const accent = new URLSearchParams(location.search).get("accent");
        if (accent) document.documentElement.dataset.accent = accent;
      } catch {}
      // Halaman detail template mengirim warna aksen dan tema tanpa memuat ulang iframe.
      addEventListener("message", (event) => {
        if (event.origin !== location.origin || typeof event.data !== "object" || !event.data) return;
        const root = document.documentElement;
        if (event.data.type === "markas:accent" && typeof event.data.accent === "string") root.dataset.accent = event.data.accent;
        if (event.data.type === "markas:theme") root.classList.toggle("dark", event.data.theme === "dark");
      });
    </script>
    <style set:html={accentCss()}></style>
  </head>
  <body class="min-h-dvh bg-canvas font-sans text-ink">
    {fw === "blade" && <Fragment set:html={bladeHtml} />}
    {fw === "react" && <TemplateReact client:load name={template.name} />}
    {fw === "vue" && <TemplateVue client:load name={template.name} />}
    {
      fw === "blade" && (
        <script>
          import Alpine from "alpinejs";
          Alpine.start();
        </script>
      )
    }
  </body>
</html>
