---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import TemplateReact from "../../../../components/templates/TemplateReact";
import TemplateSvelte from "../../../../components/templates/TemplateSvelte.svelte";
import TemplateVue from "../../../../components/templates/TemplateVue.vue";
import { accentCss } from "../../../../lib/accents";
import { getTemplates } from "../../../../lib/templates";

/**
 * Halaman demo layar penuh tanpa chrome situs, dipakai iframe di halaman detail template. Satu halaman
 * per versi yang ada (template.frameworks): Svelte hydrate sebagai island, Astro dirender langsung,
 * Angular dipasang di klien dari /angular/preview.js (scripts/angular-previews.ts).
 */
export function getStaticPaths() {
  return getTemplates().flatMap((template) => template.frameworks.map((fw) => ({ params: { slug: template.name, fw }, props: { template } })));
}

const { template } = Astro.props;
const { fw } = Astro.params;
const bladeFiles = import.meta.glob<string>("../../../../generated/templates/*.html", { query: "?raw", import: "default", eager: true });
const bladeHtml = bladeFiles[`../../../../generated/templates/${template.name}.html`] ?? "";
const astroTemplates = import.meta.glob<{ default: AstroComponentFactory }>("../../../../../../../templates/*/astro/*.astro", { eager: true });
const AstroTemplate = Object.entries(astroTemplates).find(([path]) => path.includes(`/templates/${template.name}/astro/`))?.[1].default;
/** CSS per template dari scripts/page-css.ts: token, font, template ini, dan komponen yang dipakainya. */
const stylesheets = import.meta.glob<string>("../../../../generated/css/templates/*.css", { query: "?url", import: "default", eager: true });
const stylesheet = stylesheets[`../../../../generated/css/templates/${template.name}.css`];
if (!stylesheet) throw new Error(`CSS untuk template ${template.name} belum dibangkitkan (node scripts/page-css.ts)`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{template.title} - MarkasUI</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={stylesheet} />
    <script is:inline>
      try {
        const theme = new URLSearchParams(location.search).get("theme") ?? localStorage.getItem("markas-theme");
        document.documentElement.classList.toggle("dark", theme ? theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches);
        const accent = new URLSearchParams(location.search).get("accent");
        if (accent) document.documentElement.dataset.accent = accent;
      } catch {}
      // Halaman detail template mengirim warna aksen dan tema tanpa memuat ulang iframe.
      addEventListener("message", (event) => {
        if (event.origin !== location.origin || typeof event.data !== "object" || !event.data) return;
        const root = document.documentElement;
        if (event.data.type === "markas:accent" && typeof event.data.accent === "string") root.dataset.accent = event.data.accent;
        if (event.data.type === "markas:theme") root.classList.toggle("dark", event.data.theme === "dark");
      });
    </script>
    <style set:html={accentCss()}></style>
  </head>
  <body class="min-h-dvh bg-canvas font-sans text-ink">
    {fw === "blade" && <Fragment set:html={bladeHtml} />}
    {fw === "react" && <TemplateReact client:load name={template.name} />}
    {fw === "vue" && <TemplateVue client:load name={template.name} />}
    {fw === "svelte" && <TemplateSvelte client:load name={template.name} />}
    {fw === "astro" && AstroTemplate && <AstroTemplate />}
    {fw === "angular" && <div class="contents" data-angular-template={template.name} />}
    {
      fw === "blade" && (
        <script>
          import Alpine from "alpinejs";
          // Template Blade dengan Lottie memanggil window.loadLottie; lottie-web hanya diunduh saat dipakai.
          Object.assign(window, { loadLottie: () => import("lottie-web/build/player/lottie_light").then((m) => m.default) });
          Alpine.start();
        </script>
      )
    }
    {
      fw === "angular" && (
        <script>
          type Bundle = { mountTemplate: (host: HTMLElement, slug: string) => Promise<boolean> };
          // Bundle AOT dari scripts/angular-previews.ts; runtime Angular hanya dimuat di halaman ini.
          const bundle = "/angular/preview.js";
          const host = document.querySelector<HTMLElement>("[data-angular-template]");
          if (host) {
            const { mountTemplate } = (await import(/* @vite-ignore */ bundle)) as Bundle;
            await mountTemplate(host, host.dataset.angularTemplate!);
          }
        </script>
      )
    }
  </body>
</html>
