---
/**
 * /support: "Buy me a coffee", sized to fit one desktop screen. Own art direction (src/styles/support.css): green
 * hand-drawn line art on cream, a poster headline with one serif italic word, outlined menu cards. Above the fold a
 * compact poster sits beside the order card (on phones the order card follows the headline); below it a slim
 * sticker strip, the latest supporters and a short FAQ. The form posts to /api/donate (deploy/donate/server.mjs),
 * which creates a Sumopod QRIS payment and returns its checkout URL; src/scripts/support.ts then navigates there,
 * keeps the summary line in sync and fills the supporters list from /api/donate/supporters.
 */
import "../../../styles/global.css";
import "../../../styles/support.css";
import { FRAMEWORKS } from "@markasui/registry/schema";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Icon from "../../../components/Icon.astro";
import SupportArt, { type ArtName } from "../../../components/support/SupportArt.astro";
import Base from "../../../layouts/Base.astro";
import { localeParams, toLocale } from "../../../lib/i18n";
import { getComponents } from "../../../lib/registry";
import { breadcrumbTrail } from "../../../lib/seo";
import { SITE } from "../../../lib/site";
import {
  SUPPORTERS_ENDPOINT,
  SUPPORT_DEFAULT_AMOUNT,
  SUPPORT_MAX,
  SUPPORT_MESSAGE_MAX,
  SUPPORT_MIN,
  SUPPORT_NAME_MAX,
  SUPPORT_PATH,
  SUPPORT_PRESETS,
  formatRupiah,
  supportStrings,
} from "../../../lib/support";
import { getTemplates } from "../../../lib/templates";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const copy = supportStrings(locale);
const breadcrumbs = [{ name: copy.title, path: SUPPORT_PATH }];

const stats = [
  { value: (await getComponents()).length, label: copy.stats.components },
  { value: getTemplates().length, label: copy.stats.templates },
  { value: FRAMEWORKS.length, label: copy.stats.frameworks },
];

/** Line drawing per preset, same order as SUPPORT_PRESETS. */
const TIER_ART: ArtName[] = ["cup", "cups", "croissant", "team"];
const tiers = SUPPORT_PRESETS.map((amount, index) => ({
  amount,
  art: TIER_ART[index]!,
  ...copy.tiers[index]!,
}));
const defaultTier = tiers.find((tier) => tier.amount === SUPPORT_DEFAULT_AMOUNT)!;
const fill = (template: string, values: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "");
const initialSummary = fill(copy.summaryPreset, {
  what: defaultTier.phrase,
  amount: `Rp ${formatRupiah(defaultTier.amount)}`,
});

const BREWERS: ArtName[] = ["moka", "press", "pourover"];
const STICKERS: (ArtName | "word")[] = ["mug", "beans", "sparkle", "takeaway", "word", "croissantSticker", "dripper"];
/** Enough repeats to fill a wide screen; the strip clips the rest. */
const STRIP = [...STICKERS, ...STICKERS, ...STICKERS];
const stickerWord = locale === "id" ? "kopi" : "coffee";
const error = "text-sm text-danger";
---

<Base title={copy.seoTitle} description={copy.description} breadcrumbs={breadcrumbs}>
  <main id="konten" class="sp" data-pagefind-body>
    <div class="mx-auto max-w-6xl px-4 pt-5 sm:px-6 lg:px-8">
      <Breadcrumbs trail={breadcrumbTrail(locale, breadcrumbs)} />
    </div>

    <section
      id="order"
      aria-labelledby="support-title"
      class="sp-order mx-auto grid max-w-6xl scroll-mt-20 gap-6 px-4 pt-5 pb-12 sm:px-6 sm:pt-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:gap-y-6 lg:px-8 lg:pb-14"
    >
      <div class="lg:self-end">
        <div class="flex items-end gap-3 sm:gap-5">
          {BREWERS.map((name) => <SupportArt name={name} class="h-14 w-auto sm:h-20 lg:h-24" />)}
        </div>
        <h1 id="support-title" class="sp-title mt-4 sm:mt-6">
          {copy.hero.before} <span class="sp-accent-word">{copy.hero.accent}</span>{copy.hero.after && ` ${copy.hero.after}`}
        </h1>
        <p class="sp-lead mt-3 max-w-lg sm:mt-4">{copy.lead}</p>
      </div>

      <form
        data-support-form
        data-locale={locale}
        data-min={SUPPORT_MIN}
        data-max={SUPPORT_MAX}
        data-error-amount={copy.errors.amount}
        data-error-name={copy.errors.name}
        data-error-message={copy.errors.message}
        data-error-rate={copy.errors.rate}
        data-error-generic={copy.errors.generic}
        data-summary-preset={copy.summaryPreset}
        data-summary-custom={copy.summaryCustom}
        novalidate
        aria-labelledby="support-form-title"
        class="sp-slip grid content-start gap-4 p-4 sm:p-6 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center"
      >
        <h2 id="support-form-title" class="text-base leading-6 font-semibold">{copy.form}</h2>
        <fieldset class="grid gap-4">
          <legend class="sr-only">{copy.amount}</legend>
          <div role="group" aria-label={copy.presets} class="grid grid-cols-2 gap-2.5">
            {
              tiers.map((tier) => (
                <button
                  type="button"
                  data-preset={tier.amount}
                  data-phrase={tier.phrase}
                  aria-pressed={tier.amount === SUPPORT_DEFAULT_AMOUNT ? "true" : "false"}
                  class="sp-menu"
                >
                  <SupportArt name={tier.art} class="sp-menu-art" />
                  <span class="sp-menu-name">{tier.label}</span>
                  <span class="sp-tag">Rp {formatRupiah(tier.amount)}</span>
                </button>
              ))
            }
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="grid content-start gap-1.5">
              <label for="support-amount" class="sp-label">{copy.custom}</label>
              <div class="sp-field">
                <span class="font-semibold text-[var(--sp-muted)] select-none" aria-hidden="true">Rp</span>
                <input
                  id="support-amount"
                  name="amount"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  required
                  value={formatRupiah(SUPPORT_DEFAULT_AMOUNT)}
                  aria-describedby="support-amount-hint support-amount-error"
                  class="font-semibold tabular-nums"
                />
              </div>
              <p id="support-amount-hint" class="sp-hint">{copy.amountHint}</p>
              <p id="support-amount-error" class={error} data-field-error="amount" hidden></p>
            </div>
            <div class="grid content-start gap-1.5">
              <label for="support-name" class="sp-label">{copy.name}</label>
              <div class="sp-field">
                <input
                  id="support-name"
                  name="name"
                  type="text"
                  maxlength={SUPPORT_NAME_MAX}
                  autocomplete="nickname"
                  aria-describedby="support-name-hint support-name-error"
                />
              </div>
              <p id="support-name-hint" class="sp-hint">{copy.nameHint}</p>
              <p id="support-name-error" class={error} data-field-error="name" hidden></p>
            </div>
          </div>
        </fieldset>
        <div class="grid gap-1.5">
          <label for="support-message" class="sp-label">{copy.message}</label>
          <div class="sp-field">
            <textarea
              id="support-message"
              name="message"
              rows="2"
              maxlength={SUPPORT_MESSAGE_MAX}
              aria-describedby="support-message-hint support-message-error"></textarea>
          </div>
          <p id="support-message-hint" class="sp-hint">{copy.messageHint}</p>
          <p id="support-message-error" class={error} data-field-error="message" hidden></p>
        </div>
        <p data-support-summary aria-live="polite" class="border-t-2 border-dashed border-[var(--sp-rule)] pt-4 text-base leading-6 font-semibold text-pretty empty:hidden">
          {initialSummary}
        </p>
        <p data-support-error role="alert" class="rounded-xl bg-danger/10 px-3 py-2.5 text-sm text-danger empty:hidden"></p>
        <button type="submit" disabled data-support-submit class="sp-pill w-full">
          <Icon name="coffee" class="size-5" />
          <span data-label-idle>{copy.submit}</span>
          <span data-label-busy hidden>{copy.busy}</span>
        </button>
        <noscript>
          <p class="sp-hint">{copy.noscript}</p>
        </noscript>
      </form>

      <div class="grid content-start gap-3 lg:self-start">
        <p class="flex items-start gap-2.5 text-sm leading-6 text-[var(--sp-muted)]">
          <span class="sp-badge shrink-0 text-[var(--sp-ink)]">{copy.qrisBadge}</span>
          <span>{copy.trust}</span>
        </p>
        <ul class="sp-stats">
          {
            stats.map((stat) => (
              <li>
                <strong>{stat.value}</strong> {stat.label}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="sp-band" aria-hidden="true">
      {STRIP.map((name) => (name === "word" ? <span class="sp-sticker-word">{stickerWord}</span> : <SupportArt name={name} />))}
    </div>

    <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-12 pb-16 sm:px-6 sm:pt-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 lg:px-8 lg:pb-20">
      <section id="supporters" aria-labelledby="supporters-title" class="scroll-mt-20">
        <h2 id="supporters-title" class="sp-h2">{copy.supporters.title}</h2>
        <p class="sp-hint mt-2 max-w-xl">{copy.supporters.lead}</p>
        <div data-supporters data-endpoint={SUPPORTERS_ENDPOINT} data-locale={locale} data-anonymous={copy.supporters.anonymous} aria-busy="true" class="mt-5">
          <ul data-supporters-list class="grid gap-3 empty:hidden sm:grid-cols-2"></ul>
          <div data-supporters-empty hidden class="sp-sticker flex items-center gap-4 p-4">
            <SupportArt name="mug" class="size-10 shrink-0" />
            <p class="text-base leading-6">{copy.supporters.empty}</p>
          </div>
          <p data-supporters-error hidden class="sp-sticker p-4 text-base">{copy.supporters.error}</p>
        </div>
        <template data-supporter-template>
          <li class="sp-sticker flex flex-col p-4">
            <div class="flex items-center gap-3">
              <span data-initial class="sp-initial" aria-hidden="true"></span>
              <div class="min-w-0">
                <p data-name class="truncate text-[15px] leading-5 font-semibold"></p>
                <p class="text-sm leading-5 text-[var(--sp-muted)]"><time data-date></time></p>
              </div>
            </div>
            <p data-message class="mt-3 border-t-2 border-dashed border-[var(--sp-rule)] pt-3 text-[15px] leading-6 break-words"></p>
          </li>
        </template>
      </section>

      <section aria-labelledby="faq-title">
        <h2 id="faq-title" class="sp-h2">{copy.faq.title}</h2>
        <div class="sp-faq mt-5">
          {
            copy.faq.items.map((item) => (
              <details>
                <summary class="flex min-h-13 cursor-pointer list-none items-center justify-between gap-4 py-3 text-base leading-6 font-semibold">
                  {item.question}
                  <span class="sp-plus" aria-hidden="true" />
                </summary>
                <div class="pb-5">
                  <p class="sp-hint text-[15px]">{item.answer}</p>
                  {item.links && (
                    <p class="mt-4 flex flex-wrap gap-2.5">
                      {item.links.map((link) => (
                        <a href={`${SITE.repo}${link.repoPath}`} class="sp-pill sp-pill-outline min-h-11 px-5 text-[15px]">
                          {link.label}
                          <Icon name="external" class="size-4" />
                        </a>
                      ))}
                    </p>
                  )}
                </div>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Base>

<script>
  import "../../../scripts/support";
</script>
