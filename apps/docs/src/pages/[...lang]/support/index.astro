---
/**
 * /support: "Buy me a coffee". Own art direction (src/styles/support.css): green hand-drawn line art on cream, a
 * poster headline, a green doodle band and outlined menu cards. The form posts to /api/donate
 * (deploy/donate/server.mjs), which creates a Sumopod QRIS payment and returns its checkout URL;
 * src/scripts/support.ts then navigates there, keeps the summary line in sync and fills the supporters list from
 * /api/donate/supporters (paid donations only, name and message as typed).
 */
import "../../../styles/global.css";
import "../../../styles/support.css";
import { FRAMEWORKS } from "@markasui/registry/schema";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Icon from "../../../components/Icon.astro";
import SupportArt, { type ArtName } from "../../../components/support/SupportArt.astro";
import Base from "../../../layouts/Base.astro";
import { localeParams, toLocale } from "../../../lib/i18n";
import { getComponents } from "../../../lib/registry";
import { breadcrumbTrail } from "../../../lib/seo";
import { SITE } from "../../../lib/site";
import {
  SUPPORTERS_ENDPOINT,
  SUPPORT_DEFAULT_AMOUNT,
  SUPPORT_MAX,
  SUPPORT_MESSAGE_MAX,
  SUPPORT_MIN,
  SUPPORT_NAME_MAX,
  SUPPORT_PATH,
  SUPPORT_PRESETS,
  formatRupiah,
  supportStrings,
} from "../../../lib/support";
import { getTemplates } from "../../../lib/templates";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const copy = supportStrings(locale);
const breadcrumbs = [{ name: copy.title, path: SUPPORT_PATH }];

const stats = [
  { value: (await getComponents()).length, label: copy.stats.components },
  { value: getTemplates().length, label: copy.stats.templates },
  { value: FRAMEWORKS.length, label: copy.stats.frameworks },
];

/** Line drawing per preset, same order as SUPPORT_PRESETS. */
const TIER_ART: ArtName[] = ["cup", "cups", "croissant", "team"];
const tiers = SUPPORT_PRESETS.map((amount, index) => ({
  amount,
  art: TIER_ART[index]!,
  ...copy.tiers[index]!,
}));
const defaultTier = tiers.find((tier) => tier.amount === SUPPORT_DEFAULT_AMOUNT)!;
const fill = (template: string, values: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "");
const initialSummary = fill(copy.summaryPreset, {
  what: defaultTier.phrase,
  amount: `Rp ${formatRupiah(defaultTier.amount)}`,
});

const BREWERS: ArtName[] = ["moka", "press", "pourover"];
const STICKERS: (ArtName | "word")[] = [
  "mug",
  "beans",
  "sparkle",
  "takeaway",
  "word",
  "croissantSticker",
  "dripper",
  "beans",
  "sparkle",
  "mug",
  "word",
  "takeaway",
  "croissantSticker",
  "dripper",
];
const stickerWord = locale === "id" ? "kopi" : "coffee";
const error = "text-sm text-danger";
---

<Base title={copy.seoTitle} description={copy.description} breadcrumbs={breadcrumbs}>
  <main id="konten" class="sp" data-pagefind-body>
    <div class="mx-auto max-w-screen-xl px-4 pt-8 sm:px-6 sm:pt-10 lg:px-8">
      <Breadcrumbs trail={breadcrumbTrail(locale, breadcrumbs)} />
    </div>

    <section class="mx-auto max-w-screen-xl px-4 pt-10 pb-16 text-center sm:px-6 sm:pt-14 sm:pb-20 lg:px-8" aria-labelledby="support-title">
      <div class="mx-auto flex max-w-2xl items-end justify-center gap-4 sm:gap-10">
        {BREWERS.map((name) => <SupportArt name={name} class="h-auto w-[28%] max-w-40" />)}
      </div>
      <h1 id="support-title" class="sp-title mx-auto mt-8 max-w-5xl sm:mt-10">
        {copy.hero.before} <span class="sp-accent-word">{copy.hero.accent}</span>{copy.hero.after && ` ${copy.hero.after}`}
      </h1>
      <p class="sp-lead mx-auto mt-6 max-w-2xl">{copy.lead}</p>
      <a href="#order" class="sp-pill mt-8">
        {copy.heroCta}
        <Icon name="chevronDown" class="size-5" />
      </a>
    </section>

    <section class="sp-band py-8 sm:py-10">
      <div class="sp-stickers px-4" aria-hidden="true">
        {
          STICKERS.map((name) =>
            name === "word" ? <span class="sp-sticker-word">{stickerWord}</span> : <SupportArt name={name} />,
          )
        }
      </div>
      <div class="mx-auto max-w-screen-xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <ul class="grid grid-cols-3 gap-4 text-center">
          {
            stats.map((stat) => (
              <li class="grid justify-items-center gap-2">
                <span class="sp-stat">{stat.value}</span>
                <span class="sp-stat-label">{stat.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="mx-auto mt-8 max-w-2xl text-center text-base leading-7 text-pretty opacity-90">{copy.stats.caption}</p>
      </div>
      <div class="sp-stickers flex-row-reverse px-4" aria-hidden="true">
        {
          STICKERS.map((name) =>
            name === "word" ? <span class="sp-sticker-word">{stickerWord}</span> : <SupportArt name={name} />,
          )
        }
      </div>
    </section>

    <section id="order" class="mx-auto max-w-screen-xl scroll-mt-20 px-4 py-16 sm:px-6 sm:py-24 lg:px-8" aria-labelledby="support-form-title">
      <h2 id="support-form-title" class="sp-h2">{copy.form}</h2>
      <form
        data-support-form
        data-locale={locale}
        data-min={SUPPORT_MIN}
        data-max={SUPPORT_MAX}
        data-error-amount={copy.errors.amount}
        data-error-name={copy.errors.name}
        data-error-message={copy.errors.message}
        data-error-rate={copy.errors.rate}
        data-error-generic={copy.errors.generic}
        data-summary-preset={copy.summaryPreset}
        data-summary-custom={copy.summaryCustom}
        novalidate
        class="mt-8 grid gap-8 sm:mt-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-10"
      >
        <fieldset class="grid content-start gap-4">
          <legend class="sr-only">{copy.amount}</legend>
          <div role="group" aria-label={copy.presets} class="grid grid-cols-2 gap-3 sm:gap-4">
            {
              tiers.map((tier) => (
                <button
                  type="button"
                  data-preset={tier.amount}
                  data-phrase={tier.phrase}
                  aria-pressed={tier.amount === SUPPORT_DEFAULT_AMOUNT ? "true" : "false"}
                  class="sp-menu"
                >
                  <SupportArt name={tier.art} />
                  <span class="sp-menu-name">{tier.label}</span>
                  <span class="sp-tag">Rp {formatRupiah(tier.amount)}</span>
                </button>
              ))
            }
          </div>
          <div class="mt-2 grid gap-2">
            <label for="support-amount" class="sp-label">{copy.custom}</label>
            <div class="sp-field">
              <span class="font-semibold text-[var(--sp-muted)] select-none" aria-hidden="true">Rp</span>
              <input
                id="support-amount"
                name="amount"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                required
                value={formatRupiah(SUPPORT_DEFAULT_AMOUNT)}
                aria-describedby="support-amount-hint support-amount-error"
                class="font-semibold tabular-nums"
              />
            </div>
            <p id="support-amount-hint" class="sp-hint">{copy.amountHint}</p>
            <p id="support-amount-error" class={error} data-field-error="amount" hidden></p>
          </div>
        </fieldset>

        <div class="sp-slip grid content-start gap-5 self-start p-5 sm:p-7 lg:sticky lg:top-24">
          <div class="grid gap-2">
            <label for="support-name" class="sp-label">{copy.name}</label>
            <div class="sp-field">
              <input
                id="support-name"
                name="name"
                type="text"
                maxlength={SUPPORT_NAME_MAX}
                autocomplete="nickname"
                aria-describedby="support-name-hint support-name-error"
              />
            </div>
            <p id="support-name-hint" class="sp-hint">{copy.nameHint}</p>
            <p id="support-name-error" class={error} data-field-error="name" hidden></p>
          </div>
          <div class="grid gap-2">
            <label for="support-message" class="sp-label">{copy.message}</label>
            <div class="sp-field">
              <textarea
                id="support-message"
                name="message"
                rows="3"
                maxlength={SUPPORT_MESSAGE_MAX}
                aria-describedby="support-message-hint support-message-error"></textarea>
            </div>
            <p id="support-message-hint" class="sp-hint">{copy.messageHint}</p>
            <p id="support-message-error" class={error} data-field-error="message" hidden></p>
          </div>

          <hr class="sp-rule" />
          <p data-support-summary aria-live="polite" class="text-[17px] leading-7 font-semibold text-pretty empty:hidden">
            {initialSummary}
          </p>
          <p data-support-error role="alert" class="rounded-xl bg-danger/10 px-3 py-2.5 text-sm text-danger empty:hidden"></p>
          <button type="submit" disabled data-support-submit class="sp-pill w-full">
            <Icon name="coffee" class="size-5" />
            <span data-label-idle>{copy.submit}</span>
            <span data-label-busy hidden>{copy.busy}</span>
          </button>
          <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm leading-6 text-[var(--sp-muted)]">
            <span class="sp-badge text-[var(--sp-ink)]">{copy.qrisBadge}</span>
            {copy.trust}
          </p>
          <noscript>
            <p class="sp-hint">{copy.noscript}</p>
          </noscript>
        </div>
      </form>
    </section>

    <section class="mx-auto max-w-screen-xl px-4 pb-16 sm:px-6 sm:pb-24 lg:px-8" aria-labelledby="steps-title">
      <h2 id="steps-title" class="sp-h2">{copy.steps.title}</h2>
      <ol class="mt-8 grid gap-8 sm:mt-10 md:grid-cols-3 md:gap-10">
        {
          copy.steps.items.map((step, index) => (
            <li class="flex gap-4 border-t-2 border-[var(--sp-line)] pt-5">
              <span class="sp-step-number" aria-hidden="true">
                {index + 1}
              </span>
              <span class="text-base leading-7">{step}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="supporters" aria-labelledby="supporters-title" class="mx-auto max-w-screen-xl scroll-mt-20 px-4 pb-16 sm:px-6 sm:pb-24 lg:px-8">
      <h2 id="supporters-title" class="sp-h2">{copy.supporters.title}</h2>
      <p class="sp-lead mt-4 max-w-2xl text-base">{copy.supporters.lead}</p>
      <div data-supporters data-endpoint={SUPPORTERS_ENDPOINT} data-locale={locale} data-anonymous={copy.supporters.anonymous} aria-busy="true" class="mt-8 sm:mt-10">
        <ul data-supporters-list class="grid gap-4 empty:hidden sm:grid-cols-2 lg:grid-cols-3"></ul>
        <div data-supporters-empty hidden class="sp-sticker flex items-center gap-5 p-5 sm:p-6">
          <SupportArt name="mug" class="size-14 shrink-0" />
          <p class="text-base leading-7">{copy.supporters.empty}</p>
        </div>
        <p data-supporters-error hidden class="sp-sticker p-5 text-base">{copy.supporters.error}</p>
      </div>
      <template data-supporter-template>
        <li class="sp-sticker flex flex-col p-5">
          <div class="flex items-center gap-3">
            <span data-initial class="sp-initial" aria-hidden="true"></span>
            <div class="min-w-0">
              <p data-name class="truncate text-base leading-6 font-semibold"></p>
              <p class="text-sm leading-5 text-[var(--sp-muted)]"><time data-date></time></p>
            </div>
          </div>
          <p data-message class="mt-4 border-t-2 border-dashed border-[var(--sp-rule)] pt-4 text-base leading-7 break-words"></p>
        </li>
      </template>
    </section>

    <section aria-labelledby="faq-title" class="mx-auto grid max-w-screen-xl gap-8 px-4 pb-24 sm:px-6 sm:pb-32 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16 lg:px-8">
      <h2 id="faq-title" class="sp-h2">{copy.faq.title}</h2>
      <div class="sp-faq">
        {
          copy.faq.items.map((item) => (
            <details>
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 text-[17px] leading-6 font-semibold">
                {item.question}
                <span class="sp-plus" aria-hidden="true" />
              </summary>
              <div class="pb-6">
                <p class="sp-lead max-w-2xl text-base">{item.answer}</p>
                {item.links && (
                  <p class="mt-5 flex flex-wrap gap-3">
                    {item.links.map((link) => (
                      <a href={`${SITE.repo}${link.repoPath}`} class="sp-pill sp-pill-outline min-h-11 px-5 text-[15px]">
                        {link.label}
                        <Icon name="external" class="size-4" />
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<script>
  import "../../../scripts/support";
</script>
