---
/**
 * /support: "Buy me a coffee". The form posts to /api/donate (deploy/donate/server.mjs), which creates a Sumopod
 * QRIS payment and returns its checkout URL; src/scripts/support.ts then navigates there, keeps the summary line in
 * sync and fills the supporters list from /api/donate/supporters (paid donations only, name and message as typed).
 */
import "../../../styles/global.css";
import { FRAMEWORKS } from "@markasui/registry/schema";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CoffeeCup from "../../../components/CoffeeCup.astro";
import Icon from "../../../components/Icon.astro";
import Base from "../../../layouts/Base.astro";
import { localeParams, toLocale } from "../../../lib/i18n";
import { getComponents } from "../../../lib/registry";
import { breadcrumbTrail } from "../../../lib/seo";
import { SITE } from "../../../lib/site";
import {
  SUPPORTERS_ENDPOINT,
  SUPPORT_DEFAULT_AMOUNT,
  SUPPORT_MAX,
  SUPPORT_MESSAGE_MAX,
  SUPPORT_MIN,
  SUPPORT_NAME_MAX,
  SUPPORT_PATH,
  SUPPORT_PRESETS,
  SUPPORT_TIER_ICONS,
  formatRupiah,
  supportStrings,
} from "../../../lib/support";
import { getTemplates } from "../../../lib/templates";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const copy = supportStrings(locale);
const breadcrumbs = [{ name: copy.title, path: SUPPORT_PATH }];

const componentCount = (await getComponents()).length;
const templateCount = getTemplates().length;
const counts = { components: componentCount, templates: templateCount, frameworks: FRAMEWORKS.length };
const FUND_ICONS = ["layers", "grid", "book"] as const;
const funds = copy.funds.items.map((item, index) => ({
  icon: FUND_ICONS[index]!,
  title: item.title,
  stat: item.stat(counts),
}));

const tiers = SUPPORT_PRESETS.map((amount, index) => ({
  amount,
  icons: SUPPORT_TIER_ICONS[index]!,
  ...copy.tiers[index]!,
}));
const defaultTier = tiers.find((tier) => tier.amount === SUPPORT_DEFAULT_AMOUNT)!;
const fill = (template: string, values: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "");
const initialSummary = fill(copy.summaryPreset, {
  what: defaultTier.phrase,
  amount: `Rp ${formatRupiah(defaultTier.amount)}`,
});

const label = "text-sm font-medium text-ink";
const hint = "text-sm leading-6 text-muted";
const error = "text-sm text-danger";
const control =
  "flex h-12 w-full items-center gap-2 rounded-lg border border-line bg-surface px-3.5 text-base transition-colors duration-150 ease-out has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand has-[[aria-invalid=true]]:border-danger motion-reduce:transition-none";
const field = "h-full min-w-0 flex-1 bg-transparent text-ink outline-none placeholder:text-faint";
const textarea =
  "min-h-24 w-full rounded-lg border border-line bg-surface px-3.5 py-3 text-base text-ink transition-colors duration-150 ease-out outline-none placeholder:text-faint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand aria-[invalid=true]:border-danger motion-reduce:transition-none";
const tierCard =
  "group/tier flex min-h-30 flex-col items-start rounded-xl border border-line bg-surface p-3.5 text-left transition-[background-color,border-color,box-shadow,scale] duration-150 ease-out hover:border-brand-line hover:bg-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50 aria-pressed:border-brand aria-pressed:bg-brand-soft aria-pressed:shadow-[inset_0_0_0_1px_var(--color-brand)] motion-reduce:transition-none sm:p-4";
const section = "text-2xl leading-tight font-semibold tracking-[-0.02em] sm:text-[28px]";
---

<Base title={copy.seoTitle} description={copy.description} breadcrumbs={breadcrumbs}>
  <main id="konten" class="mx-auto max-w-screen-xl px-4 pt-8 pb-24 sm:px-6 sm:pt-12 lg:px-8" data-pagefind-body>
    <Breadcrumbs trail={breadcrumbTrail(locale, breadcrumbs)} />

    {/* Phones: intro, form, then the details. Desktop: intro and details on the left, the form beside them. */}
    <div class="mt-6 grid gap-10 lg:mt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:gap-y-0 xl:gap-x-24">
      <section class="min-w-0 lg:col-start-1 lg:row-start-1 lg:pt-2" aria-labelledby="support-title">
        <CoffeeCup class="size-24 rounded-[28px] p-2.5 sm:size-28" />
        <h1 id="support-title" class="mt-6 text-[34px] leading-[1.1] font-semibold tracking-[-0.03em] text-balance sm:text-5xl">
          {copy.title}
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-pretty text-muted">{copy.lead}</p>
      </section>


      <form
        data-support-form
        data-locale={locale}
        data-min={SUPPORT_MIN}
        data-max={SUPPORT_MAX}
        data-error-amount={copy.errors.amount}
        data-error-name={copy.errors.name}
        data-error-message={copy.errors.message}
        data-error-rate={copy.errors.rate}
        data-error-generic={copy.errors.generic}
        data-summary-preset={copy.summaryPreset}
        data-summary-custom={copy.summaryCustom}
        novalidate
        aria-labelledby="support-form-title"
        class="grid gap-6 self-start rounded-2xl border border-line bg-surface p-5 shadow-[0_24px_48px_-24px_rgb(0_0_0/0.18)] sm:p-7 lg:sticky lg:top-24 lg:col-start-2 lg:row-span-2 lg:row-start-1"
      >
        <h2 id="support-form-title" class="text-xl font-semibold tracking-[-0.01em]">{copy.form}</h2>

        <fieldset class="grid gap-3">
          <legend class:list={[label, "mb-3"]}>{copy.amount}</legend>
          <div role="group" aria-label={copy.presets} class="grid grid-cols-2 gap-2.5 sm:gap-3">
            {
              tiers.map((tier) => (
                <button
                  type="button"
                  data-preset={tier.amount}
                  data-phrase={tier.phrase}
                  aria-pressed={tier.amount === SUPPORT_DEFAULT_AMOUNT ? "true" : "false"}
                  class={tierCard}
                >
                  <span class="flex h-7 items-center gap-1" aria-hidden="true">
                    {tier.icons.map((icon) => (
                      <Icon name={icon === "cup" ? "coffee" : "bread"} class="size-6 text-muted group-aria-pressed/tier:text-brand" />
                    ))}
                  </span>
                  <span class="mt-auto pt-3 text-sm leading-5 font-medium text-ink">{tier.label}</span>
                  <span class="text-base leading-6 font-semibold tabular-nums">Rp {formatRupiah(tier.amount)}</span>
                </button>
              ))
            }
          </div>
          <label for="support-amount" class:list={[label, "mt-2"]}>{copy.custom}</label>
          <div class={control}>
            <span class="shrink-0 font-medium text-muted select-none" aria-hidden="true">Rp</span>
            <input
              id="support-amount"
              name="amount"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              required
              value={formatRupiah(SUPPORT_DEFAULT_AMOUNT)}
              aria-describedby="support-amount-hint support-amount-error"
              class:list={[field, "font-medium tabular-nums"]}
            />
          </div>
          <p id="support-amount-hint" class={hint}>{copy.amountHint}</p>
          <p id="support-amount-error" class={error} data-field-error="amount" hidden></p>
        </fieldset>

        <div class="grid gap-1.5">
          <label for="support-name" class={label}>{copy.name}</label>
          <div class={control}>
            <input
              id="support-name"
              name="name"
              type="text"
              maxlength={SUPPORT_NAME_MAX}
              autocomplete="nickname"
              aria-describedby="support-name-hint support-name-error"
              class={field}
            />
          </div>
          <p id="support-name-hint" class={hint}>{copy.nameHint}</p>
          <p id="support-name-error" class={error} data-field-error="name" hidden></p>
        </div>

        <div class="grid gap-1.5">
          <label for="support-message" class={label}>{copy.message}</label>
          <textarea
            id="support-message"
            name="message"
            rows="3"
            maxlength={SUPPORT_MESSAGE_MAX}
            aria-describedby="support-message-hint support-message-error"
            class={textarea}></textarea>
          <p id="support-message-hint" class={hint}>{copy.messageHint}</p>
          <p id="support-message-error" class={error} data-field-error="message" hidden></p>
        </div>

        <p data-support-summary aria-live="polite" class="flex items-center gap-2.5 rounded-lg bg-subtle px-4 py-3 text-[15px] leading-6 font-medium empty:hidden">
          {initialSummary}
        </p>

        <p data-support-error role="alert" class="rounded-md bg-danger/10 px-3 py-2.5 text-sm text-danger empty:hidden"></p>

        <div class="grid gap-4">
          <button
            type="submit"
            disabled
            data-support-submit
            class="site-button-primary h-12 w-full text-base disabled:cursor-not-allowed disabled:opacity-60"
          >
            <Icon name="coffee" class="size-5" />
            <span data-label-idle>{copy.submit}</span>
            <span data-label-busy hidden>{copy.busy}</span>
          </button>
          <div class="text-sm leading-6 text-muted">
            <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
              <span class="inline-flex h-6 shrink-0 items-center rounded-md border border-line px-1.5 text-xs font-semibold tracking-wide text-ink">
                {copy.qrisBadge}
              </span>
              <span class="flex items-center gap-1.5">
                <Icon name="shield" class="size-4 shrink-0 text-brand" />
                {copy.trust}
              </span>
            </p>
          </div>
        </div>
        <noscript>
          <p class="text-sm text-muted">{copy.noscript}</p>
        </noscript>
      </form>

      <div class="min-w-0 lg:col-start-1 lg:row-start-2">
        <h2 class="text-base font-semibold lg:mt-12">{copy.funds.title}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-3 lg:max-w-xl lg:grid-cols-1">
          {
            funds.map((item) => (
              <li class="flex gap-3.5 rounded-xl border border-line bg-surface p-4">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-soft text-brand" aria-hidden="true">
                  <Icon name={item.icon} class="size-5" />
                </span>
                <span class="grid gap-0.5">
                  <span class="text-[15px] leading-6 font-medium">{item.title}</span>
                  <span class="text-sm leading-5 text-muted">{item.stat}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-10 text-base font-semibold">{copy.steps.title}</h2>
        <ol class="mt-4 grid gap-4 lg:max-w-xl">
          {
            copy.steps.items.map((step, index) => (
              <li class="flex gap-3.5">
                <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-line text-sm font-semibold tabular-nums">
                  {index + 1}
                </span>
                <span class="pt-0.5 text-[15px] leading-6 text-muted">{step}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <section id="supporters" aria-labelledby="supporters-title" class="mt-20 scroll-mt-24 sm:mt-28">
      <h2 id="supporters-title" class={section}>{copy.supporters.title}</h2>
      <p class="mt-3 max-w-2xl text-base leading-7 text-muted">{copy.supporters.lead}</p>
      <div data-supporters data-endpoint={SUPPORTERS_ENDPOINT} data-locale={locale} data-anonymous={copy.supporters.anonymous} aria-busy="true" class="mt-8">
        <ul data-supporters-list class="grid gap-3 empty:hidden sm:grid-cols-2 lg:grid-cols-3"></ul>
        <div data-supporters-empty hidden class="flex items-center gap-4 rounded-xl border border-dashed border-line p-5 sm:p-6">
          <CoffeeCup class="size-14 rounded-2xl p-1.5" />
          <p class="text-base leading-7 text-muted">{copy.supporters.empty}</p>
        </div>
        <p data-supporters-error hidden class="rounded-xl border border-line p-5 text-base text-muted">{copy.supporters.error}</p>
      </div>
      <template data-supporter-template>
        <li class="flex flex-col rounded-xl border border-line bg-surface p-4 sm:p-5">
          <div class="flex items-center gap-3">
            <span data-initial class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-soft text-sm font-semibold text-brand" aria-hidden="true"></span>
            <div class="min-w-0">
              <p data-name class="truncate text-[15px] leading-6 font-medium"></p>
              <p class="text-xs leading-5 text-muted"><time data-date></time></p>
            </div>
          </div>
          <p data-message class="mt-3 text-[15px] leading-6 break-words text-ink"></p>
        </li>
      </template>
    </section>

    <section aria-labelledby="faq-title" class="mt-20 grid gap-6 sm:mt-28 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
      <h2 id="faq-title" class={section}>{copy.faq.title}</h2>
      <div class="divide-y divide-line border-y border-line">
        {
          copy.faq.items.map((item) => (
            <details class="group py-1">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 text-base font-medium [&::-webkit-details-marker]:hidden">
                {item.question}
                <Icon name="chevronDown" class="size-5 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none" />
              </summary>
              <div class="pb-5">
                <p class="max-w-2xl text-base leading-7 text-muted">{item.answer}</p>
                {item.links && (
                  <p class="mt-4 flex flex-wrap gap-3">
                    {item.links.map((link) => (
                      <a href={`${SITE.repo}${link.repoPath}`} class="site-button-secondary">
                        {link.label}
                        <Icon name="external" class="size-4" />
                      </a>
                    ))}
                  </p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<script>
  import "../../../scripts/support";
</script>
