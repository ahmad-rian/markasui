---
/**
 * /support/thanks: Sumopod's success return URL (?order=KOPI-...). The query string proves nothing, so the page asks
 * /api/donate/status a few times and only says "received" once the webhook has confirmed the payment.
 */
import "../../../styles/global.css";
import Icon from "../../../components/Icon.astro";
import Base from "../../../layouts/Base.astro";
import { localeParams, localePath, toLocale } from "../../../lib/i18n";
import { SUPPORT_PATH, supportStrings } from "../../../lib/support";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const copy = supportStrings(locale).thanks;
const states = [
  { state: "checking", text: copy.checking, icon: "reload" },
  { state: "received", text: copy.received, icon: "check" },
  { state: "waiting", text: copy.waiting, icon: "coffee" },
  { state: "failed", text: copy.failed, icon: "close" },
] as const;
---

<Base title={copy.seoTitle} description={copy.waiting} noindex>
  <main id="konten" class="mx-auto flex min-h-[calc(100dvh-12rem)] max-w-xl flex-col justify-center px-4 py-20 sm:px-6">
    <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-soft text-brand" aria-hidden="true">
      <Icon name="coffee" class="size-6" />
    </span>
    <h1 class="mt-5 text-[34px] leading-tight font-semibold tracking-[-0.025em]">{copy.title}</h1>
    <div data-support-status="waiting" role="status" class="mt-4">
      {
        states.map(({ state, text, icon }) => (
          <p data-state={state} hidden={state !== "waiting"} class="flex gap-3 text-lg leading-8 text-muted [&[hidden]]:hidden">
            <Icon name={icon} class:list={["mt-1.5 size-5 shrink-0", state === "received" ? "text-brand" : "text-muted"]} />
            <span>{text}</span>
          </p>
        ))
      }
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localePath(locale, "/")} class="site-button-primary">{copy.home}</a>
      <a href={localePath(locale, SUPPORT_PATH)} data-support-again hidden class="site-button-secondary [&[hidden]]:hidden">{copy.again}</a>
    </div>
  </main>
</Base>

<script>
  import "../../../scripts/support";
</script>
