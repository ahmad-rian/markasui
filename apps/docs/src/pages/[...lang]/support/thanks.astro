---
/**
 * /support/thanks: Sumopod's success return URL (?order=KOPI-...). The query string proves nothing, so the page asks
 * /api/donate/status a few times and only says "received" once the webhook has confirmed the payment.
 */
import "../../../styles/global.css";
import "../../../styles/support.css";
import Icon from "../../../components/Icon.astro";
import SupportArt from "../../../components/support/SupportArt.astro";
import Base from "../../../layouts/Base.astro";
import { localeParams, localePath, toLocale } from "../../../lib/i18n";
import { SUPPORT_PATH, supportStrings } from "../../../lib/support";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const copy = supportStrings(locale).thanks;
const states = [
  { state: "checking", text: copy.checking, icon: "reload" },
  { state: "received", text: copy.received, icon: "check" },
  { state: "waiting", text: copy.waiting, icon: "coffee" },
  { state: "failed", text: copy.failed, icon: "close" },
] as const;
---

<Base title={copy.seoTitle} description={copy.waiting} noindex>
  <main id="konten" class="sp flex min-h-[calc(100dvh-12rem)] items-center justify-center px-4 py-16 sm:px-6 sm:py-24">
    <div class="w-full max-w-2xl text-center">
      <SupportArt name="thanks" class="mx-auto h-auto w-56 sm:w-72" />
      <h1 class="sp-accent-word mt-6 text-6xl leading-none sm:text-8xl">{copy.title}</h1>
      <div data-support-status="waiting" role="status" class="mx-auto mt-6 max-w-xl">
        {
          states.map(({ state, text, icon }) => (
            <p data-state={state} hidden={state !== "waiting"} class="text-lg leading-8 text-pretty [&[hidden]]:hidden">
              <Icon name={icon} class:list={["mr-1.5 inline size-5 align-[-3px]", state === "received" ? "text-brand" : "text-[var(--sp-muted)]"]} />
              <span>{text}</span>
            </p>
          ))
        }
      </div>
      <p class="sp-lead mx-auto mt-3 max-w-xl text-base">{copy.lead}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localePath(locale, "/")} class="sp-pill">{copy.home}</a>
        <a href={`${localePath(locale, SUPPORT_PATH)}#supporters`} class="sp-pill sp-pill-outline">{copy.supporters}</a>
        <a href={localePath(locale, SUPPORT_PATH)} data-support-again hidden class="sp-pill sp-pill-outline [&[hidden]]:hidden">{copy.again}</a>
      </div>
    </div>
  </main>
</Base>

<script>
  import "../../../scripts/support";
</script>
