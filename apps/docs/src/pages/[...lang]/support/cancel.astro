---
/** /support/cancel: Sumopod's cancel return URL. Nothing to check, the donor can start again. */
import "../../../styles/global.css";
import CoffeeCup from "../../../components/CoffeeCup.astro";
import Icon from "../../../components/Icon.astro";
import Base from "../../../layouts/Base.astro";
import { localeParams, localePath, toLocale } from "../../../lib/i18n";
import { SITE } from "../../../lib/site";
import { SUPPORT_PATH, supportStrings } from "../../../lib/support";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const copy = supportStrings(locale).cancel;
---

<Base title={copy.seoTitle} description={copy.text} noindex>
  <main id="konten" class="flex min-h-[calc(100dvh-12rem)] items-center justify-center px-4 py-16 sm:px-6 sm:py-24">
    <div class="w-full max-w-xl rounded-2xl border border-line bg-surface p-6 text-center shadow-[0_24px_48px_-24px_rgb(0_0_0/0.18)] sm:p-10">
      <CoffeeCup class="mx-auto size-24 rounded-[28px] p-2.5 sm:size-28" />
      <h1 class="mt-6 text-[34px] leading-tight font-semibold tracking-[-0.03em] sm:text-[40px]">{copy.title}</h1>
      <p class="mt-4 text-lg leading-8 text-pretty text-muted">{copy.text}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localePath(locale, SUPPORT_PATH)} class="site-button-primary h-12 px-5 text-base">
          <Icon name="coffee" class="size-5" />
          {copy.again}
        </a>
        <a href={localePath(locale, "/")} class="site-button-secondary h-12 px-5 text-base">{copy.home}</a>
      </div>
      <p class="mt-8 border-t border-line pt-6 text-sm text-muted">
        <a href={SITE.repo} class="inline-flex items-center gap-1.5 underline decoration-line underline-offset-4 hover:text-ink">
          {copy.other}
          <Icon name="external" class="size-3.5" />
        </a>
      </p>
    </div>
  </main>
</Base>

<script>
  import "../../../scripts/support";
</script>
