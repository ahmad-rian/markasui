---
import "../../../styles/global.css";
import { render } from "astro:content";
import CopyPage from "../../../components/CopyPage.astro";
import Icon from "../../../components/Icon.astro";
import Docs from "../../../layouts/Docs.astro";
import { getDocs } from "../../../lib/docs";
import { LOCALES, localePath, t, toLocale } from "../../../lib/i18n";
import { techArticle } from "../../../lib/seo";
import { gitModified, ogImagePath } from "../../../lib/seo-files";

export async function getStaticPaths() {
  const pages = await Promise.all(
    LOCALES.map(async (locale) => {
      const docs = await getDocs(locale);
      return docs.map(({ slug, entry }, index) => ({
        params: { lang: locale === "en" ? undefined : locale, slug },
        props: { entry, prev: docs[index - 1], next: docs[index + 1] },
      }));
    }),
  );
  return pages.flat();
}

const { entry, prev, next } = Astro.props;
const locale = toLocale(Astro.params.lang);
const strings = t(locale).component;
const slug = entry.id.split("/").at(-1)!;
const { Content, headings } = await render(entry);
const markdown = `# ${entry.data.title}\n\n${entry.data.description}\n\n${entry.body ?? ""}`;
const pager = "icon-button size-9 bg-subtle text-ink hover:bg-line";

const path = `/docs/${slug}`;
const seoTitle = entry.data.seoTitle ?? entry.data.title;
const seoDescription = entry.data.seoDescription ?? entry.data.description;
const ogImage = ogImagePath(locale, path);
const jsonLd = [
  techArticle(Astro.site!, {
    url: new URL(localePath(locale, path), Astro.site).toString(),
    headline: seoTitle,
    description: seoDescription,
    locale,
    image: ogImage && new URL(ogImage, Astro.site).toString(),
    modified: entry.filePath && gitModified(entry.filePath),
  }),
];
/** Pengenalan adalah pintu masuk docs, jadi tidak diberi tingkat "Docs" yang menunjuk ke dirinya sendiri. */
const breadcrumbs = [
  ...(slug === "introduction" ? [] : [{ name: t(locale).nav.docs, path: "/docs/introduction" }]),
  { name: entry.data.title, path },
];
---

<Docs title={seoTitle} description={seoDescription} headings={headings} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <h1 class="text-[34px] leading-tight font-semibold tracking-[-0.025em] sm:text-[38px]">{entry.data.title}</h1>
    <div class="flex items-center gap-2 sm:pt-1">
      <CopyPage markdown={markdown} markdownUrl={localePath(locale, `/docs/${slug}.md`)} />
      {
        prev ? (
          <a href={localePath(locale, `/docs/${prev.slug}`)} class={pager} aria-label={strings.previous(prev.entry.data.title)}>
            <Icon name="arrowLeft" />
          </a>
        ) : (
          <span class={`${pager} opacity-40`} aria-hidden="true">
            <Icon name="arrowLeft" />
          </span>
        )
      }
      {
        next ? (
          <a href={localePath(locale, `/docs/${next.slug}`)} class={pager} aria-label={strings.next(next.entry.data.title)}>
            <Icon name="arrowRight" />
          </a>
        ) : (
          <span class={`${pager} opacity-40`} aria-hidden="true">
            <Icon name="arrowRight" />
          </span>
        )
      }
    </div>
  </div>
  <p class="mt-3 max-w-2xl text-[19px] leading-8 text-muted">{entry.data.description}</p>
  <div class="prose mt-10"><Content /></div>
</Docs>
