---
import { render } from "astro:content";
import Docs from "../../../layouts/Docs.astro";
import { getDocs } from "../../../lib/docs";
import { LOCALES } from "../../../lib/i18n";

export async function getStaticPaths() {
  const pages = await Promise.all(
    LOCALES.map(async (locale) =>
      (await getDocs(locale)).map(({ slug, entry }) => ({
        params: { lang: locale === "en" ? undefined : locale, slug },
        props: { entry },
      })),
    ),
  );
  return pages.flat();
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs title={entry.data.title} description={entry.data.description} headings={headings}>
  <h1 class="text-[32px] leading-tight font-medium tracking-[-0.02em] sm:text-4xl">{entry.data.title}</h1>
  <p class="mt-3 max-w-2xl text-lg leading-7 text-muted">{entry.data.description}</p>
  <div class="prose mt-10"><Content /></div>
</Docs>
