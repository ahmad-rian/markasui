---
import AgentDemo from "../../components/AgentDemo.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Icon from "../../components/Icon.astro";
import Splash from "../../components/Splash.astro";
import Tabs from "../../components/Tabs.astro";
import LiveWall from "../../components/landing/LiveWall.astro";
import TemplateWall from "../../components/landing/TemplateWall.astro";
import Base from "../../layouts/Base.astro";
import { PACKAGE_MANAGERS, cliCommand } from "../../lib/frameworks";
import { localeParams, localePath, t, toLocale } from "../../lib/i18n";
import { getComponents, groupByCategory } from "../../lib/registry";
import { getTemplates } from "../../lib/templates";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const strings = t(locale);
const copy = strings.landing;
const home = strings.home;
const items = await getComponents();
const groups = groupByCategory(items, locale);
const templates = getTemplates();
const figures = [
  { value: String(items.length), label: home.figures.components },
  { value: "3", label: home.figures.frameworks },
  { value: "0", label: home.figures.dependencies },
  { value: "< 3 KB", label: home.figures.size },
];

const shell = "mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8";
const section = `${shell} py-20 sm:py-28`;
const sectionTitle = "text-[32px] leading-[1.1] font-medium tracking-[-0.03em] text-balance sm:text-[44px]";
const lead = "mt-4 max-w-md text-[17px] leading-7 text-muted";
const link = "text-brand underline decoration-brand-line underline-offset-4 transition-colors hover:decoration-brand";
const inlineCode = "font-mono text-sm text-ink";
const split = "grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16";
---

<Base splash>
  <Splash />
  <main id="konten">
    <section class={`${shell} pt-12 pb-20 sm:pt-20`}>
      <h1 class="text-[46px] leading-[0.98] font-medium tracking-[-0.045em] text-balance text-ink sm:text-[72px] lg:text-[84px] xl:text-[104px]">
        {home.title}
      </h1>
      <div class="mt-8 flex flex-col gap-8 lg:mt-10 lg:flex-row lg:items-end lg:justify-between">
        <p class="max-w-xl text-lg leading-8 text-muted sm:text-xl">{home.description}</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={localePath(locale, "/components")} class="site-button h-12 bg-ink px-5 text-surface hover:bg-ink/85">
            {home.primary}
            <Icon name="arrowRight" class="size-4" />
          </a>
          <div data-code-block class="flex h-12 items-center gap-3 rounded-lg pr-1.5 pl-4 font-mono text-[13px] text-ink shadow-[0_0_0_1px_var(--color-line)]">
            <span class="text-muted select-none" aria-hidden="true">$</span>
            <pre class="flex-1 text-left">npx markasui@latest init</pre>
            <button type="button" data-copy aria-label={home.copyCommand} class="icon-button size-9">
              <Icon name="copy" class="size-4 in-data-copied:hidden" />
              <Icon name="check" class="hidden size-4 text-brand in-data-copied:block" />
            </button>
          </div>
        </div>
      </div>
      <div class="mt-12 lg:mt-16">
        <LiveWall />
      </div>
    </section>

    <section class="border-y border-line" aria-label={home.figuresLabel}>
      <div class={shell}>
      <dl class="grid grid-cols-2 gap-px bg-line lg:grid-cols-4">
        {
          figures.map((figure) => (
            <div class="flex flex-col-reverse justify-end bg-surface py-8 odd:pr-4 even:pl-4 sm:py-10 sm:odd:pr-6 sm:even:pl-6 lg:px-6 lg:first:pl-0">
              <dt class="mt-3 max-w-[24ch] text-sm leading-5 text-muted">{figure.label}</dt>
              <dd class="text-[40px] leading-none font-medium tracking-[-0.03em] text-ink tabular-nums sm:text-[56px]">{figure.value}</dd>
            </div>
          ))
        }
      </dl>
      </div>
    </section>

    <section class={section} aria-labelledby="mulai-title">
      <div class={split}>
        <div class="min-w-0">
          <h2 id="mulai-title" class={sectionTitle}>{copy.installTitle}</h2>
          <p class={lead}>
            <code class={inlineCode}>init</code>{" "}{copy.installText[0]}{" "}<code class={inlineCode}>markas.css</code>.{" "}
            {copy.installText[1]}{" "}<code class={inlineCode}>add</code>{" "}{copy.installText[2]}
          </p>
          <a href={localePath(locale, "/docs/cli")} class={`mt-6 inline-block text-sm ${link}`}>{copy.installLink}</a>
        </div>
        <div class="min-w-0 lg:self-center">
          <Tabs label={strings.component.packageManager} framed group="package-manager" items={PACKAGE_MANAGERS.map((pm) => ({ value: pm, label: pm }))}>
            {
              PACKAGE_MANAGERS.map((pm) => (
                <div slot={pm}>
                  <CodeBlock code={`${cliCommand(pm, "init")}\n${cliCommand(pm, "add button input modal")}`} lang="bash" bare />
                </div>
              ))
            }
          </Tabs>
        </div>
      </div>
    </section>

    <section class="border-t border-line" aria-labelledby="agent-title">
      <div class={section}>
        <div class="grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
          <div class="min-w-0 lg:pt-2">
            <h2 id="agent-title" class={sectionTitle}>{copy.agentTitle}</h2>
            <p class={lead}>{copy.agentText}</p>
            <ul class="mt-6 grid gap-2 text-sm">
              <li><a href={localePath(locale, "/docs/mcp")} class={link}>{copy.agentLinks.mcp}</a></li>
              <li><a href={localePath(locale, "/docs/skills")} class={link}>{copy.agentLinks.skill}</a></li>
              <li><a href={localePath(locale, "/llms.txt")} class={link}>{copy.agentLinks.llms}</a></li>
            </ul>
          </div>
          <div class="min-w-0 lg:order-first">
            <AgentDemo />
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line" aria-labelledby="template-title">
      <div class={section}>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 id="template-title" class={sectionTitle}>{copy.templatesTitle(templates.length)}</h2>
            <p class={lead}>{copy.templatesText}</p>
          </div>
          <a href={localePath(locale, "/templates")} class={`text-sm ${link}`}>{copy.templatesLink}</a>
        </div>
        <div class="mt-12">
          <TemplateWall />
        </div>
      </div>
    </section>

    <section class="border-t border-line" aria-labelledby="komponen-title">
      <div class={section}>
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="komponen-title" class={sectionTitle}>{copy.componentsTitle(items.length)}</h2>
          <a href={localePath(locale, "/components")} class={`text-sm ${link}`}>{copy.componentsLink}</a>
        </div>
        <div class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
          {
            groups.map((group) => (
              <div>
                <h3 class="text-sm font-medium text-ink">{group.label}</h3>
                <ul class="mt-3 grid gap-2 text-sm">
                  {group.items.map((item) => (
                    <li>
                      <a href={localePath(locale, `/components/${item.name}`)} class="text-muted transition-colors hover:text-ink">
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>
