---
import AgentDemo from "../../components/AgentDemo.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Collage from "../../components/Collage.astro";
import FrameworkIcon from "../../components/FrameworkIcon.astro";
import HeroArt from "../../components/HeroArt.astro";
import Icon from "../../components/Icon.astro";
import Showcase from "../../components/Showcase.astro";
import Splash from "../../components/Splash.astro";
import Tabs from "../../components/Tabs.astro";
import Base from "../../layouts/Base.astro";
import type { Framework } from "@markasui/registry/schema";
import { FRAMEWORK_LABELS, PACKAGE_MANAGERS, STACK, cliCommand } from "../../lib/frameworks";
import { SITE } from "../../lib/site";
import { localeParams, localePath, t, toLocale } from "../../lib/i18n";
import { getComponents, groupByCategory } from "../../lib/registry";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const strings = t(locale);
const copy = strings.landing;
const home = strings.home;
const frameworks: Framework[] = ["blade", "react", "vue"];
const items = await getComponents();
const groups = groupByCategory(items, locale);
const sectionTitle = "text-[26px] leading-tight font-semibold tracking-[-0.025em] sm:text-[30px]";
const link = "text-brand underline decoration-brand-line underline-offset-4 transition-colors hover:decoration-brand";
const inlineCode = "font-mono text-sm text-ink";
const container = "mx-auto grid max-w-screen-xl gap-8 px-4 py-20 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16 lg:px-8";
---

<Base splash>
  <Splash />
  <main id="konten">
    <section class="hero relative isolate flex min-h-[min(100dvh,860px)] flex-col overflow-hidden">
      <HeroArt />
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="mx-auto flex w-full max-w-screen-xl flex-1 flex-col px-4 pt-28 pb-[min(52dvh,400px)] sm:px-6 sm:pt-36 lg:justify-center lg:px-8 lg:pt-24 lg:pb-40">
        <div class="max-w-[620px]">
          <a href={localePath(locale, "/docs/changelog")} class="hero-rise hero-glass inline-flex items-center gap-2 rounded-full py-1 pr-3 pl-1 text-sm text-ink transition-colors hover:bg-surface/80">
            <span class="rounded-full bg-ink px-2 py-0.5 text-xs font-medium text-surface">{home.badge}</span>
            {home.badgeText}
            <Icon name="arrowRight" class="size-3.5" />
          </a>
          <h1 class="mt-6 text-[40px] leading-[1.06] font-semibold tracking-[-0.035em] text-balance text-ink sm:text-[58px] lg:text-[68px]">
            {home.titleBefore}{" "}
            <span class="hero-rotator" aria-hidden="true">
              <span class="hero-words">
                {[...frameworks, frameworks[0]!].map((fw) => (
                  <span class="hero-word">
                    <FrameworkIcon framework={fw} brand class="size-[0.72em]" />
                    {FRAMEWORK_LABELS[fw]}
                  </span>
                ))}
              </span>
            </span>
            <span class="sr-only">Blade, React, Vue</span>
            {" "}{home.titleAfter}
          </h1>
          <p class="mt-5 max-w-lg text-[17px] leading-7 text-ink/80 sm:text-lg sm:leading-8">{home.description(items.length)}</p>
          <div class="hero-rise mt-8 flex flex-col gap-3 [--rise-delay:180ms] sm:flex-row sm:items-center">
            <a href={localePath(locale, "/components")} class="site-button h-12 rounded-full bg-ink px-6 text-surface hover:bg-ink/85">
              {home.primary}
              <Icon name="arrowRight" class="size-4" />
            </a>
            <div data-code-block class="hero-glass flex h-12 items-center gap-3 rounded-full pr-1.5 pl-5 font-mono text-[13px] text-ink">
              <span class="text-ink/60 select-none" aria-hidden="true">$</span>
              <pre class="flex-1 text-left">npx markasui@latest init</pre>
              <button type="button" data-copy aria-label={home.copyCommand} class="inline-flex size-9 items-center justify-center rounded-full bg-surface/70 text-ink transition-colors hover:bg-surface">
                <Icon name="copy" class="size-4 in-data-copied:hidden" />
                <Icon name="check" class="hidden size-4 text-brand in-data-copied:block" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-screen-xl px-4 pt-4 sm:px-6 lg:px-8" aria-label={home.stack}>
      <div class="flex flex-col items-center gap-3">
        <p class="text-xs text-muted">{home.stack}</p>
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-ink/75">
          {
            STACK.map((item) => (
              <li class="flex items-center gap-2">
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                  <path d={item.path} />
                </svg>
                {item.name}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="mt-12">
        <Showcase />
      </div>
    </section>

    <section class="mx-auto max-w-screen-xl px-4 pt-28 pb-24 sm:px-6 lg:px-8" aria-labelledby="alive-title">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="alive-title" class="text-[36px] leading-tight font-semibold tracking-[-0.03em] sm:text-[52px]">{home.aliveTitle}</h2>
        <p class="mt-4 text-lg text-muted">{home.aliveText}</p>
      </div>
      <div class="mt-12">
        <Collage />
      </div>
    </section>

    <section class="border-t border-line" aria-labelledby="mulai-title">
      <div class={container}>
        <div class="min-w-0">
          <h2 id="mulai-title" class={sectionTitle}>{copy.installTitle}</h2>
          <p class="mt-4 max-w-md leading-7 text-muted">
            <code class={inlineCode}>init</code>{" "}{copy.installText[0]}{" "}<code class={inlineCode}>markas.css</code>.{" "}
            {copy.installText[1]}{" "}<code class={inlineCode}>add</code>{" "}{copy.installText[2]}
          </p>
          <a href={localePath(locale, "/docs/cli")} class={`mt-5 inline-block text-sm ${link}`}>{copy.installLink}</a>
        </div>
        <div class="min-w-0">
          <Tabs label={strings.component.packageManager} framed group="package-manager" items={PACKAGE_MANAGERS.map((pm) => ({ value: pm, label: pm }))}>
            {
              PACKAGE_MANAGERS.map((pm) => (
                <div slot={pm}>
                  <CodeBlock code={`${cliCommand(pm, "init")}\n${cliCommand(pm, "add button input modal")}`} lang="bash" bare />
                </div>
              ))
            }
          </Tabs>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-surface" aria-labelledby="agent-title">
      <div class={container}>
        <div class="min-w-0">
          <h2 id="agent-title" class={sectionTitle}>{copy.agentTitle}</h2>
          <p class="mt-4 max-w-md leading-7 text-muted">{copy.agentText}</p>
          <ul class="mt-5 grid gap-2 text-sm">
            <li><a href={localePath(locale, "/docs/mcp")} class={link}>{copy.agentLinks.mcp}</a></li>
            <li><a href={localePath(locale, "/docs/skills")} class={link}>{copy.agentLinks.skill}</a></li>
            <li><a href={localePath(locale, "/llms.txt")} class={link}>{copy.agentLinks.llms}</a></li>
          </ul>
        </div>
        <div class="min-w-0">
          <AgentDemo />
        </div>
      </div>
    </section>

    <section class="border-t border-line" aria-labelledby="komponen-title">
      <div class="mx-auto max-w-screen-xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="komponen-title" class={sectionTitle}>{copy.componentsTitle(items.length)}</h2>
          <a href={localePath(locale, "/components")} class={`text-sm ${link}`}>{copy.componentsLink}</a>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
          {
            groups.map((group) => (
              <div>
                <h3 class="text-sm font-medium text-ink">{group.label}</h3>
                <ul class="mt-3 grid gap-2 text-sm">
                  {group.items.map((item) => (
                    <li>
                      <a href={localePath(locale, `/components/${item.name}`)} class="text-muted transition-colors hover:text-ink">
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Kaca tipis di atas ilustrasi. */
  .hero-glass {
    background: color-mix(in oklab, var(--color-surface) 62%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-ink) 10%, transparent);
    backdrop-filter: blur(10px);
  }

  /* Bawah hero melebur ke latar halaman; kiri atas sedikit diterangkan (atau digelapkan) demi kontras teks. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(to bottom, transparent 78%, var(--color-surface)),
      radial-gradient(ellipse 70% 60% at 18% 42%, color-mix(in oklab, var(--color-surface) 45%, transparent), transparent 70%);
  }
  @media (max-width: 1023px) {
    .hero-scrim {
      background:
        linear-gradient(to bottom, transparent 82%, var(--color-surface)),
        linear-gradient(to bottom, color-mix(in oklab, var(--color-surface) 35%, transparent) 20%, transparent 60%);
    }
  }

  /* Nama framework berganti bergiliran; kata terakhir salinan kata pertama supaya putarannya mulus. */
  .hero-rotator {
    display: inline-block;
    height: 1.08em;
    overflow: hidden;
    vertical-align: bottom;
  }
  .hero-words {
    display: grid;
    animation: hero-words 7.2s var(--ease-out-quint) infinite;
  }
  .hero-word {
    display: inline-flex;
    height: 1.08em;
    align-items: center;
    gap: 0.16em;
    color: var(--color-brand);
  }
  @keyframes hero-words {
    0%, 28% { transform: translateY(0); }
    33%, 61% { transform: translateY(-1.08em); }
    66%, 94% { transform: translateY(-2.16em); }
    100% { transform: translateY(-3.24em); }
  }

  /* Judul dan deskripsi tidak dianimasikan supaya LCP tidak tertunda. */
  .hero-rise {
    animation: hero-rise 600ms var(--ease-out-quint) both;
    animation-delay: var(--rise-delay, 0ms);
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px); }
  }

  /* Tahan animasi selama splash menutupi halaman. */
  :global(html[data-splash]:not([data-splash="leaving"])) .hero-rise,
  :global(html[data-splash]:not([data-splash="leaving"])) .hero-words {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-words, .hero-rise { animation: none; }
  }
</style>
