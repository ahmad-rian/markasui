---
import { FRAMEWORKS } from "@markasui/registry/schema";
import AgentDemo from "../../components/AgentDemo.astro";
import FrameworkIcon from "../../components/FrameworkIcon.astro";
import FrameworkSwitcher from "../../components/FrameworkSwitcher.astro";
import Icon from "../../components/Icon.astro";
import Splash from "../../components/Splash.astro";
import LiveFixture from "../../components/landing/LiveFixture.astro";
import LiveWall from "../../components/landing/LiveWall.astro";
import TemplateWall from "../../components/landing/TemplateWall.astro";
import Base from "../../layouts/Base.astro";
import "../../generated/css/landing.css";
import "../../styles/landing.css";
import { FRAMEWORK_LABELS, cliCommand } from "../../lib/frameworks";
import { localeParams, localePath, t, toLocale } from "../../lib/i18n";
import { HERO_FIXTURE } from "../../lib/landing";
import { getComponents, groupByCategory } from "../../lib/registry";
import { getTemplates } from "../../lib/templates";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const strings = t(locale);
const copy = strings.landing;
const home = strings.home;
const items = await getComponents();
const groups = groupByCategory(items, locale);
const templates = getTemplates();
/** Kolom angka di kiri dan kanan judul (di layar sempit menjadi grid 2 x 2 di bawah tombol). */
const stats = [
  [
    { value: String(items.length), label: home.stats.components },
    { value: "3", label: home.stats.frameworks },
  ],
  [
    { value: "0", label: home.stats.dependencies },
    { value: "< 3 KB", label: home.stats.size },
  ],
];
const FEATURE_ICONS = ["file", "layers", "shield", "contrast", "sparkles"] as const;
const features = home.features.map(([title, text], index) => ({ title, text, icon: FEATURE_ICONS[index]! }));
const templatesTitle = copy.templatesTitle(templates.length);
const componentsTitle = copy.componentsTitle(items.length);
const shell = "mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8";
---

<Base splash hero>
  <Splash />
  <main id="konten">
    <section class="lp-frame lp-hero" aria-labelledby="hero-title">
      <div class="lp-bg" aria-hidden="true">
        <div class="lp-glow"></div>
        <div class="lp-flutes"></div>
        <div class="lp-beam"></div>
      </div>

      <div class="lp-main">
        <div class="lp-center">
          <div class="lp-switch">
            <FrameworkSwitcher label={home.frameworkLabel} />
          </div>

          <h1 id="hero-title" class="lp-title">
            {home.titleBefore}{" "}
            <span class="hero-rotator" data-hero-rotator aria-hidden="true">
              {
                FRAMEWORKS.map((fw) => (
                  <span class="hero-word" data-word={fw}>
                    <FrameworkIcon framework={fw} brand class="size-[0.6em]" />
                    {FRAMEWORK_LABELS[fw]}
                  </span>
                ))
              }
            </span>
            <span class="sr-only">{home.titleFrameworks}</span>
            {home.titleAfter && ` ${home.titleAfter}`}
            <br class="max-sm:hidden" />
            {" "}{home.titleEnd}
          </h1>

          <p class="lp-sub">{home.description}</p>

          <div class="lp-actions">
            <a href={localePath(locale, "/components")} class="lp-btn">
              {home.browse}
              <Icon name="arrowRight" class="size-4" />
            </a>
            <div data-code-block class="lp-cmd">
              <span aria-hidden="true">$</span>
              <pre>{cliCommand("npm", "init")}</pre>
              <button type="button" data-copy aria-label={home.copyCommand} class="icon-button">
                <Icon name="copy" class="size-4 in-data-copied:hidden" />
                <Icon name="check" class="hidden size-4 in-data-copied:block" />
              </button>
            </div>
          </div>
        </div>

        {
          stats.map((column, index) => (
            <dl class:list={["lp-stats", index === 0 ? "lp-stats-l" : "lp-stats-r"]} aria-label={index === 0 ? home.statsLabel : undefined}>
              {column.map((stat) => (
                <div>
                  <dt>{stat.label}</dt>
                  <dd>{stat.value}</dd>
                </div>
              ))}
            </dl>
          ))
        }
      </div>

      <div class="lp-card" data-pagefind-ignore>
        <p class="lp-card-head">
          <a href={localePath(locale, "/components/switch")}>Switch</a>
          <span class="lp-chip">{home.cardBadge}</span>
        </p>
        <div class="lp-card-stage" data-preview-stage>
          <LiveFixture fixture={HERO_FIXTURE} class="w-full" />
        </div>
      </div>

      <ul class="lp-strip" aria-label={home.featuresLabel}>
        {
          features.map((feature) => (
            <li>
              <Icon name={feature.icon} class="size-5" />
              <p>
                <strong>{feature.title}</strong>
                <span>{feature.text}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="lp-frame lp-wall lp-lazy" aria-labelledby="wall-title">
      <div class={`${shell} lp-section`}>
        <div class="lp-head">
          <h2 id="wall-title" class="lp-h2">{copy.wallTitle[0]} <em class="lp-accent">{copy.wallTitle[1]}</em></h2>
          <p class="lp-lead">{copy.wallText}</p>
        </div>
        <LiveWall />
      </div>
    </section>

    <section class="lp-lazy" aria-labelledby="agent-title">
      <div class={`${shell} lp-section lp-agent`}>
        <div>
          <h2 id="agent-title" class="lp-h2">{copy.agentTitle[0]} <em class="lp-accent">{copy.agentTitle[1]}</em></h2>
          <p class="lp-lead">{copy.agentText}</p>
          <ul class="lp-links">
            <li><a href={localePath(locale, "/docs/mcp")}>{copy.agentLinks.mcp}<Icon name="arrowRight" class="size-3.5" /></a></li>
            <li><a href={localePath(locale, "/docs/skills")}>{copy.agentLinks.skill}<Icon name="arrowRight" class="size-3.5" /></a></li>
            <li><a href={localePath(locale, "/llms.txt")}>{copy.agentLinks.llms}<Icon name="arrowRight" class="size-3.5" /></a></li>
          </ul>
        </div>
        <AgentDemo />
      </div>
    </section>

    <section class="lp-lazy" aria-labelledby="template-title">
      <div class={`${shell} lp-section`}>
        <div class="lp-head">
          <h2 id="template-title" class="lp-h2">{templatesTitle[0]} <em class="lp-accent">{templatesTitle[1]}</em></h2>
          <div>
            <p class="lp-lead">{copy.templatesText}</p>
            <a href={localePath(locale, "/templates")} class="lp-more">{copy.templatesLink}<Icon name="arrowRight" class="size-3.5" /></a>
          </div>
        </div>
        <TemplateWall />
      </div>
    </section>

    <section class="lp-lazy" aria-labelledby="komponen-title">
      <div class={`${shell} lp-section`}>
        <div class="lp-head">
          <h2 id="komponen-title" class="lp-h2">{componentsTitle[0]} <em class="lp-accent">{componentsTitle[1]}</em></h2>
          <div>
            <p class="lp-lead">{copy.componentsText}</p>
            <a href={localePath(locale, "/components")} class="lp-more">{copy.componentsLink}<Icon name="arrowRight" class="size-3.5" /></a>
          </div>
        </div>
        <div class="lp-groups">
          {
            groups.map((group) => (
              <div>
                <h3>
                  {group.label}
                  <span>{group.items.length}</span>
                </h3>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a href={localePath(locale, `/components/${item.name}`)}>{item.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import "../../scripts/landing";
</script>
