---
import "../../../styles/global.css";
import TemplateDetail from "../../../components/templates/TemplateDetail.astro";
import { LOCALES, localePath, toLocale } from "../../../lib/i18n";
import { getTemplates, templateDetailPath } from "../../../lib/templates";

/**
 * Detail dashboard. Page (kind "page") juga dibangkitkan di sini supaya tautan lama /templates/<slug>
 * tetap jalan: halaman itu hanya mengalihkan ke alamat kanoniknya, /pages/<slug>.
 */
export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    getTemplates().map((template) => ({ params: { lang: locale === "en" ? undefined : locale, slug: template.name }, props: { template } })),
  );
}

const { template } = Astro.props;
const locale = toLocale(Astro.params.lang);
const target = localePath(locale, templateDetailPath(template));
---

{
  template.kind === "page" ? (
    <html lang={locale}>
      <head>
        <meta charset="UTF-8" />
        <meta name="robots" content="noindex" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <link rel="canonical" href={new URL(target, Astro.site)} />
        <title>{template.headline[locale]} - MarkasUI</title>
      </head>
      <body>
        <a href={target}>{template.headline[locale]}</a>
      </body>
    </html>
  ) : (
    <TemplateDetail template={template} locale={locale} />
  )
}
