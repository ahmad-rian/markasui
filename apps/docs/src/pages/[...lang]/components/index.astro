---
import "../../../styles/global.css";
import Base from "../../../layouts/Base.astro";
import { localeParams, localePath, t, toLocale } from "../../../lib/i18n";
import { CATEGORIES, categoryLabel, freshness, getComponents } from "../../../lib/registry";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const strings = t(locale).list;
const items = await getComponents();
const thumbs = import.meta.glob<string>("../../../../public/thumbs/*.webp", { query: "?url", import: "default", eager: true });
const hasThumb = (name: string) => `../../../../public/thumbs/${name}.webp` in thumbs;
const categories = CATEGORIES.filter((category) => items.some((item) => item.category === category)).map((category) => [category, categoryLabel(category, locale)] as const);
const control =
  "h-10 rounded-lg bg-subtle px-3 text-sm text-ink transition-colors hover:bg-line focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";
---

<Base title={strings.title} description={strings.subtitle(items.length)}>
  <main id="konten" class="mx-auto max-w-screen-xl px-4 pt-10 pb-20 sm:px-6 sm:pt-14 lg:px-8" data-pagefind-body>
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div>
        <h1 class="text-[34px] leading-tight font-semibold tracking-[-0.025em] sm:text-[38px]">{strings.title}</h1>
        <p class="mt-3 max-w-xl text-lg leading-7 text-muted">
          {strings.subtitle(items.length)}
        </p>
      </div>
    </div>

    <form class="mt-8 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap" role="search" data-filters data-pagefind-ignore>
      <label class="sr-only" for="filter-query">{strings.search}</label>
      <input id="filter-query" name="q" type="search" placeholder={strings.searchPlaceholder} class={`${control} col-span-2 min-w-0 placeholder:text-faint sm:w-72`} />
      <label class="sr-only" for="filter-category">{strings.category}</label>
      <select id="filter-category" name="category" class={control}>
        <option value="">{strings.allCategories}</option>
        {categories.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
      <label class="sr-only" for="filter-sort">{strings.sort}</label>
      <select id="filter-sort" name="sort" class={control}>
        <option value="az">{strings.sortAz}</option>
        <option value="new">{strings.sortNew}</option>
      </select>
    </form>

    <p data-empty hidden class="mt-10 text-muted">{strings.empty}</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-grid>
      {
        items.map((item) => {
          const label = freshness(item);
          return (
            <li
              data-card
              data-name={item.name}
              data-category={item.category}
              data-added={item.addedAt}
              data-search={[item.name, item.title, item.description, ...item.tags].join(" ").toLowerCase()}
            >
              <a
                href={localePath(locale, `/components/${item.name}`)}
                class="frame group block transition-colors duration-150 ease-out hover:bg-line"
              >
                <div class="frame-panel aspect-[16/10] overflow-hidden">
                  {hasThumb(item.name) ? (
                    <>
                      <img src={`/thumbs/${item.name}.webp`} alt="" width="480" height="300" loading="lazy" decoding="async" class="size-full object-cover dark:hidden" />
                      <img src={`/thumbs/${item.name}-dark.webp`} alt="" width="480" height="300" loading="lazy" decoding="async" class="hidden size-full object-cover dark:block" />
                    </>
                  ) : (
                    <span class="flex size-full items-center justify-center text-sm text-muted">{item.title}</span>
                  )}
                </div>
                <div class="flex items-baseline justify-between gap-3 px-3 pt-3 pb-2">
                  <h2 class="font-medium text-ink">{item.title}</h2>
                  <p class="text-sm text-muted">
                    {label && <span class="mr-2 text-brand">{label === "new" ? t(locale).sidebar.fresh : t(locale).sidebar.updated}</span>}
                    {categoryLabel(item.category, locale)}
                  </p>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Base>

<script>
  import { onPageLoad } from "../../../scripts/lifecycle";

  function apply(form: HTMLFormElement) {
    const grid = document.querySelector<HTMLElement>("[data-grid]");
    const empty = document.querySelector<HTMLElement>("[data-empty]");
    if (!grid || !empty) return;
    const data = new FormData(form);
    const query = String(data.get("q") ?? "").trim().toLowerCase();
    const category = String(data.get("category") ?? "");
    const sort = String(data.get("sort") ?? "az");

    const cards = [...grid.querySelectorAll<HTMLElement>("[data-card]")];
    let visible = 0;
    for (const card of cards) {
      const show = (!query || card.dataset.search!.includes(query)) && (!category || card.dataset.category === category);
      card.hidden = !show;
      if (show) visible++;
    }
    empty.hidden = visible > 0;
    grid.append(
      ...cards.toSorted((a, b) =>
        sort === "new" ? b.dataset.added!.localeCompare(a.dataset.added!) : a.dataset.name!.localeCompare(b.dataset.name!),
      ),
    );
  }

  document.addEventListener("input", (event) => {
    const form = (event.target as HTMLElement).closest<HTMLFormElement>("[data-filters]");
    if (form) apply(form);
  });
  document.addEventListener("submit", (event) => {
    if ((event.target as HTMLElement).matches("[data-filters]")) event.preventDefault();
  });
  // Filter yang dipulihkan browser (tombol kembali) tetap diterapkan.
  onPageLoad(() => {
    const form = document.querySelector<HTMLFormElement>("[data-filters]");
    if (form) apply(form);
  });
</script>
