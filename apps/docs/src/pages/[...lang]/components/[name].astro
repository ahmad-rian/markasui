---
import { FRAMEWORKS, availableFrameworks, type Framework } from "@markasui/registry/schema";
import CodeBlock from "../../../components/CodeBlock.astro";
import CopyPage from "../../../components/CopyPage.astro";
import Icon from "../../../components/Icon.astro";
import Tabs from "../../../components/Tabs.astro";
import Variants from "../../../components/Variants.astro";
import Playground from "../../../components/preview/Playground.astro";
import Preview from "../../../components/preview/Preview.astro";
import Docs from "../../../layouts/Docs.astro";
import { buildPrompt, componentMarkdown, splitUsage } from "../../../lib/ai";
import { EXAMPLE_EXTENSIONS, FRAMEWORK_LABELS, PACKAGE_MANAGERS, cliCommand, exampleForDisplay, shikiLang } from "../../../lib/frameworks";
import { LOCALES, localePath, t, toLocale } from "../../../lib/i18n";
import { renderMarkdown } from "../../../lib/markdown";
import { PLAYGROUNDS } from "../../../lib/playgrounds";
import { categoryLabel, getComponents, localized } from "../../../lib/registry";
import { fitDescription, frameworkList, techArticle } from "../../../lib/seo";
import { ogImagePath } from "../../../lib/seo-files";

export async function getStaticPaths() {
  /** Jumlah komponen terkait (kategori sama) di bawah halaman. getStaticPaths diangkat Astro, jadi konstanta ada di sini. */
  const RELATED_LIMIT = 6;
  const items = await getComponents();
  return LOCALES.flatMap((locale) =>
    items.map((item, index) => ({
      params: { lang: locale === "en" ? undefined : locale, name: item.name },
      props: {
        item,
        prev: items[index - 1],
        next: items[index + 1],
        related: items.filter((other) => other.category === item.category && other.name !== item.name).slice(0, RELATED_LIMIT),
      },
    })),
  );
}

const { item, prev, next, related } = Astro.props;
const locale = toLocale(Astro.params.lang);
const dictionary = t(locale);
const strings = dictionary.component;
const text = localized(item, locale);
const path = `/components/${item.name}`;
const available = frameworkList(availableFrameworks(item), locale);
const seoTitle = dictionary.seo.componentTitle(item.title, available);
const seoDescription = fitDescription(text.description, dictionary.seo.componentTails(available));
const category = categoryLabel(item.category, locale);
const ogImage = ogImagePath(locale, path);
const jsonLd = [
  techArticle(Astro.site!, {
    url: new URL(localePath(locale, path), Astro.site).toString(),
    headline: seoTitle,
    description: seoDescription,
    locale,
    image: ogImage && new URL(ogImage, Astro.site).toString(),
    published: item.addedAt,
    modified: item.updatedAt,
  }),
];
const breadcrumbs = [
  { name: dictionary.nav.components, path: "/components" },
  { name: item.title, path },
];
const frameworks = FRAMEWORKS;
const unavailable = (fw: Framework) => strings.unavailable(FRAMEWORK_LABELS[fw]);
const site = Astro.site!.toString();
const usage = splitUsage(text.usage);
const usageHtml = Object.fromEntries(
  await Promise.all(frameworks.map(async (fw) => [fw, await renderMarkdown(usage[fw])] as const)),
) as Record<Framework, string>;
const notesHtml = usage.notes ? await renderMarkdown(usage.notes) : "";
const prompts = Object.fromEntries(frameworks.map((fw) => [fw, item.frameworks[fw] ? buildPrompt(item, fw, site, locale) : unavailable(fw)])) as Record<Framework, string>;

/** Variasi di examples/<fw>/<nama>--<variasi>.* ditampilkan sebagai galeri. */
const variantFiles = import.meta.glob("../../../../../../examples/react/*--*.tsx");
const hasVariants = Object.keys(variantFiles).some((path) => path.includes(`/${item.name}--`));

const headings = [
  ...(hasVariants ? [{ depth: 2, slug: "contoh", text: strings.examples }] : []),
  { depth: 2, slug: "instalasi", text: strings.installation },
  { depth: 2, slug: "pemakaian", text: strings.usage },
  { depth: 2, slug: "props", text: strings.props },
  { depth: 2, slug: "aksesibilitas", text: strings.accessibility },
  ...(related.length > 0 ? [{ depth: 2, slug: "terkait", text: dictionary.seo.related }] : []),
];
const pager = "icon-button size-9 bg-subtle text-ink hover:bg-line";
/** Tipe dan default hanya patah di spasi: `("a" | "b")[]` tidak menyisakan `[]` sendirian di baris baru. */
const words = (value: string) => value.split(/(\s+)/);
const hasPlayground = item.name in PLAYGROUNDS;

/** CSS halaman ini: CSS situs plus class komponen dan contohnya saja (scripts/page-css.ts). */
const stylesheets = import.meta.glob<string>("../../../generated/css/components/*.css", { query: "?url", import: "default", eager: true });
const stylesheet = stylesheets[`../../../generated/css/components/${item.name}.css`];
if (!stylesheet) throw new Error(`CSS untuk ${item.name} belum dibangkitkan (node scripts/page-css.ts)`);

/** Kode contoh dari examples/, ditampilkan di bawah preview untuk komponen tanpa playground. */
const exampleSources = import.meta.glob<string>("../../../../../../examples/*/*", { query: "?raw", import: "default", eager: true });
const example = (fw: Framework) => {
  const code = Object.entries(exampleSources).find(([path]) => path.endsWith(`/examples/${fw}/${item.name}${EXAMPLE_EXTENSIONS[fw]}`))?.[1];
  return code ? exampleForDisplay(code, fw).replaceAll("Fixture()", "Example()") : "";
};
---

<Docs title={seoTitle} description={seoDescription} headings={headings} stylesheet={stylesheet} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <h1 class="text-[34px] leading-tight font-semibold tracking-[-0.025em] sm:text-[38px]">{item.title}</h1>
    <div class="flex items-center gap-2 sm:pt-1">
      <CopyPage markdown={componentMarkdown(item, site, locale)} markdownUrl={localePath(locale, `/components/${item.name}.md`)} prompts={prompts} />
      {
        prev ? (
          <a href={localePath(locale, `/components/${prev.name}`)} class={pager} aria-label={strings.previous(prev.title)}>
            <Icon name="arrowLeft" />
          </a>
        ) : (
          <span class={`${pager} opacity-40`} aria-hidden="true">
            <Icon name="arrowLeft" />
          </span>
        )
      }
      {
        next ? (
          <a href={localePath(locale, `/components/${next.name}`)} class={pager} aria-label={strings.next(next.title)}>
            <Icon name="arrowRight" />
          </a>
        ) : (
          <span class={`${pager} opacity-40`} aria-hidden="true">
            <Icon name="arrowRight" />
          </span>
        )
      }
    </div>
  </div>
  <p class="mt-3 max-w-2xl text-[19px] leading-8 text-muted">{text.description}</p>

  <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-4">
    {
      hasPlayground ? (
        <Playground name={item.name} title={item.title} />
      ) : (
        <>
          <Preview name={item.name} />
          {frameworks.map((fw) => (
            <div data-fw={fw}>
              {example(fw) ? <CodeBlock code={example(fw)} lang={shikiLang(fw)} collapsible /> : <p class="text-sm text-muted">{unavailable(fw)}</p>}
            </div>
          ))}
        </>
      )
    }
  </div>

  {
    hasVariants && (
      <>
        <section class="prose mt-16">
          <h2 id="contoh">{strings.examples}</h2>
        </section>
        <div class="mt-6">
          <Variants name={item.name} />
        </div>
      </>
    )
  }

  <section class="prose mt-16">
    <h2 id="instalasi">{strings.installation}</h2>
  </section>
  <div class="mt-5">
    <Tabs label={strings.installMethod} group="install-method" items={[{ value: "cli", label: strings.cli }, { value: "manual", label: strings.manual }]}>
      <div slot="cli">
        <Tabs label={strings.packageManager} framed group="package-manager" items={PACKAGE_MANAGERS.map((pm) => ({ value: pm, label: pm }))}>
          {
            PACKAGE_MANAGERS.map((pm) => (
              <div slot={pm}>
                <CodeBlock code={cliCommand(pm, `add ${item.name}`)} lang="bash" bare />
              </div>
            ))
          }
        </Tabs>
      </div>
      <div slot="manual" class="grid grid-cols-[minmax(0,1fr)] gap-5">
        {
          frameworks.map((fw) => {
            const file = item.frameworks[fw];
            return file ? (
            <div data-fw={fw} class="grid grid-cols-[minmax(0,1fr)] gap-5">
              <ol class="prose">
                <li>
                  {strings.manualSetup} <a href={localePath(locale, "/docs/installation")}>{strings.manualSetupLink}</a>.
                </li>
                {file.deps.length > 0 && (
                  <li>
                    {strings.manualDeps} <code>npm install {file.deps.join(" ")}</code>
                  </li>
                )}
                <li>
                  {strings.manualCopy} <code>{file.target}</code>.
                </li>
              </ol>
              <CodeBlock code={file.code} lang={shikiLang(fw)} title={file.target} framework={fw} collapsible />
            </div>
            ) : (
              <p data-fw={fw} class="text-sm text-muted">{unavailable(fw)}</p>
            );
          })
        }
      </div>
    </Tabs>
  </div>

  <section class="prose mt-16">
    <h2 id="pemakaian">{strings.usage}</h2>
    {frameworks.map((fw) => (usageHtml[fw] ? <div data-fw={fw} set:html={usageHtml[fw]} /> : <p data-fw={fw}>{unavailable(fw)}</p>))}
    {notesHtml && <Fragment set:html={notesHtml} />}

    <h2 id="props">{strings.props}</h2>
    <div class="table-wrap props-wrap" tabindex="0" role="region" aria-label={strings.table.label}>
      <table class="props-table">
        <thead>
          <tr><th>{strings.table.name}</th><th>{strings.table.type}</th><th>{strings.table.default}</th><th>{strings.table.description}</th></tr>
        </thead>
        <tbody>
          {
            text.props.map((prop) => (
              <tr>
                <td><code>{prop.name}</code></td>
                <td data-label={strings.table.type}><code>{words(prop.type).map((word) => (/\s/.test(word) ? word : <span class="whitespace-nowrap">{word}</span>))}</code></td>
                <td data-label={strings.table.default} class="font-mono text-[13px] text-muted">{words(prop.default).map((word) => (/\s/.test(word) ? word : <span class="whitespace-nowrap">{word}</span>))}</td>
                <td>{prop.description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2 id="aksesibilitas">{strings.accessibility}</h2>
    <ul>
      {text.a11y.map((note) => <li>{note}</li>)}
    </ul>
  </section>

  {
    related.length > 0 && (
      <section class="mt-16" aria-labelledby="terkait">
        <h2 id="terkait" class="scroll-mt-24 text-[26px] leading-tight font-semibold tracking-[-0.02em]">{dictionary.seo.related}</h2>
        <p class="mt-2 text-muted">{dictionary.seo.relatedText(category)}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {related.map((other) => (
            <li>
              <a href={localePath(locale, `/components/${other.name}`)} class="block h-full rounded-xl border border-line p-4 transition-colors hover:bg-subtle">
                <span class="font-medium text-ink">{other.title}</span>
                <span class="mt-1 line-clamp-2 block text-sm text-muted">{localized(other, locale).description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Docs>
