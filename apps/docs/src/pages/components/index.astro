---
import Base from "../../layouts/Base.astro";
import { CATEGORY_LABELS, freshness, getComponents } from "../../lib/registry";

const items = await getComponents();
const thumbs = import.meta.glob<string>("../../../public/thumbs/*.webp", { query: "?url", import: "default", eager: true });
const hasThumb = (name: string) => `../../../public/thumbs/${name}.webp` in thumbs;
const categories = Object.entries(CATEGORY_LABELS).filter(([key]) => items.some((item) => item.category === key));
const control =
  "h-9 rounded-md border border-line bg-surface px-3 text-sm text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
---

<Base title="Komponen" description={`${items.length} komponen UI untuk Blade, React, dan Vue.`}>
  <main id="konten" class="mx-auto max-w-screen-xl px-4 py-10 sm:px-6" data-pagefind-body>
    <p class="label-mono mb-3">{items.length} komponen</p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Komponen</h1>
    <p class="mt-3 text-lg text-muted">Satu desain untuk Blade, React, dan Vue. Salin kodenya atau tambahkan lewat CLI.</p>

    <form class="mt-8 flex flex-wrap gap-3" role="search" data-filters data-pagefind-ignore>
      <label class="sr-only" for="filter-query">Cari komponen</label>
      <input id="filter-query" name="q" type="search" placeholder="Cari nama atau tag..." class={`${control} min-w-0 flex-1 sm:max-w-xs`} />
      <label class="sr-only" for="filter-category">Kategori</label>
      <select id="filter-category" name="category" class={control}>
        <option value="">Semua kategori</option>
        {categories.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
      <label class="sr-only" for="filter-sort">Urutan</label>
      <select id="filter-sort" name="sort" class={control}>
        <option value="az">A sampai Z</option>
        <option value="new">Terbaru</option>
      </select>
    </form>

    <p data-empty hidden class="mt-10 text-muted">Tidak ada komponen yang cocok.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-grid>
      {
        items.map((item) => {
          const label = freshness(item);
          return (
            <li
              data-card
              data-name={item.name}
              data-category={item.category}
              data-added={item.addedAt}
              data-search={[item.name, item.title, item.description, ...item.tags].join(" ").toLowerCase()}
            >
              <a
                href={`/components/${item.name}`}
                class="group block overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-primary-line"
              >
                <div class="dot-grid flex aspect-[16/10] items-center justify-center border-b border-line">
                  {hasThumb(item.name) ? (
                    <img
                      src={`/thumbs/${item.name}.webp`}
                      alt=""
                      width="480"
                      height="300"
                      loading="lazy"
                      decoding="async"
                      class="size-full object-cover dark:hidden"
                    />
                  ) : (
                    <span class="font-mono text-sm text-faint">{item.title}</span>
                  )}
                  {hasThumb(item.name) && (
                    <img
                      src={`/thumbs/${item.name}-dark.webp`}
                      alt=""
                      width="480"
                      height="300"
                      loading="lazy"
                      decoding="async"
                      class="hidden size-full object-cover dark:block"
                    />
                  )}
                </div>
                <div class="flex items-center justify-between gap-2 p-4">
                  <div>
                    <h2 class="font-semibold text-ink">{item.title}</h2>
                    <p class="label-mono mt-1">{CATEGORY_LABELS[item.category]}</p>
                  </div>
                  {label === "baru" && (
                    <span class="rounded-full border border-primary-line bg-primary-soft px-2 py-0.5 font-mono text-[10px] tracking-[0.2em] text-primary">
                      BARU
                    </span>
                  )}
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-filters]");
  const grid = document.querySelector<HTMLElement>("[data-grid]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  function apply() {
    if (!form || !grid || !empty) return;
    const data = new FormData(form);
    const query = String(data.get("q") ?? "").trim().toLowerCase();
    const category = String(data.get("category") ?? "");
    const sort = String(data.get("sort") ?? "az");

    const cards = [...grid.querySelectorAll<HTMLElement>("[data-card]")];
    let visible = 0;
    for (const card of cards) {
      const show = (!query || card.dataset.search!.includes(query)) && (!category || card.dataset.category === category);
      card.hidden = !show;
      if (show) visible++;
    }
    empty.hidden = visible > 0;

    const sorted = cards.toSorted((a, b) =>
      sort === "new" ? b.dataset.added!.localeCompare(a.dataset.added!) : a.dataset.name!.localeCompare(b.dataset.name!),
    );
    grid.append(...sorted);
  }

  form?.addEventListener("input", apply);
  form?.addEventListener("submit", (event) => event.preventDefault());
</script>
