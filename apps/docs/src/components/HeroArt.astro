---
import { BRAND_SHAPES } from "../lib/brand";

/**
 * Lukisan datar berlapis untuk hero landing: langit senja (gelap: malam berbintang),
 * matahari/bulan, awan, empat lapis bukit dengan kabut, dan siluet jenderal di puncak.
 * Warna diatur lewat variabel CSS di bawah supaya satu SVG melayani dua tema.
 */
type Point = readonly [number, number];

const WIDTH = 1440;
const HEIGHT = 860;

/** Kurva halus Catmull-Rom melewati titik-titik, lalu ditutup ke dasar gambar. */
function hill(points: readonly Point[]): string {
  const r = Math.round;
  const segments = points.slice(1).map((point, i) => {
    const p0 = points[i - 1] ?? points[i]!;
    const p1 = points[i]!;
    const p3 = points[i + 2] ?? point;
    const c1 = [p1[0] + (point[0] - p0[0]) / 6, p1[1] + (point[1] - p0[1]) / 6];
    const c2 = [point[0] - (p3[0] - p1[0]) / 6, point[1] - (p3[1] - p1[1]) / 6];
    return `C${r(c1[0]!)} ${r(c1[1]!)} ${r(c2[0]!)} ${r(c2[1]!)} ${point[0]} ${point[1]}`;
  });
  const [x0, y0] = points[0]!;
  const xn = points[points.length - 1]![0];
  return `M${x0} ${y0}${segments.join("")}L${xn} ${HEIGHT}L${x0} ${HEIGHT}Z`;
}

/** Pegunungan jauh bergerigi: garis lurus terasa lebih jauh daripada kurva. */
const ridge = (points: readonly Point[]) =>
  `M${points.map((p) => p.join(" ")).join("L")}L${WIDTH} ${HEIGHT}L0 ${HEIGHT}Z`;

const FAR = ridge([
  [0, 560], [70, 532], [130, 548], [220, 492], [290, 530], [360, 500], [440, 538], [530, 486], [610, 524],
  [690, 482], [770, 516], [850, 494], [930, 532], [1010, 512], [1100, 462], [1180, 508], [1260, 486],
  [1350, 526], [1440, 498],
]);
const MID = hill([[-20, 640], [160, 606], [330, 636], [520, 596], [700, 628], [860, 606], [1040, 646], [1210, 612], [1460, 636]]);
const NEAR = hill([
  [-20, 724], [200, 702], [420, 730], [640, 704], [820, 680], [930, 650], [1010, 637], [1090, 646], [1200, 690],
  [1330, 700], [1460, 688],
]);
const FRONT = hill([[-20, 772], [180, 748], [380, 778], [600, 800], [800, 790], [1000, 806], [1200, 772], [1460, 760]]);

/** Siluet jenderal tampak depan, tinggi 180 satuan, kaki di y=180: pet militer, mantel panjang tertiup angin, tangan di belakang. */
const GENERAL =
  "M-16 6Q0-1 16 6L15 9L10 13L10 16L12 17L8 19Q9 26 5 31L4 34L4 37Q14 37 21 40Q25 42 25 47L26 76Q25 82 20 88L17 92L22 120L30 146L42 150L30 152L13 152L13 172L19 175L19 180L4 180L5 157L-5 157L-4 180L-19 180L-19 175L-13 172L-13 152L-26 151L-22 120L-17 92L-20 88Q-25 82 -26 76L-25 47Q-25 42 -21 40Q-14 37 -4 37L-4 34L-5 31Q-9 26 -8 19L-12 17L-10 16L-10 13L-15 9Z" +
  "M18 56L22 76L18 84L16 62Z M-18 56L-16 62L-18 84L-22 76Z";

/** Bintang dengan posisi pseudo-acak tetap supaya hasil build stabil. */
let seed = 7;
const random = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
/** Tanpa bintang di belakang teks hero (desktop); yang berada di belakang teks versi mobile diberi kelas khusus. */
const STARS = Array.from({ length: 60 }, () => ({
  x: Math.round(random() * WIDTH),
  y: Math.round(random() * 420),
  r: (0.6 + random() * 0.9).toFixed(1),
}))
  .filter((star) => !(star.x < 780 && star.y > 110))
  .map((star) => ({ ...star, mobileText: star.x >= 560 && star.x <= 1200 && star.y < 200 }));

const FLAG_SCALE = 0.058;
---

<div class="hero-art" aria-hidden="true">
<svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} preserveAspectRatio="xMidYMax slice" focusable="false">
  <defs>
    <linearGradient id="hero-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="s1" />
      <stop offset="0.5" class="s2" />
      <stop offset="0.78" class="s3" />
    </linearGradient>
    <radialGradient id="hero-glow">
      <stop offset="0.35" class="g1" />
      <stop offset="1" class="g2" />
    </radialGradient>
    <linearGradient id="hero-mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="m0" />
      <stop offset="0.5" class="m1" />
      <stop offset="1" class="m0" />
    </linearGradient>
  </defs>

  <rect width={WIDTH} height={HEIGHT} fill="url(#hero-sky)" />
  <g class="hero-stars">{STARS.map((s) => <circle cx={s.x} cy={s.y} r={s.r} class:list={[s.mobileText && "hero-star-m"]} />)}</g>
  <circle cx="1010" cy="520" r="380" fill="url(#hero-glow)" />
  <circle class="hero-sun" cx="1010" cy="520" r="150" />

  <g class="hero-cloud hero-cloud-a">
    <rect x="70" y="170" width="250" height="22" rx="11" />
    <circle cx="160" cy="166" r="20" /><circle cx="205" cy="160" r="26" />
    <rect x="140" y="194" width="210" height="18" rx="9" />
  </g>
  <g class="hero-cloud hero-cloud-b">
    <rect x="1100" y="240" width="270" height="26" rx="13" />
    <circle cx="1190" cy="236" r="26" /><circle cx="1240" cy="226" r="34" /><circle cx="1290" cy="240" r="20" />
    <rect x="1040" y="268" width="230" height="22" rx="11" />
  </g>
  <g class="hero-cloud hero-cloud-c">
    <rect x="790" y="450" width="250" height="20" rx="10" />
    <rect x="860" y="474" width="320" height="20" rx="10" />
    <rect x="1120" y="420" width="190" height="16" rx="8" />
  </g>

  <path class="hero-far" d={FAR} />
  <rect class="hero-mist" y="540" width={WIDTH} height="120" fill="url(#hero-mist)" />
  <path class="hero-mid" d={MID} />
  <rect class="hero-mist hero-mist-low" y="630" width={WIDTH} height="110" fill="url(#hero-mist)" />
  <path class="hero-near" d={NEAR} />

  <g class="hero-figure">
    <path transform="translate(1004 430) scale(1.15)" d={GENERAL} fill-rule="evenodd" />
    <rect x="1064" y="376" width="4" height="265" />
    <g class="hero-flag" transform={`translate(1068 379) scale(${FLAG_SCALE})`}>
      {BRAND_SHAPES.map((shape) => <polygon points={shape.points} data-tone={shape.tone} />)}
    </g>
  </g>

  <path class="hero-front" d={FRONT} />
</svg>
</div>

<!-- is:inline: tetap di HTML, bukan file CSS terpisah yang memblokir render (anggaran LCP). -->
<style is:inline>
  .hero-art {
    /* Senja keemasan-hijau. */
    --sky-1: #e3ead5;
    --sky-2: #f3e6c3;
    --sky-3: #efc98a;
    --sun: #f6d27f;
    --glow: #fbe3a6;
    --glow-alpha: 0.75;
    --cloud: #f7e2b6;
    --far: #c5cda6;
    --mid: #92a882;
    --near: #4f6d4c;
    --front: #2f4734;
    --figure: #152016;
    --mist: #f7ebcd;
    --flag-a: #49ae7f;
    --flag-b: #2e6b3a;
    --flag-c: #daefe5;
    --stars: 0;
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--sky-1);
  }
  .hero-art svg {
    position: absolute;
    bottom: 0;
    left: 50%;
    height: var(--art-h, 100%);
    aspect-ratio: 1440 / 860;
    min-width: 100%;
    max-width: none;
    translate: var(--art-x, -50%) 0;
  }
  .dark .hero-art {
    /* Malam biru-hijau berbintang, bulan menggantikan matahari. */
    --sky-1: #081113;
    --sky-2: #0e1f25;
    --sky-3: #1b3735;
    --sun: #e6ecdc;
    --glow: #7fb5a0;
    --glow-alpha: 0.28;
    --cloud: #1a3135;
    --far: #15302e;
    --mid: #0f241f;
    --near: #0a1915;
    --front: #07110e;
    --figure: #020604;
    --mist: #1f3c39;
    --flag-a: #5fa36b;
    --flag-b: #2f6b3e;
    --flag-c: #9bc9b0;
    --stars: 0.85;
  }
  @media (max-width: 639px) {
    .hero-art {
      --art-x: -66%;
      --art-h: 70%;
    }
    .hero-star-m {
      display: none;
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .hero-art {
      --art-x: -58%;
      --art-h: 80%;
    }
  }

  .s1 { stop-color: var(--sky-1); }
  .s2 { stop-color: var(--sky-2); }
  .s3 { stop-color: var(--sky-3); }
  .g1 { stop-color: var(--glow); stop-opacity: var(--glow-alpha); }
  .g2 { stop-color: var(--glow); stop-opacity: 0; }
  .m0 { stop-color: var(--mist); stop-opacity: 0; }
  .m1 { stop-color: var(--mist); stop-opacity: 0.9; }

  .hero-stars { fill: #f4f1e3; opacity: var(--stars); }
  .hero-sun { fill: var(--sun); }
  .hero-cloud { fill: var(--cloud); }
  .hero-cloud-c { opacity: 0.92; }
  .hero-far { fill: var(--far); }
  .hero-mid { fill: var(--mid); }
  .hero-near { fill: var(--near); }
  .hero-front { fill: var(--front); }
  .hero-figure { fill: var(--figure); }
  .hero-flag [data-tone="back"], .hero-flag [data-tone="mint"] { fill: var(--flag-c); }
  .hero-flag [data-tone="upper"], .hero-flag [data-tone="mid"], .hero-flag [data-tone="green"] { fill: var(--flag-a); }
  .hero-flag [data-tone="dark"] { fill: var(--flag-b); }

  /* Gerak halus: hanya transform dan opacity. */
  .hero-cloud { animation: hero-drift 38s ease-in-out infinite alternate; }
  .hero-cloud-b { animation-duration: 46s; animation-direction: alternate-reverse; }
  .hero-cloud-c { animation-duration: 30s; }
  .hero-mist { animation: hero-breathe 9s ease-in-out infinite alternate; }
  .hero-mist-low { animation-delay: -4s; }
  .hero-flag polygon {
    transform-box: view-box;
    transform-origin: 0 700px;
    animation: hero-wave 2.6s ease-in-out infinite alternate;
  }
  @keyframes hero-drift {
    to { transform: translateX(46px); }
  }
  @keyframes hero-breathe {
    from { opacity: 0.55; }
    to { opacity: 1; }
  }
  @keyframes hero-wave {
    from { transform: skewY(-3deg) scaleX(1); }
    to { transform: skewY(4deg) scaleX(0.93); }
  }

  html[data-splash]:not([data-splash="leaving"]) .hero-art * {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-art * { animation: none !important; }
  }
</style>
