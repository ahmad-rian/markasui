---
import type { Framework } from "@markasui/registry/schema";
import Icon from "./Icon.astro";
import { getLocale, t } from "../lib/i18n";

interface Props {
  markdown: string;
  markdownUrl: string;
  /** Tanpa prompts (halaman docs), menu Copy prompt disembunyikan. */
  prompts?: Record<Framework, string>;
}
const { markdown, markdownUrl, prompts } = Astro.props;
const absoluteMd = new URL(markdownUrl, Astro.site).toString();
const strings = t(getLocale(Astro.url)).copyPage;
const ask = encodeURIComponent(strings.ask(absoluteMd));
const item =
  "flex w-full items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm text-ink transition-colors hover:bg-subtle focus-visible:bg-subtle";
---

<div class="flex items-center" data-copy-page>
  <script type="application/json" data-copy-page-data set:html={JSON.stringify({ markdown, prompts: prompts ?? {} }).replaceAll("<", "\\u003c")} />
  <button
    type="button"
    data-copy-markdown
    class="inline-flex h-9 items-center gap-2 rounded-l-lg bg-subtle pr-3 pl-3.5 text-sm font-medium text-ink transition-colors hover:bg-line"
  >
    <Icon name="copy" class="size-4 in-data-copied:hidden" />
    <Icon name="check" class="hidden size-4 text-primary in-data-copied:block" />
    {strings.copy}
  </button>
  <button
    type="button"
    popovertarget="copy-page-menu"
    aria-label={strings.more}
    class="inline-flex h-9 items-center rounded-r-lg border-l border-surface bg-subtle px-2.5 text-ink transition-colors hover:bg-line"
  >
    <Icon name="chevronDown" class="size-4" />
  </button>
  <div
    id="copy-page-menu"
    popover
    role="menu"
    class="m-0 w-60 rounded-xl border border-line bg-surface p-1 text-ink shadow-overlay [position-area:bottom_span-left] [position-try-fallbacks:flip-block]"
  >
    {prompts && (<button type="button" role="menuitem" data-copy-prompt class={item}>
      <Icon name="message" class="size-4 text-muted" />
      <span class="in-data-copied:hidden">{strings.prompt}</span>
      <span class="hidden in-data-copied:inline">{strings.promptCopied}</span>
    </button>)}
    <a role="menuitem" href={markdownUrl} class={item}><Icon name="file" class="size-4 text-muted" />{strings.markdown}</a>
    <a role="menuitem" href={`https://claude.ai/new?q=${ask}`} target="_blank" rel="noopener" class={item}>
      <Icon name="external" class="size-4 text-muted" />{strings.claude}
    </a>
    <a role="menuitem" href={`https://chatgpt.com/?q=${ask}`} target="_blank" rel="noopener" class={item}>
      <Icon name="external" class="size-4 text-muted" />{strings.chatgpt}
    </a>
  </div>
</div>

<script>
  import { copyText } from "../scripts/clipboard";
  import { onPageLoad } from "../scripts/lifecycle";
  import { getFramework } from "../scripts/prefs";

  onPageLoad(() => document.querySelectorAll<HTMLElement>("[data-copy-page]:not([data-ready])").forEach((root) => {
    root.dataset.ready = "";
    const raw = root.querySelector("[data-copy-page-data]")?.textContent;
    if (!raw) return;
    const data = JSON.parse(raw) as { markdown: string; prompts: Record<string, string> };

    const markdownButton = root.querySelector<HTMLElement>("[data-copy-markdown]");
    markdownButton?.addEventListener("click", () => void copyText(data.markdown, markdownButton));

    const promptButton = root.querySelector<HTMLElement>("[data-copy-prompt]");
    promptButton?.addEventListener("click", () => void copyText(data.prompts[getFramework()] ?? "", promptButton));

    // Navigasi panah di dalam menu (WAI-ARIA menu).
    const menu = root.querySelector<HTMLElement>("[role=menu]");
    menu?.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState === "open") menu.querySelector<HTMLElement>("[role=menuitem]")?.focus();
    });
    menu?.addEventListener("keydown", (event) => {
      const items = [...menu.querySelectorAll<HTMLElement>("[role=menuitem]")];
      const index = items.indexOf(document.activeElement as HTMLElement);
      const next = { ArrowDown: index + 1, ArrowUp: index - 1, Home: 0, End: items.length - 1 }[event.key];
      if (next === undefined) return;
      event.preventDefault();
      items[(next + items.length) % items.length]?.focus();
    });
  }));
</script>
