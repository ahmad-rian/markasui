---
import BrandMark from "./BrandMark.astro";

/**
 * Kolase "Every component, alive": HTML Blade asli dari examples/, dipasang miring di sekitar simbol brand.
 * Murni dekorasi (inert, aria-hidden); komponen yang bisa dicoba ada di halaman masing-masing.
 */
const bladeFiles = import.meta.glob<string>("../generated/blade/*.html", { query: "?raw", import: "default", eager: true });
const html = (name: string) => bladeFiles[`../generated/blade/${name}.html`] ?? "";

const cards = [
  { name: "tabs", label: "Tabs", desktop: "left-[2%] top-[22%] w-[300px] -rotate-3", depth: true },
  { name: "checkbox", label: "Checkbox", desktop: "left-[24%] top-[2%] w-[260px] rotate-2", depth: true },
  { name: "progress", label: "Progress", desktop: "left-[30%] bottom-[2%] w-[300px] -rotate-1", depth: false },
  { name: "badge", label: "Badge", desktop: "right-[26%] top-[4%] w-[280px] -rotate-2", depth: true },
  { name: "radio-group", label: "Radio Group", desktop: "right-[2%] top-[26%] w-[280px] rotate-3", depth: true },
  { name: "switch", label: "Switch", desktop: "left-[6%] bottom-[8%] w-[280px] rotate-2", depth: false },
  { name: "alert", label: "Alert", desktop: "right-[4%] bottom-[4%] w-[340px] -rotate-2", depth: false },
];
const card = "max-h-60 overflow-hidden rounded-2xl border border-line bg-surface p-4 shadow-overlay";
---

<div class="relative" aria-hidden="true" inert>
  <div class="relative mx-auto hidden h-[640px] max-w-6xl lg:block">
    <div class="absolute inset-0 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--color-ink)_7%,transparent),transparent)]"></div>
    {
      cards.map((item) => (
        <div class:list={["absolute", item.desktop, item.depth && "opacity-70 blur-[1.5px]"]}>
          <div class={card}>
            <p class="mb-3 text-xs text-muted">{item.label}</p>
            <div class="origin-top-left scale-[0.82] [&_*]:pointer-events-none" set:html={html(item.name)} />
          </div>
        </div>
      ))
    }
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
      <BrandMark class="h-56 w-auto drop-shadow-[0_24px_48px_rgb(0_0_0/0.12)]" />
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:hidden">
    {
      cards.slice(0, 4).map((item) => (
        <div class={card}>
          <p class="mb-3 text-xs text-muted">{item.label}</p>
          <div class="[&_*]:pointer-events-none" set:html={html(item.name)} />
        </div>
      ))
    }
  </div>
</div>
