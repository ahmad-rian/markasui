---
import { BRAND_SHAPES, BRAND_VIEWBOX } from "../lib/brand";
import { LOCALES, t } from "../lib/i18n";


---

<div
  id="language-overlay"
  transition:persist="language-overlay"
  data-language-overlay
  role="status"
  aria-live="polite"
  hidden
  class="fixed inset-0 z-[60] flex flex-col items-center justify-center gap-7 bg-surface px-6 text-center opacity-0 transition-opacity duration-200 ease-out data-visible:opacity-100"
>
  <svg viewBox={BRAND_VIEWBOX} class="brand-mark lang-logo h-28 w-auto" aria-hidden="true">
    {BRAND_SHAPES.map((shape, index) => <polygon points={shape.points} data-tone={shape.tone} style={`--i:${index}`} />)}
  </svg>
  {
    LOCALES.map((locale) => (
      <div data-overlay-lang={locale} lang={locale} hidden class="grid gap-2">
        <p class="text-[32px] leading-tight font-semibold tracking-[-0.025em] sm:text-[40px]">
          {t(locale).switching.title}
          <span class="lang-dots" aria-hidden="true">
            <span>.</span>
            <span>.</span>
            <span>.</span>
          </span>
        </p>
        <p class="text-[15px] text-muted">{t(locale).switching.subtitle}</p>
      </div>
    ))
  }
  <div class="h-0.5 w-56 overflow-hidden rounded-full bg-subtle" aria-hidden="true">
    <div class="lang-progress h-full rounded-full bg-brand"></div>
  </div>
</div>
