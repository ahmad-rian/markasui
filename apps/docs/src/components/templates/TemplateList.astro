---
/** Daftar kartu template (dashboard atau page) dengan thumbnail iframe lazy. Dipakai /templates dan /pages. */
import Icon from "../Icon.astro";
import TemplateSectors from "./TemplateSectors.astro";
import Base from "../../layouts/Base.astro";
import { localePath, t, type Locale } from "../../lib/i18n";
import { collectionPage } from "../../lib/seo";
import { KIND_BASE, templateDetailPath, type Template } from "../../lib/templates";

interface Props {
  title: string;
  subtitle: string;
  templates: Template[];
  locale: Locale;
  /** Teks saat belum ada isi. */
  empty: string;
  /** Judul dan deskripsi untuk mesin pencari. */
  seo: { title: string; description: string };
  kind: Template["kind"];
}

const { title, subtitle, templates, locale, empty, seo, kind } = Astro.props;
const absolute = (path: string) => new URL(localePath(locale, path), Astro.site).toString();
const base = KIND_BASE[kind];
const sectorsLabel = t(locale).templates.sectors;
const jsonLd = [
  collectionPage(
    { url: absolute(base), name: seo.title, description: seo.description, locale },
    templates.map((template) => ({ name: template.headline[locale], url: absolute(templateDetailPath(template)) })),
  ),
];
---

<Base title={seo.title} description={seo.description} breadcrumbs={[{ name: title, path: base }]} jsonLd={jsonLd}>
  <main id="konten" class="mx-auto max-w-screen-xl px-4 pt-10 pb-24 sm:px-6 sm:pt-14 lg:px-8" data-pagefind-body>
    <h1 class="text-[34px] leading-tight font-semibold tracking-[-0.025em] sm:text-[38px]">{title}</h1>
    <p class="mt-3 max-w-2xl text-lg leading-8 text-muted">{subtitle}</p>
    {
      templates.length === 0 ? (
        <div data-template-empty class="frame mt-10">
          <div class="frame-panel flex flex-col items-center justify-center gap-3 px-6 py-20 text-center">
            <span class="inline-flex size-10 items-center justify-center rounded-lg shadow-[0_0_0_1px_var(--color-line)]">
              <Icon name="file" class="size-5 text-muted" />
            </span>
            <p class="max-w-sm text-muted">{empty}</p>
          </div>
        </div>
      ) : (
        <ul class="mt-10 grid gap-6 md:grid-cols-2">
          {templates.map((template) => (
            <li>
              <a href={localePath(locale, templateDetailPath(template))} class="frame group block transition-colors hover:bg-line">
                <div class="frame-panel relative aspect-[16/10] overflow-hidden">
                  <iframe
                    src={`/demo/templates/${template.name}/react`}
                    title={template.headline[locale]}
                    loading="lazy"
                    tabindex="-1"
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 left-0 h-[900px] w-[1440px] origin-top-left scale-[0.4] border-0 sm:scale-[0.42] lg:scale-[0.41]"
                  />
                </div>
                <div class="px-3 pt-3 pb-2.5">
                  <div class="flex items-baseline justify-between gap-3">
                    <h2 class="font-medium text-ink">{template.headline[locale]}</h2>
                    <span class="shrink-0 text-sm text-muted">{template.title}</span>
                  </div>
                  <p class="mt-1 text-sm text-muted">{template.description[locale]}</p>
                  <TemplateSectors label={sectorsLabel} sectors={template.sectors[locale]} class="mt-3" />
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
