---
/**
 * Halaman detail bersama untuk dashboard (/templates/<slug>) dan page (/pages/<slug>):
 * pratinjau dengan pemilih aksen, kode yang dimuat saat diminta, komponen yang dipakai, dan instalasi.
 */
import "../../styles/global.css";
import CodeBlock from "../CodeBlock.astro";
import CopyPage from "../CopyPage.astro";
import Icon from "../Icon.astro";
import Tabs from "../Tabs.astro";
import TemplateSectors from "./TemplateSectors.astro";
import Docs from "../../layouts/Docs.astro";
import { ACCENTS } from "../../lib/accents";
import { FRAMEWORK_LABELS, PACKAGE_MANAGERS, cliCommand } from "../../lib/frameworks";
import { TEMPLATE_FRAMEWORKS } from "../../lib/templates";
import { localePath, t, type Locale } from "../../lib/i18n";
import { getComponents, localized } from "../../lib/registry";
import { SITE } from "../../lib/site";
import { KIND_BASE, templateDetailPath, type Template } from "../../lib/templates";
import { fitDescription, frameworkList, sourceCode } from "../../lib/seo";
import { ogImagePath } from "../../lib/seo-files";
import { templateMarkdown, templatePrompts } from "../../lib/template-ai";

interface Props {
  template: Template;
  locale: Locale;
}

const { template, locale } = Astro.props;
const dictionary = t(locale);
const strings = template.kind === "page" ? { ...dictionary.templates, ...dictionary.pages } : dictionary.templates;
const component = dictionary.component;
const registry = new Map((await getComponents()).map((item) => [item.name, item]));
const site = Astro.site!.toString();
const markdown = templateMarkdown(template, registry, site, locale);
const prompts = templatePrompts(template, site, locale, component.unavailable);
const used = template.components.flatMap((name) => {
  const item = registry.get(name);
  return item ? [{ name, title: item.title, description: localized(item, locale).description }] : [];
});
const thumbs = import.meta.glob<string>("../../../public/thumbs/*.webp", { query: "?url", import: "default", eager: true });
const hasThumb = (name: string) => `../../../public/thumbs/${name}.webp` in thumbs;
const demo = `/demo/templates/${template.name}/blade?accent=${template.accent}`;
const frameworks = template.frameworks;
/** Versi yang belum di-porting: preview memakai React, kode diberi pesan "belum tersedia". */
const pending = TEMPLATE_FRAMEWORKS.filter((fw) => !frameworks.includes(fw));

const path = templateDetailPath(template);
const headline = template.headline[locale];
const sourceList = frameworkList(frameworks, locale);
const seoTitle = dictionary.seo.templateTitle(headline, sourceList);
const seoDescription = fitDescription(template.description[locale], dictionary.seo.templateTails(sourceList));
const ogImage = ogImagePath(locale, path);
const jsonLd = [
  sourceCode({
    url: new URL(localePath(locale, path), Astro.site).toString(),
    name: headline,
    description: seoDescription,
    locale,
    repository: `${SITE.repo}/tree/main/templates/${template.name}`,
    image: ogImage && new URL(ogImage, Astro.site).toString(),
    published: template.addedAt,
  }),
];
const breadcrumbs = [
  { name: template.kind === "page" ? dictionary.nav.pages : dictionary.nav.templates, path: KIND_BASE[template.kind] },
  { name: headline, path },
];
---

<Docs title={seoTitle} description={seoDescription} wide breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
    <div class="max-w-2xl">
      <p class="text-sm text-muted">{template.title}</p>
      <h1 class="mt-1 text-[34px] leading-tight font-semibold tracking-[-0.025em] sm:text-[38px]">{headline}</h1>
      <p class="mt-3 text-lg leading-8 text-muted">{template.description[locale]}</p>
      <TemplateSectors label={dictionary.templates.sectors} sectors={template.sectors[locale]} class="mt-4" />
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <CopyPage markdown={markdown} markdownUrl={localePath(locale, `${path}.md`)} prompts={prompts} ask={dictionary.copyPage.askTemplate} />
      <a href={demo} data-template-open class="soft-button" target="_blank" rel="noopener">
        {strings.open}
        <Icon name="external" />
      </a>
    </div>
  </div>

  <section class="mt-8" aria-labelledby="preview">
    <h2 id="preview" class="sr-only">{strings.preview}</h2>
    <div class="frame">
      <div class="flex flex-wrap items-center justify-between gap-3 px-2 pt-1 pb-2">
        <div role="radiogroup" aria-label={strings.accent} data-accent-picker={template.name} data-default-accent={template.accent} class="flex flex-wrap items-center gap-1.5">
          <span class="mr-1.5 text-sm text-muted" aria-hidden="true">{strings.accent}</span>
          {
            ACCENTS.map((accent) => (
              <button
                type="button"
                role="radio"
                aria-checked={accent.name === template.accent ? "true" : "false"}
                aria-label={accent.label}
                title={accent.label}
                data-accent={accent.name}
                class="grid size-7 place-items-center rounded-full transition-transform duration-150 ease-out hover:scale-110 aria-checked:ring-2 aria-checked:ring-ink aria-checked:ring-offset-2 aria-checked:ring-offset-subtle"
              >
                <span class="size-5 rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.12)]" style={`background:${accent.swatch}`} />
              </button>
            ))
          }
        </div>
      </div>
      <div class="frame-panel overflow-hidden">
        <iframe data-template-frame={template.name} data-template-frameworks={frameworks.join(",")} src={demo} title={`${headline}: ${strings.preview}`} class="h-[min(860px,80dvh)] w-full border-0" loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <section class="mt-6 grid grid-cols-[minmax(0,1fr)]" aria-label={strings.code}>
    {
      frameworks.map((fw) => (
        <div data-fw={fw} data-template-code={`/snippets/templates/${template.name}/${fw}`} class="frame">
          <div class="flex items-center justify-between gap-3 px-3 py-2">
            <span class="truncate font-mono text-[13px] text-muted">{template.sources[fw]!.path}</span>
            <span class="shrink-0 text-xs text-muted">{strings.lines(template.sources[fw]!.code.split("\n").length)}</span>
          </div>
          <div class="frame-panel flex items-center justify-center px-4 py-8">
            <button type="button" data-template-code-load class="soft-button">
              <Icon name="file" class="size-4" />
              {strings.viewCode}
            </button>
          </div>
        </div>
      ))
    }
    {
      pending.map((fw) => (
        <p data-fw={fw} class="text-sm text-muted">
          {component.unavailable(FRAMEWORK_LABELS[fw])}
        </p>
      ))
    }
  </section>

  <section class="mt-16" aria-labelledby="components">
    <h2 id="components" class="text-2xl font-semibold tracking-[-0.02em]">{strings.components}</h2>
    <p class="mt-2 max-w-2xl text-muted">{strings.componentsText(used.length)}</p>
    <ul class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 2xl:grid-cols-4">
      {
        used.map((item) => (
          <li>
            <a href={localePath(locale, `/components/${item.name}`)} class="frame group block h-full transition-colors hover:bg-line">
              <div class="frame-panel aspect-[16/10] overflow-hidden">
                {hasThumb(item.name) ? (
                  <>
                    <img src={`/thumbs/${item.name}.webp`} alt="" width="480" height="300" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03] dark:hidden" />
                    <img src={`/thumbs/${item.name}-dark.webp`} alt="" width="480" height="300" loading="lazy" decoding="async" class="hidden size-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03] dark:block" />
                  </>
                ) : (
                  <span class="flex size-full items-center justify-center text-sm text-muted">{item.title}</span>
                )}
              </div>
              <div class="px-3 pt-3 pb-2">
                <h3 class="font-medium text-ink">{item.title}</h3>
                <p class="mt-1 line-clamp-2 text-sm text-muted">{item.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 max-w-3xl" aria-labelledby="install">
    <h2 id="install" class="text-2xl font-semibold tracking-[-0.02em]">{strings.install}</h2>
    <p class="mt-2 text-muted">{strings.installText}</p>
    <div class="mt-5">
      <Tabs label={component.packageManager} framed group="package-manager" items={PACKAGE_MANAGERS.map((pm) => ({ value: pm, label: pm }))}>
        {
          PACKAGE_MANAGERS.map((pm) => (
            <div slot={pm}>
              <CodeBlock code={cliCommand(pm, `add ${template.components.join(" ")}`)} lang="bash" bare />
            </div>
          ))
        }
      </Tabs>
    </div>
    <a href={`${SITE.repo}/tree/main/templates/${template.name}`} class="mt-5 inline-flex min-h-6 items-center gap-2 text-sm text-brand underline decoration-brand-line underline-offset-4 hover:decoration-brand" target="_blank" rel="noopener">
      {strings.source}
      <Icon name="external" class="size-3.5" />
    </a>
  </section>
</Docs>

<script>
  import { onPageLoad } from "../../scripts/lifecycle";
  import { TEMPLATE_FALLBACK_FRAMEWORK } from "../../lib/template-frameworks";
  import { getFramework } from "../../scripts/prefs";

  /** Pilihan aksen disimpan per template, karena setiap template punya aksen bawaan sendiri (meta.json). */
  const ACCENT_KEY = "markas-template-accent";
  const picker = () => document.querySelector<HTMLElement>("[data-accent-picker]");
  const accentKey = () => `${ACCENT_KEY}:${picker()?.dataset.accentPicker ?? ""}`;
  const isPickable = (accent: string | null): accent is string =>
    !!accent && !!picker()?.querySelector(`[role=radio][data-accent="${accent}"]`);
  const readAccent = () => {
    const fallback = picker()?.dataset.defaultAccent ?? "neutral";
    try {
      const stored = localStorage.getItem(accentKey());
      return isPickable(stored) ? stored : fallback;
    } catch {
      return fallback;
    }
  };
  const themeOf = () => (document.documentElement.classList.contains("dark") ? "dark" : "light");
  /** Versi framework terpilih kalau template ini sudah punya (data-template-frameworks), selain itu React. */
  const demoFramework = (frame: HTMLIFrameElement) => {
    const available = (frame.dataset.templateFrameworks ?? "").split(",");
    return available.includes(getFramework()) ? getFramework() : TEMPLATE_FALLBACK_FRAMEWORK;
  };
  const demoUrl = (frame: HTMLIFrameElement) =>
    `/demo/templates/${frame.dataset.templateFrame}/${demoFramework(frame)}?accent=${readAccent()}&theme=${themeOf()}`;
  const post = (data: object) =>
    document.querySelectorAll<HTMLIFrameElement>("[data-template-frame]").forEach((frame) => frame.contentWindow?.postMessage(data, location.origin));

  /** Iframe dan tombol layar penuh mengikuti framework, warna aksen, dan tema yang dipilih. */
  function sync() {
    document.querySelectorAll<HTMLIFrameElement>("[data-template-frame]").forEach((frame) => {
      const url = demoUrl(frame);
      const framework = `/${demoFramework(frame)}?`;
      // Sekali saat dimuat: pilihan aksen tersimpan bisa beda dari bawaan di src awal. Setelahnya lewat postMessage.
      const staleAccent = !frame.dataset.synced && new URL(frame.src).searchParams.get("accent") !== readAccent();
      frame.dataset.synced = "true";
      if (!frame.src.includes(framework) || staleAccent) frame.src = url;
      document.querySelectorAll<HTMLAnchorElement>("[data-template-open]").forEach((link) => (link.href = url));
    });
    const accent = readAccent();
    document.querySelectorAll<HTMLElement>("[data-accent-picker] [role=radio]").forEach((radio) => {
      radio.setAttribute("aria-checked", String(radio.dataset.accent === accent));
      radio.tabIndex = radio.dataset.accent === accent ? 0 : -1;
    });
  }

  function choose(accent: string) {
    try {
      localStorage.setItem(accentKey(), accent);
    } catch {
      // Storage diblok: warna tetap berganti untuk sesi ini lewat postMessage.
    }
    post({ type: "markas:accent", accent });
    sync();
  }

  document.addEventListener("click", (event) => {
    const radio = (event.target as HTMLElement).closest<HTMLElement>("[data-accent-picker] [role=radio]");
    if (radio?.dataset.accent) choose(radio.dataset.accent);
  });
  document.addEventListener("keydown", (event) => {
    const group = (event.target as HTMLElement).closest<HTMLElement>("[data-accent-picker]");
    const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
    if (!group || !step) return;
    event.preventDefault();
    const radios = [...group.querySelectorAll<HTMLElement>("[role=radio]")];
    const index = radios.findIndex((radio) => radio.getAttribute("aria-checked") === "true");
    const next = radios[(index + step + radios.length) % radios.length]!;
    choose(next.dataset.accent!);
    next.focus();
  });

  // Tema situs berganti: teruskan ke iframe tanpa memuat ulang.
  new MutationObserver(() => post({ type: "markas:theme", theme: themeOf() })).observe(document.documentElement, { attributeFilter: ["class"] });

  // Kode template besar, jadi dimuat saat diminta dari /snippets/templates/<slug>/<fw>.
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-template-code-load]");
    const holder = button?.closest<HTMLElement>("[data-template-code]");
    if (!button || !holder) return;
    button.disabled = true;
    try {
      const response = await fetch(holder.dataset.templateCode!);
      if (!response.ok) throw new Error(String(response.status));
      const html = new DOMParser().parseFromString(await response.text(), "text/html");
      const block = html.querySelector("[data-code-block]");
      if (!block) throw new Error("code block missing");
      holder.replaceChildren(block);
      holder.classList.remove("frame");
    } catch {
      button.disabled = false;
    }
  });

  onPageLoad(sync);
  document.addEventListener("markas:framework", sync);
</script>
