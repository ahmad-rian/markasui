---
import Icon from "./Icon.astro";
import { getLocale, t } from "../lib/i18n";

const strings = t(getLocale(Astro.url)).search;
const label = t(getLocale(Astro.url)).header.search;

interface Props {
  /** Header landing memasang tombol (ikon saja) di bilah gelap dan dialognya di luar, agar dialog tetap mengikuti tema halaman. */
  part?: "all" | "trigger" | "dialog";
}
const { part = "all" } = Astro.props;
const trigger = part !== "dialog";
const dialog = part !== "trigger";
const iconOnly = part === "trigger";
---

{
  trigger && iconOnly && (
    <button type="button" data-search-open class="icon-button" aria-label={label}>
      <Icon name="search" class="size-4" />
    </button>
  )
}
{
  trigger && !iconOnly && (
<button
  type="button"
  data-search-open
  class="icon-button md:h-9 md:w-64 md:justify-start md:gap-2 md:bg-subtle md:px-3 md:text-muted md:hover:bg-line/70"
>
  <Icon name="search" class="size-4 md:hidden" />
  <span class="sr-only text-sm md:not-sr-only">{strings.trigger}</span>
  <span aria-hidden="true" class="ml-auto hidden items-center gap-1 md:inline-flex">
    <kbd data-shortcut-mod class="inline-flex h-5 min-w-5 px-1 items-center justify-center rounded-md bg-surface font-sans text-[11px] text-muted shadow-[0_0_0_1px_var(--color-line)]">Ctrl</kbd>
    <kbd class="inline-flex size-5 items-center justify-center rounded-md bg-surface font-sans text-[11px] text-muted shadow-[0_0_0_1px_var(--color-line)]">K</kbd>
  </span>
</button>
  )
}

{
  dialog && (
<dialog
  data-search-dialog
  aria-label={strings.dialog}
  data-strings={JSON.stringify({ idle: strings.idle, unavailable: strings.unavailable, none: strings.none, one: strings.results(1), many: strings.results(2).replace("2", "{n}") })}
  class="mx-auto mt-[10vh] w-[calc(100%-2rem)] max-w-xl rounded-2xl border border-line bg-surface p-0 text-ink shadow-overlay backdrop:bg-ink/30"
>
  <form method="dialog" class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="search" class="size-4 text-muted" />
    <label for="search-input" class="sr-only">{strings.keyword}</label>
    <input
      id="search-input"
      data-search-input
      type="search"
      autocomplete="off"
      placeholder={strings.placeholder}
      class="h-14 min-w-0 flex-1 bg-transparent text-[15px] outline-none placeholder:text-faint"
    />
    <button type="submit" class="rounded-md border border-line px-1.5 font-mono text-[11px] leading-5 text-muted">Esc</button>
  </form>
  <div data-search-status role="status" class="px-5 pt-3 pb-2 text-[13px] text-muted">{strings.idle}</div>
  <ul data-search-results class="max-h-[55vh] overflow-y-auto px-2 pb-2"></ul>
</dialog>
  )
}
