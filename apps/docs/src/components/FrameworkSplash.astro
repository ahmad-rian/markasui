---
import { FRAMEWORKS } from "@markasui/registry/schema";
import FrameworkIcon from "./FrameworkIcon.astro";
import { FRAMEWORK_LABELS } from "../lib/frameworks";
import { getLocale, t } from "../lib/i18n";

/**
 * Tanda setelah pengunjung memilih framework lain di switcher: layar penuh seperti overlay ganti bahasa
 * (LanguageOverlay.astro), dengan logo framework berwarna brand dan "Now showing <framework>", sekitar satu detik.
 * Tidak menangkap klik, plus pengumuman aria-live untuk pembaca layar. Popover manual supaya tampil di top layer,
 * juga di atas laci menu (dialog modal) di ponsel. Dikendalikan oleh scripts/framework-splash.ts; tidak tampil saat
 * load pertama atau saat pilihan tersimpan dipasang.
 */
const nowShowing = t(getLocale(Astro.url)).framework.nowShowing;
---

<div class="fw-splash" popover="manual" aria-hidden="true" data-framework-splash>
  {
    FRAMEWORKS.map((framework) => (
      <div class="fw-splash-item" data-splash-fw={framework} data-message={`${nowShowing} ${FRAMEWORK_LABELS[framework]}`} hidden>
        <FrameworkIcon framework={framework} brand class="fw-splash-logo" />
        <p class="fw-splash-text">
          <span class="fw-splash-kicker">{nowShowing}</span>
          <span class="fw-splash-name">{FRAMEWORK_LABELS[framework]}</span>
        </p>
      </div>
    ))
  }
  <div class="fw-splash-track">
    <div class="fw-splash-progress"></div>
  </div>
</div>
<p class="sr-only" role="status" aria-live="polite" data-framework-announce></p>

<style is:global>
  .fw-splash {
    /* Reset gaya bawaan [popover]: selebar layar, tanpa border. */
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 24px;
    border: 0;
    background: var(--color-surface);
    color: var(--color-ink);
    pointer-events: none;
  }
  .fw-splash:popover-open {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: center;
    animation: fw-splash 1000ms var(--ease-out-quint) forwards;
  }
  .fw-splash-item {
    display: grid;
    justify-items: center;
    gap: 24px;
    animation: fw-splash-content 1000ms var(--ease-out-quint) forwards;
  }
  .fw-splash-item[hidden] {
    display: none;
  }
  .fw-splash-logo {
    width: 96px;
    height: 96px;
  }
  .fw-splash-text {
    display: grid;
    gap: 6px;
  }
  .fw-splash-kicker {
    font-size: 15px;
    line-height: 22px;
    color: var(--color-muted);
  }
  .fw-splash-name {
    font-size: 40px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .fw-splash-track {
    width: 224px;
    height: 2px;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--color-subtle);
  }
  .fw-splash-progress {
    height: 100%;
    border-radius: 9999px;
    background: var(--color-brand);
    animation: fw-splash-progress 850ms var(--ease-out-quint) forwards;
  }
  @keyframes fw-splash {
    0% {
      opacity: 0;
    }
    15%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes fw-splash-content {
    0% {
      transform: translateY(8px) scale(0.97);
    }
    30%,
    100% {
      transform: none;
    }
  }
  @keyframes fw-splash-progress {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fw-splash:popover-open,
    .fw-splash-item,
    .fw-splash-progress {
      animation: none;
    }
  }
</style>
