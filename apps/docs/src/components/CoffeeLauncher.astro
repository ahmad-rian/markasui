---
import CoffeeCup from "./CoffeeCup.astro";
import Icon from "./Icon.astro";
import { localePath, getLocale } from "../lib/i18n";
import { SUPPORT_AMOUNT_PARAM, SUPPORT_PATH, SUPPORT_PRESETS, supportStrings } from "../lib/support";

/**
 * Floating "Buy me a coffee" card at the bottom right of every docs page (Base.astro leaves it out on /support, the
 * 404 and other noindex pages). Closed: a card with a Lottie cup, title and subtitle that opens the popover; below
 * 640 px, or after the reader presses its x, a round button with the cup. The popover is native (Escape, light dismiss
 * and focus return come from the browser); scripts/coffee.ts handles the delayed entrance, aria-expanded, focus into
 * the popover, minimizing for the visit and the 7-day "hide"; scripts/coffee-lottie.ts plays the cup.
 */
const locale = getLocale(Astro.url);
const copy = supportStrings(locale);
const text = copy.launcher;
const supportHref = localePath(locale, SUPPORT_PATH);
const chips = SUPPORT_PRESETS.map((amount) => ({
  href: `${supportHref}?${SUPPORT_AMOUNT_PARAM}=${amount}`,
  label: `Rp ${amount / 1000}${text.thousand}`,
}));
---

<div class="coffee" data-coffee data-state="idle">
  <div id="coffee-card" class="coffee-card" popover="auto" role="dialog" aria-labelledby="coffee-title" tabindex="-1" data-coffee-card>
    <div class="coffee-head">
      <h2 id="coffee-title" class="coffee-title">{copy.title}</h2>
      <button type="button" class="coffee-icon-button" popovertarget="coffee-card" popovertargetaction="hide" aria-label={text.close}>
        <Icon name="close" class="coffee-close-icon" />
      </button>
    </div>
    <p class="coffee-text">{text.text}</p>
    <ul class="coffee-chips" aria-label={copy.presets}>
      {
        chips.map((chip) => (
          <li>
            <a href={chip.href} class="coffee-chip">
              {chip.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={supportHref} class="coffee-cta">
      <Icon name="coffee" class="coffee-cta-icon" />
      {text.cta}
    </a>
    <button type="button" class="coffee-hide" data-coffee-hide>{text.hide}</button>
  </div>
  <div class="coffee-launch">
    <button
      type="button"
      class="coffee-toggle"
      popovertarget="coffee-card"
      aria-controls="coffee-card"
      aria-expanded="false"
      aria-describedby="coffee-sub"
      data-coffee-toggle
    >
      <CoffeeCup />
      <span class="coffee-copy">
        <span class="coffee-name">{text.open}</span>
        {/* Read as the description, not as part of the name. */}
        <span id="coffee-sub" class="coffee-sub" aria-hidden="true">{text.subtitle}</span>
      </span>
      <Icon name="chevronRight" class="coffee-chevron" />
    </button>
    <button type="button" class="coffee-minimize" aria-label={text.minimize} data-coffee-minimize>
      <Icon name="close" class="coffee-minimize-icon" />
    </button>
  </div>
</div>

<style is:global>
  .coffee {
    --coffee-gap: 24px;
    /* Height of the launcher; the popover opens above it. */
    --coffee-launch-h: 88px;
    /* Sticky site header (64 px) plus a little air: the popover never reaches it. */
    --coffee-header-room: calc(72px + env(safe-area-inset-top));
    position: fixed;
    right: calc(var(--coffee-gap) + env(safe-area-inset-right));
    bottom: calc(var(--coffee-gap) + env(safe-area-inset-bottom));
    z-index: 30;
    transition:
      opacity 500ms var(--ease-out-quint),
      transform 500ms var(--ease-out-quint);
  }
  .coffee[hidden] {
    display: none;
  }
  .coffee[data-state="idle"] {
    visibility: hidden;
    opacity: 0;
    transform: translateY(16px);
  }
  .coffee[data-instant] {
    transition: none;
  }
  /* Menu drawer open or a toast demo showing at the same corner: step aside. */
  html:has(dialog[data-drawer][open]) .coffee,
  body:has(.fixed.right-4.bottom-4 > :not(template)) .coffee {
    visibility: hidden;
    opacity: 0;
  }
  /* Room under the footer so the card never sits on its last links. */
  body:has(.coffee) > footer {
    padding-bottom: 128px;
  }

  .coffee-launch {
    position: relative;
  }
  .coffee-toggle {
    display: grid;
    /* Same width as the popover above it. */
    width: 300px;
    height: var(--coffee-launch-h);
    grid-template-columns: 64px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 14px;
    padding: 12px 16px 12px 12px;
    border-radius: 18px;
    background: var(--color-surface);
    color: var(--color-ink);
    text-align: left;
    box-shadow:
      0 0 0 1px var(--color-line),
      0 12px 32px rgb(0 0 0 / 0.1),
      0 2px 6px rgb(0 0 0 / 0.05);
    transition:
      transform 200ms var(--ease-out-quint),
      box-shadow 200ms var(--ease-out-quint);
  }
  .coffee-toggle:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px var(--color-brand-line),
      0 16px 36px rgb(0 0 0 / 0.12),
      0 2px 6px rgb(0 0 0 / 0.05);
  }
  .coffee-toggle[aria-expanded="true"] {
    box-shadow:
      0 0 0 1px var(--color-brand-line),
      0 12px 32px rgb(0 0 0 / 0.1),
      0 2px 6px rgb(0 0 0 / 0.05);
  }
  .coffee-toggle .coffee-art {
    width: 64px;
    height: 64px;
    padding: 4px;
    border-radius: 14px;
  }
  .coffee-copy {
    display: grid;
    min-width: 0;
    gap: 2px;
  }
  .coffee-name {
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  /* Short enough for one line in English; longer translations wrap to a second line. */
  .coffee-sub {
    display: -webkit-box;
    overflow: hidden;
    font-size: 13px;
    line-height: 17px;
    color: var(--color-muted);
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .coffee-chevron {
    width: 16px;
    height: 16px;
    color: var(--color-muted);
    transition: transform 200ms var(--ease-out-quint);
  }
  .coffee-toggle:hover .coffee-chevron {
    transform: translateX(2px);
  }
  .coffee-toggle[aria-expanded="true"] .coffee-chevron {
    transform: rotate(-90deg);
  }

  /* The small x shrinks the card to a round button for the rest of the visit (scripts/coffee.ts). */
  .coffee-minimize {
    position: absolute;
    top: -8px;
    right: -8px;
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-surface);
    color: var(--color-muted);
    box-shadow:
      0 0 0 1px var(--color-line),
      0 2px 6px rgb(0 0 0 / 0.08);
    transition:
      opacity 150ms ease-out,
      color 150ms ease-out;
  }
  .coffee-minimize:hover {
    color: var(--color-ink);
  }
  .coffee-minimize-icon {
    width: 14px;
    height: 14px;
  }
  @media (hover: hover) {
    .coffee-launch:not(:hover, :focus-within) .coffee-minimize {
      opacity: 0;
    }
  }

  /* Minimized for this visit, and every screen below 640 px: a round button with the cup. */
  .coffee[data-compact] {
    --coffee-launch-h: 56px;
  }
  .coffee[data-compact] .coffee-toggle {
    width: 56px;
    grid-template-columns: 48px;
    gap: 0;
    padding: 3px;
    border-radius: 9999px;
  }
  .coffee[data-compact] .coffee-toggle .coffee-art {
    width: 48px;
    height: 48px;
    padding: 2px;
    border-radius: 9999px;
  }
  .coffee[data-compact] .coffee-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .coffee[data-compact] .coffee-chevron,
  .coffee[data-compact] .coffee-minimize {
    display: none;
  }
  body:has(.coffee[data-compact]) > footer {
    padding-bottom: 96px;
  }

  .coffee-card {
    position: fixed;
    inset: auto calc(var(--coffee-gap, 24px) + env(safe-area-inset-right))
      calc(var(--coffee-gap, 24px) + var(--coffee-launch-h, 88px) + 12px + env(safe-area-inset-bottom)) auto;
    width: min(300px, calc(100vw - 32px));
    /* Never taller than the room between the sticky header and the launcher; scrolls inside if it must. */
    max-height: calc(
      100dvh - var(--coffee-gap, 24px) - var(--coffee-launch-h, 88px) - 12px - var(--coffee-header-room) -
        env(safe-area-inset-bottom)
    );
    margin: 0;
    padding: 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    border-radius: 16px;
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow:
      0 0 0 1px var(--color-line),
      0 24px 48px -12px rgb(0 0 0 / 0.22),
      0 4px 12px rgb(0 0 0 / 0.08);
    outline: none;
  }
  .coffee-card:popover-open {
    display: grid;
    gap: 12px;
    animation: coffee-card 200ms var(--ease-out-quint);
  }
  @keyframes coffee-card {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  .coffee-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .coffee-title {
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .coffee-icon-button {
    display: inline-flex;
    width: 32px;
    height: 32px;
    margin: -6px -6px -6px 0;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: var(--color-muted);
    transition: background-color 150ms ease-out;
  }
  .coffee-icon-button:hover {
    background: var(--color-subtle);
    color: var(--color-ink);
  }
  .coffee-close-icon,
  .coffee-cta-icon {
    width: 16px;
    height: 16px;
  }
  .coffee-text {
    font-size: 14px;
    line-height: 21px;
    color: var(--color-muted);
  }
  .coffee-chips {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }
  .coffee-chip {
    display: flex;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .coffee-chip:hover {
    border-color: var(--color-brand-line);
    background: var(--color-brand-soft);
  }
  .coffee-cta {
    display: inline-flex;
    height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 10px;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-size: 14px;
    font-weight: 500;
    transition: background-color 150ms ease-out;
  }
  .coffee-cta:hover {
    background: var(--color-brand-strong);
  }
  .coffee-hide {
    justify-self: center;
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--color-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 3px;
  }
  .coffee-hide:hover {
    color: var(--color-ink);
  }

  /* Phones (portrait or landscape) and other short screens: a round button with the cup and, to its left, a small
     speech bubble with the title (scripts/coffee.ts hides it after a while and on scroll down), clear of the content
     and the home indicator, with touch-sized targets in the popover. The bubble is the button's own label, so
     tapping it opens the popover and the accessible name stays the same. */
  @media (width < 40rem), (height < 32rem) {
    .coffee {
      --coffee-gap: 16px;
      --coffee-launch-h: 56px;
    }
    .coffee .coffee-toggle {
      width: 56px;
      grid-template-columns: 48px;
      gap: 0;
      padding: 4px;
      border-radius: 9999px;
    }
    .coffee .coffee-toggle .coffee-art {
      width: 48px;
      height: 48px;
      padding: 5px;
      border-radius: 9999px;
    }
    .coffee .coffee-copy {
      position: absolute;
      top: 50%;
      right: calc(100% + 10px);
      display: flex;
      height: 38px;
      align-items: center;
      padding: 0 14px;
      border-radius: 9999px;
      background: var(--color-surface);
      color: var(--color-ink);
      white-space: nowrap;
      box-shadow:
        0 0 0 1px var(--color-line),
        0 8px 20px rgb(0 0 0 / 0.1),
        0 1px 3px rgb(0 0 0 / 0.06);
      transform: translateY(-50%);
      transition:
        opacity 250ms var(--ease-out-quint),
        transform 250ms var(--ease-out-quint);
    }
    /* Tail: the right-hand corner of a rotated square, pointing at the button. */
    .coffee .coffee-copy::after {
      content: "";
      position: absolute;
      top: 50%;
      right: -5px;
      width: 10px;
      height: 10px;
      border-top: 1px solid var(--color-line);
      border-right: 1px solid var(--color-line);
      background: var(--color-surface);
      clip-path: polygon(0 0, 100% 0, 100% 100%);
      transform: translateY(-50%) rotate(45deg);
    }
    .coffee .coffee-name {
      font-size: 14px;
      line-height: 20px;
      font-weight: 500;
    }
    .coffee .coffee-sub {
      display: none;
    }
    /* Hidden but still the button's label, so it keeps its accessible name. */
    .coffee[data-bubble="hidden"] .coffee-copy,
    .coffee-toggle[aria-expanded="true"] .coffee-copy {
      opacity: 0;
      transform: translate(8px, -50%);
      pointer-events: none;
    }
    .coffee .coffee-chevron,
    .coffee .coffee-minimize {
      display: none;
    }
    body:has(.coffee) > footer {
      padding-bottom: 88px;
    }
  }

  /* Touch: 44 px targets in the popover. */
  @media (width < 40rem), (height < 32rem), (pointer: coarse) {
    .coffee-icon-button {
      width: 44px;
      height: 44px;
      margin: -12px -12px -12px 0;
    }
    .coffee-chip {
      height: 44px;
      font-size: 14px;
    }
    .coffee-cta {
      height: 48px;
      font-size: 15px;
    }
    .coffee-hide {
      min-height: 44px;
      padding: 0 12px;
      font-size: 14px;
    }
  }

  /* Phones in portrait: a sheet with 16 px side margins above the button, amounts in a 2 x 2 grid. */
  @media (width < 40rem) {
    .coffee-card {
      left: calc(16px + env(safe-area-inset-left));
      width: auto;
      padding: 20px;
      border-radius: 20px;
    }
    .coffee-card:popover-open {
      gap: 16px;
    }
    .coffee-title {
      font-size: 17px;
    }
    .coffee-text {
      font-size: 15px;
      line-height: 22px;
    }
    .coffee-chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .coffee-chip {
      font-size: 15px;
    }
  }

  /* Phones in landscape: little height, so the popover keeps the amounts and buttons and drops the intro line. */
  @media (height < 32rem) {
    .coffee-text {
      display: none;
    }
  }
  /* Too short to stack above the button without reaching the header: open to its left, bottoms aligned. */
  @media (height < 32rem) and (width >= 40rem) {
    .coffee-card {
      right: calc(var(--coffee-gap) + var(--coffee-launch-h) + 12px + env(safe-area-inset-right));
      bottom: calc(var(--coffee-gap) + env(safe-area-inset-bottom));
      max-height: calc(100dvh - var(--coffee-gap) - var(--coffee-header-room) - env(safe-area-inset-bottom));
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .coffee,
    .coffee[data-state="idle"],
    .coffee-toggle,
    .coffee-toggle:hover,
    .coffee-chevron {
      transition: none;
      transform: none;
    }
    .coffee-toggle[aria-expanded="true"] .coffee-chevron {
      transform: rotate(-90deg);
    }
    .coffee .coffee-copy {
      transition: none;
    }
    .coffee-card:popover-open {
      animation: none;
    }
  }
</style>
