---
import CoffeeCup from "./CoffeeCup.astro";
import Icon from "./Icon.astro";
import SupportArt from "./support/SupportArt.astro";
import { localePath, getLocale } from "../lib/i18n";
import {
  SUPPORT_AMOUNT_PARAM,
  SUPPORT_DEFAULT_AMOUNT,
  SUPPORT_PATH,
  SUPPORT_PRESETS,
  formatRupiah,
  supportBreakdown,
  supportStrings,
} from "../lib/support";

/**
 * Floating "Buy me a coffee" card at the bottom right of every docs page (Base.astro leaves it out on /support, the
 * 404 and other noindex pages), in the /support art direction: cream (light) or green-black (dark) with a thin green
 * outline and green line art. Closed: a card with the line cup, title and subtitle that opens the popover; below
 * 640 px, or after the reader presses its x, a round button with the cup. The popover holds the amounts as small
 * menu cards; the chosen one goes to /support?amount=. The popover is native (Escape, light dismiss and focus return
 * come from the browser); scripts/coffee.ts handles the delayed entrance, aria-expanded, focus into the popover, the
 * amount choice, minimizing for the visit and the 7-day "hide".
 */
const locale = getLocale(Astro.url);
const copy = supportStrings(locale);
const text = copy.launcher;
const supportHref = localePath(locale, SUPPORT_PATH);
const amountHref = (amount: number) => `${supportHref}?${SUPPORT_AMOUNT_PARAM}=${amount}`;
const rupiah = (value: number) => `Rp ${formatRupiah(value)}`;
/** "Coffee Rp 25.000 + QRIS service fee Rp 479 = total Rp 25.479" for each amount, swapped in by scripts/coffee.ts. */
const feeLine = (amount: number) => {
  const parts = supportBreakdown(amount);
  return copy.breakdown
    .replace("{amount}", rupiah(parts.amount))
    .replace("{fee}", rupiah(parts.fee))
    .replace("{total}", rupiah(parts.total));
};
const amounts = SUPPORT_PRESETS.map((amount, index) => ({
  amount,
  name: copy.tiers[index]!.label,
  price: `Rp ${amount / 1000}${text.thousand}`,
  feeLine: feeLine(amount),
}));
---

<div class="coffee" data-coffee data-state="idle">
  <div id="coffee-card" class="coffee-card" popover="auto" role="dialog" aria-labelledby="coffee-title" tabindex="-1" data-coffee-card>
    <div class="coffee-head">
      <div class="coffee-brewers" aria-hidden="true">
        <SupportArt name="moka" />
        <SupportArt name="press" />
        <SupportArt name="pourover" />
      </div>
      <button type="button" class="coffee-icon-button" popovertarget="coffee-card" popovertargetaction="hide" aria-label={text.close}>
        <Icon name="close" class="coffee-close-icon" />
      </button>
    </div>
    <h2 id="coffee-title" class="coffee-title">
      {text.title.before} <span class="coffee-accent">{text.title.accent}</span>
    </h2>
    <p class="coffee-text">{text.text}</p>
    <div role="group" aria-label={copy.presets} class="coffee-amounts">
      {
        amounts.map((item) => (
          <button
            type="button"
            class="coffee-amount"
            aria-pressed={item.amount === SUPPORT_DEFAULT_AMOUNT ? "true" : "false"}
            data-coffee-amount={item.amount}
            data-fee-line={item.feeLine}
          >
            <span class="coffee-amount-name">{item.name}</span>
            <span class="coffee-amount-price">{item.price}</span>
          </button>
        ))
      }
    </div>
    <p class="coffee-fee" data-coffee-fee>{feeLine(SUPPORT_DEFAULT_AMOUNT)}</p>
    <a href={amountHref(SUPPORT_DEFAULT_AMOUNT)} class="coffee-cta" data-coffee-cta data-base={supportHref}>
      <Icon name="coffee" class="coffee-cta-icon" />
      {text.cta}
    </a>
    <button type="button" class="coffee-hide" data-coffee-hide>{text.hide}</button>
  </div>
  <div class="coffee-launch">
    <button
      type="button"
      class="coffee-toggle"
      popovertarget="coffee-card"
      aria-controls="coffee-card"
      aria-expanded="false"
      aria-describedby="coffee-sub"
      data-coffee-toggle
    >
      <CoffeeCup />
      <span class="coffee-copy">
        <span class="coffee-name">{text.open}</span>
        {/* Read as the description, not as part of the name. */}
        <span id="coffee-sub" class="coffee-sub" aria-hidden="true">{text.subtitle}</span>
      </span>
      <Icon name="chevronRight" class="coffee-chevron" />
    </button>
    <button type="button" class="coffee-minimize" aria-label={text.minimize} data-coffee-minimize>
      <Icon name="close" class="coffee-minimize-icon" />
    </button>
  </div>
</div>

<style is:global>
  .coffee {
    /* The /support palette (src/styles/support.css), repeated here because docs pages do not load that file. */
    --cf-paper: #f7f1e6;
    --cf-card: #fffbf4;
    --cf-ink: #14213d;
    --cf-muted: #4d5a50;
    --cf-line: #2e6b3a;
    --cf-tile: #e7efe5;
    --cf-button: var(--site-brand);
    --cf-button-hover: var(--site-brand-strong);
    --cf-on-button: #fbf6ec;
    --cf-shadow: 0 14px 32px -8px rgb(20 33 20 / 0.22), 0 2px 6px rgb(20 33 20 / 0.08);
    --coffee-gap: 24px;
    /* Height of the launcher; the popover opens above it. */
    --coffee-launch-h: 88px;
    /* Sticky site header (64 px) plus a little air: the popover never reaches it. */
    --coffee-header-room: calc(72px + env(safe-area-inset-top));
    position: fixed;
    right: calc(var(--coffee-gap) + env(safe-area-inset-right));
    bottom: calc(var(--coffee-gap) + env(safe-area-inset-bottom));
    z-index: 30;
    transition:
      opacity 500ms var(--ease-out-quint),
      transform 500ms var(--ease-out-quint);
  }
  .dark .coffee {
    --cf-paper: #132018;
    --cf-card: #0d1710;
    --cf-ink: #f4ede0;
    --cf-muted: #b8c2b5;
    --cf-line: #7fbf8a;
    --cf-tile: #1b2a1d;
    --cf-button: #7fbf8a;
    --cf-button-hover: #93cc9d;
    --cf-on-button: #0d1710;
    --cf-shadow: 0 14px 32px -8px rgb(0 0 0 / 0.6), 0 2px 6px rgb(0 0 0 / 0.3);
  }
  .coffee[hidden] {
    display: none;
  }
  .coffee[data-state="idle"] {
    visibility: hidden;
    opacity: 0;
    transform: translateY(16px);
  }
  .coffee[data-instant] {
    transition: none;
  }
  /* Menu drawer open or a toast demo showing at the same corner: step aside. */
  html:has(dialog[data-drawer][open]) .coffee,
  body:has(.fixed.right-4.bottom-4 > :not(template)) .coffee {
    visibility: hidden;
    opacity: 0;
  }
  /* Room under the footer so the card never sits on its last links. */
  body:has(.coffee) > footer {
    padding-bottom: 128px;
  }

  .coffee-launch {
    position: relative;
  }
  .coffee-toggle {
    display: grid;
    /* Same width as the popover above it. */
    width: 300px;
    height: var(--coffee-launch-h);
    grid-template-columns: 64px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 14px;
    padding: 12px 16px 12px 12px;
    border-radius: 20px;
    background: var(--cf-paper);
    color: var(--cf-ink);
    text-align: left;
    box-shadow:
      inset 0 0 0 1.5px var(--cf-line),
      var(--cf-shadow);
    transition: transform 200ms var(--ease-out-quint);
  }
  .coffee-toggle:hover {
    transform: translateY(-2px);
  }
  .coffee-art {
    display: block;
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    padding: 6px;
    border-radius: 14px;
    background: var(--cf-tile);
    color: var(--cf-line);
  }
  .coffee-art > svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* The steam rises a few times once the launcher shows, and once more on hover. */
  .coffee[data-state="shown"] .coffee-steam {
    animation: coffee-steam 2.4s ease-in-out 3;
  }
  .coffee[data-state="shown"] .coffee-toggle:hover .coffee-steam {
    animation-name: coffee-steam-again;
    animation-iteration-count: 1;
  }
  .coffee[data-state="shown"] .coffee-steam + .coffee-steam {
    animation-delay: 0.6s;
  }
  @keyframes coffee-steam {
    50% {
      opacity: 0.25;
      transform: translateY(-3px);
    }
  }
  @keyframes coffee-steam-again {
    50% {
      opacity: 0.25;
      transform: translateY(-3px);
    }
  }
  .coffee-copy {
    display: grid;
    min-width: 0;
    gap: 2px;
  }
  .coffee-name {
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* Short enough for one line in English; longer translations wrap to a second line. */
  .coffee-sub {
    display: -webkit-box;
    overflow: hidden;
    font-size: 13px;
    line-height: 17px;
    color: var(--cf-muted);
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .coffee-chevron {
    width: 16px;
    height: 16px;
    color: var(--cf-line);
    transition: transform 200ms var(--ease-out-quint);
  }
  .coffee-toggle:hover .coffee-chevron {
    transform: translateX(2px);
  }
  .coffee-toggle[aria-expanded="true"] .coffee-chevron {
    transform: rotate(-90deg);
  }

  /* The small x shrinks the card to a round button for the rest of the visit (scripts/coffee.ts). */
  .coffee-minimize {
    position: absolute;
    top: -8px;
    right: -8px;
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--cf-paper);
    color: var(--cf-muted);
    box-shadow: inset 0 0 0 1.5px var(--cf-line);
    transition:
      opacity 150ms ease-out,
      color 150ms ease-out;
  }
  .coffee-minimize:hover {
    color: var(--cf-ink);
  }
  .coffee-minimize-icon {
    width: 14px;
    height: 14px;
  }
  @media (hover: hover) {
    .coffee-launch:not(:hover, :focus-within) .coffee-minimize {
      opacity: 0;
    }
  }

  /* Minimized for this visit, and every screen below 640 px: a round button with the cup. */
  .coffee[data-compact] {
    --coffee-launch-h: 56px;
  }
  .coffee[data-compact] .coffee-toggle {
    width: 56px;
    grid-template-columns: 48px;
    gap: 0;
    padding: 4px;
    border-radius: 9999px;
  }
  .coffee[data-compact] .coffee-art {
    width: 48px;
    height: 48px;
    padding: 5px;
    border-radius: 9999px;
    background: transparent;
  }
  .coffee[data-compact] .coffee-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .coffee[data-compact] .coffee-chevron,
  .coffee[data-compact] .coffee-minimize {
    display: none;
  }
  body:has(.coffee[data-compact]) > footer {
    padding-bottom: 96px;
  }

  .coffee-card {
    position: fixed;
    inset: auto calc(var(--coffee-gap, 24px) + env(safe-area-inset-right))
      calc(var(--coffee-gap, 24px) + var(--coffee-launch-h, 88px) + 12px + env(safe-area-inset-bottom)) auto;
    width: min(300px, calc(100vw - 32px));
    /* Never taller than the room between the sticky header and the launcher; scrolls inside if it must. */
    max-height: calc(
      100dvh - var(--coffee-gap, 24px) - var(--coffee-launch-h, 88px) - 12px - var(--coffee-header-room) -
        env(safe-area-inset-bottom)
    );
    margin: 0;
    padding: 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    border-radius: 20px;
    background: var(--cf-paper);
    color: var(--cf-ink);
    box-shadow:
      inset 0 0 0 1.5px var(--cf-line),
      var(--cf-shadow);
    outline: none;
  }
  .coffee-card:popover-open {
    display: grid;
    gap: 12px;
    animation: coffee-card 200ms var(--ease-out-quint);
  }
  @keyframes coffee-card {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  .coffee-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }
  .coffee-brewers {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    color: var(--cf-line);
  }
  .coffee-brewers > svg {
    width: auto;
    height: 44px;
    overflow: visible;
    /* Thicker than on /support, so the lines hold up at this size. */
    stroke-width: 6;
  }
  .coffee-brewers .sp-fill {
    fill: currentColor;
  }
  .coffee-title {
    font-size: 20px;
    line-height: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .coffee-accent {
    font-family: var(--font-tag);
    font-style: italic;
    font-weight: 400;
    font-size: 1.2em;
    letter-spacing: -0.01em;
    color: var(--cf-line);
  }
  .coffee-icon-button {
    display: inline-flex;
    width: 32px;
    height: 32px;
    margin: -6px -6px 0 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--cf-muted);
    transition: background-color 150ms ease-out;
  }
  .coffee-icon-button:hover {
    background: color-mix(in oklab, var(--cf-line) 12%, transparent);
    color: var(--cf-ink);
  }
  .coffee-close-icon,
  .coffee-cta-icon {
    width: 16px;
    height: 16px;
  }
  .coffee-text {
    margin-top: -6px;
    font-size: 14px;
    line-height: 20px;
    color: var(--cf-muted);
  }
  .coffee-fee {
    margin-top: -4px;
    font-size: 13px;
    line-height: 18px;
    color: var(--cf-muted);
    font-variant-numeric: tabular-nums;
    text-wrap: pretty;
  }
  .coffee-amounts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .coffee-amount {
    display: grid;
    gap: 1px;
    padding: 8px 12px;
    border-radius: 14px;
    background: var(--cf-card);
    color: var(--cf-ink);
    text-align: left;
    box-shadow: inset 0 0 0 1.5px var(--cf-line);
    transition:
      background-color 150ms ease-out,
      transform 150ms ease-out;
  }
  .coffee-amount:hover {
    background: color-mix(in oklab, var(--cf-line) 10%, var(--cf-card));
  }
  .coffee-amount:active {
    transform: scale(0.98);
  }
  .coffee-amount-name {
    font-size: 13px;
    line-height: 18px;
    font-weight: 600;
  }
  .coffee-amount-price {
    font-size: 13px;
    line-height: 18px;
    font-weight: 700;
    color: var(--cf-line);
    font-variant-numeric: tabular-nums;
  }
  .coffee-amount[aria-pressed="true"] {
    background: var(--cf-button);
    color: var(--cf-on-button);
    box-shadow: inset 0 0 0 1.5px var(--cf-button);
  }
  .coffee-amount[aria-pressed="true"] .coffee-amount-price {
    color: var(--cf-on-button);
  }
  .coffee-cta {
    display: inline-flex;
    height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 9999px;
    background: var(--cf-button);
    color: var(--cf-on-button);
    font-size: 15px;
    font-weight: 600;
    transition:
      background-color 150ms ease-out,
      transform 150ms ease-out;
  }
  .coffee-cta:hover {
    background: var(--cf-button-hover);
  }
  .coffee-cta:active {
    transform: scale(0.98);
  }
  .coffee-hide {
    justify-self: center;
    margin-top: -4px;
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--cf-muted);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--cf-muted) 40%, transparent);
    text-underline-offset: 3px;
  }
  .coffee-hide:hover {
    color: var(--cf-ink);
  }

  /* Phones (portrait or landscape) and other short screens: a round button with the cup and, to its left, a small
     speech bubble with the title (scripts/coffee.ts hides it after a while and on scroll down), clear of the content
     and the home indicator, with touch-sized targets in the popover. The bubble is the button's own label, so
     tapping it opens the popover and the accessible name stays the same. */
  @media (width < 40rem), (height < 32rem) {
    .coffee {
      --coffee-gap: 16px;
      --coffee-launch-h: 56px;
    }
    .coffee .coffee-toggle {
      width: 56px;
      grid-template-columns: 48px;
      gap: 0;
      padding: 4px;
      border-radius: 9999px;
    }
    .coffee .coffee-art {
      width: 48px;
      height: 48px;
      padding: 5px;
      border-radius: 9999px;
      background: transparent;
    }
    .coffee .coffee-copy {
      position: absolute;
      top: 50%;
      right: calc(100% + 10px);
      display: flex;
      height: 38px;
      align-items: center;
      padding: 0 14px;
      border-radius: 9999px;
      background: var(--cf-paper);
      color: var(--cf-ink);
      white-space: nowrap;
      box-shadow:
        inset 0 0 0 1.5px var(--cf-line),
        var(--cf-shadow);
      transform: translateY(-50%);
      transition:
        opacity 250ms var(--ease-out-quint),
        transform 250ms var(--ease-out-quint);
    }
    /* Tail: the right-hand corner of a rotated square, pointing at the button. */
    .coffee .coffee-copy::after {
      content: "";
      position: absolute;
      top: 50%;
      right: -5px;
      width: 10px;
      height: 10px;
      border-top: 1.5px solid var(--cf-line);
      border-right: 1.5px solid var(--cf-line);
      background: var(--cf-paper);
      clip-path: polygon(0 0, 100% 0, 100% 100%);
      transform: translateY(-50%) rotate(45deg);
    }
    .coffee .coffee-name {
      font-size: 14px;
      line-height: 20px;
      font-weight: 600;
    }
    .coffee .coffee-sub {
      display: none;
    }
    /* Hidden but still the button's label, so it keeps its accessible name. */
    .coffee[data-bubble="hidden"] .coffee-copy,
    .coffee-toggle[aria-expanded="true"] .coffee-copy {
      opacity: 0;
      transform: translate(8px, -50%);
      pointer-events: none;
    }
    .coffee .coffee-chevron,
    .coffee .coffee-minimize {
      display: none;
    }
    body:has(.coffee) > footer {
      padding-bottom: 88px;
    }
  }

  /* Touch: 44 px targets in the popover. */
  @media (width < 40rem), (height < 32rem), (pointer: coarse) {
    .coffee-icon-button {
      width: 44px;
      height: 44px;
      margin: -10px -10px 0 0;
    }
    .coffee-amount {
      min-height: 52px;
      align-content: center;
    }
    .coffee-cta {
      height: 48px;
    }
    .coffee-hide {
      min-height: 44px;
      padding: 0 12px;
      font-size: 14px;
    }
  }

  /* Phones in portrait: a sheet with 16 px side margins above the button. */
  @media (width < 40rem) {
    .coffee-card {
      left: calc(16px + env(safe-area-inset-left));
      width: auto;
      padding: 20px;
      border-radius: 22px;
    }
    .coffee-card:popover-open {
      gap: 14px;
    }
    .coffee-title {
      font-size: 22px;
      line-height: 28px;
    }
    .coffee-text {
      font-size: 15px;
      line-height: 22px;
    }
    .coffee-amount-name,
    .coffee-amount-price {
      font-size: 14px;
      line-height: 20px;
    }
  }

  /* Phones in landscape: little height, so the popover drops the drawings and the intro line, keeps the close
     button in the title's corner and lays the amounts out in one row. */
  @media (height < 32rem) {
    .coffee-brewers,
    .coffee-text {
      display: none;
    }
    .coffee-head {
      position: absolute;
      top: 14px;
      right: 14px;
    }
    .coffee-title {
      padding-right: 40px;
    }
  }
  /* Too short to stack above the button without reaching the header: open to its left, bottoms aligned. */
  @media (height < 32rem) and (width >= 40rem) {
    .coffee-amounts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .coffee-card {
      width: min(440px, calc(100vw - 2 * var(--coffee-gap) - var(--coffee-launch-h) - 12px));
      right: calc(var(--coffee-gap) + var(--coffee-launch-h) + 12px + env(safe-area-inset-right));
      bottom: calc(var(--coffee-gap) + env(safe-area-inset-bottom));
      max-height: calc(100dvh - var(--coffee-gap) - var(--coffee-header-room) - env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coffee,
    .coffee[data-state="idle"],
    .coffee-toggle,
    .coffee-toggle:hover,
    .coffee-chevron,
    .coffee-amount,
    .coffee-cta {
      transition: none;
      transform: none;
    }
    .coffee-toggle[aria-expanded="true"] .coffee-chevron {
      transform: rotate(-90deg);
    }
    .coffee .coffee-copy {
      transition: none;
    }
    .coffee[data-state="shown"] .coffee-steam,
    .coffee-card:popover-open {
      animation: none;
    }
  }
</style>
