---
import type { MarkdownHeading } from "astro";
import Icon from "./Icon.astro";
import { getLocale, t } from "../lib/i18n";

interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{
  headings.length > 0 && (
    <nav aria-labelledby="toc-title" class="sticky top-24 max-h-[calc(100dvh-12rem)] overflow-y-auto" data-toc>
      <h2 id="toc-title" class="mb-3 flex items-center gap-2 text-sm text-muted">
        <Icon name="list" class="size-4" />
        {t(getLocale(Astro.url)).toc}
      </h2>
      <ul class="ml-2 grid border-l border-line text-sm">
        {headings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link={heading.slug}
              class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-ink/70 transition-colors duration-150 ease-out hover:text-ink data-active:border-ink data-active:text-ink"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
