---
import { getLocale, t } from "../lib/i18n";
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{
  headings.length > 0 && (
    <nav aria-labelledby="toc-title" class="sticky top-24">
      <h2 id="toc-title" class="mb-3 text-xs font-medium text-muted">
        {t(getLocale(Astro.url)).toc}
      </h2>
      <ul class="grid gap-2 border-l border-line text-sm">
        {headings.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} class="-ml-px block border-l border-transparent pl-3 text-muted transition-colors hover:border-faint hover:text-ink">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
