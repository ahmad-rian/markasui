---
import type { Framework } from "@markasui/registry/schema";
import { Code } from "astro:components";
import FrameworkIcon from "./FrameworkIcon.astro";
import Icon from "./Icon.astro";
import type { ShikiFrameworkLang } from "../lib/frameworks";
import { getLocale, t } from "../lib/i18n";

interface Props {
  code: string;
  lang: ShikiFrameworkLang | "bash" | "css" | "json" | "ts" | "js";
  /** Judul di atas kode, biasanya path file. */
  title?: string;
  /** Logo framework di samping judul. */
  framework?: Framework;
  /** Kode lebih dari 12 baris dipotong dengan tombol "Lihat kode" (PRD bagian 7). */
  collapsible?: boolean;
  /** Tanpa bingkai, untuk dipasang di dalam panel lain (tab berbingkai, panel hero). */
  bare?: boolean;
  class?: string;
}

const COLLAPSE_AFTER_LINES = 12;
const { code, lang, title, framework, collapsible = false, bare = false, class: className } = Astro.props;
const strings = t(getLocale(Astro.url)).code;
const trimmed = code.trim();
const collapsed = collapsible && trimmed.split("\n").length > COLLAPSE_AFTER_LINES;
---

<div class:list={["group relative", !bare && "frame", className]} data-code-block>
  {
    title && (
      <div class="flex h-9 items-center gap-2 pr-12 pl-3">
        {framework && <FrameworkIcon framework={framework} brand class="size-3.5" />}
        <span class="truncate font-mono text-[11px] text-muted">{title}</span>
      </div>
    )
  }
  <button
    type="button"
    data-copy
    aria-label={strings.copy}
    class:list={["icon-button absolute z-10 size-8 hover:bg-subtle", title ? "top-0.5 right-1" : "top-2.5 right-2.5"]}
  >
    <Icon name="copy" class="size-4 group-data-copied:hidden" />
    <Icon name="check" class="hidden size-4 text-brand group-data-copied:block" />
  </button>
  <div class:list={["relative overflow-hidden", !bare && "frame-panel"]}>
    <div
      class:list={[
        "overflow-x-auto px-4 py-3.5 font-mono text-[12.5px] leading-6",
        !title && "pr-12",
        collapsed && "max-h-80 overflow-y-hidden group-data-expanded:max-h-none",
      ]}
      data-code
    >
      <Code code={trimmed} lang={lang} themes={{ light: "github-light-high-contrast", dark: "github-dark-high-contrast" }} defaultColor={false} />
    </div>
    {
      collapsed && (
        <div class="absolute inset-x-0 bottom-0 flex h-24 items-end justify-center bg-linear-to-t from-surface via-surface/90 to-transparent pb-4 group-data-expanded:hidden">
          <button type="button" data-expand class="soft-button h-8">
            {strings.expand}
          </button>
        </div>
      )
    }
  </div>
</div>
