---
import { LOCALES, LOCALE_NAMES, getLocale, localePath, stripLocale, t } from "../lib/i18n";

const locale = getLocale(Astro.url);
const path = stripLocale(Astro.url.pathname);
---

<nav aria-label={t(locale).header.language} class="flex items-center rounded-lg border border-line p-0.5 font-mono text-xs">
  {
    LOCALES.map((code) => (
      <a
        href={localePath(code, path)}
        hreflang={code}
        data-lang-switch
        lang={code}
        aria-current={code === locale ? "true" : undefined}
        class="inline-flex h-7 min-w-8 items-center justify-center rounded-md px-1.5 text-muted uppercase transition-colors hover:text-ink aria-[current=true]:bg-subtle aria-[current=true]:text-ink"
      >
        {code}<span class="sr-only">, {LOCALE_NAMES[code]}</span>
      </a>
    ))
  }
</nav>
