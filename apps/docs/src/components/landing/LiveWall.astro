---
import FrameworkSwitcher from "../FrameworkSwitcher.astro";
import ReactPreview from "../preview/ReactPreview";
import VuePreview from "../preview/VuePreview.vue";
import { getLocale, localePath, t } from "../../lib/i18n";

/**
 * Dinding komponen hidup di hero landing. Setiap sel memakai fixture examples/ yang sama dengan
 * halaman komponen: HTML Blade statis (Alpine) plus island React dan Vue yang hanya hydrate saat
 * framework itu dipilih (pane lain display: none, jadi client:visible tidak terpicu).
 */
const locale = getLocale(Astro.url);
const strings = t(locale).home;
const bladeFiles = import.meta.glob<string>("../../generated/blade/*.html", { query: "?raw", import: "default", eager: true });
const blade = (fixture: string) => {
  const html = bladeFiles[`../../generated/blade/${fixture}.html`];
  if (!html) throw new Error(`HTML Blade untuk ${fixture} belum dirender`);
  return html;
};

type Tile = { fixture: string; component: string; title: string; span: string };
/** Di layar sempit tiga sel kecil disembunyikan supaya dinding tidak terlalu panjang. Grid 12 kolom di desktop; baris minimal 176px, jadi row-span-2 untuk fixture yang tinggi. */
const tiles: Tile[] = [
  { fixture: "dock", component: "dock", title: "Dock", span: "lg:col-span-7 lg:row-span-2" },
  { fixture: "dynamic-island", component: "dynamic-island", title: "Dynamic Island", span: "lg:col-span-5 lg:row-span-2" },
  { fixture: "currency-input", component: "currency-input", title: "Currency Input", span: "lg:col-span-4 lg:row-span-2" },
  { fixture: "card-stack", component: "card-stack", title: "Card Stack", span: "lg:col-span-5 lg:row-span-2" },
  { fixture: "command--icon-trigger", component: "command", title: "Command", span: "lg:col-span-3" },
  { fixture: "toggle-group", component: "toggle-group", title: "Toggle Group", span: "max-sm:hidden lg:col-span-3" },
  { fixture: "prompt-input", component: "prompt-input", title: "Prompt Input", span: "max-sm:hidden lg:col-span-7" },
  { fixture: "theme-toggle--in-navbar", component: "theme-toggle", title: "Theme Toggle", span: "max-sm:hidden lg:col-span-5" },
];
const tile = "relative flex min-w-0 flex-col rounded-xl bg-surface shadow-[0_0_0_1px_var(--color-line)]";
const label = "absolute top-3 left-4 z-10 rounded text-xs text-muted transition-colors duration-150 ease-out hover:text-ink";
const stage = "flex flex-1 items-center justify-center px-4 pt-12 pb-6 sm:px-6";
const pane = "w-full max-w-md";
---

<div data-pagefind-ignore>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="w-full sm:w-72">
      <FrameworkSwitcher label={strings.wallLabel} />
    </div>
    <p class="max-w-md text-sm text-muted sm:text-right">
      {strings.wallNote[0]} <code class="font-mono text-xs text-ink">add</code>{strings.wallNote[1]}
    </p>
  </div>
  <div class="frame mt-3 grid gap-1 sm:grid-cols-2 lg:auto-rows-[minmax(176px,auto)] lg:grid-cols-12">
    {
      tiles.map((item) => (
        <section class:list={[tile, item.span]} aria-label={item.title}>
          <a href={localePath(locale, `/components/${item.component}`)} class={label}>
            {item.title}
          </a>
          <div class={stage} data-preview-stage>
            <div data-fw="blade" class={pane} set:html={blade(item.fixture)} />
            <div data-fw="react" class={pane}>
              <ReactPreview client:visible name={item.fixture} />
            </div>
            <div data-fw="vue" class={pane}>
              <VuePreview client:visible name={item.fixture} />
            </div>
          </div>
        </section>
      ))
    }
  </div>
</div>
