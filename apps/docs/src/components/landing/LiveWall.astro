---
import LiveFixture from "./LiveFixture.astro";
import { getLocale, localePath } from "../../lib/i18n";
import { LANDING_TILES as tiles } from "../../lib/landing";

/**
 * Dinding komponen hidup di landing (framework dipilih lewat pill di hero). Setiap sel memakai
 * fixture examples/ yang sama dengan halaman komponen, lewat LiveFixture.
 */
const locale = getLocale(Astro.url);

const tile = "relative flex min-w-0 flex-col rounded-2xl bg-surface shadow-[0_0_0_1px_var(--markas-line)]";
const label = "absolute top-3 left-4 z-10 rounded text-xs text-muted transition-colors duration-150 ease-out hover:text-ink";
const stage = "flex flex-1 items-center justify-center px-4 pt-12 pb-6 sm:px-6";
---

<div data-pagefind-ignore>
  <div class="grid gap-2 sm:grid-cols-2 lg:auto-rows-[minmax(176px,auto)] lg:grid-cols-12">
    {
      tiles.map((item) => (
        <section class:list={[tile, item.span]} aria-label={item.title}>
          <a href={localePath(locale, `/components/${item.component}`)} class={label}>
            {item.title}
          </a>
          <div class={stage} data-preview-stage>
            <LiveFixture fixture={item.fixture} lazy />
          </div>
        </section>
      ))
    }
  </div>
</div>
