---
import { getLocale, localePath } from "../../lib/i18n";
import { templateDetailPath, type Template } from "../../lib/templates";

/**
 * Template sebagai thumbnail live: halaman demo Blade di iframe lazy yang diperkecil.
 * Iframe dibuat 250% / 400% dari sel lalu di-scale 0.4 / 0.25, jadi template dirender di lebar
 * desktop sebenarnya tanpa perlu tahu lebar sel. src baru dipasang saat sel mendekati viewport
 * (skrip di bawah), karena loading="lazy" bawaan browser memuatnya terlalu awal.
 */
interface Props {
  /** Dashboard atau page yang ditampilkan; yang pertama tampil besar. */
  templates: Template[];
}

const { templates } = Astro.props;
const locale = getLocale(Astro.url);
const frame = "pointer-events-none absolute top-0 left-0 origin-top-left border-0";
const large = "h-[400%] w-[400%] scale-25 lg:h-[250%] lg:w-[250%] lg:scale-40";
const small = "h-[400%] w-[400%] scale-25";
---

<ul class="grid grid-cols-[minmax(0,1fr)] gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    templates.map((template, index) => (
      <li class:list={["min-w-0", index === 0 && "sm:col-span-2 lg:row-span-2"]}>
        <a href={localePath(locale, templateDetailPath(template))} class="group block">
          <div class="frame transition-colors duration-150 ease-out group-hover:bg-line">
            <div class="frame-panel relative aspect-[16/10] overflow-hidden">
              <iframe
                data-lazy-src={`/demo/templates/${template.name}/blade`}
                title={template.headline[locale]}
                loading="lazy"
                tabindex="-1"
                aria-hidden="true"
                class:list={[frame, index === 0 ? large : small]}
              />
            </div>
          </div>
          <p class="mt-3 flex items-baseline justify-between gap-3 px-1">
            <span class="min-w-0 font-medium text-ink">{template.headline[locale]}</span>
            <span class="shrink-0 text-sm text-muted">{template.title}</span>
          </p>
        </a>
      </li>
    ))
  }
</ul>

<script>
  import { onPageLoad } from "../../scripts/lifecycle";

  const MARGIN = "400px 0px";
  let observer: IntersectionObserver | undefined;

  onPageLoad(() => {
    observer?.disconnect();
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const frame = entry.target as HTMLIFrameElement;
          if (!entry.isIntersecting || !frame.dataset.lazySrc) return;
          frame.src = frame.dataset.lazySrc;
          delete frame.dataset.lazySrc;
          observer?.unobserve(frame);
        });
      },
      { rootMargin: MARGIN },
    );
    document.querySelectorAll<HTMLIFrameElement>("iframe[data-lazy-src]").forEach((frame) => observer?.observe(frame));
  });
</script>
