---
import { BRAND_SHAPES, BRAND_VIEWBOX } from "../lib/brand";

/**
 * Splash di landing, sama gayanya dengan overlay ganti bahasa: bilah logo Jenderal meluncur masuk
 * bergantian, wordmark muncul, lalu memudar ke halaman. Sekali per sesi, dilewati saat reduced motion.
 */
---

<div class="splash" aria-hidden="true" data-splash>
  <div class="splash-content">
    <svg viewBox={BRAND_VIEWBOX} class="brand-mark splash-logo" aria-hidden="true">
      {BRAND_SHAPES.map((shape, index) => <polygon points={shape.points} data-tone={shape.tone} style={`--i:${index}`} />)}
    </svg>
    <p class="splash-word">MarkasUI</p>
    <div class="splash-track"><div class="splash-bar"></div></div>
  </div>
</div>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    place-items: center;
    background: var(--color-surface);
    color: var(--color-ink);
    transition: opacity 450ms var(--ease-out-quint);
  }
  :global(html[data-splash]) .splash {
    display: grid;
  }
  :global(html[data-splash="leaving"]) .splash {
    opacity: 0;
    pointer-events: none;
  }
  .splash-content {
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .splash-logo {
    height: 112px;
    width: auto;
    overflow: visible;
  }
  .splash-logo polygon {
    opacity: 0;
    animation: splash-bar-in 700ms var(--ease-out-quint) forwards;
    animation-delay: calc(var(--i) * 90ms);
  }
  .splash-word {
    font-family: var(--font-sans);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.025em;
    opacity: 0;
    transform: translateY(6px);
    animation: splash-word-in 500ms var(--ease-out-quint) 550ms forwards;
  }
  .splash-track {
    width: 160px;
    height: 2px;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--color-subtle);
  }
  .splash-bar {
    height: 100%;
    border-radius: 9999px;
    background: var(--color-brand);
    transform: translateX(-100%);
    animation: splash-progress 1300ms var(--ease-out-quint) 150ms forwards;
  }
  @keyframes splash-bar-in {
    from {
      opacity: 0;
      transform: translate(-320px, 156px);
    }
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }
  @keyframes splash-word-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes splash-progress {
    to {
      transform: translateX(0);
    }
  }
</style>
