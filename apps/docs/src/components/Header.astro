---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import SidebarNav from "./SidebarNav.astro";
import { NAV, SITE, getGithubStars } from "../lib/site";

const stars = await getGithubStars();
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/components" ? path.startsWith("/components") : href === "/docs/mcp" ? path === href : path.startsWith("/docs") && path !== "/docs/mcp";
const navLink =
  "rounded-md px-1 text-sm text-muted transition-colors hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink";
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas">
  <div class="mx-auto flex h-16 max-w-screen-2xl items-center gap-8 px-4 sm:px-6 lg:px-8">
    <Logo />
    <nav aria-label="Utama" class="hidden items-center gap-6 md:flex">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} class={navLink}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <Search />
      <a href={SITE.repo} class="icon-button w-auto gap-1.5 px-2" aria-label={stars === null ? "GitHub" : `GitHub, ${stars} bintang`}>
        <Icon name="github" />
        {stars !== null && <span class="hidden font-mono text-xs tabular-nums sm:inline">{new Intl.NumberFormat("id-ID", { notation: "compact" }).format(stars)}</span>}
      </a>
      <button type="button" class="icon-button" data-theme-toggle aria-label="Ganti tema terang atau gelap">
        <Icon name="sun" class="size-4 dark:hidden" />
        <Icon name="moon" class="hidden size-4 dark:block" />
      </button>
      <button type="button" class="icon-button lg:hidden" data-drawer-open aria-label="Menu" aria-haspopup="dialog">
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<dialog
  data-drawer
  aria-label="Navigasi"
  class="m-0 ml-auto h-dvh max-h-dvh w-80 max-w-[88vw] border-l border-line bg-canvas p-0 text-ink backdrop:bg-ink/30"
>
  <div class="flex h-16 items-center justify-between border-b border-line px-4">
    <Logo />
    <form method="dialog">
      <button type="submit" aria-label="Tutup menu" class="icon-button"><Icon name="close" /></button>
    </form>
  </div>
  <div class="grid gap-6 overflow-y-auto p-4">
    <nav aria-label="Utama seluler" class="grid gap-0.5">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="flex h-10 items-center rounded-lg px-3 text-[15px] text-ink transition-colors hover:bg-subtle aria-[current=page]:bg-subtle aria-[current=page]:font-medium"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <SidebarNav />
  </div>
</dialog>

<script>
  import { onPageLoad } from "../scripts/lifecycle";
  import { setTheme } from "../scripts/prefs";

  const drawer = () => document.querySelector<HTMLDialogElement>("[data-drawer]");

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("[data-theme-toggle]")) {
      setTheme(document.documentElement.classList.contains("dark") ? "light" : "dark");
    }
    if (target.closest("[data-drawer-open]")) drawer()?.showModal();
    const dialog = drawer();
    if (dialog?.open && (target === dialog || target.closest("[data-drawer] a"))) dialog.close();
  });

  // Drawer tidak boleh tetap terbuka setelah pindah halaman.
  onPageLoad(() => drawer()?.close());
</script>
