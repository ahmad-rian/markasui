---
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import SidebarNav from "./SidebarNav.astro";
import { getLocale, localePath, stripLocale, t } from "../lib/i18n";
import { SITE, getGithubStars, nav } from "../lib/site";

interface Props {
  /** hero: bilah transparan di dalam bingkai hero landing (gayanya di halaman landing). */
  variant?: "default" | "hero";
}
const { variant = "default" } = Astro.props;
const hero = variant === "hero";
const locale = getLocale(Astro.url);
const strings = t(locale);
const stars = await getGithubStars();
const path = stripLocale(Astro.url.pathname);
const ACTIVE: Record<string, (path: string) => boolean> = {
  home: (p) => p === "/",
  components: (p) => p.startsWith("/components"),
  templates: (p) => p.startsWith("/templates"),
  pages: (p) => p === "/pages" || p.startsWith("/pages/"),
  mcp: (p) => p === "/docs/mcp",
  docs: (p) => p.startsWith("/docs") && p !== "/docs/mcp",
};
const isActive = (key: string) => ACTIVE[key]?.(path) ?? false;
const items = nav(locale);
const navLink =
  "rounded-md text-[15px] text-ink/80 transition-colors hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink";
---

<header class:list={hero ? "hero-header" : "sticky top-0 z-40 bg-surface/95 backdrop-blur-sm"}>
  <div class:list={["mx-auto flex h-16 items-center", hero ? "hero-bar gap-3" : "max-w-screen-2xl gap-10 px-4 sm:px-6 lg:px-10"]}>
    <Logo />
    <nav aria-label={strings.nav.main} class:list={hero ? "hero-nav" : "hidden items-center gap-7 md:flex"}>
      {
        items.map((item) => (
          <a href={item.href} aria-current={isActive(item.key) ? "page" : undefined} class={hero ? undefined : navLink}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      {!hero && <span class="hidden h-8 items-center rounded-lg bg-subtle px-2.5 font-mono text-[11px] text-muted lg:inline-flex">v{SITE.version}</span>}
      <Search part={hero ? "trigger" : "all"} />
      <div class="hidden sm:block"><LanguageSwitcher /></div>
      <a href={SITE.repo} class="icon-button w-auto gap-1.5 px-2" aria-label={stars === null ? strings.header.github : strings.header.stars(stars)}>
        <Icon name="github" />
        {stars !== null && <span class="hidden font-mono text-xs tabular-nums sm:inline">{new Intl.NumberFormat(locale, { notation: "compact" }).format(stars)}</span>}
      </a>
      <button type="button" class="icon-button" data-theme-toggle aria-label={strings.header.theme}>
        <Icon name="sun" class="size-4 dark:hidden" />
        <Icon name="moon" class="hidden size-4 dark:block" />
      </button>
      {
        hero && (
          <a href={localePath(locale, "/docs/introduction")} class="hero-cta">
            {strings.header.getStarted}
          </a>
        )
      }
      <button type="button" class="icon-button lg:hidden" data-drawer-open aria-label={strings.header.menu} aria-haspopup="dialog">
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>
{hero && <Search part="dialog" />}

<dialog
  data-drawer
  aria-label={strings.header.navigation}
  class="m-0 ml-auto h-dvh max-h-dvh w-80 max-w-[88vw] border-l border-line bg-surface p-0 text-ink backdrop:bg-ink/30"
>
  <div class="flex h-16 items-center justify-between gap-3 border-b border-line px-4">
    <LanguageSwitcher />
    <form method="dialog">
      <button type="submit" aria-label={strings.header.closeMenu} class="icon-button"><Icon name="close" /></button>
    </form>
  </div>
  <div class="grid gap-6 overflow-y-auto p-4">
    <nav aria-label={strings.nav.mainMobile} class="grid gap-0.5">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.key) ? "page" : undefined}
            class="flex h-10 items-center rounded-lg px-3 text-[15px] text-ink transition-colors hover:bg-subtle aria-[current=page]:bg-subtle aria-[current=page]:font-medium"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <SidebarNav />
  </div>
</dialog>
