---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import { NAV, SITE, getGithubStars } from "../lib/site";

const stars = await getGithubStars();
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/components" ? path.startsWith("/components") : path === href);
const iconButton =
  "inline-flex size-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-subtle hover:text-ink";
---

<header class="sticky top-0 z-40 h-16 border-b border-line bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-full max-w-screen-2xl items-center gap-6 px-4 sm:px-6">
    <Logo />
    <nav aria-label="Utama" class="hidden items-center gap-5 text-sm md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="rounded-sm text-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <Search />
      <a href={SITE.repo} class={`${iconButton} w-auto gap-1.5 px-2 font-mono text-xs`} aria-label={stars === null ? "GitHub" : `GitHub, ${stars} star`}>
        <Icon name="github" />
        {stars !== null && <span>{new Intl.NumberFormat("id-ID", { notation: "compact" }).format(stars)}</span>}
      </a>
      <button type="button" class={iconButton} data-theme-toggle aria-label="Ganti tema terang atau gelap">
        <Icon name="sun" class="size-4 dark:hidden" />
        <Icon name="moon" class="hidden size-4 dark:block" />
      </button>
    </div>
  </div>
</header>

<script>
  import { setTheme } from "../scripts/prefs";

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    setTheme(document.documentElement.classList.contains("dark") ? "light" : "dark");
  });
</script>
