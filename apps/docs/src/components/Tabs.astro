---
/**
 * Tab statis untuk halaman docs (bukan komponen MarkasUI). Isi setiap panel dikirim lewat slot
 * bernama sama dengan value. Pilihan disimpan per grup lewat atribut data-tabs-group.
 */
interface Props {
  items: { value: string; label: string }[];
  group?: string;
  label: string;
  /** Tab di dalam bingkai abu-abu, isi panel di kartu putih (gaya blok perintah). */
  framed?: boolean;
  /** Tab berbentuk pil di kanan (View/Code di galeri variasi). */
  pills?: boolean;
}
const { items, group, label, framed = false, pills = false } = Astro.props;
const id = `tabs-${Math.random().toString(36).slice(2, 8)}`;
const first = items[0]?.value;
---

<div data-docs-tabs data-tabs-group={group} class:list={["min-w-0", framed && "frame"]}>
  <div role="tablist" aria-label={label} class:list={[
      "flex overflow-x-auto",
      pills ? "ml-auto w-fit gap-1 rounded-lg bg-subtle p-1" : framed ? "h-10 gap-4 px-3" : "gap-5 border-b border-line",
    ]}>
    {
      items.map((item) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${item.value}`}
          aria-controls={`${id}-panel-${item.value}`}
          aria-selected={item.value === first ? "true" : "false"}
          tabindex={item.value === first ? 0 : -1}
          data-value={item.value}
          class:list={[
            "shrink-0 text-sm text-muted transition-colors hover:text-ink aria-selected:font-medium aria-selected:text-ink",
            pills
              ? "inline-flex h-8 items-center gap-1.5 rounded-md px-3 aria-selected:bg-surface aria-selected:shadow-[0_1px_2px_rgb(0_0_0/0.06)]"
              : "border-b-2 border-transparent aria-selected:border-ink",
            !pills && (framed ? "h-full" : "-mb-px pb-2.5"),
          ]}
        >
          {item.label}
        </button>
      ))
    }
  </div>
  {
    items.map((item) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${item.value}`}
        aria-labelledby={`${id}-tab-${item.value}`}
        data-value={item.value}
        hidden={item.value !== first}
        class:list={["min-w-0", framed ? "frame-panel" : pills ? "pt-3" : "pt-4"]}
      >
        <slot name={item.value} />
      </div>
    ))
  }
</div>
