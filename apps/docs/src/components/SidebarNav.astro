---
import type { RegistryItem } from "@markasui/registry/schema";
import BrandMark from "./BrandMark.astro";
import FrameworkSwitcher from "./FrameworkSwitcher.astro";
import Icon from "./Icon.astro";
import { getLocale, localePath, pagePath, t } from "../lib/i18n";
import { freshness, getComponents, groupByCategory } from "../lib/registry";
import { docsNav } from "../lib/site";
import { getTemplates } from "../lib/templates";

const locale = getLocale(Astro.url);
const strings = t(locale).sidebar;
const path = pagePath(Astro.url);

type Link = { href: string; label: string; tag: string | null };
type IconName = "brand" | "book" | "layout" | "form" | "bell" | "layers" | "compass" | "table" | "sparkles" | "image" | "pointer";
type Section = { label: string; icon: IconName; links: Link[] };

const GROUP_ICONS: Record<RegistryItem["category"], IconName> = {
  form: "form",
  feedback: "bell",
  overlay: "layers",
  navigation: "compass",
  data: "table",
  markas: "brand",
  animation: "sparkles",
  background: "image",
  button: "pointer",
};

const guide = docsNav(locale).map((item) => ({ href: item.href, label: item.label, tag: null }));
// Halaman ikhtisar ikut di Panduan, setelah Instalasi (seperti Animate UI).
const overviews: Link[] = [
  { href: localePath(locale, "/components"), label: strings.components, tag: null },
  { href: localePath(locale, "/templates"), label: strings.templates, tag: null },
];
const groups = groupByCategory(await getComponents(), locale);

const sections: Section[] = [
  { label: strings.start, icon: "book", links: [...guide.slice(0, 2), ...overviews, ...guide.slice(2)] },
  ...groups.map((group) => ({
    label: group.label,
    icon: GROUP_ICONS[group.category],
    links: group.items.map((item) => {
      const fresh = freshness(item);
      return {
        href: localePath(locale, `/components/${item.name}`),
        label: item.title,
        tag: fresh === "new" ? strings.fresh : fresh === "updated" ? strings.updated : null,
      };
    }),
  })),
  {
    label: strings.templates,
    icon: "layout",
    links: getTemplates().map((template) => ({ href: localePath(locale, `/templates/${template.name}`), label: template.title, tag: null })),
  },
];
---

<div class="grid gap-7">
  <FrameworkSwitcher />
  {
    sections.map((section) => (
      <section>
        <h2 class="mb-2 flex items-center gap-2.5 text-sm text-muted">
          <span class="inline-flex size-6 items-center justify-center rounded-md shadow-[0_0_0_1px_var(--color-line)]">
            {section.icon === "brand" ? <BrandMark class="size-3.5" /> : <Icon name={section.icon} class="size-3.5" />}
          </span>
          {section.label}
        </h2>
        <ul class="ml-3 grid border-l border-line">
          {section.links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
                class="relative -ml-px flex h-9 items-center justify-between gap-2 border-l-2 border-transparent pr-2 pl-5 text-[15px] text-ink/75 transition-colors duration-150 ease-out hover:text-ink aria-[current=page]:border-ink aria-[current=page]:font-medium aria-[current=page]:text-ink"
              >
                {link.label}
                {link.tag && <span class="font-tag text-[15px] text-muted italic">{link.tag}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
