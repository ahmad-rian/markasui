---
import FrameworkSwitcher from "./FrameworkSwitcher.astro";
import { getLocale, localePath, pagePath, t } from "../lib/i18n";
import { freshness, getComponents, groupByCategory } from "../lib/registry";
import { docsNav } from "../lib/site";

const locale = getLocale(Astro.url);
const strings = t(locale).sidebar;
const path = pagePath(Astro.url);
const groups = groupByCategory(await getComponents(), locale);
const heading = "mb-2 px-3 text-xs font-medium text-muted";
const link =
  "flex h-8 items-center justify-between gap-2 rounded-lg px-3 text-sm text-muted transition-colors duration-150 ease-out hover:bg-subtle hover:text-ink aria-[current=page]:bg-subtle aria-[current=page]:font-medium aria-[current=page]:text-ink";
---

<div class="grid gap-6">
  <FrameworkSwitcher />
  <section>
    <h2 class={heading}>{strings.start}</h2>
    <ul class="grid gap-0.5">
      {
        docsNav(locale).map((item) => (
          <li>
            <a href={item.href} class={link} aria-current={path === item.href ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  {
    groups.map((group) => (
      <section>
        <h2 class={heading}>{group.label}</h2>
        <ul class="grid gap-0.5">
          {group.items.map((item) => {
            const label = freshness(item);
            const href = localePath(locale, `/components/${item.name}`);
            return (
              <li>
                <a href={href} class={link} aria-current={path === href ? "page" : undefined}>
                  {item.title}
                  {label && <span class="text-xs text-primary">{label === "new" ? strings.fresh : strings.updated}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</div>
