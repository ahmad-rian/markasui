---
import { FRAMEWORKS } from "@markasui/registry/schema";
import FrameworkIcon from "./FrameworkIcon.astro";
import { FRAMEWORK_LABELS } from "../lib/frameworks";
import { getLocale, t } from "../lib/i18n";

interface Props {
  /** compact: hanya untuk header panel kode, tanpa latar segmen. */
  variant?: "segmented" | "compact";
  label?: string;
}
const strings = t(getLocale(Astro.url)).framework;
const { variant = "segmented", label = strings.label } = Astro.props;
const isCompact = variant === "compact";
---

<div
  role="radiogroup"
  aria-label={label}
  data-framework-switcher
  class:list={isCompact ? "flex items-center gap-1" : "grid grid-cols-3 gap-1 rounded-xl bg-subtle p-1"}
>
  {
    FRAMEWORKS.map((framework) => (
      <button
        type="button"
        role="radio"
        aria-checked="false"
        data-value={framework}
        data-fw-option={framework}
        class:list={[
          "inline-flex items-center justify-center gap-2 rounded-md text-sm text-muted transition-colors duration-150 ease-out hover:text-ink aria-checked:text-ink",
          isCompact
            ? "h-8 px-2.5 aria-checked:bg-subtle"
            : "h-9 rounded-lg aria-checked:bg-surface aria-checked:font-medium aria-checked:shadow-[0_1px_3px_rgb(0_0_0/0.08)]",
        ]}
      >
        <FrameworkIcon framework={framework} class="size-4" />
        {FRAMEWORK_LABELS[framework]}
      </button>
    ))
  }
</div>

<script>
  import { onPageLoad } from "../scripts/lifecycle";
  import { getFramework, isFramework, setFramework } from "../scripts/prefs";

  function sync() {
    const current = getFramework();
    document.querySelectorAll<HTMLElement>("[data-framework-switcher] [role=radio]").forEach((radio) => {
      const checked = radio.dataset.value === current;
      radio.setAttribute("aria-checked", String(checked));
      radio.tabIndex = checked ? 0 : -1;
    });
  }

  const STEPS: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };

  document.addEventListener("click", (event) => {
    const radio = (event.target as HTMLElement).closest<HTMLElement>("[data-framework-switcher] [role=radio]");
    if (radio && isFramework(radio.dataset.value)) setFramework(radio.dataset.value);
  });
  document.addEventListener("keydown", (event) => {
    const group = (event.target as HTMLElement).closest<HTMLElement>("[data-framework-switcher]");
    const step = STEPS[event.key];
    if (!group || !step) return;
    event.preventDefault();
    const radios = [...group.querySelectorAll<HTMLElement>("[role=radio]")];
    const index = radios.findIndex((radio) => radio.getAttribute("aria-checked") === "true");
    const next = radios[(index + step + radios.length) % radios.length]!;
    if (isFramework(next.dataset.value)) setFramework(next.dataset.value);
    next.focus();
  });

  document.addEventListener("markas:framework", sync);
  onPageLoad(sync);
</script>
