---
import { FRAMEWORKS } from "@markasui/registry/schema";
import FrameworkIcon from "./FrameworkIcon.astro";
import { FRAMEWORK_LABELS } from "../lib/frameworks";
import { getLocale, t } from "../lib/i18n";

interface Props {
  /** compact: hanya untuk header panel kode, tanpa latar segmen. */
  variant?: "segmented" | "compact";
  label?: string;
}
const strings = t(getLocale(Astro.url)).framework;
const { variant = "segmented", label = strings.label } = Astro.props;
const isCompact = variant === "compact";
---

<div
  role="radiogroup"
  aria-label={label}
  data-framework-switcher
  class:list={isCompact ? "flex items-center gap-1" : "grid grid-cols-3 gap-1 rounded-xl bg-subtle p-1"}
>
  {
    FRAMEWORKS.map((framework) => (
      <button
        type="button"
        role="radio"
        aria-checked="false"
        data-value={framework}
        data-fw-option={framework}
        class:list={[
          "inline-flex items-center justify-center gap-2 rounded-md text-sm text-muted transition-colors duration-150 ease-out hover:text-ink aria-checked:text-ink",
          isCompact
            ? "h-8 px-2.5 aria-checked:bg-subtle"
            : "h-9 rounded-lg aria-checked:bg-surface aria-checked:font-medium aria-checked:shadow-[0_1px_3px_rgb(0_0_0/0.08)]",
        ]}
      >
        <FrameworkIcon framework={framework} class="size-4" />
        {FRAMEWORK_LABELS[framework]}
      </button>
    ))
  }
</div>
