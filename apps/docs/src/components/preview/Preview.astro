---
import Icon from "../Icon.astro";
import ReactPreview from "./ReactPreview";
import VuePreview from "./VuePreview.vue";

interface Props {
  name: string;
  /** Tanpa bingkai dan tombol reload, untuk dipasang di dalam panel lain (hero). */
  bare?: boolean;
  class?: string;
}
const { name, bare = false, class: className } = Astro.props;

// HTML Blade dibuat oleh scripts/render-blade.php (pnpm --filter @markasui/docs generate).
const bladeFiles = import.meta.glob<string>("../../generated/blade/*.html", { query: "?raw", import: "default", eager: true });
const bladeHtml = bladeFiles[`../../generated/blade/${name}.html`];
const pane = "w-full max-w-md";
---

<div
  class:list={["relative", !bare && "overflow-hidden rounded-xl border border-line bg-surface", className]}
  data-preview
  data-pagefind-ignore
>
  {
    !bare && (
      <button type="button" data-preview-reload aria-label="Muat ulang preview" class="icon-button absolute top-2 right-2 z-10 size-8">
        <Icon name="reload" />
      </button>
    )
  }
  <div class:list={["flex items-center justify-center", bare ? "px-6 py-8 sm:px-10" : "dot-grid min-h-72 px-4 py-12 sm:px-8"]} data-preview-stage>
    <div data-fw="blade" class={pane}>
      {bladeHtml ? <Fragment set:html={bladeHtml} /> : <p class="text-sm text-danger">Preview Blade belum dirender. Jalankan pnpm build.</p>}
    </div>
    <div data-fw="react" class={pane}>
      <ReactPreview client:visible name={name} />
    </div>
    <div data-fw="vue" class={pane}>
      <VuePreview client:visible name={name} />
    </div>
  </div>
</div>

<script>
  import { onAfterSwap } from "../../scripts/lifecycle";

  // HTML awal disimpan sebelum island hydrate dan sebelum Alpine berjalan. Tombol reload memasangnya
  // kembali: astro-island yang baru akan hydrate ulang, dan Alpine menginisialisasi DOM Blade baru.
  const pristine = new WeakMap<HTMLElement, string>();
  const capture = () =>
    document.querySelectorAll<HTMLElement>("[data-preview-stage]").forEach((stage) => pristine.set(stage, stage.innerHTML));

  capture();
  onAfterSwap(capture);

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest("[data-preview-reload]");
    const stage = button?.closest("[data-preview]")?.querySelector<HTMLElement>("[data-preview-stage]");
    const html = stage && pristine.get(stage);
    if (stage && html) stage.innerHTML = html;
  });
</script>
