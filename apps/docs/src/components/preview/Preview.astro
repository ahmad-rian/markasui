---
import Icon from "../Icon.astro";
import { getLocale, t } from "../../lib/i18n";
import ReactPreview from "./ReactPreview";
import FrameworkPanes from "./FrameworkPanes.astro";
import VuePreview from "./VuePreview.vue";

interface Props {
  name: string;
  /** Tanpa bingkai dan tombol reload, untuk dipasang di dalam panel lain (hero). */
  bare?: boolean;
  class?: string;
}
const { name, bare = false, class: className } = Astro.props;

// HTML Blade dibuat oleh scripts/render-blade.php (pnpm --filter @markasui/docs generate).
const bladeFiles = import.meta.glob<string>("../../generated/blade/*.html", { query: "?raw", import: "default", eager: true });
const bladeHtml = bladeFiles[`../../generated/blade/${name}.html`];
/** Komponen selebar halaman (navigasi situs) butuh panggung penuh supaya tampil versi desktop. */
const WIDE = ["navbar", "navigation-menu", "sidebar", "footer", "faq", "logo-cloud", "not-found"];
const isWide = WIDE.some((wide) => name === wide || name.startsWith(`${wide}--`));
const pane = isWide ? "w-full" : "w-full max-w-md";
const strings = t(getLocale(Astro.url)).component;
---

<div class:list={["relative", !bare && "frame", className]} data-preview data-pagefind-ignore>
  <div class:list={["relative", !bare && "frame-panel overflow-hidden"]}>
    {
      !bare && (
        <button type="button" data-preview-reload aria-label={strings.reload} class="icon-button absolute top-2 right-2 z-10 size-8">
          <Icon name="reload" />
        </button>
      )
    }
    <div class:list={["flex items-center justify-center", bare ? "px-6 py-8 sm:px-10" : "dot-grid min-h-80 px-4 py-14 sm:px-8"]} data-preview-stage>
      <div data-fw="blade" class={pane}>
        {bladeHtml ? <Fragment set:html={bladeHtml} /> : <p class="text-sm text-danger">{strings.bladeMissing}</p>}
      </div>
      <div data-fw="react" class={pane}>
        <ReactPreview client:near name={name} />
      </div>
      <div data-fw="vue" class={pane}>
        <VuePreview client:near name={name} />
      </div>
      <FrameworkPanes name={name} pane={pane} />
    </div>
  </div>
</div>
