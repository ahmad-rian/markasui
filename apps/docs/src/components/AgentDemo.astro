---
import Icon from "./Icon.astro";
import { getLocale, t } from "../lib/i18n";

const strings = t(getLocale(Astro.url)).agentDemo;
/** Transkrip alur MCP: tool dan path yang dipakai agent persis seperti di @markasui/mcp. */
const calls = [
  ["get_setup", "blade"],
  ["get_component", "input, blade"],
  ["get_component", "button, blade"],
];
const written = [
  "resources/views/components/markas/input.blade.php",
  "resources/views/components/markas/button.blade.php",
  "resources/views/auth/login.blade.php",
];
const row = "flex min-w-0 items-center gap-3";
---

<figure class="lp-term dark">
  <figcaption class="flex h-11 items-center gap-3 border-b border-line px-4 text-xs text-muted">
    <span class="lp-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {strings.caption}
  </figcaption>
  <div class="grid grid-cols-[minmax(0,1fr)] gap-6 p-5 sm:p-7">
    <p class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-subtle px-4 py-3 text-[15px] leading-6 text-ink">{strings.prompt}</p>
    <div class="grid grid-cols-[minmax(0,1fr)] gap-4 font-mono text-xs leading-5">
      <ol class="grid grid-cols-[minmax(0,1fr)] gap-1.5 text-muted" aria-label={strings.calls}>
        {
          calls.map(([tool, args]) => (
            <li class={row}>
              <span class="w-28 shrink-0 text-ink">{tool}</span>
              <span class="truncate">{args}</span>
            </li>
          ))
        }
      </ol>
      <ul class="grid grid-cols-[minmax(0,1fr)] gap-1.5 border-t border-line pt-4" aria-label={strings.files}>
        {
          written.map((path) => (
            <li class:list={[row, "text-muted"]}>
              <Icon name="check" class="size-3.5 shrink-0 text-brand" />
              <span class="truncate">{path}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="flex gap-3 text-[15px] leading-6 text-ink">
      <Icon name="sparkles" class="mt-1 size-4 shrink-0 text-brand" />
      {strings.reply}
    </p>
  </div>
</figure>
