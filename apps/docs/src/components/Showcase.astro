---
import type { Framework } from "@markasui/registry/schema";
import CodeBlock from "./CodeBlock.astro";
import FrameworkIcon from "./FrameworkIcon.astro";
import Icon from "./Icon.astro";
import Preview from "./preview/Preview.astro";
import { FRAMEWORK_LABELS, shikiLang } from "../lib/frameworks";
import { getLocale, t } from "../lib/i18n";

const strings = t(getLocale(Astro.url)).home;
const frameworks: Framework[] = ["blade", "react", "vue"];

/** Contoh login dari examples/, jadi kode yang tampil sama dengan yang diuji parity di CI. */
const sources = import.meta.glob<string>("../../../../examples/*/login-form.*", { query: "?raw", import: "default", eager: true });
const source = (framework: Framework) => {
  const entry = Object.entries(sources).find(([path]) => path.includes(`/examples/${framework}/`));
  if (!entry) throw new Error(`Contoh login-form untuk ${framework} tidak ada`);
  return entry[1];
};
const dedent = (text: string) => {
  const lines = text.split("\n");
  const indent = Math.min(...lines.filter((line) => line.trim()).map((line) => line.match(/^ */)![0].length));
  return lines.map((line) => line.slice(indent)).join("\n");
};
const snippet: Record<Framework, string> = {
  blade: source("blade").trim(),
  react: dedent(source("react").match(/return \(\n([\s\S]*?)\n\s*\);/)![1]!),
  vue: dedent(source("vue").match(/<template>\n([\s\S]*?)\n<\/template>/)![1]!),
};
const files: Record<Framework, string> = {
  blade: "resources/views/auth/login.blade.php",
  react: "src/pages/Login.tsx",
  vue: "src/pages/Login.vue",
};
const added: Record<Framework, string[]> = {
  blade: ["input.blade.php", "checkbox.blade.php", "button.blade.php"],
  react: ["Input.tsx", "Checkbox.tsx", "Button.tsx"],
  vue: ["Input.vue", "Checkbox.vue", "Button.vue"],
};
const COMMAND = "npx markasui@latest add input checkbox button";
const windowClass = "overflow-hidden rounded-2xl border border-line bg-surface/90 shadow-overlay backdrop-blur-md";
const bar = "flex h-10 items-center justify-center border-b border-line px-4 text-xs text-muted";
---

<div class="showcase-bg relative overflow-hidden rounded-3xl border border-line p-4 sm:p-8 lg:p-12" data-pagefind-ignore>
  <div class="relative grid gap-5 lg:grid-cols-12">
    <div class="grid gap-5 lg:col-span-7">
      <section class={windowClass} aria-label={strings.preview}>
        <div class={bar}>{strings.preview}</div>
        <div class="dot-grid">
          <Preview name="login-form" bare />
        </div>
      </section>
      <section class={windowClass} aria-label="Editor">
        <div class={bar}>
          {frameworks.map((fw) => <span data-fw={fw} class="truncate font-mono text-[11px]">{files[fw]}</span>)}
        </div>
        {frameworks.map((fw) => <div data-fw={fw} class="code-lines"><CodeBlock code={snippet[fw]} lang={shikiLang(fw)} bare /></div>)}
      </section>
    </div>

    <div class="grid content-start gap-5 lg:col-span-5">
      <section class={windowClass} aria-label={strings.terminal}>
        <div class={bar}>{strings.terminal}</div>
        <div class="grid gap-1.5 px-4 py-4 font-mono text-[12px] leading-5">
          <p class="flex min-w-0 gap-2 text-ink">
            <span class="text-muted" aria-hidden="true">$</span>
            <span class="terminal-type overflow-hidden whitespace-nowrap" style={`--chars:${COMMAND.length}`}>{COMMAND}</span>
          </p>
          {
            frameworks.map((fw) => (
              <div data-fw={fw}>
                <ul class="terminal-output grid gap-1 text-muted">
                  {added[fw].map((file) => (
                    <li class="flex items-center gap-2">
                      <Icon name="check" class="size-3.5 shrink-0 text-brand" />
                      <span class="truncate">{strings.added(file)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class={windowClass} aria-labelledby="showcase-frameworks">
        <div class={bar} id="showcase-frameworks">{strings.frameworks}</div>
        <div role="radiogroup" aria-labelledby="showcase-frameworks" data-framework-switcher class="grid gap-1 p-2">
          {
            frameworks.map((fw) => (
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-value={fw}
                data-fw-option={fw}
                class="flex h-12 items-center gap-3 rounded-xl px-3 text-left text-[15px] text-ink/80 transition-colors duration-150 ease-out hover:bg-subtle aria-checked:bg-subtle aria-checked:text-ink"
              >
                <FrameworkIcon framework={fw} class="size-5" />
                <span class="font-medium">{FRAMEWORK_LABELS[fw]}</span>
                <span class="ml-auto truncate font-mono text-[11px] text-muted">{strings.frameworkMeta[fw]}</span>
              </button>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</div>
