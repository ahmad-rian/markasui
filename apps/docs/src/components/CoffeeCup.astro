---
/**
 * The cup on the floating coffee launcher (components/CoffeeLauncher.astro): a green hand-drawn line cup with two
 * wisps of steam, in the /support art direction (src/styles/support.css). The steam rises a few times once the
 * launcher shows and again on hover (CSS only, still with reduced motion). Size and tile come from the caller.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["coffee-art", className]} aria-hidden="true" data-coffee-art>
  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    <path class="coffee-steam" d="M26 7q-3.5 4.5 0 9t0 9" />
    <path class="coffee-steam" d="M36 7q-3.5 4.5 0 9t0 9" />
    <path d="M13 29H47V37A17 17 0 0 1 13 37Z" />
    <path d="M18 33.5H42V37A12 12 0 0 1 18 37Z" fill="currentColor" stroke="none" />
    <path d="M47 32H50A6.5 6.5 0 0 1 50 45H45" />
    <path d="M9 59H51" />
  </svg>
</span>
