---
import BrandMark from "./BrandMark.astro";
import { getLocale, localePath } from "../lib/i18n";
const locale = getLocale(Astro.url);
---

<a href={localePath(locale, "/")} class="flex shrink-0 items-center gap-2.5 rounded-md text-[17px] font-semibold tracking-[-0.02em] text-ink" aria-label="MarkasUI">
  <BrandMark class="h-7 w-auto" />
  <span>MarkasUI</span>
</a>
