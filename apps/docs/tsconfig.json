{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "../../components/*/*.astro",
    "../../examples/astro/*.astro",
    "../../templates/*/astro/*.astro"
  ],
  "exclude": ["dist", "src/generated"]
}
